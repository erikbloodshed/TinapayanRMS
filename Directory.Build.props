<Project>

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <!-- For the MAUI app (TinapayanRMS.Maui), whose Windows target needs Windows SDK 10.0.19041 or later;
         the bare net11.0-windows moniker resolves to windows7.0. -->
    <WindowsTargetFramework>net11.0-windows10.0.19041.0</WindowsTargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The SDK's built-in .NET analyzers at their Recommended rule set, tracking the SDK's latest
         rules. Per-folder exceptions live in .editorconfig. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- A using nothing needs (IDE0005, a warning in .editorconfig) is reported by every build, so CI's, which takes any
         warning as an error, refuses it. The build runs the code-style rules for it, and the compiler reads the doc
         comments, without which it can't tell whether a using is there for one (a <see cref>): a doc comment it can't
         read, or that names what isn't there, is a warning too. No documentation is wanted from it, so a public member
         without a comment isn't one, and no XML file is published. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
    <!-- .NET 11's runtime async: async methods compile to the runtime's own support for them rather
         than to state machines. Still an opt-in compiler feature in RC3. -->
    <Features>$(Features);runtime-async=on</Features>
  </PropertyGroup>

  <!-- Everyday builds leave the commit out. The SDK otherwise puts the commit's hash into each
       assembly's version and its Source Link file, so the first build after any commit would recompile
       every project, even after a commit that changed only docs, and the MCP server, which builds as it
       starts, would miss Claude Code's wait at every session start. A dotnet publish keeps both, so an
       installed copy still says which commit it was built from. -->
  <PropertyGroup Condition="'$(_IsPublishing)' != 'true'">
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <EnableSourceLink>false</EnableSourceLink>
  </PropertyGroup>

</Project>
