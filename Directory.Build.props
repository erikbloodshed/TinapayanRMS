<Project>

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <!-- For the UI and Tests projects. ReactiveUI.WPF needs Windows SDK 10.0.19041 or later,
         and the bare net11.0-windows moniker resolves to windows7.0. -->
    <WindowsTargetFramework>net11.0-windows10.0.19041.0</WindowsTargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The SDK's built-in .NET analyzers at their Recommended rule set, tracking the SDK's latest
         rules. Per-folder exceptions live in .editorconfig. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- .NET 11's runtime async: async methods compile to the runtime's own support for them rather
         than to state machines. Still an opt-in compiler feature in RC3. -->
    <Features>$(Features);runtime-async=on</Features>
  </PropertyGroup>

  <!-- Everyday builds leave the commit out (2026-11-04). The SDK otherwise puts the commit's hash into
       each assembly's version and its Source Link file, so the first build after any commit recompiled
       every project, even after a commit that changed only docs, and the MCP server, which builds as it
       starts, missed Claude Code's wait at every session start. A dotnet publish keeps both, so an
       installed copy still says which commit it was built from. -->
  <PropertyGroup Condition="'$(_IsPublishing)' != 'true'">
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <EnableSourceLink>false</EnableSourceLink>
  </PropertyGroup>

</Project>
