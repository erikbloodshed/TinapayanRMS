<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(WindowsTargetFramework)</TargetFramework>
    <IsPackable>false</IsPackable>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="Respawn" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TinapayanRMS.Domain\TinapayanRMS.Domain.csproj" />
    <ProjectReference Include="..\..\src\TinapayanRMS.ApplicationCore\TinapayanRMS.ApplicationCore.csproj" />
    <ProjectReference Include="..\..\src\TinapayanRMS.Infrastructure\TinapayanRMS.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\TinapayanRMS.UI\TinapayanRMS.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\src\TinapayanRMS.UI\appsettings.json" Link="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
