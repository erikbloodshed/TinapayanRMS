<Project Sdk="Microsoft.NET.Sdk">

  <!-- The MAUI app's screens (TinapayanRMS.Components): the DI wiring, the page's list of Syncfusion scripts, the Vim
       keys' C#, and the shared components rendered with bUnit, with no database, no web view and no MAUI. -->

  <ItemGroup>
    <PackageReference Include="bunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TinapayanRMS.Components\TinapayanRMS.Components.csproj" />
  </ItemGroup>

  <!-- The architecture tests that read IL (DecimalNumbersTests) read the app and the two servers too, from the assemblies
       their builds make, without loading them (ExternalAssemblies): built first, but not referenced. The app's is Windows
       only, which this project's net11.0 can't reference, so its framework isn't negotiated. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\TinapayanRMS.Maui\TinapayanRMS.Maui.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" OutputItemType="ReadAssembly" />
    <ProjectReference Include="..\..\src\TinapayanRMS.RecipeApi\TinapayanRMS.RecipeApi.csproj" ReferenceOutputAssembly="false" OutputItemType="ReadAssembly" />
    <ProjectReference Include="..\..\src\TinapayanRMS.Mcp\TinapayanRMS.Mcp.csproj" ReferenceOutputAssembly="false" OutputItemType="ReadAssembly" />
  </ItemGroup>

  <Target Name="NameReadAssemblies" AfterTargets="ResolveProjectReferences" BeforeTargets="GetAssemblyAttributes">
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>ReadAssembly:%(ReadAssembly.Filename)</_Parameter1>
        <_Parameter2>%(ReadAssembly.FullPath)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- SyncfusionScriptsTests: the page's list of the Syncfusion components whose scripts it loads, and Syncfusion's
         loader, from the package at SyncfusionVersion, that it's checked against. -->
    <Content Include="..\..\src\TinapayanRMS.Components\wwwroot\syncfusion.js" Link="syncfusion.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(NuGetPackageRoot)syncfusion.blazor.core\$(SyncfusionVersion)\staticwebassets\scripts\syncfusion-blazor-base.min.js"
             Link="syncfusion-blazor-base.min.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- AppIconsTests: the theme the page links, which defines Syncfusion's icons. -->
    <Content Include="$(NuGetPackageRoot)syncfusion.blazor.themes\$(SyncfusionVersion)\staticwebassets\fluent2-lite.css" Link="fluent2-lite.css">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Bunit" />
    <!-- bUnit still has a TestContext of its own (obsolete since 2.0): TUnit's is the one meant here. -->
    <Using Include="TUnit.Core.TestContext" Alias="TestContext" />
  </ItemGroup>

</Project>
