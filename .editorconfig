root = true

# Every file is written with LF, as Git stores and checks them out (.gitattributes).
[*]
end_of_line = lf

[*.cs]
# CA1716 flags member names that are keywords in other .NET languages, such as `Date` in Visual Basic.
# This app is C# only, and IPriceHistoryEntry.Date maps to a database column.
dotnet_diagnostic.CA1716.severity = none

# A using nothing needs: every build reports it (Directory.Build.props), and CI's fails on it.
dotnet_diagnostic.IDE0005.severity = warning

# Code metrics (docs/adr/0004): a method's cyclomatic complexity over 25 (CA1502), and a type coupled to over 95 types
# or a member to over 40 (CA1506), the analyzers' own thresholds. What was over them on 2026-11-20 carries a
# SuppressMessage saying why, so CI's build (warnings as errors) refuses anything new over them.
dotnet_diagnostic.CA1502.severity = warning
dotnet_diagnostic.CA1506.severity = warning

# Back at the Recommended level's severity for the files on disk: .globalconfig takes them off for the code Razor
# generates from a .razor file, which takes its severities from there alone.
dotnet_diagnostic.CA1000.severity = warning
dotnet_diagnostic.CA1305.severity = warning
dotnet_diagnostic.CA1816.severity = warning
dotnet_diagnostic.CA1822.severity = warning
dotnet_diagnostic.CA1826.severity = warning
dotnet_diagnostic.CA1861.severity = warning

# A .razor file's code is the developer's, though the compiler sees it in the files Razor generates from it (the markup in
# *_razor.g.cs, the @code members in *_razor.decl.g.cs), which analyzers skip as generated. Marked as not, the code
# metrics see it too, at the severity .globalconfig gives them.
[**_razor.{g,decl.g}.cs]
generated_code = false

# Migrations are scaffolded by `dotnet ef migrations add` and never edited by hand,
# so analyzer warnings in them can't be acted on.
[src/TinapayanRMS.Infrastructure/Migrations/**.cs]
generated_code = true

# WinUI's XAML compiler writes this file into the app's build, with a Convert.ChangeType BannedSymbols.txt refuses
# elsewhere: nothing in it can be changed (approved 2026-11-22, ADR 0010).
[src/TinapayanRMS.Maui/obj/**/XamlTypeInfo.g.cs]
dotnet_diagnostic.RS0030.severity = none

[tests/**.cs]
# Test methods are named Method_Scenario_Result.
dotnet_diagnostic.CA1707.severity = none

# A test class reaches into whatever its scenarios need: the code metrics are for the app's code.
dotnet_diagnostic.CA1502.severity = none
dotnet_diagnostic.CA1506.severity = none
