{
  "mcpServers": {
    "tinapayanrms": {
      "command": "powershell",
      "args": ["-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "scripts/Start-McpServer.ps1"]
    },
    "syncfusion-blazor": {
      "command": "dotnet",
      "args": ["dnx", "Syncfusion.Blazor.MCP", "--yes"],
      "env": {
        "Syncfusion_API_Key": "${SYNCFUSION_API_KEY}"
      }
    }
  }
}
