<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Syncfusion.Themes.Windows11Light.WPF</RootNamespace>
    <AssemblyName>Syncfusion.Themes.Windows11Light.WPF</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>ThemeStudio.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="ThemeStudio.snk" />
  </ItemGroup>

  <!--
    Generated by Syncfusion Theme Studio, which references the locally installed
    Essential Studio WPF 34.2.2 via local file paths and covers every control
    Theme Studio knows about (~50 assemblies, including PDF/DocIO/XlsIO/Gantt/
    Spreadsheet document engines and specialty visualization controls this app
    never uses). Converted to NuGet PackageReferences and trimmed to the "core
    set" TinapayanRMS.UI actually adopts (SfDataGrid, input controls, ButtonAdv,
    TabControlExt, DockingManager/Ribbon, SfChart) plus their shared/base
    dependencies. Four packages (PivotAnalysis.WPF, Pdf.Base, DocIO.Base,
    XlsIO.Base) don't exist at 34.2.2 on nuget.org at all — Syncfusion renamed
    them (Pdf.Wpf, DocIO.Wpf, XlsIO.Wpf) — but none of that document-engine
    chain is needed here, so they're dropped rather than chased.
    Note: the "SfTabControl" folder Theme Studio generated is NOT a general
    tab control — its XAML resolves Syncfusion.Windows.Controls.SfTabControl
    from Syncfusion.SfChromelessWindow.WPF, i.e. it's SfChromelessWindow's own
    tab strip. The general-purpose tab control is TabControlExt (kept, backed
    by Syncfusion.Tools.WPF).
    Folders for dropped controls are excluded from compilation below, mirroring
    the pre-existing Fluent exclusion. See PLAN.md's Open Items for what to do
    if a later phase needs a control from the dropped set.
  -->
  <ItemGroup>
    <PackageReference Include="Syncfusion.SfSkinManager.WPF" Version="34.2.2" />
    <PackageReference Include="Syncfusion.Shared.WPF" Version="34.2.2" />
    <PackageReference Include="Syncfusion.Tools.WPF" Version="34.2.2" />
    <PackageReference Include="Syncfusion.Tools.WPF.Classic" Version="34.2.2" />
    <PackageReference Include="Syncfusion.SfInput.WPF" Version="34.2.2" />
    <PackageReference Include="Syncfusion.SfGrid.WPF" Version="34.2.2" />
    <PackageReference Include="Syncfusion.SfGridCommon.WPF" Version="34.2.2" />
    <PackageReference Include="Syncfusion.Data.WPF" Version="34.2.2" />
    <PackageReference Include="Syncfusion.Grid.WPF" Version="34.2.2" />
    <PackageReference Include="Syncfusion.GridCommon.WPF" Version="34.2.2" />
    <PackageReference Include="Syncfusion.SfChart.WPF" Version="34.2.2" />
    <PackageReference Include="Syncfusion.SfNavigationDrawer.WPF" Version="34.2.2" />
  </ItemGroup>

  <!-- Folders for controls outside the core set (see comment above) -->
  <ItemGroup>
    <_ExcludedThemeFolders Include="Fluent" />
    <_ExcludedThemeFolders Include="PivotGridControl" />
    <_ExcludedThemeFolders Include="GanttControl" />
    <_ExcludedThemeFolders Include="PdfViewerControl" />
    <_ExcludedThemeFolders Include="DocumentContainer" />
    <_ExcludedThemeFolders Include="SfRichTextBoxAdv" />
    <_ExcludedThemeFolders Include="SfSpreadsheet" />
    <_ExcludedThemeFolders Include="SfCellGrid" />
    <_ExcludedThemeFolders Include="SfScheduler" />
    <_ExcludedThemeFolders Include="SfKanban" />
    <_ExcludedThemeFolders Include="SfDiagram" />
    <_ExcludedThemeFolders Include="SfDiagramRibbon" />
    <_ExcludedThemeFolders Include="SfMap" />
    <_ExcludedThemeFolders Include="SfTreeMap" />
    <_ExcludedThemeFolders Include="SfHeatMap" />
    <_ExcludedThemeFolders Include="SfSmithChart" />
    <_ExcludedThemeFolders Include="SfSunburstChart" />
    <_ExcludedThemeFolders Include="SfBulletGraph" />
    <_ExcludedThemeFolders Include="SfImageEditor" />
    <_ExcludedThemeFolders Include="SfGauge" />
    <_ExcludedThemeFolders Include="SfCircularGauge" />
    <_ExcludedThemeFolders Include="SfDigitalGauge" />
    <_ExcludedThemeFolders Include="SfLinearGauge" />
    <_ExcludedThemeFolders Include="MarkdownViewer" />
    <_ExcludedThemeFolders Include="SfSmartTextEditor" />
    <_ExcludedThemeFolders Include="AssistView" />
    <_ExcludedThemeFolders Include="SfAssistViewLayout" />
    <_ExcludedThemeFolders Include="SfSmartDataGrid" />
    <_ExcludedThemeFolders Include="SfChat" />
    <_ExcludedThemeFolders Include="SpellChecker" />
    <_ExcludedThemeFolders Include="SfAccordion" />
    <_ExcludedThemeFolders Include="SfTreeView" />
    <_ExcludedThemeFolders Include="SfTreeNavigator" />
    <_ExcludedThemeFolders Include="SfTreeGrid" />
    <_ExcludedThemeFolders Include="SfChromelessWindow" />
    <_ExcludedThemeFolders Include="ChromelessWindow" />
    <_ExcludedThemeFolders Include="SfTextInputLayout" />
    <_ExcludedThemeFolders Include="SfToastNotification" />
    <_ExcludedThemeFolders Include="SfBusyIndicator" />
    <_ExcludedThemeFolders Include="BusyIndicator" />
    <_ExcludedThemeFolders Include="SfLinearProgressBar" />
    <_ExcludedThemeFolders Include="SfCircularProgressBar" />
    <_ExcludedThemeFolders Include="SfStepProgressBar" />
    <_ExcludedThemeFolders Include="SfColorPalette" />
    <_ExcludedThemeFolders Include="ColorPickerPalette" />
    <_ExcludedThemeFolders Include="SfHubTile" />
    <_ExcludedThemeFolders Include="SfPulsingTile" />
    <_ExcludedThemeFolders Include="SfRadialMenu" />
    <_ExcludedThemeFolders Include="PropertyGrid" />
    <_ExcludedThemeFolders Include="Stencil" />
    <_ExcludedThemeFolders Include="EditControl" />
    <_ExcludedThemeFolders Include="PrintPreviewControl" />
    <_ExcludedThemeFolders Include="GridPrintPreviewControl" />
    <_ExcludedThemeFolders Include="PrintPreview" />
    <_ExcludedThemeFolders Include="SfRadialSlider" />
    <_ExcludedThemeFolders Include="SfTabControl" />

    <Compile Remove="@(_ExcludedThemeFolders -> '%(Identity)\**')" />
    <EmbeddedResource Remove="@(_ExcludedThemeFolders -> '%(Identity)\**')" />
    <None Remove="@(_ExcludedThemeFolders -> '%(Identity)\**')" />
    <Page Remove="@(_ExcludedThemeFolders -> '%(Identity)\**')" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Common\FontFamily\Windows11ThemeControlIcons.ttf" />
  </ItemGroup>

</Project>
