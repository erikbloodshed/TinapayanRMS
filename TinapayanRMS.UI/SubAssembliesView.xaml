<UserControl x:Class="TinapayanRMS.UI.SubAssembliesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1400">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="260" />
        </Grid.ColumnDefinitions>

        <syncfusion:SfDataGrid Grid.Column="0"
                                ItemsSource="{Binding SubAssemblies}"
                                SelectedItem="{Binding SelectedSubAssembly, Mode=TwoWay}"
                                AutoGenerateColumns="False"
                                AllowEditing="False"
                                SelectionMode="Single"
                                NavigationMode="Row">
            <syncfusion:SfDataGrid.Columns>
                <syncfusion:GridTextColumn MappingName="Name" HeaderText="Name" />
                <syncfusion:GridTextColumn MappingName="Role.Name" HeaderText="Role" />
                <syncfusion:GridNumericColumn MappingName="TotalWeight" HeaderText="Total Weight (g)" />
                <syncfusion:GridNumericColumn MappingName="TotalCost" HeaderText="Total Cost" />
            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>

        <StackPanel Grid.Column="2">
            <TextBlock Text="Name" Margin="0,0,0,4" />
            <syncfusion:SfTextBoxExt Text="{Binding EditingName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,0,0,12" />

            <TextBlock Text="Role" Margin="0,0,0,4" />
            <syncfusion:ComboBoxAdv ItemsSource="{Binding Roles}"
                                     DisplayMemberPath="Name"
                                     SelectedItem="{Binding EditingRole, Mode=TwoWay}"
                                     Margin="0,0,0,12" />

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <syncfusion:ButtonAdv Label="New" IconTemplate="{StaticResource AddIconTemplate}" Command="{Binding NewCommand}" Margin="0,0,8,0" />
                <syncfusion:ButtonAdv Label="Save" IconTemplate="{StaticResource SaveIconTemplate}" Command="{Binding SaveCommand}" Margin="0,0,8,0" />
                <syncfusion:ButtonAdv Label="Delete" IconTemplate="{StaticResource DeleteIconTemplate}" Command="{Binding DeleteCommand}" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="4"
                    Visibility="{Binding ShowLinesEditor, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="Lines" FontSize="14" Margin="0,0,0,8" />

            <syncfusion:SfDataGrid ItemsSource="{Binding LineEdits}"
                                    SelectedItem="{Binding SelectedLineEdit, Mode=TwoWay}"
                                    AutoGenerateColumns="False"
                                    AllowEditing="False"
                                    SelectionMode="Single"
                                    NavigationMode="Row"
                                    Height="220">
                <syncfusion:SfDataGrid.Columns>
                    <syncfusion:GridTextColumn MappingName="Ingredient.Name" HeaderText="Ingredient" />
                    <syncfusion:GridNumericColumn MappingName="Grams" HeaderText="Grams" />
                </syncfusion:SfDataGrid.Columns>
            </syncfusion:SfDataGrid>

            <TextBlock Text="Ingredient" Margin="0,12,0,4" />
            <syncfusion:ComboBoxAdv ItemsSource="{Binding Ingredients}"
                                     DisplayMemberPath="Name"
                                     SelectedItem="{Binding EditingLineIngredient, Mode=TwoWay}"
                                     Margin="0,0,0,12" />

            <TextBlock Text="Grams" Margin="0,0,0,4" />
            <syncfusion:DoubleTextBox Value="{Binding EditingLineGrams, Mode=TwoWay}"
                                       Margin="0,0,0,12" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <syncfusion:ButtonAdv Label="Add Line" IconTemplate="{StaticResource AddIconTemplate}" Command="{Binding AddLineCommand}" Margin="0,0,8,0" />
                <syncfusion:ButtonAdv Label="Remove Line" IconTemplate="{StaticResource RemoveIconTemplate}" Command="{Binding RemoveLineCommand}" />
            </StackPanel>

            <syncfusion:ButtonAdv Label="Save Lines" IconTemplate="{StaticResource SaveIconTemplate}" Command="{Binding SaveLinesCommand}" />
        </StackPanel>

        <StackPanel Grid.Column="6">
            <TextBlock Text="Roles" FontSize="14" Margin="0,0,0,8" />

            <syncfusion:SfDataGrid ItemsSource="{Binding Roles}"
                                    SelectedItem="{Binding SelectedRole, Mode=TwoWay}"
                                    AutoGenerateColumns="False"
                                    AllowEditing="False"
                                    SelectionMode="Single"
                                    NavigationMode="Row"
                                    Height="180">
                <syncfusion:SfDataGrid.Columns>
                    <syncfusion:GridTextColumn MappingName="Name" HeaderText="Name" />
                    <syncfusion:GridNumericColumn MappingName="SortOrder" HeaderText="Order" />
                </syncfusion:SfDataGrid.Columns>
            </syncfusion:SfDataGrid>

            <TextBlock Text="Name" Margin="0,12,0,4" />
            <syncfusion:SfTextBoxExt Text="{Binding EditingRoleName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,0,0,12" />

            <TextBlock Text="Sort Order" Margin="0,0,0,4" />
            <syncfusion:DoubleTextBox Value="{Binding EditingRoleSortOrder, Mode=TwoWay}"
                                       Margin="0,0,0,12" />

            <StackPanel Orientation="Horizontal">
                <syncfusion:ButtonAdv Label="New" IconTemplate="{StaticResource AddIconTemplate}" Command="{Binding NewRoleCommand}" Margin="0,0,8,0" />
                <syncfusion:ButtonAdv Label="Save" IconTemplate="{StaticResource SaveIconTemplate}" Command="{Binding SaveRoleCommand}" Margin="0,0,8,0" />
                <syncfusion:ButtonAdv Label="Delete" IconTemplate="{StaticResource DeleteIconTemplate}" Command="{Binding DeleteRoleCommand}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
