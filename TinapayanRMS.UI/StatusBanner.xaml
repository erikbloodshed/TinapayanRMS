<UserControl x:Class="TinapayanRMS.UI.StatusBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="40" d:DesignWidth="600">
    <!--
        Deliberately does not set its own DataContext: it inherits whatever the hosting
        view's DataContext is (that view's ViewModel), so it binds straight to the
        ErrorMessage/HasError/IsBusy members every ViewModelBase-derived ViewModel already
        has, without any wiring from the host. Replaces the six copy-pasted status blocks
        that each hardcoded the error color inline.
    -->
    <StackPanel>
        <Border Style="{StaticResource ErrorBannerStyle}"
                Margin="0,0,0,8"
                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource ErrorForegroundBrush}"
                       TextWrapping="Wrap" />
        </Border>

        <ProgressBar IsIndeterminate="True" Height="4"
                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </StackPanel>
</UserControl>
