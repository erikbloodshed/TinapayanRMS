<UserControl x:Class="TinapayanRMS.UI.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="1400">
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <StackPanel Orientation="Horizontal" Margin="12">

            <!-- Product list -->
            <syncfusion:SfDataGrid Width="260" Height="600" VerticalAlignment="Top"
                                    ItemsSource="{Binding Products}"
                                    SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                                    AutoGenerateColumns="False"
                                    AllowEditing="False"
                                    SelectionMode="Single"
                                    NavigationMode="Row">
                <syncfusion:SfDataGrid.Columns>
                    <syncfusion:GridTextColumn MappingName="Name" HeaderText="Name" />
                </syncfusion:SfDataGrid.Columns>
            </syncfusion:SfDataGrid>

            <!-- Product form -->
            <StackPanel Width="240" Margin="16,0,0,0">
                <TextBlock Text="Name" Margin="0,0,0,4" />
                <syncfusion:SfTextBoxExt Text="{Binding EditingName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,12" />

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <syncfusion:ButtonAdv Label="New" IconTemplate="{StaticResource AddIconTemplate}" Command="{Binding NewCommand}" Margin="0,0,8,0" />
                    <syncfusion:ButtonAdv Label="Save" IconTemplate="{StaticResource SaveIconTemplate}" Command="{Binding SaveCommand}" Margin="0,0,8,0" />
                    <syncfusion:ButtonAdv Label="Delete" IconTemplate="{StaticResource DeleteIconTemplate}" Command="{Binding DeleteCommand}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Width="380" Margin="16,0,0,0"
                        Visibility="{Binding ShowProductDetail, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="Sub-Assembly Usages" FontSize="14" Margin="0,0,0,8" />

                <syncfusion:SfDataGrid ItemsSource="{Binding UsageEdits}"
                                        SelectedItem="{Binding SelectedUsageEdit, Mode=TwoWay}"
                                        AutoGenerateColumns="False"
                                        AllowEditing="False"
                                        SelectionMode="Single"
                                        NavigationMode="Row"
                                        Height="220">
                    <syncfusion:SfDataGrid.Columns>
                        <syncfusion:GridTextColumn MappingName="SubAssembly.Name" HeaderText="Sub-Assembly" />
                        <syncfusion:GridTextColumn MappingName="SubAssembly.Role.Name" HeaderText="Role" />
                        <syncfusion:GridNumericColumn MappingName="WeightPerPiece" HeaderText="Wt/Piece (g)" />
                        <syncfusion:GridNumericColumn MappingName="Yield" HeaderText="Yield" />
                        <syncfusion:GridNumericColumn MappingName="CostPerPiece" HeaderText="Cost/Piece" />
                    </syncfusion:SfDataGrid.Columns>
                </syncfusion:SfDataGrid>

                <TextBlock Text="Sub-Assembly" Margin="0,12,0,4" />
                <syncfusion:ComboBoxAdv ItemsSource="{Binding SubAssemblies}"
                                         DisplayMemberPath="Name"
                                         SelectedItem="{Binding EditingUsageSubAssembly, Mode=TwoWay}"
                                         Margin="0,0,0,12" />

                <TextBlock Text="Weight Per Piece (g)" Margin="0,0,0,4" />
                <syncfusion:DoubleTextBox Value="{Binding EditingUsageWeightPerPiece, Mode=TwoWay}"
                                           Margin="0,0,0,12" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <syncfusion:ButtonAdv Label="Add" IconTemplate="{StaticResource AddIconTemplate}" Command="{Binding AddUsageCommand}" Margin="0,0,8,0" />
                    <syncfusion:ButtonAdv Label="Remove" IconTemplate="{StaticResource RemoveIconTemplate}" Command="{Binding RemoveUsageCommand}" />
                </StackPanel>

                <syncfusion:ButtonAdv Label="Save Usages" IconTemplate="{StaticResource SaveIconTemplate}" Command="{Binding SaveUsagesCommand}" />
            </StackPanel>

            <StackPanel Width="420" Margin="16,0,0,0"
                        Visibility="{Binding ShowProductDetail, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="Packaging Lines" FontSize="14" Margin="0,0,0,8" />

                <syncfusion:SfDataGrid ItemsSource="{Binding LineEdits}"
                                        SelectedItem="{Binding SelectedLineEdit, Mode=TwoWay}"
                                        AutoGenerateColumns="False"
                                        AllowEditing="False"
                                        SelectionMode="Single"
                                        NavigationMode="Row"
                                        Height="220">
                    <syncfusion:SfDataGrid.Columns>
                        <syncfusion:GridTextColumn MappingName="PackagingMaterial.Name" HeaderText="Material" />
                        <syncfusion:GridTextColumn MappingName="EntryUnit.Abbreviation" HeaderText="Unit" />
                        <syncfusion:GridNumericColumn MappingName="QtyPerPiece" HeaderText="Qty/Piece" />
                        <syncfusion:GridNumericColumn MappingName="PiecesPerPackagingUnit" HeaderText="Pieces/Unit" />
                        <syncfusion:GridNumericColumn MappingName="CostPerPiece" HeaderText="Cost/Piece" />
                    </syncfusion:SfDataGrid.Columns>
                </syncfusion:SfDataGrid>

                <TextBlock Text="Packaging Material" Margin="0,12,0,4" />
                <syncfusion:ComboBoxAdv ItemsSource="{Binding PackagingMaterials}"
                                         DisplayMemberPath="Name"
                                         SelectedItem="{Binding EditingLinePackagingMaterial, Mode=TwoWay}"
                                         Margin="0,0,0,12" />

                <TextBlock Text="Entry Unit" Margin="0,0,0,4" />
                <syncfusion:ComboBoxAdv ItemsSource="{Binding EntryUnitOptions}"
                                         DisplayMemberPath="Name"
                                         SelectedItem="{Binding EditingLineEntryUnit, Mode=TwoWay}"
                                         Margin="0,0,0,12" />

                <TextBlock Text="Authored Field" Margin="0,0,0,4" />
                <syncfusion:ComboBoxAdv ItemsSource="{Binding AuthoredFieldOptions}"
                                         SelectedItem="{Binding EditingLineAuthoredField, Mode=TwoWay}"
                                         Margin="0,0,0,12" />

                <TextBlock Text="Value (in the field above)" Margin="0,0,0,4" />
                <syncfusion:DoubleTextBox Value="{Binding EditingLineAuthoredValue, Mode=TwoWay}"
                                           Margin="0,0,0,12" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <syncfusion:ButtonAdv Label="Add" IconTemplate="{StaticResource AddIconTemplate}" Command="{Binding AddLineCommand}" Margin="0,0,8,0" />
                    <syncfusion:ButtonAdv Label="Remove" IconTemplate="{StaticResource RemoveIconTemplate}" Command="{Binding RemoveLineCommand}" />
                </StackPanel>

                <syncfusion:ButtonAdv Label="Save Lines" IconTemplate="{StaticResource SaveIconTemplate}" Command="{Binding SaveLinesCommand}" />
            </StackPanel>

            <StackPanel Width="280" Margin="16,0,0,0"
                        Visibility="{Binding ShowProductDetail, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="Costing Parameters" FontSize="14" Margin="0,0,0,8" />

                <TextBlock Text="Labor Cost (per piece)" Margin="0,0,0,4" />
                <syncfusion:DoubleTextBox Value="{Binding EditingLaborCost, Mode=TwoWay}"
                                           Margin="0,0,0,12" />

                <TextBlock Text="Overhead Cost (per piece)" Margin="0,0,0,4" />
                <syncfusion:DoubleTextBox Value="{Binding EditingOverheadCost, Mode=TwoWay}"
                                           Margin="0,0,0,12" />

                <TextBlock Text="Margin %" Margin="0,0,0,4" />
                <syncfusion:DoubleTextBox Value="{Binding EditingMarginPercent, Mode=TwoWay}"
                                           Margin="0,0,0,12" />

                <TextBlock Text="VAT %" Margin="0,0,0,4" />
                <syncfusion:DoubleTextBox Value="{Binding EditingVatPercent, Mode=TwoWay}"
                                           Margin="0,0,0,12" />

                <syncfusion:ButtonAdv Label="Save Costing" IconTemplate="{StaticResource SaveIconTemplate}" Command="{Binding SaveCostingCommand}" Margin="0,0,0,16" />

                <Border BorderBrush="#CCCCCC" BorderThickness="0,1,0,0" Margin="0,0,0,12" />

                <TextBlock Text="Summary (per piece)" FontSize="14" Margin="0,0,0,8" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Material Cost" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding MaterialCostPerPiece, StringFormat={}{0:N4}}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Base Cost" Margin="0,4,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BaseCost, StringFormat={}{0:N4}}" Margin="0,4,0,0" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Pre-VAT Price" Margin="0,4,0,0" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PreVatPrice, StringFormat={}{0:N4}}" Margin="0,4,0,0" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Selling Price" FontWeight="Bold" Margin="0,8,0,0" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SellingPrice, StringFormat={}{0:N2}}" FontWeight="Bold" Margin="0,8,0,0" />
                </Grid>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
