<UserControl x:Class="TinapayanRMS.UI.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="1400">
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <StackPanel Orientation="Horizontal" Margin="12">

            <!-- Price Trend -->
            <StackPanel Width="620">
                <TextBlock Text="Price Trend" FontSize="14" Margin="0,0,0,8" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <StackPanel Width="160" Margin="0,0,12,0">
                        <TextBlock Text="Material Kind" Margin="0,0,0,4" />
                        <syncfusion:ComboBoxAdv ItemsSource="{Binding MaterialKindOptions}"
                                                 SelectedItem="{Binding SelectedMaterialKind, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Width="300"
                                Visibility="{Binding IsIngredientKind, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Ingredient" Margin="0,0,0,4" />
                        <syncfusion:ComboBoxAdv ItemsSource="{Binding Ingredients}"
                                                 DisplayMemberPath="Name"
                                                 SelectedItem="{Binding SelectedIngredient, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Width="300"
                                Visibility="{Binding IsPackagingKind, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Packaging Material" Margin="0,0,0,4" />
                        <syncfusion:ComboBoxAdv ItemsSource="{Binding PackagingMaterials}"
                                                 DisplayMemberPath="Name"
                                                 SelectedItem="{Binding SelectedPackagingMaterial, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>

                <syncfusion:SfChart Header="Price Per Purchase Unit Over Time" Height="450">
                    <syncfusion:SfChart.PrimaryAxis>
                        <syncfusion:DateTimeAxis Header="Date" />
                    </syncfusion:SfChart.PrimaryAxis>
                    <syncfusion:SfChart.SecondaryAxis>
                        <syncfusion:NumericalAxis Header="Price" />
                    </syncfusion:SfChart.SecondaryAxis>
                    <syncfusion:SfChart.Series>
                        <syncfusion:LineSeries ItemsSource="{Binding PricePoints}"
                                                XBindingPath="Date"
                                                YBindingPath="Price"
                                                Label="Price"
                                                ShowTooltip="True" />
                    </syncfusion:SfChart.Series>
                </syncfusion:SfChart>
            </StackPanel>

            <!-- Margin Overview -->
            <StackPanel Width="620" Margin="16,0,0,0">
                <TextBlock Text="Margin Overview (as of today — not historized)" FontSize="14" Margin="0,0,0,8" />

                <syncfusion:SfChart Header="Cost vs. Selling Price, Per Piece" Height="500">
                    <syncfusion:SfChart.PrimaryAxis>
                        <syncfusion:CategoryAxis Header="Product" />
                    </syncfusion:SfChart.PrimaryAxis>
                    <syncfusion:SfChart.SecondaryAxis>
                        <syncfusion:NumericalAxis Header="Pesos" />
                    </syncfusion:SfChart.SecondaryAxis>
                    <syncfusion:SfChart.Series>
                        <syncfusion:ColumnSeries ItemsSource="{Binding MarginRows}"
                                                  XBindingPath="ProductName"
                                                  YBindingPath="BaseCost"
                                                  Label="Base Cost"
                                                  ShowTooltip="True" />
                        <syncfusion:ColumnSeries ItemsSource="{Binding MarginRows}"
                                                  XBindingPath="ProductName"
                                                  YBindingPath="SellingPrice"
                                                  Label="Selling Price"
                                                  ShowTooltip="True" />
                    </syncfusion:SfChart.Series>
                    <syncfusion:SfChart.Legend>
                        <syncfusion:ChartLegend />
                    </syncfusion:SfChart.Legend>
                </syncfusion:SfChart>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
