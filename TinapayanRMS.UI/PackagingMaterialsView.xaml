<UserControl x:Class="TinapayanRMS.UI.PackagingMaterialsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="1200">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" Margin="0,0,0,8">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#C00000"
                       TextWrapping="Wrap"
                       Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <ProgressBar IsIndeterminate="True" Height="4"
                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>

        <syncfusion:SfDataGrid Grid.Row="1" Grid.Column="0"
                                ItemsSource="{Binding PackagingMaterials}"
                                SelectedItem="{Binding SelectedPackagingMaterial, Mode=TwoWay}"
                                AutoGenerateColumns="False"
                                AllowEditing="False"
                                SelectionMode="Single"
                                NavigationMode="Row">
            <syncfusion:SfDataGrid.Columns>
                <syncfusion:GridTextColumn MappingName="Name" HeaderText="Name" />
                <syncfusion:GridTextColumn MappingName="PackagingCategory.Name" HeaderText="Category" />
                <syncfusion:GridTextColumn MappingName="StandardUnit.Abbreviation" HeaderText="Standard Unit" />
                <syncfusion:GridTextColumn MappingName="PurchaseUnit.Abbreviation" HeaderText="Purchase Unit" />
                <syncfusion:GridNumericColumn MappingName="PurchaseUnitQty" HeaderText="Purchase Qty" />
                <syncfusion:GridNumericColumn MappingName="CurrentCost" HeaderText="Current Cost" />
            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>

        <StackPanel Grid.Row="1" Grid.Column="2">
            <TextBlock Text="Name" Margin="0,0,0,4" />
            <syncfusion:SfTextBoxExt Text="{Binding EditingName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,0,0,12" />

            <TextBlock Text="Category" Margin="0,0,0,4" />
            <syncfusion:ComboBoxAdv ItemsSource="{Binding Categories}"
                                     DisplayMemberPath="Name"
                                     SelectedItem="{Binding EditingCategory, Mode=TwoWay}"
                                     Margin="0,0,0,12" />

            <TextBlock Text="Standard Unit" Margin="0,0,0,4" />
            <syncfusion:ComboBoxAdv ItemsSource="{Binding StandardUnits}"
                                     DisplayMemberPath="Name"
                                     SelectedItem="{Binding EditingStandardUnit, Mode=TwoWay}"
                                     Margin="0,0,0,12" />

            <TextBlock Text="Purchase Unit" Margin="0,0,0,4" />
            <syncfusion:ComboBoxAdv ItemsSource="{Binding PurchaseUnits}"
                                     DisplayMemberPath="Name"
                                     SelectedItem="{Binding EditingPurchaseUnit, Mode=TwoWay}"
                                     Margin="0,0,0,12" />

            <TextBlock Text="Purchase Unit Qty" Margin="0,0,0,4" />
            <syncfusion:DoubleTextBox Value="{Binding EditingPurchaseUnitQty, Mode=TwoWay}"
                                       Margin="0,0,0,12" />

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <syncfusion:ButtonAdv Label="New" IconTemplate="{StaticResource AddIconTemplate}" Command="{Binding NewCommand}" Margin="0,0,8,0" />
                <syncfusion:ButtonAdv Label="Save" IconTemplate="{StaticResource SaveIconTemplate}" Command="{Binding SaveCommand}" Margin="0,0,8,0" />
                <syncfusion:ButtonAdv Label="Delete" IconTemplate="{StaticResource DeleteIconTemplate}" Command="{Binding DeleteCommand}" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="4"
                    Visibility="{Binding ShowPriceHistory, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="Price History" FontSize="14" Margin="0,0,0,8" />

            <syncfusion:SfDataGrid ItemsSource="{Binding PriceHistory}"
                                    SelectedItem="{Binding SelectedPriceHistoryEntry, Mode=TwoWay}"
                                    AutoGenerateColumns="False"
                                    AllowEditing="False"
                                    SelectionMode="Single"
                                    NavigationMode="Row"
                                    Height="200">
                <syncfusion:SfDataGrid.Columns>
                    <syncfusion:GridDateTimeColumn MappingName="Date" HeaderText="Date" />
                    <syncfusion:GridNumericColumn MappingName="Price" HeaderText="Price" />
                </syncfusion:SfDataGrid.Columns>
            </syncfusion:SfDataGrid>

            <TextBlock Text="Date" Margin="0,12,0,4" />
            <syncfusion:DateTimeEdit DateTime="{Binding EditingPriceDate, Mode=TwoWay}"
                                      Pattern="ShortDate"
                                      Margin="0,0,0,12" />

            <TextBlock Text="Price (per purchase unit)" Margin="0,0,0,4" />
            <syncfusion:DoubleTextBox Value="{Binding EditingPrice, Mode=TwoWay}"
                                       Margin="0,0,0,12" />

            <StackPanel Orientation="Horizontal">
                <syncfusion:ButtonAdv Label="Add Price" IconTemplate="{StaticResource AddIconTemplate}" Command="{Binding AddPriceCommand}" Margin="0,0,8,0" />
                <syncfusion:ButtonAdv Label="Delete Price" IconTemplate="{StaticResource DeleteIconTemplate}" Command="{Binding DeletePriceCommand}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
