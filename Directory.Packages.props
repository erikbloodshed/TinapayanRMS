<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Lets a PackageVersion below override a vulnerable transitive dependency. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <!-- Npgsql.EntityFrameworkCore.PostgreSQL asks for exactly this EF Core: move both together. -->
    <EFCoreVersion>11.0.0-rc.3.26522.148</EFCoreVersion>
    <!-- Microsoft.Extensions.* ships with the .NET runtime: keep it on the same release. -->
    <MicrosoftExtensionsVersion>11.0.0-rc.3.26522.148</MicrosoftExtensionsVersion>
    <!-- MAUI's packages are the installed workload's (`dotnet workload list`, maui-windows): move them with it. -->
    <MauiPackagesVersion>11.0.0-rc.2.26505.5</MauiPackagesVersion>
    <!-- Every Syncfusion package must be on the same version: upgrade them together. -->
    <SyncfusionVersion>35.1.43</SyncfusionVersion>
  </PropertyGroup>
  <ItemGroup Label="Application">
    <PackageVersion Include="Dapper" Version="2.1.89" />
    <PackageVersion Include="DynamicData" Version="9.5.0" />
    <!-- No .NET 11 release yet. 10.0.1 asks for EF Core [10.0.1, 11.0.0), but works on EF Core 11: the snake_case names,
         the model-changes check and the compiled model all hold. Move to its 11.x when there is one. -->
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <!-- Blazor, for the MAUI app's screens (TinapayanRMS.Components): it ships with the .NET runtime, so it's on its release. -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiPackagesVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(EFCoreVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Maui.Controls" Version="$(MauiPackagesVersion)" />
    <!-- The official MCP C# SDK, for TinapayanRMS.Mcp. -->
    <PackageVersion Include="ModelContextProtocol" Version="2.3.1" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0-rc.3" />
    <!-- ReactiveUI and its two hosts, the WPF app's and the Blazor screens': move them together. -->
    <PackageVersion Include="ReactiveUI" Version="26.0.1" />
    <PackageVersion Include="ReactiveUI.Blazor" Version="26.0.1" />
    <PackageVersion Include="ReactiveUI.WPF" Version="26.0.1" />
    <PackageVersion Include="Serilog" Version="4.3.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="System.Reactive" Version="7.0.0" />
  </ItemGroup>
  <ItemGroup Label="Transitive pins">
    <!-- EFCore.NamingConventions asks for EF Core 10: keep every project on EFCoreVersion, the one Npgsql's provider takes. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="$(EFCoreVersion)" />
    <!-- MAUI's BlazorWebView asks for an earlier release candidate's: keep Blazor itself on the runtime's. -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebView" Version="$(MicrosoftExtensionsVersion)" />
  </ItemGroup>
  <ItemGroup Label="Syncfusion">
    <!-- The MAUI app's screens (Syncfusion Blazor). -->
    <PackageVersion Include="Syncfusion.Blazor.Buttons" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.Blazor.Charts" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.Blazor.DropDowns" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.Blazor.Grid" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.Blazor.Inputs" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.Blazor.Navigations" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.Blazor.Notifications" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.Blazor.Popups" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.Blazor.SplitButtons" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.Blazor.Themes" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.XlsIO.Net.Core" Version="$(SyncfusionVersion)" />
    <!-- The WPF app's controls. -->
    <PackageVersion Include="Syncfusion.DataGridExcelExport.WPF" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.Licensing" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.SfChart.WPF" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.SfGrid.WPF" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.SfInput.WPF" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.SfNavigationDrawer.WPF" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.SfSkinManager.WPF" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.SfTextInputLayout.WPF" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.SfTreeView.WPF" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.Themes.Windows11Light.WPF" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.Tools.WPF" Version="$(SyncfusionVersion)" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <!-- Renders the MAUI app's Blazor components in a test, without a web view (TinapayanRMS.Components.Tests). -->
    <PackageVersion Include="bunit" Version="2.14.0" />
    <!-- ASP.NET Core ships with the .NET runtime too: the Recipe API's tests run it in memory on the same release. -->
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <!-- At the Microsoft.Testing.Platform version TUnit brings (2.5.2 with TUnit 1.81.10): move them together. It does
         nothing unless TESTINGPLATFORM_HOTRELOAD_ENABLED is 1, which only scripts/Watch-Tests.ps1 sets. -->
    <PackageVersion Include="Microsoft.Testing.Extensions.HotReload" Version="2.5.2" />
    <PackageVersion Include="Respawn" Version="7.0.0" />
    <!-- TUnit.Engine runs the tests, TUnit.Core has their attributes (all the shared fixtures library needs): the TUnit
         package would add its own assertions beside AwesomeAssertions. Move both together. -->
    <PackageVersion Include="TUnit.Core" Version="1.81.10" />
    <PackageVersion Include="TUnit.Engine" Version="1.81.10" />
  </ItemGroup>
</Project>