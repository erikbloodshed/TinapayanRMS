<!-- TinapayanRMS for every Windows user on the PC: the published app in Program Files\TinapayanRMS, with Start menu and
     Desktop shortcuts for everyone. Each user's own data stays theirs, in %LocalAppData%\TinapayanRMS\Maui (the view
     state, the log and the web view's folder), and the MSI never touches it, nor the database: the app brings the
     database up to its version the first time it opens after an install, after a backup (IDatabaseUpdater).
     On the PC that holds the database, its Recipe API feature, ticked on its features page, also installs the Recipe API as a Windows service
     (ADR 0021), so an update brings the app and the API to the same version in one step. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:fire="http://wixtoolset.org/schemas/v4/wxs/firewall"
     xmlns:netfx="http://wixtoolset.org/schemas/v4/wxs/netfx"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!-- The UpgradeCode is the app's for good: a new MSI with it replaces the copy installed. -->
  <Package Name="TinapayanRMS"
           Manufacturer="Tinapayan Festival Bakeshoppe"
           Version="$(var.ProductVersion)"
           UpgradeCode="4E4A8926-1F88-40FF-A780-B8EC774B5CE3"
           Scope="perMachine"
           Language="1033">

    <!-- The same version replaces too, so an MSI rebuilt from one commit still installs over its last build. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of TinapayanRMS is already installed. Uninstall it first to go back to this one." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="$(var.AppIconFile)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPCOMMENTS" Value="Recipes and costing for Tinapayan Festival Bakeshoppe." />
    <!-- Its screens: WiX's feature-tree set, with the Recipe API unticked unless this PC has it, but for its licence page,
         which has no licence of the shop's to show: Welcome goes straight to the features, and their Back to Welcome
         (a NewDialog of a higher Order wins). An update shows them again, the features as they were installed
         (MigrateFeatureStates), and Settings > Apps > Modify opens them to add or take away the Recipe API. -->
    <ui:WixUI Id="WixUI_FeatureTree" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="CustomizeDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="CustomizeDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="3" Condition="NOT Installed" />
    </UI>

    <!-- The app is framework-dependent: it runs on the PC's .NET 11 (Microsoft.NETCore.App 11.x, x64), which the MSI
         can't install. Not there, and the install stops before changing anything, saying where to get it. -->
    <netfx:DotNetCompatibilityCheck Property="DOTNET_RUNTIME_CHECK" RuntimeType="core" Platform="x64" Version="11.0.0" RollForward="minor" />
    <Launch Condition="Installed OR DOTNET_RUNTIME_CHECK=&quot;0&quot;"
            Message="TinapayanRMS needs the .NET 11 Runtime (x64). Install it from https://dotnet.microsoft.com/download/dotnet/11.0, then run this installer again." />

    <!-- The Recipe API runs on ASP.NET Core's runtime as well, which only the PC that installs it needs: its feature's
         state is known only once costing is done, so this is an error action then, not a launch condition. -->
    <netfx:DotNetCompatibilityCheck Property="ASPNETCORE_RUNTIME_CHECK" RuntimeType="aspnet" Platform="x64" Version="11.0.0" RollForward="minor" />
    <CustomAction Id="RecipeApiNeedsAspNetCore"
                  Error="The Recipe API needs the ASP.NET Core Runtime 11 (x64). Install it from https://dotnet.microsoft.com/download/dotnet/11.0, then run this installer again." />
    <InstallExecuteSequence>
      <Custom Action="RecipeApiNeedsAspNetCore" After="CostFinalize"
              Condition="(&amp;RecipeApi = 3) AND ASPNETCORE_RUNTIME_CHECK &lt;&gt; &quot;0&quot;" />
    </InstallExecuteSequence>

    <!-- A copy that's open holds its files: Windows Installer's Restart Manager asks it to close (InstallValidate),
         finding it by the files it holds, so only the copy in INSTALLFOLDER. The app answers as its Close would: with a
         form's unsaved changes it stays open and asks about them (WindowsWindow), and the files it holds are replaced at
         a restart if it's still open when they're copied. WiX's util:CloseApplication, tried on 2026-11-15, came after it
         and could only reach copies run from elsewhere, as it finds the app by its .exe's name alone. -->

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="TinapayanRMS">
        <Directory Id="RECIPEAPIFOLDER" Name="RecipeApi" />
      </Directory>
    </StandardDirectory>

    <!-- The Recipe API's service: its .exe (left out of the harvest, RecipeApiFiles.xslt) is this component's key path,
         which is the file a service runs. It runs as its own virtual account, NT SERVICE\TinapayanRMSRecipeApi, which
         scripts\Setup-RecipeApi.ps1 gives its data folder, %ProgramData%\TinapayanRMS\RecipeApi, to read: its key, the
         role it reads as and that role's password. It starts at boot, with nobody signed in, and again a minute after
         it stops on a failure (Util's ServiceConfig: WiX warns that Windows Installer's own doesn't work as expected). An update stops it before its files are replaced (Stop="both"), so Restart Manager has
         nothing of it to ask about, and starts the new one. It's started without waiting for it: one that stops at once,
         as before its setup when the per-user copy it replaces still holds the port, doesn't fail the install. The
         firewall rule lets the local subnet reach its port, on private networks only. -->
    <DirectoryRef Id="RECIPEAPIFOLDER">
      <Component Id="RecipeApiService">
        <File Id="RecipeApiExe" Source="$(var.RecipeApiPublishDir)TinapayanRMS.RecipeApi.exe" KeyPath="yes">
          <fire:FirewallException Id="RecipeApiFirewall" Name="TinapayanRMS Recipe API" Port="5290" Protocol="tcp"
                                  Scope="localSubnet" Profile="private"
                                  Description="Lets TinapayanBMS on the shop's other PCs read the recipes from the TinapayanRMS Recipe API." />
        </File>
        <ServiceInstall Id="RecipeApiService" Name="TinapayanRMSRecipeApi" DisplayName="TinapayanRMS Recipe API"
                        Description="Serves TinapayanRMS's recipes, ingredients, prices and costs, read-only, to TinapayanBMS on port 5290."
                        Type="ownProcess" Start="auto" ErrorControl="normal" Account="NT SERVICE\TinapayanRMSRecipeApi" Vital="yes">
          <util:ServiceConfig FirstFailureActionType="restart" SecondFailureActionType="restart" ThirdFailureActionType="restart"
                              RestartServiceDelayInSeconds="60" ResetPeriodInDays="1" />
        </ServiceInstall>
        <ServiceControl Id="StopRecipeApi" Name="TinapayanRMSRecipeApi" Stop="both" Remove="uninstall" Wait="yes" />
        <ServiceControl Id="StartRecipeApi" Name="TinapayanRMSRecipeApi" Start="install" Wait="no" />
      </Component>
    </DirectoryRef>

    <!-- Each shortcut is kept by a value of its own under HKLM, as a per-machine shortcut has no file to be kept by. It
         takes its icon from the .exe. -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="StartMenuShortcut" Name="TinapayanRMS" Description="Recipes and costing for Tinapayan Festival Bakeshoppe."
                  Target="[INSTALLFOLDER]TinapayanRMS.Maui.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKLM" Key="Software\TinapayanRMS" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut">
        <Shortcut Id="DesktopShortcut" Name="TinapayanRMS" Description="Recipes and costing for Tinapayan Festival Bakeshoppe."
                  Target="[INSTALLFOLDER]TinapayanRMS.Maui.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKLM" Key="Software\TinapayanRMS" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="TinapayanRMS" AllowAbsent="no" Display="expand"
             Description="The app, for every Windows user of this PC, with its Start menu and Desktop shortcuts.">
      <!-- The published app, harvested by the project (HarvestDirectory). -->
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <!-- Only on the PC that holds the database, so off unless asked for (Level 2, over the default INSTALLLEVEL of 1): ticked
         on the features page, or msiexec /i <msi> ADDLOCAL=ALL. An update keeps it as it was, as MajorUpgrade migrates the features' states
         (ADDLOCAL naming only this feature would skip that, and leave the app out). -->
    <Feature Id="RecipeApi" Title="Recipe API" Level="2"
             Description="Only on the PC that holds the database: serves the recipes to TinapayanBMS, as a Windows service. Needs the ASP.NET Core Runtime 11 (x64).">
      <ComponentGroupRef Id="RecipeApiFiles" />
      <ComponentRef Id="RecipeApiService" />
    </Feature>

  </Package>
</Wix>
