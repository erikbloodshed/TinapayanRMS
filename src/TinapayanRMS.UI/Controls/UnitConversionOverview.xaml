<UserControl x:Class="TinapayanRMS.UI.Controls.UnitConversionOverview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:local="clr-namespace:TinapayanRMS.UI.Controls"
             x:Name="Root"
             d:DesignHeight="260" d:DesignWidth="360">
    <UserControl.Resources>
        <!-- The diagram: a box per unit, with what it comes to underneath, pointing down into the base unit -->
        <DataTemplate x:Key="PointingDownTemplate">
            <StackPanel Margin="6,0" MinWidth="96">
                <Border Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8">
                    <StackPanel>
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource HeadingForegroundBrush}">
                            <Run Text="1" />
                            <Run Text="{Binding UnitName, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock HorizontalAlignment="Center"
                                   Foreground="{StaticResource MutedForegroundBrush}"
                                   Text="{Binding BaseEquivalentText, StringFormat=({0})}" />
                    </StackPanel>
                </Border>
                <TextBlock HorizontalAlignment="Center"
                           Margin="0,6,0,0"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource HeadingForegroundBrush}"
                           Text="{Binding BaseEquivalentText}" />
                <TextBlock HorizontalAlignment="Center"
                           Style="{StaticResource IconGlyphStyle}"
                           FontSize="18"
                           Foreground="{StaticResource AccentBrush}"
                           Text="&#xE74B;" />
            </StackPanel>
        </DataTemplate>

        <!--
            ShowAsRows: a row per unit, its box pointing right at what it comes to. The boxes share one
            width (SharedSizeGroup), so the arrows line up; a long name wraps inside its box.
        -->
        <DataTemplate x:Key="RowTemplate">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="UnitBox" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8">
                    <TextBlock HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="170"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource HeadingForegroundBrush}">
                        <Run Text="1" />
                        <Run Text="{Binding UnitName, Mode=OneWay}" />
                    </TextBlock>
                </Border>
                <TextBlock Grid.Column="1"
                           Margin="10,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource IconGlyphStyle}"
                           FontSize="16"
                           Foreground="{StaticResource AccentBrush}"
                           Text="&#xE72A;" />
                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource HeadingForegroundBrush}"
                           Text="{Binding BaseEquivalentText}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <!-- Empty state: nothing to convert yet -->
        <TextBlock Style="{StaticResource EmptyStateStyle}"
                   Margin="0,24"
                   Visibility="{Binding HasItems, ElementName=Root, Converter={StaticResource EmptyStateVisibilityConverter}}">
            <Run Text="No alternative units yet. Add one to see how it converts to" />
            <Run Text="{Binding BaseUnitName, ElementName=Root, Mode=OneWay}" /><Run Text="." />
        </TextBlock>

        <StackPanel Visibility="{Binding HasItems, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}">
            <!--
                One box per alternative unit, each pointing down into the base unit; or, with ShowAsRows,
                a row per unit pointing right at what it comes to (the base unit box then isn't drawn).
            -->
            <ItemsControl ItemsSource="{Binding ItemsSource, ElementName=Root}" HorizontalAlignment="Center" Grid.IsSharedSizeScope="True">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="ItemTemplate" Value="{StaticResource PointingDownTemplate}" />
                        <Setter Property="ItemsPanel">
                            <Setter.Value>
                                <ItemsPanelTemplate>
                                    <WrapPanel HorizontalAlignment="Center" />
                                </ItemsPanelTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowAsRows, RelativeSource={RelativeSource AncestorType=local:UnitConversionOverview}}" Value="True">
                                <Setter Property="ItemTemplate" Value="{StaticResource RowTemplate}" />
                                <Setter Property="ItemsPanel">
                                    <Setter.Value>
                                        <ItemsPanelTemplate>
                                            <StackPanel />
                                        </ItemsPanelTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
            </ItemsControl>

            <!-- The base unit everything converts to -->
            <Border HorizontalAlignment="Center"
                    Visibility="{Binding ShowAsRows, ElementName=Root, Converter={StaticResource EmptyStateVisibilityConverter}}"
                    Margin="0,4,0,0"
                    MinWidth="120"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="2"
                    CornerRadius="6"
                    Padding="16,8">
                <StackPanel>
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource HeadingForegroundBrush}"
                               Text="{Binding BaseUnitName, ElementName=Root}" />
                    <TextBlock HorizontalAlignment="Center"
                               Foreground="{StaticResource MutedForegroundBrush}"
                               Text="(base unit)" />
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
