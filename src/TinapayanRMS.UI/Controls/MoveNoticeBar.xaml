<UserControl x:Class="TinapayanRMS.UI.Controls.MoveNoticeBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             Visibility="{Binding MoveNotice, Converter={StaticResource NotNullToVisibilityConverter}}"
             AutomationProperties.AutomationId="MoveNotice">
    <!--
        What the last move in a main screen's list did, with Undo (IListTreeScreen.MoveNotice), under the list's tree: a
        drag, Move To or Promote saves at once, so this is where one made by mistake is taken back. It hides itself a few
        seconds on, unless the mouse is over it (the code-behind). Its DataContext is the screen's. The list card makes it
        as wide as the tree, so a long message wraps rather than widening the card.
    -->
    <Border Padding="10,4,4,4"
            CornerRadius="6"
            Background="{StaticResource InfoBackgroundBrush}">
        <DockPanel>
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource ToastCloseButtonStyle}"
                    Command="{Binding DismissMoveNoticeCommand}"
                    VerticalAlignment="Center"
                    ToolTip="Close"
                    AutomationProperties.Name="Close">
                <TextBlock Text="&#xE711;" Style="{StaticResource IconGlyphStyle}" FontSize="12" />
            </Button>
            <syncfusion:ButtonAdv DockPanel.Dock="Right"
                                  Label="Undo"
                                  IconTemplate="{StaticResource UndoIconTemplate}"
                                  Command="{Binding UndoMoveCommand}"
                                  VerticalAlignment="Center"
                                  Margin="8,0,4,0" />
            <TextBlock Text="{Binding MoveNotice}"
                       Foreground="{StaticResource InfoForegroundBrush}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
        </DockPanel>
    </Border>
</UserControl>
