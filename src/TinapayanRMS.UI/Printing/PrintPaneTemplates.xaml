<!--
    The print pane's dropdown items (PrintPaneFit), in place of the theme's. The theme's are drawn for its 12 px text in
    43 px rows, so at the app's 14 px a second line runs into the dropdown's edge. These grow with their text and trim a
    line too long for the pane. The items are Syncfusion's (Syncfusion.Windows.Shared.Printing): each has an icon, drawn
    in the text's colour as the theme draws it, and a name.
-->
<ResourceDictionary x:Class="TinapayanRMS.UI.Printing.PrintPaneTemplates"
                    x:ClassModifier="internal"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:printing="clr-namespace:Syncfusion.Windows.Shared.Printing;assembly=Syncfusion.Shared.WPF"
                    xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF">

    <printing:PageSizeTextConverter x:Key="PageSizeTextConverter" />
    <printing:PrintQueueNameToVisibilityConverter x:Key="PrintQueueNameToVisibilityConverter" />
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <!-- Every item at least this tall, so the one-line dropdowns stand as tall as the two-line ones -->
    <Style x:Key="ItemGridStyle" TargetType="Grid">
        <Setter Property="MinHeight" Value="44" />
    </Style>

    <Style x:Key="ItemIconStyle" TargetType="Path">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Margin" Value="4,0,12,0" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{Binding Path=(Control.Foreground), RelativeSource={RelativeSource Mode=Self}}" />
    </Style>

    <Style x:Key="ItemTextStyle" TargetType="TextBlock">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- The second line: what the choice means -->
    <Style x:Key="ItemDetailStyle" TargetType="TextBlock" BasedOn="{StaticResource ItemTextStyle}">
        <Setter Property="Opacity" Value="0.8" />
        <Setter Property="Margin" Value="0,1,0,0" />
    </Style>

    <Style x:Key="ItemTextPanelStyle" TargetType="StackPanel">
        <Setter Property="Grid.Column" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,4" />
    </Style>

    <!-- PrintQueueOption: the printer's name, with the Windows default marked on its icon -->
    <DataTemplate x:Key="PrinterItemTemplate">
        <Grid Style="{StaticResource ItemGridStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Margin="4,0,12,0" Width="24" Height="24" VerticalAlignment="Center">
                <Path Visibility="{Binding PrintQueue.Name, ConverterParameter=Printer, Converter={StaticResource PrintQueueNameToVisibilityConverter}}"
                      Stretch="Fill"
                      Stroke="{Binding Path=(Control.Foreground), RelativeSource={RelativeSource Mode=Self}}"
                      Data="M5.25,16.25 L2.25,16.25 C1.42157,16.25 0.75,15.5784 0.75,14.75 L0.75,9.5 C0.75,7.42893 2.42893,5.75 4.5,5.75 L5.25,5.75 M18.75,16.25 L21.75,16.25 C22.5784,16.25 23.25,15.5784 23.25,14.75 L23.25,9.5 C23.25,7.42893 21.5711,5.75 19.5,5.75 L18.75,5.75 M18.75,16.25 L18.75,14 C18.75,12.7574 17.7426,11.75 16.5,11.75 L7.5,11.75 C6.25736,11.75 5.25,12.7574 5.25,14 L5.25,18.5 C5.25,19.7426 6.25736,20.75 7.5,20.75 L16.5,20.75 C17.7426,20.75 18.75,19.7426 18.75,18.5 L18.75,16.25 M18.75,5.75 L18.75,3.5 C18.75,2.25736 17.7426,1.25 16.5,1.25 L7.5,1.25 C6.25736,1.25 5.25,2.25736 5.25,3.5 L5.25,5.75 M18.75,5.75 L5.25,5.75" />
                <Path Visibility="{Binding PrintQueue.Name, ConverterParameter=Fax, Converter={StaticResource PrintQueueNameToVisibilityConverter}}"
                      Stretch="Fill"
                      Stroke="{Binding Path=(Control.Foreground), RelativeSource={RelativeSource Mode=Self}}"
                      Data="M18.75,5.5 L19.5,5.5 C21.5711,5.5 23.25,7.17893 23.25,9.25 L23.25,14.5 C23.25,15.3284 22.5784,16 21.75,16 L5.25,16 L2.25,16 C1.42157,16 0.75,15.3284 0.75,14.5 L0.75,9.25 C0.75,7.17893 2.42893,5.5 4.5,5.5 L5.25,5.5 M18.75,5.5 L18.75,3.25 C18.75,2.00736 17.7426,1 16.5,1 L7.5,1 C6.25736,1 5.25,2.00736 5.25,3.25 L5.25,5.5 M18.75,5.5 L5.25,5.5" />
                <!-- Windows' default printer: a tick on the accent's deep shade, since white on the accent itself is hard to read -->
                <Grid Width="13" Height="13" Margin="0,0,-3,-3" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Visibility="{Binding IsDefault, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Ellipse Fill="{DynamicResource AccentForegroundBrush}" />
                    <Path Data="M 3.5,6.8 L 5.6,8.8 L 9.6,4.4" Stroke="White" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Grid>
            </Grid>
            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding PrintQueue.Name}" Style="{StaticResource ItemTextStyle}" />
        </Grid>
    </DataTemplate>

    <!-- PrintPageRangeSelection: all pages, or the pages typed under it; the second line in Syncfusion's own words -->
    <DataTemplate x:Key="PageRangeItemTemplate">
        <Grid Style="{StaticResource ItemGridStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Path Data="{Binding ImagePath}" Style="{StaticResource ItemIconStyle}" />
            <StackPanel Style="{StaticResource ItemTextPanelStyle}">
                <TextBlock Text="{Binding PageRangeSelectionName}" Style="{StaticResource ItemTextStyle}" />
                <TextBlock>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource ItemDetailStyle}">
                            <Setter Property="Text">
                                <Setter.Value>
                                    <shared:SharedLocalizationResourceExtension ResourceName="PrintPreview_AllPages_ToolTip" />
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PageRangeSelectionName}">
                                    <DataTrigger.Value>
                                        <shared:SharedLocalizationResourceExtension ResourceName="PrintPreview_UserPages" />
                                    </DataTrigger.Value>
                                    <Setter Property="Text">
                                        <Setter.Value>
                                            <shared:SharedLocalizationResourceExtension ResourceName="PrintPreview_UserPages_ToolTip" />
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- PrintPageCollation: collated or not, with the order the copies' pages come out in -->
    <DataTemplate x:Key="CollationItemTemplate">
        <Grid Style="{StaticResource ItemGridStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Path Data="{Binding ImagePath}" Style="{StaticResource ItemIconStyle}" />
            <StackPanel Style="{StaticResource ItemTextPanelStyle}">
                <TextBlock Text="{Binding CollationName}" Style="{StaticResource ItemTextStyle}" />
                <TextBlock>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource ItemDetailStyle}">
                            <Setter Property="Text" Value="1,2,3   1,2,3   1,2,3" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CollationName}" Value="Uncollated">
                                    <Setter Property="Text" Value="1,1,1   2,2,2   3,3,3" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- PrintPageOrientation: portrait or landscape -->
    <DataTemplate x:Key="OrientationItemTemplate">
        <Grid Style="{StaticResource ItemGridStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Path Data="{Binding ImagePath}" Style="{StaticResource ItemIconStyle}" />
            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding OrientationName}" Style="{StaticResource ItemTextStyle}" />
        </Grid>
    </DataTemplate>

    <!-- PrintPageSize: the paper's name and size, in the unit the pane was given -->
    <DataTemplate x:Key="PaperItemTemplate">
        <Grid Style="{StaticResource ItemGridStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Path Data="{Binding ImagePath.Data}" Style="{StaticResource ItemIconStyle}" />
            <StackPanel Style="{StaticResource ItemTextPanelStyle}">
                <TextBlock Text="{Binding PageSizeName}" Style="{StaticResource ItemTextStyle}" />
                <TextBlock Style="{StaticResource ItemDetailStyle}">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource PageSizeTextConverter}">
                            <Binding Path="Size" />
                            <Binding Path="PageSizeUnit" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!--
        PrintPageMargin: the margins' name and their sides in cm. The closed dropdown shows left and right only, as the
        theme's does; the list shows top and bottom too.
    -->
    <DataTemplate x:Key="MarginItemTemplate">
        <Grid Style="{StaticResource ItemGridStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Path Data="{Binding ImagePath}" Style="{StaticResource ItemIconStyle}" />
            <StackPanel Style="{StaticResource ItemTextPanelStyle}">
                <TextBlock Text="{Binding MarginName}" Style="{StaticResource ItemTextStyle}" />
                <TextBlock Style="{StaticResource ItemDetailStyle}">
                    <Run Text="{Binding Thickness.Left, Mode=OneWay, StringFormat='Left: {0} cm'}" /><Run Text="   " /><Run Text="{Binding Thickness.Right, Mode=OneWay, StringFormat='Right: {0} cm'}" />
                </TextBlock>
                <TextBlock x:Name="TopAndBottom" Style="{StaticResource ItemDetailStyle}">
                    <Run Text="{Binding Thickness.Top, Mode=OneWay, StringFormat='Top: {0} cm'}" /><Run Text="   " /><Run Text="{Binding Thickness.Bottom, Mode=OneWay, StringFormat='Bottom: {0} cm'}" />
                </TextBlock>
            </StackPanel>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ComboBoxItem}}" Value="{x:Null}">
                <Setter TargetName="TopAndBottom" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
