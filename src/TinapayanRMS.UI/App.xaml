<Application x:Class="TinapayanRMS.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TinapayanRMS.UI.Controls"
             xmlns:converters="clr-namespace:TinapayanRMS.UI.Converters"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:sys="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
             xmlns:system="clr-namespace:System;assembly=System.Runtime">
    <Application.Resources>
        <ResourceDictionary>
            <!-- The colour scales the design tokens below are named from -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Palette.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <sys:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:AddNewRowPositionConverter x:Key="AddNewRowPositionConverter" />
            <converters:BooleanToStarWidthConverter x:Key="BooleanToStarWidthConverter" />
            <converters:EmptyStateVisibilityConverter x:Key="EmptyStateVisibilityConverter" />
            <converters:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter" />
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <!-- Every two-way number box bound to a decimal: its double goes in as the decimal it shows (DecimalValueConverter) -->
            <converters:DecimalValueConverter x:Key="DecimalValueConverter" />

            <!--
                The Unit cell of every packaging grid (a product's Packaging tab, the Add Sub-Assembly form, and a
                packaging set's Lines) offers the units of that row's own material, so its list comes from the row.
                One instance serves all three: it holds nothing.
            -->
            <controls:PackagingUnitSelector x:Key="PackagingUnitSelector" />

            <!--
                ButtonAdv.IconTemplate glyphs, Segoe Fluent Icons (Windows 11) falling back to
                Segoe MDL2 Assets (Windows 10+) — no extra icon package, and it matches the
                Windows11Light theme natively. One template per verb, reused across every
                CRUD screen's buttons instead of repeating the glyph markup on each one.
            -->
            <FontFamily x:Key="IconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

            <Style x:Key="IconGlyphStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource IconFontFamily}" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <DataTemplate x:Key="AddIconTemplate">
                <TextBlock Text="&#xE710;" Style="{StaticResource IconGlyphStyle}" />
            </DataTemplate>

            <DataTemplate x:Key="SaveIconTemplate">
                <TextBlock Text="&#xE74E;" Style="{StaticResource IconGlyphStyle}" />
            </DataTemplate>

            <DataTemplate x:Key="UndoIconTemplate">
                <TextBlock Text="&#xE10E;" Style="{StaticResource IconGlyphStyle}" />
            </DataTemplate>

            <DataTemplate x:Key="RedoIconTemplate">
                <TextBlock Text="&#xE10D;" Style="{StaticResource IconGlyphStyle}" />
            </DataTemplate>

            <DataTemplate x:Key="ApplyIconTemplate">
                <TextBlock Text="&#xE73E;" Style="{StaticResource IconGlyphStyle}" />
            </DataTemplate>

            <DataTemplate x:Key="DeleteIconTemplate">
                <TextBlock Text="&#xE74D;" Style="{StaticResource IconGlyphStyle}" />
            </DataTemplate>

            <DataTemplate x:Key="RemoveIconTemplate">
                <TextBlock Text="&#xE738;" Style="{StaticResource IconGlyphStyle}" />
            </DataTemplate>

            <DataTemplate x:Key="CancelIconTemplate">
                <TextBlock Text="&#xE711;" Style="{StaticResource IconGlyphStyle}" />
            </DataTemplate>

            <DataTemplate x:Key="EditIconTemplate">
                <TextBlock Text="&#xE70F;" Style="{StaticResource IconGlyphStyle}" />
            </DataTemplate>

            <DataTemplate x:Key="CalculateIconTemplate">
                <TextBlock Text="&#xE8EF;" Style="{StaticResource IconGlyphStyle}" />
            </DataTemplate>

            <DataTemplate x:Key="CopyIconTemplate">
                <TextBlock Text="&#xE8C8;" Style="{StaticResource IconGlyphStyle}" />
            </DataTemplate>

            <DataTemplate x:Key="LinkIconTemplate">
                <TextBlock Text="&#xE71B;" Style="{StaticResource IconGlyphStyle}" />
            </DataTemplate>

            <!-- Unlink: the font has no broken-link glyph, so the scissors (Cut) cut the link -->
            <DataTemplate x:Key="UnlinkIconTemplate">
                <TextBlock Text="&#xE8C6;" Style="{StaticResource IconGlyphStyle}" />
            </DataTemplate>

            <DataTemplate x:Key="MoveUpIconTemplate">
                <TextBlock Text="&#xE74A;" Style="{StaticResource IconGlyphStyle}" />
            </DataTemplate>

            <DataTemplate x:Key="MoveDownIconTemplate">
                <TextBlock Text="&#xE74B;" Style="{StaticResource IconGlyphStyle}" />
            </DataTemplate>

            <DataTemplate x:Key="SettingsIconTemplate">
                <TextBlock Text="&#xE713;" Style="{StaticResource IconGlyphStyle}" />
            </DataTemplate>

            <!-- Which columns show: View, the eye -->
            <DataTemplate x:Key="ColumnsIconTemplate">
                <TextBlock Text="&#xE890;" Style="{StaticResource IconGlyphStyle}" />
            </DataTemplate>

            <DataTemplate x:Key="PrintIconTemplate">
                <TextBlock Text="&#xE749;" Style="{StaticResource IconGlyphStyle}" />
            </DataTemplate>

            <!-- A backup put back over the data: UpdateRestore, an arrow turning back -->
            <DataTemplate x:Key="RestoreIconTemplate">
                <TextBlock Text="&#xE777;" Style="{StaticResource IconGlyphStyle}" />
            </DataTemplate>

            <!-- A folder opened in File Explorer, or a file picked from one: FolderOpen -->
            <DataTemplate x:Key="FolderIconTemplate">
                <TextBlock Text="&#xE838;" Style="{StaticResource IconGlyphStyle}" />
            </DataTemplate>

            <!-- A table to an Excel workbook: Export, an arrow leaving a box -->
            <DataTemplate x:Key="ExportIconTemplate">
                <TextBlock Text="&#xEDE1;" Style="{StaticResource IconGlyphStyle}" />
            </DataTemplate>

            <!-- A composite product, made of several: AllApps, as its Products tab and its row in the list show it -->
            <DataTemplate x:Key="CompositeIconTemplate">
                <TextBlock Text="&#xE71D;" Style="{StaticResource IconGlyphStyle}" />
            </DataTemplate>

            <!-- A new category or role, a folder in a list's tree: NewFolder, as the tree's right-click menus show it -->
            <DataTemplate x:Key="NewFolderIconTemplate">
                <TextBlock Text="&#xE8F4;" Style="{StaticResource IconGlyphStyle}" />
            </DataTemplate>

            <!-- A list's Expand All and Collapse All: the chevrons ExpandChevronStyle uses, down to open and up to close -->
            <DataTemplate x:Key="ExpandAllIconTemplate">
                <TextBlock Text="&#xE70D;" Style="{StaticResource IconGlyphStyle}" />
            </DataTemplate>

            <DataTemplate x:Key="CollapseAllIconTemplate">
                <TextBlock Text="&#xE70E;" Style="{StaticResource IconGlyphStyle}" />
            </DataTemplate>
            <!--
                A collapse toggle's chevron (a checkable ButtonAdv): pointing up while the section is open
                (unchecked), down once it's collapsed (checked).
            -->
            <Style x:Key="ExpandChevronStyle" TargetType="TextBlock" BasedOn="{StaticResource IconGlyphStyle}">
                <Setter Property="Text" Value="&#xE70E;" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=syncfusion:ButtonAdv}}" Value="True">
                        <Setter Property="Text" Value="&#xE70D;" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <DataTemplate x:Key="ExpandIconTemplate">
                <TextBlock Style="{StaticResource ExpandChevronStyle}" />
            </DataTemplate>

            <!--
                SfTextBoxExt.WatermarkTemplate: the theme shows the watermark in a plain ContentControl,
                which ignores VerticalContentAlignment, so the hint sits at the top of the box, and 4px
                right of where typed text starts (measured). This puts the hint where typed text goes.
            -->
            <DataTemplate x:Key="AlignedWatermarkTemplate">
                <TextBlock Text="{Binding}" VerticalAlignment="Center" Margin="-4,0,0,0" />
            </DataTemplate>

            <!--
                Design tokens for the app's own surfaces (cards, page background, banners). These
                are plain app resources, not Syncfusion theme resources — Syncfusion controls only
                ever get recolored through Windows11LightThemeSettings (see App.xaml.cs), never
                through a Style, so their templates stay intact. Every token is a Catppuccin Latte
                colour from Themes/Palette.xaml, in the roles Catppuccin's style guide gives them: Mantle
                for the page, Base for the cards, Text and Subtext for type, Sky for the accent that
                matches PrimaryBackground/PrimaryForeground, Blue for links, Green, Yellow and Red for
                success, warning and error, and Mauve for a neutral notice.
                A coloured banner or badge sits on its hue's Tint, with text in its hue's Deep shade,
                since most of Latte's hues are too pale to read as text on a light background.
            -->
            <SolidColorBrush x:Key="PageBackgroundBrush" Color="{StaticResource LatteMantleColor}" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource LatteBaseColor}" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource LatteCrustColor}" />
            <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{StaticResource LatteTextColor}" />
            <SolidColorBrush x:Key="MutedForegroundBrush" Color="{StaticResource LatteSubtext1Color}" />
            <!--
                TabControlExt colours, set as its own properties (TabPanelBackground, TabItemSelectedBackground,
                TabItemHoverBackground) since the theme's are neutral greys and a Syncfusion control never gets a Style.
                A tab strip is a step darker than what it sits over, and the selected tab is the colour of its content,
                so the two read as one piece: the window's tabs (MainWindow, SettingsWindow) are Crust over the Mantle page,
                the tabs inside a card are Mantle over the Base card. The mouse darkens a tab by one more step.
            -->
            <SolidColorBrush x:Key="PageTabStripBrush" Color="{StaticResource LatteCrustColor}" />
            <SolidColorBrush x:Key="PageTabHoverBrush" Color="{StaticResource LatteSurface0Color}" />
            <SolidColorBrush x:Key="CardTabStripBrush" Color="{StaticResource LatteMantleColor}" />
            <SolidColorBrush x:Key="CardTabHoverBrush" Color="{StaticResource LatteCrustColor}" />
            <!--
                The one colour here that isn't Latte's: the white the Windows11Light theme fills a list's rows with (its
                ContentBackground, on every SfDataGrid). It's for a list the theme leaves transparent, so it still matches the
                grids: the Products tree (ProductListCard). The theme's own brush can't be looked up from here, since
                SfSkinManager's ThemeResource needs ApplyThemeAsDefaultStyle, which stays off (App.xaml.cs).
            -->
            <SolidColorBrush x:Key="ListBackgroundBrush" Color="#FFFFFFFF" />
            <!-- A read-only value's text, greyed out so it doesn't look typeable (Controls/ReadOnlyText) -->
            <SolidColorBrush x:Key="ReadOnlyForegroundBrush" Color="{StaticResource LatteOverlay0Color}" />
            <!--
                The accent is Sky, for fills, lines and borders (the grids' current-cell outline, the chart line). Sky is
                too pale for text or a small glyph (2.5:1 on Base), so accent text uses AccentForegroundBrush, its Deep shade.
            -->
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource LatteSkyColor}" />
            <SolidColorBrush x:Key="AccentForegroundBrush" Color="{StaticResource LatteSkyDeepColor}" />
            <!-- The Costing Summary's Subtotal and Total Selling Price bands: the accent's Tint, a soft wash rather than a block -->
            <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource LatteSkyTintColor}" />
            <!--
                A neutral notice that explains rather than warns (the linked-cost preview on Raw Materials): Mauve, so it
                reads apart from the warning's Yellow, the link's Blue and the accent's Sky.
            -->
            <SolidColorBrush x:Key="InfoBackgroundBrush" Color="{StaticResource LatteMauveTintColor}" />
            <SolidColorBrush x:Key="InfoForegroundBrush" Color="{StaticResource LatteMauveDeepColor}" />
            <!--
                Something clickable that takes you elsewhere (a linked badge, a Used By tile's focus): Blue, Catppuccin's
                link colour, and underlined under the mouse, so a clickable badge reads apart from the plain Yellow ones.
                The Deep shade rather than Blue itself: the badge text is 11px, and Blue on its Tint is only 3.7:1.
            -->
            <SolidColorBrush x:Key="LinkBackgroundBrush" Color="{StaticResource LatteBlueTintColor}" />
            <SolidColorBrush x:Key="LinkForegroundBrush" Color="{StaticResource LatteBlueDeepColor}" />
            <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="{StaticResource LatteGreenTintColor}" />
            <SolidColorBrush x:Key="SuccessForegroundBrush" Color="{StaticResource LatteGreenDeepColor}" />
            <!-- The success toast's border (Controls/SuccessToast) -->
            <SolidColorBrush x:Key="SuccessBorderBrush" Color="{StaticResource LatteGreenColor}" />

            <!-- The error toast (Controls/ErrorToast) -->
            <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="{StaticResource LatteRedTintColor}" />
            <SolidColorBrush x:Key="ErrorBorderBrush" Color="{StaticResource LatteRedColor}" />
            <SolidColorBrush x:Key="ErrorForegroundBrush" Color="{StaticResource LatteRedDeepColor}" />
            <SolidColorBrush x:Key="WarningBackgroundBrush" Color="{StaticResource LatteYellowTintColor}" />
            <SolidColorBrush x:Key="WarningForegroundBrush" Color="{StaticResource LatteYellowDeepColor}" />

            <!-- The toasts' close button (Controls/ErrorToast, Controls/SuccessToast): just the glyph, with a soft highlight under the mouse -->
            <Style x:Key="ToastCloseButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome" Width="24" Height="24" CornerRadius="4" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="#14000000" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="#24000000" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                A printed product's table rules (Printing/ProductPrintLayout), which otherwise takes the Costing card's colours:
                Surface 1, a step darker than the card's Crust lines, which all but vanish on white paper.
            -->
            <SolidColorBrush x:Key="PrintRuleBrush" Color="{StaticResource LatteSurface1Color}" />
            <!--
                The paper a printed product's pages are on, in the print pane as on the printer: white whatever the theme. The
                second colour here that isn't Latte's, after ListBackgroundBrush: Syncfusion's pane draws the page transparent
                over its grey, and its own page template for the printer frames the page in grey.
            -->
            <SolidColorBrush x:Key="PrintPaperBrush" Color="#FFFFFFFF" />

            <!--
                A product's icon, by what its category holds (ProductCategoryIconConverter): the downloaded full-colour
                images (Assets/Icons) for rolls, cakes, pastries, loaves, breads and composites. Each 128 px file shrinks to 32 (40 px at 125%
                scaling), which stays sharp, rounded to whole pixels so it doesn't land between them and blur. Any other
                product gets the navigation menu's Products glyph in the accent.
            -->
            <converters:ProductCategoryIconConverter x:Key="ProductCategoryIconConverter">
                <converters:ProductCategoryIconConverter.Roll>
                    <DataTemplate>
                        <Image Source="/Assets/Icons/Roll_Cake_128px.png"
                               Width="32"
                               Height="32"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               UseLayoutRounding="True" />
                    </DataTemplate>
                </converters:ProductCategoryIconConverter.Roll>
                <converters:ProductCategoryIconConverter.Cake>
                    <DataTemplate>
                        <Image Source="/Assets/Icons/Cake_128px.png"
                               Width="32"
                               Height="32"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               UseLayoutRounding="True" />
                    </DataTemplate>
                </converters:ProductCategoryIconConverter.Cake>
                <converters:ProductCategoryIconConverter.Pastry>
                    <DataTemplate>
                        <Image Source="/Assets/Icons/Pastry_128px.png"
                               Width="32"
                               Height="32"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               UseLayoutRounding="True" />
                    </DataTemplate>
                </converters:ProductCategoryIconConverter.Pastry>
                <converters:ProductCategoryIconConverter.Loaf>
                    <DataTemplate>
                        <Image Source="/Assets/Icons/Loaf_128px.png"
                               Width="32"
                               Height="32"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               UseLayoutRounding="True" />
                    </DataTemplate>
                </converters:ProductCategoryIconConverter.Loaf>
                <converters:ProductCategoryIconConverter.Bread>
                    <DataTemplate>
                        <Image Source="/Assets/Icons/Bread_128px.png"
                               Width="32"
                               Height="32"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               UseLayoutRounding="True" />
                    </DataTemplate>
                </converters:ProductCategoryIconConverter.Bread>
                <converters:ProductCategoryIconConverter.Composite>
                    <DataTemplate>
                        <Image Source="/Assets/Icons/Composite_128px.png"
                               Width="32"
                               Height="32"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               UseLayoutRounding="True" />
                    </DataTemplate>
                </converters:ProductCategoryIconConverter.Composite>
                <converters:ProductCategoryIconConverter.Other>
                    <DataTemplate>
                        <TextBlock Text="&#xE71D;" Style="{StaticResource IconGlyphStyle}" FontSize="32" Foreground="{StaticResource AccentForegroundBrush}" />
                    </DataTemplate>
                </converters:ProductCategoryIconConverter.Other>
            </converters:ProductCategoryIconConverter>

            <!--
                The height both detail screens' header cards are held to (Raw Materials' natural height), so the
                card below starts at the same place on either screen and nothing jumps when the tab changes. It's a
                floor rather than a fixed height: the content still decides, this only stops the shorter card short.
            -->
            <system:Double x:Key="HeaderCardHeight">179</system:Double>

            <!-- Card container: the shared "panel on a surface" look used by every screen's list and detail sections. -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource HeadingForegroundBrush}" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>

            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <!--
                A stacked form's field label, on the left of its input (2026-09-24, the user's practice for a desktop app:
                labels beside inputs, not above them). Each field is a row Grid of its own, the label in an Auto column
                that a SharedSizeGroup lines up down the form, and the gap to the next field on the row, so the label
                centres on its box. FieldLabelStyle, above its input, stays for side-by-side strips of fields (the
                headers), where a label beside every box wouldn't fit on one row.
            -->
            <Style x:Key="FormLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldLabelStyle}">
                <!-- 6 to its box, not 12: at 12 the label read as apart from its field (the user's call, the same day) -->
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="CaptionStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!--
                The compact screen's sections (Products): unboxed sections inside one bordered region, each a
                smaller header, set apart from the next by a divider line.
            -->
            <Style x:Key="PanelHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionHeaderStyle}">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <!--
                A header figure's tile (the Raw Materials, Sub-Assemblies and Products headers): a rounded block in a
                Latte Wash, one colour per figure, behind the figure's label and value, which sit in the grid cells the
                tile spans. The same figure keeps its colour on every screen: Last Updated is Mauve, a total weight Teal,
                a total cost Flamingo, a cost per gram Yellow (2026-09-25, at the user's request; they were plain columns
                with a thin line between each before). The label is Text rather than muted, since Subtext on the Mauve
                Wash is only 4.1:1, and the tiles stand 8 apart (FigureTileGapStyle) where the lines were.
            -->
            <Style x:Key="FigureTileStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="6" />
            </Style>
            <Style x:Key="FigureTileLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource HeadingForegroundBrush}" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="Margin" Value="6,8,6,4" />
            </Style>
            <Style x:Key="FigureTileGapStyle" TargetType="Border">
                <Setter Property="Width" Value="8" />
            </Style>
            <SolidColorBrush x:Key="RosewaterTileBrush" Color="{StaticResource LatteRosewaterWashColor}" />
            <SolidColorBrush x:Key="FlamingoTileBrush" Color="{StaticResource LatteFlamingoWashColor}" />
            <SolidColorBrush x:Key="PinkTileBrush" Color="{StaticResource LattePinkWashColor}" />
            <SolidColorBrush x:Key="MauveTileBrush" Color="{StaticResource LatteMauveWashColor}" />
            <SolidColorBrush x:Key="PeachTileBrush" Color="{StaticResource LattePeachWashColor}" />
            <SolidColorBrush x:Key="YellowTileBrush" Color="{StaticResource LatteYellowWashColor}" />
            <SolidColorBrush x:Key="GreenTileBrush" Color="{StaticResource LatteGreenWashColor}" />
            <SolidColorBrush x:Key="TealTileBrush" Color="{StaticResource LatteTealWashColor}" />
            <SolidColorBrush x:Key="SkyTileBrush" Color="{StaticResource LatteSkyWashColor}" />

            <Style x:Key="SectionDividerStyle" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Margin" Value="0,12" />
                <Setter Property="Background" Value="{StaticResource CardBorderBrush}" />
            </Style>

            <Style x:Key="EmptyStateStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- A small "Linked to …" tag beside a Products recipe section's name. -->
            <Style x:Key="LinkedBadgeStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource WarningBackgroundBrush}" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="6,1" />
                <Setter Property="Margin" Value="8,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!--
                The same tag as a link, for one that names where it's kept: in the link colours (Blue, where the plain
                tag is Yellow), so a clickable tag reads apart from a plain one, and its text underlined under the mouse, as a
                link's is.
            -->
            <Style x:Key="LinkedBadgeLinkStyle" TargetType="Button">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{StaticResource LinkBackgroundBrush}" CornerRadius="4" Padding="6,1">
                                <TextBlock x:Name="BadgeText"
                                           Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontSize="13"
                                           Foreground="{StaticResource LinkForegroundBrush}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BadgeText" Property="TextDecorations" Value="Underline" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                A product under Used By (Sub-Assemblies, Raw Materials), as File Explorer shows a file: an icon over its name,
                flat until the mouse is over it, then a wash, and a click opens it. A plain Button, templated here like the
                navigation menu's rows (MainWindow), for the same reason: a flattened ButtonAdv's themed hover is opaque and
                barely reads. Keyboard focus draws the link-colour border (LinkForegroundBrush), since Tab can reach the tiles.
            -->
            <Style x:Key="UsedByTileStyle" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource HeadingForegroundBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Margin" Value="0,0,4,4" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Tile"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="6,10,6,8">
                                <ContentPresenter VerticalAlignment="Top" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Tile" Property="Background" Value="#14000000" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource LinkForegroundBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Tile" Property="Background" Value="#24000000" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                The Used By tiles, bound to a screen's UsedBy (LinkingProducts): one per product, in rows and columns. Every
                tile is ItemWidth wide, so they line up down the page as well as across, and as many fit on a row as the card
                is wide. A long name wraps inside its tile, and the WrapPanel stretches the row's other tiles to its height.
                A tile runs the screen's OpenProductCommand, which opens its product on the Products screen (MainWindow
                subscribes). The icon says what the product is: a composite's bag of breads, or from its category, a cake, a
                pastry's cupcake, a loaf, a bread, or else the navigation menu's Products glyph (ProductCategoryIconConverter).
            -->
            <Style x:Key="UsedByTilesStyle" TargetType="ItemsControl">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <WrapPanel ItemWidth="124" />
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <Button Style="{StaticResource UsedByTileStyle}"
                                    Command="{Binding DataContext.OpenProductCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding Id}"
                                    ToolTip="Open on the Products screen"
                                    AutomationProperties.Name="{Binding Name}">
                                <StackPanel>
                                    <ContentPresenter Content="{Binding}"
                                                      ContentTemplate="{Binding Converter={StaticResource ProductCategoryIconConverter}}"
                                                      HorizontalAlignment="Center"
                                                      Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                A value in a Products recipe section's Total row, under its table: right-aligned like the
                grid's number cells, which the grid's own summary row doesn't do.
            -->
            <Style x:Key="SectionTotalCellStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="5,9" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource HeadingForegroundBrush}" />
            </Style>

            <!-- The line on a Total row cell's right, carrying the grid's vertical lines (GridLinesVisibility="Both") through the total -->
            <Style x:Key="SectionTotalDividerStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="0,0,1,0" />
            </Style>

            <Style x:Key="AppTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource HeadingForegroundBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
