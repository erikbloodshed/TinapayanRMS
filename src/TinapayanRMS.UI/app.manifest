<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="TinapayanRMS.UI.app" />

  <!-- Same as the SDK's default manifest, which this file replaces. -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <!--
    Per-monitor DPI awareness. Without it WPF is only system-DPI-aware: it renders at the
    primary monitor's scale and Windows bitmap-stretches the whole window on any monitor with
    a different scale (e.g. a 100% monitor beside a 125% one), which makes it blurry there.
    PerMonitorV2 lets WPF re-render natively at each monitor's DPI as the window moves, and
    also rescales the native title bar. dpiAware is only read by Windows versions before
    10 1607, where WPF can't do per-monitor, so it stays system-aware there.
  -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2, PerMonitor</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
