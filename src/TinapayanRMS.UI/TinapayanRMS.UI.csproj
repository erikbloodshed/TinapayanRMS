<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(WindowsTargetFramework)</TargetFramework>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishReadyToRun>true</PublishReadyToRun>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Made from Assets\Icons\tinapayan-rms-icon.png (see the developer manual). The .exe's icon, which Explorer and
         shortcuts show. The windows don't take it from here: AppWindow sets each one's Icon from the same file. -->
    <ApplicationIcon>Assets\Icons\tinapayan-rms-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DynamicData" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="ReactiveUI.WPF" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Syncfusion.DataGridExcelExport.WPF" />
    <PackageReference Include="Syncfusion.Licensing" />
    <PackageReference Include="Syncfusion.SfChart.WPF" />
    <PackageReference Include="Syncfusion.SfGrid.WPF" />
    <PackageReference Include="Syncfusion.SfInput.WPF" />
    <PackageReference Include="Syncfusion.SfNavigationDrawer.WPF" />
    <PackageReference Include="Syncfusion.SfSkinManager.WPF" />
    <PackageReference Include="Syncfusion.SfTextInputLayout.WPF" />
    <PackageReference Include="Syncfusion.SfTreeView.WPF" />
    <PackageReference Include="Syncfusion.Themes.Windows11Light.WPF" />
    <PackageReference Include="Syncfusion.Tools.WPF" />
    <PackageReference Include="System.Reactive" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TinapayanRMS.Domain\TinapayanRMS.Domain.csproj" />
    <ProjectReference Include="..\TinapayanRMS.ApplicationCore\TinapayanRMS.ApplicationCore.csproj" />
    <ProjectReference Include="..\TinapayanRMS.Infrastructure\TinapayanRMS.Infrastructure.csproj" />
    <ProjectReference Include="..\TinapayanRMS.Pricing\TinapayanRMS.Pricing.csproj" />
    <!-- The screens' ViewModels, which the MAUI app's screens draw too. -->
    <ProjectReference Include="..\TinapayanRMS.Presentation\TinapayanRMS.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Icons\**\*.png;Assets\Icons\**\*.ico" />
  </ItemGroup>

  <!-- The Syncfusion licence key, taken from the SYNCFUSION_LICENSE_KEY environment variable when the app is built, so
       the installed app doesn't need the variable. App reads it back with the AssemblyMetadata key. -->
  <ItemGroup Condition="'$(SYNCFUSION_LICENSE_KEY)' != ''">
    <AssemblyMetadata Include="SyncfusionLicenseKey" Value="$(SYNCFUSION_LICENSE_KEY)" />
  </ItemGroup>

  <!-- A publish without the key would make an app that can't start. -->
  <Target Name="RequireSyncfusionLicenseKey" BeforeTargets="PrepareForPublish" Condition="'$(SYNCFUSION_LICENSE_KEY)' == ''">
    <Error Text="Set the SYNCFUSION_LICENSE_KEY environment variable before publishing. The key is compiled into the app." />
  </Target>

</Project>
