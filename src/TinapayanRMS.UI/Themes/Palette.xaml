<!--
    The app's colour scale: Amber, the accent's hue, in Tailwind's steps from 50 (lightest) to 950 (darkest). Every
    coloured token is a shade of it, info notices and links included. App.xaml's design tokens name these shades
    rather than repeating hex codes; views use the tokens, not the scale. The neutrals (Stone) and the success and
    error pairs are still loose values in App.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Amber -->
    <Color x:Key="Amber50Color">#FFFFFBEB</Color>
    <Color x:Key="Amber100Color">#FFFEF3C7</Color>
    <Color x:Key="Amber200Color">#FFFDE68A</Color>
    <Color x:Key="Amber300Color">#FFFCD34D</Color>
    <Color x:Key="Amber400Color">#FFFBBF24</Color>
    <Color x:Key="Amber500Color">#FFF59E0B</Color>
    <Color x:Key="Amber600Color">#FFD97706</Color>
    <Color x:Key="Amber700Color">#FFB45309</Color>
    <Color x:Key="Amber800Color">#FF92400E</Color>
    <Color x:Key="Amber900Color">#FF78350F</Color>
    <Color x:Key="Amber950Color">#FF451A03</Color>

    <SolidColorBrush x:Key="Amber50Brush" Color="{StaticResource Amber50Color}" />
    <SolidColorBrush x:Key="Amber100Brush" Color="{StaticResource Amber100Color}" />
    <SolidColorBrush x:Key="Amber200Brush" Color="{StaticResource Amber200Color}" />
    <SolidColorBrush x:Key="Amber300Brush" Color="{StaticResource Amber300Color}" />
    <SolidColorBrush x:Key="Amber400Brush" Color="{StaticResource Amber400Color}" />
    <SolidColorBrush x:Key="Amber500Brush" Color="{StaticResource Amber500Color}" />
    <SolidColorBrush x:Key="Amber600Brush" Color="{StaticResource Amber600Color}" />
    <SolidColorBrush x:Key="Amber700Brush" Color="{StaticResource Amber700Color}" />
    <SolidColorBrush x:Key="Amber800Brush" Color="{StaticResource Amber800Color}" />
    <SolidColorBrush x:Key="Amber900Brush" Color="{StaticResource Amber900Color}" />
    <SolidColorBrush x:Key="Amber950Brush" Color="{StaticResource Amber950Color}" />

</ResourceDictionary>
