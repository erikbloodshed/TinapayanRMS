<UserControl x:Class="TinapayanRMS.UI.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:controls="clr-namespace:TinapayanRMS.UI.Controls"
             xmlns:p="clr-namespace:TinapayanRMS.UI.Views.Products"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="1400">
    <!--
        The list beside the selected product: its summary header, then its cards in tabs along the
        bottom. Each card is a UserControl in Views/Products that inherits this screen's DataContext;
        when a card shows is decided here.
    -->
    <Grid Background="{StaticResource PageBackgroundBrush}" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ErrorMessage as a toast, over the cards: it spans the whole Grid and puts itself in its bottom-right corner -->
        <controls:ErrorToast Grid.RowSpan="2" Grid.ColumnSpan="3" />

        <p:ProductListCard Grid.RowSpan="2" Grid.Column="0" />

        <p:ProductHeaderCard x:Name="Header" Grid.Column="2" Margin="0,0,0,16" />

        <!--
            Every tab but Links & Clone is part of the one form Save writes, so a new product shows them
            too. Fixed tabs, like Raw Materials': nothing to close or reopen. The strip sits along the
            bottom, and each tab scrolls on its own, so the strip stays put. Links & Clone only applies to a
            saved product; while it's hidden the ViewModel moves the selection off it (SelectedDetailsTab).
        -->
        <syncfusion:TabControlExt Grid.Row="1"
                                  Grid.Column="2"
                                  TabStripPlacement="Bottom"
                                  CloseButtonType="Hide"
                                  ShowTabItemContextMenu="False"
                                  ShowTabListContextMenu="False"
                                  SelectedIndex="{Binding SelectedDetailsTab, Mode=TwoWay}">
            <!--
                The recipe gets two thirds: its tables need about 580 px, and the doughnut beside it about
                310 px. Narrower than 960 px (a window under about 1,350 px wide) the side cards move under
                it at full width instead.
            -->
            <syncfusion:TabItemExt Header="Recipe" CanClose="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <controls:ResponsiveColumnsPanel Breakpoint="960" LeadingWeight="2" TrailingWeight="1">
                        <p:RecipeStructureCard />
                        <p:RecipeSidePanel />
                    </controls:ResponsiveColumnsPanel>
                </ScrollViewer>
            </syncfusion:TabItemExt>

            <syncfusion:TabItemExt Header="Costing" CanClose="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>

                        <p:CostingSummaryCard Grid.ColumnSpan="3" Margin="0,0,0,16" />
                        <p:CostBreakdownCard Grid.Row="1" />
                        <p:ProfitMarginCard Grid.Row="1" Grid.Column="2" VerticalAlignment="Top" />
                    </Grid>
                </ScrollViewer>
            </syncfusion:TabItemExt>

            <syncfusion:TabItemExt Header="Links &amp; Clone"
                                   CanClose="False"
                                   Visibility="{Binding ShowLinks, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <p:TabLinksCard VerticalAlignment="Top" />
                        <p:CloneCard Grid.Column="2" VerticalAlignment="Top" />
                    </Grid>
                </ScrollViewer>
            </syncfusion:TabItemExt>
        </syncfusion:TabControlExt>
    </Grid>
</UserControl>
