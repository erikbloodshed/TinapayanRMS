<UserControl x:Class="TinapayanRMS.UI.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:controls="clr-namespace:TinapayanRMS.UI.Controls"
             xmlns:p="clr-namespace:TinapayanRMS.UI.Views.Products"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="1400">
    <!--
        Two bordered regions: the product list, and the selected product's details (its header of figures, the
        fields typed in about it, then its tabs along the bottom). Inside the details the sections aren't boxed: headers and divider lines
        set them apart. Each section is a UserControl in Views/Products that inherits this screen's
        DataContext; when one shows is decided here.
    -->
    <!-- Cards are 4px apart and 4px from the page's edge, as on Raw Materials -->
    <Grid Background="{StaticResource PageBackgroundBrush}" Margin="4">
        <Grid.ColumnDefinitions>
            <!-- Auto: the list card is as wide as its columns, as on Raw Materials -->
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--
            ErrorMessage and SuccessMessage as toasts, over everything: each spans the whole Grid and puts itself in its
            bottom-right corner. The success toast came with the History tab (2026-10-17), whose Restore says what it put
            back; Revert's and a relink's messages had been set here all along with nothing to show them.
        -->
        <controls:ErrorToast Grid.ColumnSpan="3" />
        <controls:SuccessToast Grid.ColumnSpan="3" />

        <p:ProductListCard Grid.Column="0" />

        <!--
            As on Raw Materials: the header card, then the tabs in a card of their own, 4px apart. The tab control
            draws no frame (BorderThickness 0), so the card around it is the only border, and each tab's content
            sits straight in it, kept off the edge by its ScrollViewer's padding.
        -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource CardStyle}" Padding="12" MinHeight="{StaticResource HeaderCardHeight}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--
                        The header only shows figures; what's typed in about the product sits under it, 16 below the
                        figures (4 until 2026-09-24, when its labels moved beside the boxes and the row needed setting apart)
                    -->
                    <p:ProductHeaderCard />

                    <p:ProductDetailsCard x:Name="Details" Grid.Row="1" Margin="0,16,0,0" />
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="0,4,0,0" Style="{StaticResource CardStyle}" Padding="4">
                <!--
                    Every tab but Scaling and Clone is part of the one form Save writes, so a new product shows them
                    too (Scaling only works the recipe out). Fixed tabs, like Raw Materials': nothing to close or reopen, and nothing to drag into
                    another order (AllowDragDrop, which TabControlExt defaults to true). The strip sits along the
                    bottom, and each tab scrolls on its own, so the strip stays put. Clone only applies to a
                    saved product; while it's hidden the ViewModel moves the selection off it (SelectedDetailsTab).
                    Between picking a product and its details arriving, the previous product's still show, and
                    the tabs ignore the mouse (AreDetailsReady): what's in them is no longer the form's.
                -->
                <syncfusion:TabControlExt BorderThickness="0"
                                          Background="{StaticResource CardBackgroundBrush}"
                                          TabPanelBackground="{StaticResource CardTabStripBrush}"
                                          TabItemSelectedBackground="{StaticResource CardBackgroundBrush}"
                                          TabItemHoverBackground="{StaticResource CardTabHoverBrush}"
                                          AllowDragDrop="False"
                                          EnableLabelEdit="False"
                                          IsHitTestVisible="{Binding AreDetailsReady}"
                                          TabStripPlacement="Bottom"
                                          CloseButtonType="Hide"
                                          ShowTabItemContextMenu="False"
                                          ShowTabListContextMenu="False"
                                          SelectedIndex="{Binding SelectedDetailsTab, Mode=TwoWay}">
                    <!--
                        The recipe, the tab's full width. **No ScrollViewer here, unlike the other two tabs**: the
                        card scrolls inside its own content frame, so its header and its sub-assembly tabs stay put
                        while the form under them moves. A ScrollViewer around the card would scroll them off the
                        top. FocusScrolling.SkipOnClick went in with it, for the same reason it was here — the
                        sub-assembly form's lines table often starts near the bottom of the window, and a click on
                        it used to scroll the page out from under the mouse.
                    -->
                    <syncfusion:TabItemExt Header="Recipe" CanClose="False">
                        <Border Padding="12">
                            <p:RecipeStructureCard />
                        </Border>
                    </syncfusion:TabItemExt>

                    <!-- The costing parameters beside the recipe cost breakdown (CostingCard) -->
                    <syncfusion:TabItemExt Header="Costing" CanClose="False">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,12,14,12">
                            <p:CostingCard />
                        </ScrollViewer>
                    </syncfusion:TabItemExt>

                    <!--
                        The recipe scaled to a number of sellable units (ScalingCard). No ScrollViewer, as on Recipe: the
                        tree grid scrolls itself, and the quantity above it stays put.
                    -->
                    <syncfusion:TabItemExt Header="Scaling" CanClose="False">
                        <Border Padding="12">
                            <p:ScalingCard />
                        </Border>
                    </syncfusion:TabItemExt>

                    <!-- Linking the packaging moved into the Recipe Structure's Add Sub-Assembly, so this tab only clones: a copy, or a variant that links the recipe and packaging. -->
                    <syncfusion:TabItemExt Header="Clone"
                                           CanClose="False"
                                           Visibility="{Binding ShowLinks, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,12,14,12">
                            <p:CloneCard HorizontalAlignment="Left" VerticalAlignment="Top" MinWidth="420" />
                        </ScrollViewer>
                    </syncfusion:TabItemExt>

                    <!--
                        The product's versions, a saved product's only, as Clone. No ScrollViewer, as on Scaling: the table
                        scrolls itself, and the changes beside it scroll on their own.
                    -->
                    <syncfusion:TabItemExt Header="History"
                                           CanClose="False"
                                           Visibility="{Binding ShowLinks, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <p:HistoryCard />
                    </syncfusion:TabItemExt>
                </syncfusion:TabControlExt>
            </Border>
        </Grid>
    </Grid>
</UserControl>
