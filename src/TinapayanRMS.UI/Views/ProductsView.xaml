<UserControl x:Class="TinapayanRMS.UI.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:controls="clr-namespace:TinapayanRMS.UI.Controls"
             xmlns:p="clr-namespace:TinapayanRMS.UI.Views.Products"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="1400">
    <!--
        Two bordered regions: the product list, and the selected product's details (its header of figures, the
        fields typed in about it, then its tabs along the bottom). Inside the details the sections aren't boxed: headers and divider lines
        set them apart. Each section is a UserControl in Views/Products that inherits this screen's
        DataContext; when one shows is decided here.
    -->
    <!-- Cards are 4px apart and 4px from the page's edge, as on Raw Materials -->
    <Grid Background="{StaticResource PageBackgroundBrush}" Margin="4">
        <Grid.ColumnDefinitions>
            <!-- Auto: the list card is as wide as its columns, as on Raw Materials -->
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ErrorMessage as a toast, over everything: it spans the whole Grid and puts itself in its bottom-right corner -->
        <controls:ErrorToast Grid.ColumnSpan="3" />

        <p:ProductListCard Grid.Column="0" />

        <!--
            As on Raw Materials: the header card, then the tabs in a card of their own, 4px apart. The tab control
            draws no frame (BorderThickness 0), so the card around it is the only border, and each tab's content
            sits straight in it, kept off the edge by its ScrollViewer's padding.
        -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource CardStyle}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- The header only shows figures; what's typed in about the product sits under it -->
                    <p:ProductHeaderCard />

                    <p:ProductDetailsCard x:Name="Details" Grid.Row="1" Margin="0,12,0,0" />
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="0,4,0,0" Style="{StaticResource CardStyle}" Padding="4">
                <!--
                    Every tab but Clone is part of the one form Save writes, so a new product shows them
                    too. Fixed tabs, like Raw Materials': nothing to close or reopen. The strip sits along the
                    bottom, and each tab scrolls on its own, so the strip stays put. Clone only applies to a
                    saved product; while it's hidden the ViewModel moves the selection off it (SelectedDetailsTab).
                    Between picking a product and its details arriving, the previous product's still show, and
                    the tabs ignore the mouse (AreDetailsReady): what's in them is no longer the form's.
                -->
                <syncfusion:TabControlExt BorderThickness="0"
                                          IsHitTestVisible="{Binding AreDetailsReady}"
                                          TabStripPlacement="Bottom"
                                          CloseButtonType="Hide"
                                          ShowTabItemContextMenu="False"
                                          ShowTabListContextMenu="False"
                                          SelectedIndex="{Binding SelectedDetailsTab, Mode=TwoWay}">
                    <!--
                        The recipe, the tab's full width. A click doesn't scroll the tab (FocusScrolling): the
                        sub-assembly form's lines table often starts near the bottom of the window.
                    -->
                    <syncfusion:TabItemExt Header="Recipe" CanClose="False">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,12,14,12">
                            <p:RecipeStructureCard controls:FocusScrolling.SkipOnClick="True" />
                        </ScrollViewer>
                    </syncfusion:TabItemExt>

                    <!-- The costing parameters beside the recipe cost breakdown (CostingCard) -->
                    <syncfusion:TabItemExt Header="Costing" CanClose="False">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,12,14,12">
                            <p:CostingCard />
                        </ScrollViewer>
                    </syncfusion:TabItemExt>

                    <!-- Packs sits after Costing: a pack's price is the piece price it's worked out from, times its pieces -->
                    <syncfusion:TabItemExt Header="Packs" CanClose="False">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,12,14,12">
                            <p:PacksCard />
                        </ScrollViewer>
                    </syncfusion:TabItemExt>

                    <!-- Linking the packaging moved into the Recipe Structure's Add Sub-Assembly, so this tab only clones: a copy, or a variant that links the recipe and packaging. -->
                    <syncfusion:TabItemExt Header="Clone"
                                           CanClose="False"
                                           Visibility="{Binding ShowLinks, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,12,14,12">
                            <p:CloneCard HorizontalAlignment="Left" VerticalAlignment="Top" MinWidth="420" />
                        </ScrollViewer>
                    </syncfusion:TabItemExt>
                </syncfusion:TabControlExt>
            </Border>
        </Grid>
    </Grid>
</UserControl>
