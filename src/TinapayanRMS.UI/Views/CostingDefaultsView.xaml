<UserControl x:Class="TinapayanRMS.UI.Views.CostingDefaultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:controls="clr-namespace:TinapayanRMS.UI.Controls"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="900">
    <Grid Background="{StaticResource PageBackgroundBrush}" Margin="16">
        <!-- ErrorMessage and SuccessMessage as toasts, over the card: each puts itself in the Grid's bottom-right corner -->
        <controls:ErrorToast />
        <controls:SuccessToast />

        <!--
            The two cards side by side, each as tall as its own content, 16px apart as Settings' other tabs space theirs.
            In a window narrowed below the pair's width, Stored Costs wraps under the defaults, 16px down, rather than
            being cut off, and the tab scrolls to it. Each card carries the gap on its right and below, so it's the same
            either way.
        -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Top">
                <!-- Where a new product goes, the five percentages as the Products screen's Costing tab labels them, the shop-wide wastage, then a new raw material's cost buffer -->
                <Border Width="420" Style="{StaticResource CardStyle}" Margin="0,0,16,16" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Costing Defaults" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock Style="{StaticResource CaptionStyle}"
                                   Margin="0,0,0,12"
                                   Text="Where a new product goes, what its costing starts with, and what a new raw material's cost buffer starts with: each keeps its own from its first Save, so changing these doesn't change anything saved. Wastage % is different: every product is priced with it, unless its category sets its own (Product Categories), so changing it reprices them all." />

                        <!-- One under another, each label on the left of its box (FormLabelStyle); the Auto column lines the boxes up -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="New Products In" Style="{StaticResource FormLabelStyle}" ToolTip="The folder New on the Products screen files a product in. New Product Here keeps its folder's, and a clone or variant goes in Research and Development." />
                            <syncfusion:ComboBoxAdv Grid.Column="1"
                                                    ItemsSource="{Binding Stages}"
                                                    DisplayMemberPath="Value"
                                                    SelectedValuePath="Key"
                                                    SelectedValue="{Binding EditingNewProductStage, Mode=TwoWay}" />

                            <TextBlock Grid.Row="2" Text="Labor %" Style="{StaticResource FormLabelStyle}" ToolTip="Of the sub-assemblies (ingredients) cost per piece" />
                            <syncfusion:DoubleTextBox Grid.Row="2"
                                                      Grid.Column="1"
                                                      MinValue="0"
                                                      Value="{Binding EditingLaborPercent, Converter={StaticResource DecimalValueConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="4" Text="Overhead %" Style="{StaticResource FormLabelStyle}" ToolTip="Of the sub-assemblies (ingredients) cost per piece" />
                            <syncfusion:DoubleTextBox Grid.Row="4"
                                                      Grid.Column="1"
                                                      MinValue="0"
                                                      Value="{Binding EditingOverheadPercent, Converter={StaticResource DecimalValueConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="6" Text="Administrative %" Style="{StaticResource FormLabelStyle}" ToolTip="Of the sub-assemblies (ingredients) cost per piece: office, permits, bookkeeping" />
                            <syncfusion:DoubleTextBox Grid.Row="6"
                                                      Grid.Column="1"
                                                      MinValue="0"
                                                      Value="{Binding EditingAdministrativePercent, Converter={StaticResource DecimalValueConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="8" Text="Markup %" Style="{StaticResource FormLabelStyle}" ToolTip="On the base cost: materials, wastage, labor, overhead and administrative" />
                            <syncfusion:DoubleTextBox Grid.Row="8"
                                                      Grid.Column="1"
                                                      MinValue="0"
                                                      Value="{Binding EditingMarginPercent, Converter={StaticResource DecimalValueConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="10" Text="VAT %" Style="{StaticResource FormLabelStyle}" ToolTip="On top of the marked-up price" />
                            <syncfusion:DoubleTextBox Grid.Row="10"
                                                      Grid.Column="1"
                                                      MinValue="0"
                                                      Value="{Binding EditingVatPercent, Converter={StaticResource DecimalValueConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="12" Text="Wastage %" Style="{StaticResource FormLabelStyle}" ToolTip="Every product's, not just new ones, unless its category sets its own (Product Categories): what's lost making a product, as a cost on top of its sub-assemblies (ingredients). 3% adds ₱3 to ₱100 of ingredients. Packaging isn't wasted, so it's left out." />
                            <syncfusion:DoubleTextBox Grid.Row="12"
                                                      Grid.Column="1"
                                                      MinValue="0"
                                                      MaxValue="100"
                                                      NumberDecimalDigits="2"
                                                      Value="{Binding EditingWastagePercent, Converter={StaticResource DecimalValueConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="14" Text="Cost Buffer %" Style="{StaticResource FormLabelStyle}" ToolTip="What a new raw material's Cost Buffer % starts at: a cushion on top of its cost for price swings and waste" />
                            <syncfusion:DoubleTextBox Grid.Row="14"
                                                      Grid.Column="1"
                                                      MinValue="0"
                                                      MaxValue="100"
                                                      NumberDecimalDigits="2"
                                                      Value="{Binding EditingCostBufferPercent, Converter={StaticResource DecimalValueConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="16" Text="Price Rounding" Style="{StaticResource FormLabelStyle}" ToolTip="A suggested price rounded up to a price you'd charge, shown beside the exact one on the Costing tab, in Reports and in the Price Simulator. The exact figures don't change." />
                            <syncfusion:ComboBoxAdv Grid.Row="16"
                                                    Grid.Column="1"
                                                    ItemsSource="{Binding PriceRoundingOptions}"
                                                    DisplayMemberPath="Label"
                                                    SelectedItem="{Binding EditingPriceRounding, Mode=TwoWay}" />
                        </Grid>

                        <syncfusion:ButtonAdv Label="Save"
                                              HorizontalAlignment="Left"
                                              Margin="0,16,0,0"
                                              IconTemplate="{StaticResource SaveIconTemplate}"
                                              Command="{Binding SaveCommand}" />
                    </StackPanel>
                </Border>

                <!--
                    The stored costs worked out again, from what they're made of: each Save keeps them right as it goes, so this is
                    for after the database was changed outside the app. The toast says how many were out of date.
                -->
                <Border Width="420" Style="{StaticResource CardStyle}" Margin="0,0,16,16" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Stored Costs" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock Style="{StaticResource CaptionStyle}"
                                   Margin="0,0,0,12"
                                   Text="Each Save keeps made and linked ingredients' costs, and sub-assemblies' totals, up to date. If the database was changed outside the app, work them all out again from what they're made of." />
                        <syncfusion:ButtonAdv Label="Recalculate Costs"
                                              HorizontalAlignment="Left"
                                              IconTemplate="{StaticResource CalculateIconTemplate}"
                                              Command="{Binding RecalculateCostsCommand}" />
                    </StackPanel>
                </Border>
            </WrapPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
