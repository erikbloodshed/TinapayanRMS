<UserControl x:Class="TinapayanRMS.UI.Views.PriceSimulatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:controls="clr-namespace:TinapayanRMS.UI.Controls"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1400">
    <!-- Two cards, 4px from the page's edge and 4px apart, as on Raw Materials: the changes tried, then what they do -->
    <Grid Background="{StaticResource PageBackgroundBrush}" Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="4" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            The saved scenarios on the left, the changes tried on the right. They share rows, so the two headings, captions
            and tables line up whichever caption wraps further.
        -->
        <Border Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Scenarios" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" />
                    <syncfusion:ButtonAdv Grid.Column="1"
                                          Label="Save Scenario"
                                          IconTemplate="{StaticResource SaveIconTemplate}"
                                          Command="{Binding SaveScenarioCommand}"
                                          ToolTip="Saves the price changes in the table under a name, to open here again. No real price changes."
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0" />
                    <syncfusion:ButtonAdv Grid.Column="2"
                                          Label="Delete Scenario"
                                          IconTemplate="{StaticResource DeleteIconTemplate}"
                                          Command="{Binding DeleteScenarioCommand}"
                                          ToolTip="Deletes the open scenario. Its price changes stay in the table."
                                          VerticalAlignment="Center" />
                </Grid>
                <TextBlock Grid.Row="1"
                           Style="{StaticResource CaptionStyle}"
                           Margin="0,0,0,12"
                           Text="The price changes saved under a name, newest first. Click one to open it: its changes replace the table's." />
                <!-- Clicking a scenario opens it (PriceSimulatorViewModel.SelectedScenario), as tall as the table it fills -->
                <syncfusion:SfDataGrid x:Name="ScenariosGrid"
                                       Grid.Row="2"
                                       ItemsSource="{Binding Scenarios}"
                                       SelectedItem="{Binding SelectedScenario, Mode=TwoWay}"
                                       AutomationProperties.Name="Scenarios"
                                       GridLinesVisibility="Both"
                                       CurrentCellBorderBrush="{StaticResource AccentBrush}"
                                       CurrentCellBorderThickness="1"
                                       controls:GridFillerRows.IsEnabled="True"
                                       AutoGenerateColumns="False"
                                       AllowEditing="False"
                                       AllowSorting="False"
                                       SelectionMode="Single"
                                       NavigationMode="Row"
                                       ColumnSizer="Star"
                                       Height="200">
                    <syncfusion:SfDataGrid.Columns>
                        <syncfusion:GridDateTimeColumn MappingName="SavedAt" HeaderText="Saved" Pattern="CustomPattern" CustomPattern="MMM d, yyyy  h:mm tt" Width="170" />
                        <syncfusion:GridTextColumn MappingName="Name" HeaderText="Name" />
                    </syncfusion:SfDataGrid.Columns>
                </syncfusion:SfDataGrid>

                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Price Changes" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" />
                    <syncfusion:ButtonAdv Grid.Column="1"
                                          Label="Remove Line"
                                          IconTemplate="{StaticResource RemoveIconTemplate}"
                                          Command="{Binding RemoveChangeCommand}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0" />
                    <syncfusion:ButtonAdv Grid.Column="2"
                                          Label="Clear All"
                                          IconTemplate="{StaticResource CancelIconTemplate}"
                                          Command="{Binding ClearCommand}"
                                          ToolTip="Takes every price change away, so the figures are today's again, and closes the open scenario."
                                          VerticalAlignment="Center" />
                </Grid>
                <TextBlock Grid.Row="1"
                           Grid.Column="2"
                           Style="{StaticResource CaptionStyle}"
                           Margin="0,0,0,12"
                           Text="Pick a raw material and type how much its price changes, in percent, or its new price; the other is worked out. Prices are per the unit it's bought in. No real price changes here: the changes last while the app is open, and Save Scenario keeps them under a name to open again. A saved percentage goes on the price as it is when you open the scenario." />
                <syncfusion:SfDataGrid x:Name="ChangesGrid"
                                       Grid.Row="2"
                                       Grid.Column="2"
                                       ItemsSource="{Binding Changes}"
                                       SelectedItem="{Binding SelectedChange, Mode=TwoWay}"
                                       controls:NumericEditing.IsEnabled="True"
                                       GridLinesVisibility="Both"
                                       CurrentCellBorderBrush="{StaticResource AccentBrush}"
                                       CurrentCellBorderThickness="1"
                                       controls:GridFillerRows.IsEnabled="True"
                                       ShowRowHeader="True"
                                       AutoGenerateColumns="False"
                                       AllowEditing="True"
                                       AllowDeleting="True"
                                       EditTrigger="OnTap"
                                       AddNewRowPosition="Bottom"
                                       SelectionMode="Single"
                                       ColumnSizer="Star"
                                       controls:GridEditCommit.OnFocusLeave="True"
                                       controls:GridAddNewRow.DropWhenUntouched="True"
                                       controls:AutoCompleteDropDown.IsEnabled="True"
                                       controls:GridAddNewRow.ItemFactory="{Binding NewChange}"
                                       Height="200">
                    <syncfusion:SfDataGrid.Columns>
                        <syncfusion:GridMultiColumnDropDownList MappingName="MaterialId"
                                                                HeaderText="Raw Material"
                                                                ItemsSource="{Binding Materials}"
                                                                DisplayMember="Name"
                                                                ValueMember="Id"
                                                                AllowAutoComplete="True"
                                                                AllowNullInput="True"
                                                                AllowIncrementalFiltering="True"
                                                                SearchCondition="Contains"
                                                                AutoGenerateColumns="False"
                                                                IsAutoPopupSize="False"
                                                                PopUpWidth="380"
                                                                PopUpHeight="260"
                                                                GridColumnSizer="Star">
                            <syncfusion:GridMultiColumnDropDownList.Columns>
                                <syncfusion:Columns>
                                    <syncfusion:GridTextColumn MappingName="Name" HeaderText="Raw Material" />
                                    <syncfusion:GridTextColumn MappingName="Category.Name" HeaderText="Category" Width="120" />
                                </syncfusion:Columns>
                            </syncfusion:GridMultiColumnDropDownList.Columns>
                        </syncfusion:GridMultiColumnDropDownList>
                        <syncfusion:GridTextColumn MappingName="UnitName" HeaderText="Per" Width="120" AllowEditing="False" AllowFocus="False" />
                        <controls:NumericColumn MappingName="CurrentPrice" HeaderText="Current Price" NumberDecimalDigits="2" Width="120" AllowEditing="False" AllowFocus="False" AllowNullValue="True" />
                        <controls:NumericColumn MappingName="NewPrice" HeaderText="New Price" NumberDecimalDigits="2" Width="120" AllowNullValue="True" />
                        <controls:NumericColumn MappingName="ChangePercent" HeaderText="Change %" NumberDecimalDigits="2" Width="110" AllowNullValue="True" />
                    </syncfusion:SfDataGrid.Columns>
                </syncfusion:SfDataGrid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <DockPanel>
                <Grid DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Products" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" />
                        <!-- While the figures are unbuffered, so none is taken for the usual, buffered one, as on Products -->
                        <Border Style="{StaticResource LinkedBadgeStyle}"
                                ToolTip="Every figure in this table, the report and the export is at the materials' true costs, without their cost buffers. Buffered switches back."
                                Visibility="{Binding IsUnbuffered, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Unbuffered costs" FontSize="13" Foreground="{StaticResource WarningForegroundBrush}" />
                        </Border>
                    </StackPanel>
                    <!-- Syncfusion has no check box of its own outside its grids and ribbon; the Keyboard tab uses WPF's too -->
                    <CheckBox Grid.Column="1"
                              Content="Only affected products"
                              IsChecked="{Binding OnlyAffected, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0" />
                    <!-- Named for the costs it switches to: Unbuffered, then Buffered. The badge beside the heading says which show. -->
                    <syncfusion:ButtonAdv Grid.Column="2"
                                          Label="{Binding CostBasisButtonLabel}"
                                          IconTemplate="{StaticResource CalculateIconTemplate}"
                                          Command="{Binding ToggleCostBasisCommand}"
                                          ToolTip="{Binding CostBasisButtonTooltip}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0" />
                    <!-- Writes: each product's Current Price to its Price to Charge, after a question that says how many -->
                    <syncfusion:ButtonAdv Grid.Column="4"
                                          Label="Set Current Prices"
                                          IconTemplate="{StaticResource ApplyIconTemplate}"
                                          Command="{Binding SetCurrentPricesCommand}"
                                          ToolTip="Sets the Current Price of the products picked, or of every product shown, to its Price to Charge: only those a change reaches. Asks first. The raw material prices don't change."
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0" />
                    <syncfusion:ButtonAdv Grid.Column="3"
                                          Label="Print Report"
                                          IconTemplate="{StaticResource PrintIconTemplate}"
                                          Command="{Binding PrintCommand}"
                                          ToolTip="Previews and prints each product's recipe and costing with the price changes, beside today's: the products picked in the table, or every product it shows."
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0" />
                    <syncfusion:ButtonAdv Grid.Column="5"
                                          Label="Export to Excel"
                                          IconTemplate="{StaticResource ExportIconTemplate}"
                                          Command="{Binding ExportCommand}"
                                          ToolTip="Saves the products as shown, and the price changes, to an Excel workbook."
                                          VerticalAlignment="Center" />
                </Grid>
                <TextBlock DockPanel.Dock="Top"
                           Style="{StaticResource CaptionStyle}"
                           Margin="0,0,0,12"
                           Text="Every product for one sellable unit, now and with the price changes, at buffered costs; Unbuffered shows them at the materials' true costs instead, and Print Report and Export to Excel follow. A change reaches made and linked ingredients as a real one would, and moves a material's cost and buffered cost by the same amount. Markup % is what the product's current price earns, and Price to Keep Markup the price that earns today's markup with the changes. Double-click a product to open it. Click a product, or several with Ctrl or Shift held, for Print Report to print only those." />
                <syncfusion:SfDataGrid x:Name="ProductsGrid"
                                       ItemsSource="{Binding Products}"
                                       CellDoubleTapped="Products_CellDoubleTapped"
                                       controls:GridHeaderHeight.Lines="3"
                                       controls:GridHeaderAlignment.IsBottom="True"
                                       controls:CheckboxFilterFill.IsEnabled="True"
                                       FrozenColumnCount="1"
                                       GridLinesVisibility="Both"
                                       CurrentCellBorderBrush="{StaticResource AccentBrush}"
                                       CurrentCellBorderThickness="1"
                                       controls:GridFillerRows.IsEnabled="True"
                                       AutoGenerateColumns="False"
                                       AllowEditing="False"
                                       AllowSorting="True"
                                       SelectionMode="Extended"
                                       NavigationMode="Row"
                                       ColumnSizer="Star">
                    <syncfusion:SfDataGrid.FilterPopupStyle>
                        <Style TargetType="syncfusion:GridFilterControl">
                            <Setter Property="FilterMode" Value="CheckboxFilter" />
                            <Setter Property="SortOptionVisibility" Value="Collapsed" />
                            <Setter Property="FilterPopupWidth" Value="340" />
                        </Style>
                    </syncfusion:SfDataGrid.FilterPopupStyle>
                    <syncfusion:SfDataGrid.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Right" />
                        </DataTemplate>
                    </syncfusion:SfDataGrid.HeaderTemplate>
                    <syncfusion:SfDataGrid.Columns>
                        <syncfusion:GridTextColumn MappingName="ProductName" HeaderText="Product" Width="220" AllowFiltering="True" />
                        <syncfusion:GridTextColumn MappingName="Category" HeaderText="Category" MinimumWidth="120" AllowFiltering="True" />
                        <controls:NumericColumn MappingName="RawMaterialCost" HeaderText="Raw Material Cost" NumberDecimalDigits="2" />
                        <controls:NumericColumn MappingName="SimulatedRawMaterialCost" HeaderText="Simulated Raw Material Cost" NumberDecimalDigits="2" />
                        <controls:NumericColumn MappingName="RawMaterialChangePercent" HeaderText="Change %" NumberDecimalDigits="2" />
                        <controls:NumericColumn MappingName="BaseCost" HeaderText="Base Cost" NumberDecimalDigits="2" />
                        <controls:NumericColumn MappingName="SimulatedBaseCost" HeaderText="Simulated Base Cost" NumberDecimalDigits="2" />
                        <controls:NumericColumn MappingName="ChangePercent" HeaderText="Change %" NumberDecimalDigits="2" />
                        <controls:NumericColumn MappingName="SuggestedPrice" HeaderText="Suggested Price" NumberDecimalDigits="2" />
                        <controls:NumericColumn MappingName="SimulatedSuggestedPrice" HeaderText="Simulated Suggested Price" NumberDecimalDigits="2" />
                        <controls:NumericColumn MappingName="CurrentPrice" HeaderText="Current Price" NumberDecimalDigits="2" AllowNullValue="True" />
                        <controls:NumericColumn MappingName="MarkupPercent" HeaderText="Markup %" NumberDecimalDigits="2" AllowNullValue="True" />
                        <controls:NumericColumn MappingName="SimulatedMarkupPercent" HeaderText="Simulated Markup %" NumberDecimalDigits="2" AllowNullValue="True" />
                        <controls:NumericColumn MappingName="PriceToKeepMarkup" HeaderText="Price to Keep Markup" NumberDecimalDigits="2" AllowNullValue="True" />
                        <controls:NumericColumn MappingName="PriceToCharge" HeaderText="Price to Charge" NumberDecimalDigits="2" AllowNullValue="True" />
                    </syncfusion:SfDataGrid.Columns>
                </syncfusion:SfDataGrid>
            </DockPanel>
        </Border>

        <controls:ErrorToast Grid.RowSpan="3" />
        <controls:SuccessToast Grid.RowSpan="3" />
    </Grid>
</UserControl>
