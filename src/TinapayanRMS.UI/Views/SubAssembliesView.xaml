<UserControl x:Class="TinapayanRMS.UI.Views.SubAssembliesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:controls="clr-namespace:TinapayanRMS.UI.Controls"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="1400">
    <UserControl.Resources>
        <!--
            The percentage column's header, "Baker's %" or "Absolute %" (PercentHeader). A template binding the view's own
            DataContext, not HeaderText="{Binding}": a bound HeaderText reaches the header cell only through the grid's
            row generator, which left each Recipe Structure tab's grid showing the header of the tab shown before it.
        -->
        <DataTemplate x:Key="PercentHeaderTemplate">
            <TextBlock Text="{Binding DataContext.PercentHeader, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </DataTemplate>
        <!--
            A header figure's value, under its label (FigureTileLabelStyle), sized as the Products and Raw Materials
            headers' figures are, and centred in the figure's tile as theirs are (2026-09-25, at the user's request)
        -->
        <Style x:Key="TotalValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource HeadingForegroundBrush}" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="6,0,6,8" />
        </Style>
    </UserControl.Resources>

    <!--
        Standalone sub-assemblies, which no product owns: the list beside the one being edited. Products
        link them (and follow every change saved here) or copy them, from their recipe. The list is as
        wide as its columns (Auto), and the form takes the rest. Cards are 4px apart and 4px from the page's
        edge, as on Raw Materials.
    -->
    <Grid Background="{StaticResource PageBackgroundBrush}" Margin="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ErrorMessage and SuccessMessage as toasts, over the cards, in the Grid's bottom-right corner -->
        <controls:ErrorToast Grid.ColumnSpan="3" />
        <controls:SuccessToast Grid.ColumnSpan="3" />

        <Border Grid.Column="0" Style="{StaticResource CardStyle}">
            <DockPanel>
                <!-- Title and search on one row, laid out as the Raw Materials and Products list cards lay out their own -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <syncfusion:SfTextBoxExt DockPanel.Dock="Right"
                                             Width="190"
                                             Watermark="Search sub-assembly"
                                             WatermarkTemplate="{StaticResource AlignedWatermarkTemplate}"
                                             Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Sub-Assemblies"
                               Style="{StaticResource SectionHeaderStyle}"
                               Margin="0"
                               VerticalAlignment="Center" />
                </DockPanel>

                <!-- Fixed widths, so the card is as wide as its columns and never cuts one off -->
                <syncfusion:SfDataGrid x:Name="List"
                                       ItemsSource="{Binding VisibleRows}"
                                       SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                                       GridLinesVisibility="Both"
                                       CurrentCellBorderBrush="{StaticResource AccentBrush}"
                                       CurrentCellBorderThickness="1"
                                       controls:GridFillerRows.IsEnabled="True"
                                       AutoGenerateColumns="False"
                                       AllowEditing="False"
                                       SelectionMode="Single"
                                       NavigationMode="Row">
                    <syncfusion:SfDataGrid.Columns>
                        <!--
                            The Raw Materials list's width in all, so the three lists are the same width, but more of it for
                            the name: one saved from a product is named after it and its role ("Almond Cheese Bread
                            Filling: Cheesy Corn Custard"), and a role is one short word. The tooltip shows a name cut short.
                        -->
                        <syncfusion:GridTextColumn MappingName="Name" HeaderText="Name" Width="260" ShowToolTip="True" />
                        <syncfusion:GridTextColumn MappingName="RoleName" HeaderText="Role" Width="110" />
                    </syncfusion:SfDataGrid.Columns>
                </syncfusion:SfDataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource CardStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,14,0">
                <StackPanel>
                    <!-- Title and caption beside New, Save and Delete -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding HeaderTitle}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource HeadingForegroundBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <syncfusion:ButtonAdv Label="New" IconTemplate="{StaticResource AddIconTemplate}" Command="{Binding NewCommand}" Margin="0,0,8,0" />
                            <syncfusion:ButtonAdv Label="Save"
                                                  IconTemplate="{StaticResource SaveIconTemplate}"
                                                  Command="{Binding SaveCommand}"
                                                  ToolTip="Saves the name, role and lines together."
                                                  Margin="0,0,8,0" />
                            <syncfusion:ButtonAdv Label="Undo"
                                                  IconTemplate="{StaticResource UndoIconTemplate}"
                                                  Command="{Binding UndoCommand}"
                                                  ToolTip="Takes back the last change: a quantity typed, a line added or removed. Ctrl+Z."
                                                  Margin="0,0,8,0" />
                            <syncfusion:ButtonAdv Label="Redo"
                                                  IconTemplate="{StaticResource RedoIconTemplate}"
                                                  Command="{Binding RedoCommand}"
                                                  ToolTip="Puts back the change the last Undo took. Ctrl+Y."
                                                  Margin="0,0,8,0" />
                            <syncfusion:ButtonAdv Label="Delete" IconTemplate="{StaticResource DeleteIconTemplate}" Command="{Binding DeleteCommand}" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource SectionDividerStyle}" />

                    <!--
                        The batch totals first, each label over its figure as the other headers' figures are; then the
                        fields 16 under them, each label on the left of its field (FormLabelStyle; 2026-09-24, at the
                        user's request, as the Products header has them). They shared one row, labels above, until then.
                        The figures take equal shares of the width (2026-09-25, at the user's request, as the Raw
                        Materials and Products headers lay theirs out), each on a tile of its own colour with a gap
                        between each (a thin line until later that day); they sat packed at the left, 24 apart, before.
                        A packaging set's Set Cost stands alone in the first share, with the gaps hidden.
                    -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Each figure's tile, in the colour its kind of figure has on every screen (FigureTileStyle) -->
                        <Border Grid.Column="0"
                                Grid.RowSpan="2"
                                Style="{StaticResource FigureTileStyle}"
                                Background="{StaticResource TealTileBrush}"
                                Visibility="{Binding IsPackaging, Converter={StaticResource EmptyStateVisibilityConverter}}" />
                        <Border Grid.Column="0"
                                Grid.RowSpan="2"
                                Style="{StaticResource FigureTileStyle}"
                                Background="{StaticResource FlamingoTileBrush}"
                                Visibility="{Binding IsPackaging, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Border Grid.Column="2"
                                Grid.RowSpan="2"
                                Style="{StaticResource FigureTileStyle}"
                                Background="{StaticResource FlamingoTileBrush}"
                                Visibility="{Binding IsPackaging, Converter={StaticResource EmptyStateVisibilityConverter}}" />
                        <Border Grid.Column="4"
                                Grid.RowSpan="2"
                                Style="{StaticResource FigureTileStyle}"
                                Background="{StaticResource YellowTileBrush}"
                                Visibility="{Binding IsPackaging, Converter={StaticResource EmptyStateVisibilityConverter}}" />

                        <Border Grid.Column="1"
                                Grid.RowSpan="2"
                                Style="{StaticResource FigureTileGapStyle}"
                                Visibility="{Binding IsPackaging, Converter={StaticResource EmptyStateVisibilityConverter}}" />
                        <Border Grid.Column="3"
                                Grid.RowSpan="2"
                                Style="{StaticResource FigureTileGapStyle}"
                                Visibility="{Binding IsPackaging, Converter={StaticResource EmptyStateVisibilityConverter}}" />

                        <!-- A recipe's batch totals; a packaging set has its set cost in their place -->
                        <TextBlock Grid.Column="0"
                                   Text="Batch Weight"
                                   Style="{StaticResource FigureTileLabelStyle}"
                                   Visibility="{Binding IsPackaging, Converter={StaticResource EmptyStateVisibilityConverter}}" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="{Binding BatchWeight, StringFormat='{}{0:#,0.##} g'}"
                                   Style="{StaticResource TotalValueStyle}"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsPackaging, Converter={StaticResource EmptyStateVisibilityConverter}}" />

                        <TextBlock Grid.Column="2"
                                   Text="Batch Cost"
                                   Style="{StaticResource FigureTileLabelStyle}"
                                   Visibility="{Binding IsPackaging, Converter={StaticResource EmptyStateVisibilityConverter}}" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="2"
                                   Text="{Binding BatchCost, StringFormat='{}{0:N2}'}"
                                   Style="{StaticResource TotalValueStyle}"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsPackaging, Converter={StaticResource EmptyStateVisibilityConverter}}" />

                        <TextBlock Grid.Column="4"
                                   Text="Cost per g"
                                   Style="{StaticResource FigureTileLabelStyle}"
                                   Visibility="{Binding IsPackaging, Converter={StaticResource EmptyStateVisibilityConverter}}" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="4"
                                   Text="{Binding CostPerGram, StringFormat='{}{0:N4}'}"
                                   Style="{StaticResource TotalValueStyle}"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsPackaging, Converter={StaticResource EmptyStateVisibilityConverter}}" />

                        <!-- A packaging set's one figure, first in the row: the recipe totals are collapsed beside it -->
                        <TextBlock Grid.Column="0"
                                   Text="Set Cost"
                                   Style="{StaticResource FigureTileLabelStyle}"
                                   Visibility="{Binding IsPackaging, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="{Binding SetCost, StringFormat='{}{0:N4}'}"
                                   Style="{StaticResource TotalValueStyle}"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsPackaging, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Name" Style="{StaticResource FormLabelStyle}" />
                        <syncfusion:SfTextBoxExt Grid.Column="1"
                                                 controls:FieldUndoStep.Recorder="{Binding}"
                                                 Text="{Binding EditingName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Column="3" Text="Role" Style="{StaticResource FormLabelStyle}" />
                        <syncfusion:ComboBoxAdv Grid.Column="4"
                                                ItemsSource="{Binding Roles}"
                                                DisplayMemberPath="Name"
                                                controls:FieldUndoStep.Recorder="{Binding}"
                                                SelectedItem="{Binding EditingRole, Mode=TwoWay}" />
                    </Grid>

                    <TextBlock Text="Lines" Style="{StaticResource PanelHeaderStyle}" Margin="0,16,0,8" />

                    <!--
                        A packaging set's lines: how much of each material one set takes, in its base unit. The same
                        columns as a product's Packaging tab, which a product linking the set shows them in, one set per sellable unit.
                    -->
                    <syncfusion:SfDataGrid ItemsSource="{Binding PackagingLines}"
                                           controls:GridUndoSteps.Recorder="{Binding}"
                                           controls:GridRowReordering.IsEnabled="True"
                                           controls:NumericEditing.IsEnabled="True"
                                           Visibility="{Binding IsPackaging, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           SelectedItem="{Binding SelectedPackagingLine, Mode=TwoWay}"
                                           GridLinesVisibility="Both"
                                           CurrentCellBorderBrush="{StaticResource AccentBrush}"
                                           CurrentCellBorderThickness="1"
                                           controls:GridFillerRows.IsEnabled="True"
                                           ShowRowHeader="True"
                                           AutoGenerateColumns="False"
                                           AllowEditing="True"
                                           AllowDeleting="True"
                                           EditTrigger="OnTap"
                                           AddNewRowPosition="Bottom"
                                           SelectionMode="Single"
                                           ColumnSizer="Star"
                                           controls:GridEditCommit.OnFocusLeave="True"
                                           controls:GridAddNewRow.DropWhenUntouched="True"
                                           controls:AutoCompleteDropDown.IsEnabled="True"
                                           controls:GridAddNewRow.ItemFactory="{Binding NewPackagingLine}"
                                           Height="280">
                        <syncfusion:SfDataGrid.Columns>
                            <!-- Typing opens the list of names containing the text and picks one: the first starting with it, else the first containing it -->
                            <syncfusion:GridMultiColumnDropDownList MappingName="PackagingMaterialId"
                                                                    HeaderText="Material"
                                                                    ItemsSource="{Binding PackagingMaterials}"
                                                                    DisplayMember="Name"
                                                                    ValueMember="Id"
                                                                    AllowAutoComplete="True"
                                                                    AllowNullInput="True"
                                                                    AllowIncrementalFiltering="True"
                                                                    SearchCondition="Contains"
                                                                    AutoGenerateColumns="False"
                                                                    IsAutoPopupSize="False"
                                                                    PopUpWidth="380"
                                                                    PopUpHeight="260"
                                                                    GridColumnSizer="Star">
                                <syncfusion:GridMultiColumnDropDownList.Columns>
                                    <syncfusion:Columns>
                                        <syncfusion:GridTextColumn MappingName="Name" HeaderText="Material" />
                                        <syncfusion:GridTextColumn MappingName="Category.Name" HeaderText="Category" Width="100" />
                                        <syncfusion:GridTextColumn MappingName="BaseUnit.Abbreviation" HeaderText="Unit" Width="52" />
                                        <controls:NumericColumn MappingName="BufferedCostPerBaseUnit" HeaderText="Cost per Unit" Width="96" NumberDecimalDigits="4" />
                                    </syncfusion:Columns>
                                </syncfusion:GridMultiColumnDropDownList.Columns>
                            </syncfusion:GridMultiColumnDropDownList>
                            <controls:NumericColumn MappingName="QtyPerUnit" HeaderText="Qty" Width="96" NumberDecimalDigits="1" TypedDecimalDigits="4" AllowNullValue="True" />
                            <!--
                                The unit the Qty is typed in: the material's base unit, or one of its alternative units. Each row has its
                                own material, so its list comes from the row (PackagingUnitSelector). Editable, so the unit can be typed
                                as well as picked. What the quantity comes to in base units is never shown — the conversion is behind
                                the scenes, in Unit Cost (what one of the picked unit costs) and in the line's own total.
                            -->
                            <syncfusion:GridComboBoxColumn MappingName="UnitKey"
                                                           HeaderText="Unit"
                                                           Width="72"
                                                           ItemsSourceSelector="{StaticResource PackagingUnitSelector}"
                                                           DisplayMemberPath="Abbreviation"
                                                           SelectedValuePath="Key"
                                                           IsEditable="True" />
                            <controls:NumericColumn MappingName="UnitCost" HeaderText="Unit Cost" Width="88" NumberDecimalDigits="4" AllowEditing="False" />
                            <controls:NumericColumn MappingName="CostPerUnit" HeaderText="Cost per Set" Width="104" NumberDecimalDigits="4" AllowEditing="False" />
                        </syncfusion:SfDataGrid.Columns>
                    </syncfusion:SfDataGrid>

                    <!-- Typed straight into: the add row at the bottom starts a line, Delete removes the selected one -->
                    <syncfusion:SfDataGrid ItemsSource="{Binding Lines}"
                                           controls:GridUndoSteps.Recorder="{Binding}"
                                           controls:GridRowReordering.IsEnabled="True"
                                           controls:NumericEditing.IsEnabled="True"
                                           Visibility="{Binding IsPackaging, Converter={StaticResource EmptyStateVisibilityConverter}}"
                                           controls:GridAddNewRow.HideCheckBoxes="True"
                                           controls:GridCellEditing.IsEnabled="True"
                                           SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                                           GridLinesVisibility="Both"
                                           CurrentCellBorderBrush="{StaticResource AccentBrush}"
                                           CurrentCellBorderThickness="1"
                                           controls:GridFillerRows.IsEnabled="True"
                                           ShowRowHeader="True"
                                           AutoGenerateColumns="False"
                                           AllowEditing="True"
                                           AllowDeleting="True"
                                           EditTrigger="OnTap"
                                           AddNewRowPosition="Bottom"
                                           SelectionMode="Single"
                                           ColumnSizer="Star"
                                           controls:GridEditCommit.OnFocusLeave="True"
                                           controls:GridAddNewRow.DropWhenUntouched="True"
                                           controls:AutoCompleteDropDown.IsEnabled="True"
                                           controls:GridAddNewRow.ItemFactory="{Binding NewLine}"
                                           Height="280">
                        <syncfusion:SfDataGrid.Columns>
                            <!-- Typing opens the list of names containing the text and picks one: the first starting with it, else the first containing it -->
                            <syncfusion:GridMultiColumnDropDownList MappingName="IngredientId"
                                                                    HeaderText="Ingredient"
                                                                    ItemsSource="{Binding Ingredients}"
                                                                    DisplayMember="Name"
                                                                    ValueMember="Id"
                                                                    AllowAutoComplete="True"
                                                                    AllowNullInput="True"
                                                                    AllowIncrementalFiltering="True"
                                                                    SearchCondition="Contains"
                                                                    AutoGenerateColumns="False"
                                                                    IsAutoPopupSize="False"
                                                                    PopUpWidth="380"
                                                                    PopUpHeight="260"
                                                                    GridColumnSizer="Star">
                                <syncfusion:GridMultiColumnDropDownList.Columns>
                                    <syncfusion:Columns>
                                        <syncfusion:GridTextColumn MappingName="Name" HeaderText="Ingredient" />
                                        <syncfusion:GridTextColumn MappingName="Category.Name" HeaderText="Category" Width="100" />
                                        <controls:NumericColumn MappingName="BufferedCostPerBaseUnit" HeaderText="Cost per g" Width="88" NumberDecimalDigits="4" />
                                    </syncfusion:Columns>
                                </syncfusion:GridMultiColumnDropDownList.Columns>
                            </syncfusion:GridMultiColumnDropDownList>
                            <controls:NumericColumn MappingName="Grams" HeaderText="Grams" Width="120" NumberDecimalDigits="1" TypedDecimalDigits="4" AllowNullValue="True" />
                            <controls:NumericColumn MappingName="Percent"
                                                    HeaderTemplate="{StaticResource PercentHeaderTemplate}"
                                                    Width="86"
                                                    NumberDecimalDigits="1"
                                                    AllowNullValue="True"
                                                    controls:GridCellEditing.AllowWhen="CanTypeBakersPercent" />
                            <controls:NumericColumn MappingName="CostPerGram" HeaderText="Cost per g" Width="120" NumberDecimalDigits="4" AllowEditing="False" />
                            <controls:NumericColumn MappingName="Cost" HeaderText="Cost" Width="120" NumberDecimalDigits="2" AllowEditing="False" />
                            <!-- The formula's 100% base for baker's percentage, usually the flour; more than one can be ticked. -->
                            <syncfusion:GridCheckBoxColumn MappingName="IsFormulaBase"
                                                           HeaderText="Base"
                                                           Width="54"
                                                           HorizontalHeaderContentAlignment="Center" />
                        </syncfusion:SfDataGrid.Columns>
                    </syncfusion:SfDataGrid>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <!-- What the percentages are read against, and the figure a batch is scaled by. -->
                            <TextBlock Text="{Binding FormulaBaseCaption}"
                                       Style="{StaticResource CaptionStyle}"
                                       Visibility="{Binding IsPackaging, Converter={StaticResource EmptyStateVisibilityConverter}}" />
                            <TextBlock Text="A product whose packaging links this set takes one whole set per sellable unit."
                                       Style="{StaticResource CaptionStyle}"
                                       Visibility="{Binding IsPackaging, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                        <syncfusion:ButtonAdv Grid.Column="1" Label="Remove Line" IconTemplate="{StaticResource RemoveIconTemplate}" Command="{Binding RemoveLineCommand}" />
                    </Grid>

                    <Border Style="{StaticResource SectionDividerStyle}" />

                    <TextBlock Text="Used By" Style="{StaticResource PanelHeaderStyle}" Margin="0,0,0,8" />

                    <!-- One tile per product linking it (UsedByTilesStyle), which opens it on the Products screen -->
                    <ItemsControl ItemsSource="{Binding UsedBy}" Style="{StaticResource UsedByTilesStyle}" />

                    <TextBlock Text="{Binding UsedByText}" Style="{StaticResource CaptionStyle}" Margin="0,2,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
