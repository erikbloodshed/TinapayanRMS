<UserControl x:Class="TinapayanRMS.UI.Views.SubAssembliesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:controls="clr-namespace:TinapayanRMS.UI.Controls"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1300">
    <Grid Background="{StaticResource PageBackgroundBrush}" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <controls:StatusBanner Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,12" />

        <!-- Sub-assemblies list -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Sub-Assemblies" Style="{StaticResource SectionHeaderStyle}" />

                <syncfusion:SfDataGrid Grid.Row="1"
                                        ItemsSource="{Binding SubAssemblies}"
                                        SelectedItem="{Binding SelectedSubAssembly, Mode=TwoWay}"
                                        AutoGenerateColumns="False"
                                        AllowEditing="False"
                                        SelectionMode="Single"
                                        NavigationMode="Row"
                                        ColumnSizer="AutoWithLastColumnFill">
                    <syncfusion:SfDataGrid.Columns>
                        <syncfusion:GridTextColumn MappingName="Name" HeaderText="Name" />
                        <syncfusion:GridTextColumn MappingName="Role.Name" HeaderText="Role" />
                        <controls:NumericColumn MappingName="TotalWeight" HeaderText="Total Weight (g)" NumberDecimalDigits="2" />
                        <controls:NumericColumn MappingName="TotalCost" HeaderText="Total Cost" NumberDecimalDigits="2" />
                    </syncfusion:SfDataGrid.Columns>
                </syncfusion:SfDataGrid>
            </Grid>
        </Border>

        <!-- Right rail: details, lines, lookups -->
        <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Details" Style="{StaticResource SectionHeaderStyle}" />

                        <TextBlock Text="Name" Style="{StaticResource FieldLabelStyle}" />
                        <syncfusion:SfTextBoxExt Text="{Binding EditingName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Margin="0,0,0,12" />

                        <TextBlock Text="Role" Style="{StaticResource FieldLabelStyle}" />
                        <syncfusion:ComboBoxAdv ItemsSource="{Binding Roles}"
                                                 DisplayMemberPath="Name"
                                                 SelectedItem="{Binding EditingRole, Mode=TwoWay}"
                                                 Margin="0,0,0,12" />

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <syncfusion:ButtonAdv Label="New" IconTemplate="{StaticResource AddIconTemplate}" Command="{Binding NewCommand}" Margin="0,0,8,0" />
                            <syncfusion:ButtonAdv Label="Save" IconTemplate="{StaticResource SaveIconTemplate}" Command="{Binding SaveCommand}" Margin="0,0,8,0" />
                            <syncfusion:ButtonAdv Label="Delete" IconTemplate="{StaticResource DeleteIconTemplate}" Command="{Binding DeleteCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16" MinHeight="120"
                        Visibility="{Binding SelectedSubAssembly, Converter={StaticResource EmptyStateVisibilityConverter}}">
                    <TextBlock Text="Select a sub-assembly to edit its lines." Style="{StaticResource EmptyStateStyle}" />
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"
                        Visibility="{Binding ShowLinesEditor, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Lines" Style="{StaticResource SectionHeaderStyle}" />

                        <syncfusion:SfDataGrid ItemsSource="{Binding LineEdits}"
                                                SelectedItem="{Binding SelectedLineEdit, Mode=TwoWay}"
                                                AutoGenerateColumns="False"
                                                AllowEditing="False"
                                                SelectionMode="Single"
                                                NavigationMode="Row"
                                                ColumnSizer="Star"
                                                Height="220">
                            <syncfusion:SfDataGrid.Columns>
                                <syncfusion:GridTextColumn MappingName="Ingredient.Name" HeaderText="Ingredient" />
                                <controls:NumericColumn MappingName="Quantity" HeaderText="Qty" NumberDecimalDigits="2" />
                                <syncfusion:GridTextColumn MappingName="Unit.Abbreviation" HeaderText="Unit" Padding="12,0,0,0" />
                                <controls:NumericColumn MappingName="Grams" HeaderText="Grams" NumberDecimalDigits="2" />
                                <controls:NumericColumn MappingName="Cost" HeaderText="Cost" NumberDecimalDigits="2" />
                            </syncfusion:SfDataGrid.Columns>
                        </syncfusion:SfDataGrid>

                        <TextBlock Text="Ingredient" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,4" />
                        <syncfusion:ComboBoxAdv ItemsSource="{Binding Ingredients}"
                                                 DisplayMemberPath="Name"
                                                 SelectedItem="{Binding EditingLineIngredient, Mode=TwoWay}"
                                                 Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Quantity" Style="{StaticResource FieldLabelStyle}" />
                                <syncfusion:DoubleTextBox Value="{Binding EditingLineQuantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Unit" Style="{StaticResource FieldLabelStyle}" />
                                <syncfusion:ComboBoxAdv ItemsSource="{Binding LineUnitOptions}"
                                                         DisplayMemberPath="Name"
                                                         SelectedItem="{Binding EditingLineUnit, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <syncfusion:ButtonAdv Label="Add Line" IconTemplate="{StaticResource AddIconTemplate}" Command="{Binding AddLineCommand}" Margin="0,0,8,0" />
                            <syncfusion:ButtonAdv Label="Remove Line" IconTemplate="{StaticResource RemoveIconTemplate}" Command="{Binding RemoveLineCommand}" />
                        </StackPanel>

                        <syncfusion:ButtonAdv Label="Save Lines" IconTemplate="{StaticResource SaveIconTemplate}" Command="{Binding SaveLinesCommand}" />
                    </StackPanel>
                </Border>

                <Expander Header="Manage roles" IsExpanded="False">
                    <Border Style="{StaticResource CardStyle}" Margin="0,8,0,0">
                        <StackPanel>
                            <syncfusion:SfDataGrid ItemsSource="{Binding Roles}"
                                                    SelectedItem="{Binding SelectedRole, Mode=TwoWay}"
                                                    AutoGenerateColumns="False"
                                                    AllowEditing="False"
                                                    SelectionMode="Single"
                                                    NavigationMode="Row"
                                                    ColumnSizer="Star"
                                                    Height="180">
                                <syncfusion:SfDataGrid.Columns>
                                    <syncfusion:GridTextColumn MappingName="Name" HeaderText="Name" />
                                    <controls:NumericColumn MappingName="SortOrder" HeaderText="Order" NumberDecimalDigits="0" />
                                </syncfusion:SfDataGrid.Columns>
                            </syncfusion:SfDataGrid>

                            <TextBlock Text="Name" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,4" />
                            <syncfusion:SfTextBoxExt Text="{Binding EditingRoleName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Margin="0,0,0,12" />

                            <TextBlock Text="Sort Order" Style="{StaticResource FieldLabelStyle}" />
                            <syncfusion:DoubleTextBox Value="{Binding EditingRoleSortOrder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                       Margin="0,0,0,12" />

                            <StackPanel Orientation="Horizontal">
                                <syncfusion:ButtonAdv Label="New" IconTemplate="{StaticResource AddIconTemplate}" Command="{Binding NewRoleCommand}" Margin="0,0,8,0" />
                                <syncfusion:ButtonAdv Label="Save" IconTemplate="{StaticResource SaveIconTemplate}" Command="{Binding SaveRoleCommand}" Margin="0,0,8,0" />
                                <syncfusion:ButtonAdv Label="Delete" IconTemplate="{StaticResource DeleteIconTemplate}" Command="{Binding DeleteRoleCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
