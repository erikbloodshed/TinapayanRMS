<UserControl x:Class="TinapayanRMS.UI.Views.RawMaterialsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:controls="clr-namespace:TinapayanRMS.UI.Controls"
             xmlns:rm="clr-namespace:TinapayanRMS.UI.Views.RawMaterials"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="1400">
    <!--
        The list beside the selected material: its summary header, then its cards in tabs along
        the bottom. Each card is a UserControl in Views/RawMaterials that inherits this screen's
        DataContext; when a card shows is decided here. The list is as wide as its columns (Auto),
        and the material's details take the rest. Cards are 4px apart, as the page is from the window's edge.
    -->
    <Grid Background="{StaticResource PageBackgroundBrush}" Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--
            ErrorMessage and SuccessMessage as toasts, over the cards: each spans the whole Grid and puts
            itself in its bottom-right corner. An action clears both first, so only one shows at a time.
        -->
        <controls:ErrorToast Grid.RowSpan="2" Grid.ColumnSpan="3" />
        <controls:SuccessToast Grid.RowSpan="2" Grid.ColumnSpan="3" />

        <rm:MaterialListCard Grid.RowSpan="2" Grid.Column="0" />

        <rm:SummaryHeaderCard x:Name="SummaryHeader" Grid.Column="2" Margin="0,0,0,4" />

        <!--
            Every tab is part of the one form Save writes, so a new material shows them too.
            Fixed tabs, like the Settings window's: nothing to close or reopen. The strip sits
            along the bottom (TabStripPlacement), and each tab scrolls on its own, so the
            strip stays put. Price History only applies to a saved purchased material; while
            it's hidden the ViewModel moves the selection off it (SelectedDetailsTab).
            Between picking a material and its details arriving, the previous material's still
            show, and the tabs ignore the mouse (AreDetailsReady): what's in them isn't the form's.
        -->
        <!-- In a card of its own, as on Products, so the tabs get the rounded corners the theme's square frame doesn't have -->
        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource CardStyle}" Padding="4">
            <!-- No frame of its own: the card around it is the frame, and gives it its colour where the theme's is white -->
            <syncfusion:TabControlExt IsHitTestVisible="{Binding AreDetailsReady}"
                                      BorderThickness="0"
                                      Background="{StaticResource CardBackgroundBrush}"
                                      TabPanelBackground="{StaticResource CardTabStripBrush}"
                                      TabItemSelectedBackground="{StaticResource CardBackgroundBrush}"
                                      TabItemHoverBackground="{StaticResource CardTabHoverBrush}"
                                      EnableLabelEdit="False"
                                      TabStripPlacement="Bottom"
                                      CloseButtonType="Hide"
                                      ShowTabItemContextMenu="False"
                                      ShowTabListContextMenu="False"
                                      SelectedIndex="{Binding SelectedDetailsTab, Mode=TwoWay}">
                <!-- A material is purchased (a price), made (a BOM) or linked (a share of another's cost), so one of the first three cards shows -->
                <syncfusion:TabItemExt Header="Cost Setup" CanClose="False">
                    <!-- Full width, one card -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <rm:PurchaseCostSetupCard Visibility="{Binding ShowPurchaseSetup, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <rm:BillOfMaterialsCard Visibility="{Binding IsEditingMade, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <rm:LinkedCostCard Visibility="{Binding IsEditingLinked, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </ScrollViewer>
                </syncfusion:TabItemExt>

                <syncfusion:TabItemExt Header="Alternative Units" CanClose="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <rm:AlternativeUnitsCard />
                            <rm:UnitConversionCard Grid.Column="2" />
                        </Grid>
                    </ScrollViewer>
                </syncfusion:TabItemExt>

                <syncfusion:TabItemExt Header="Usage Example" CanClose="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <rm:UsageExampleCard />
                    </ScrollViewer>
                </syncfusion:TabItemExt>

                <!-- Before Price History, so it keeps its place on the strip when that tab hides -->
                <syncfusion:TabItemExt Header="Used By" CanClose="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <rm:UsedByCard />
                    </ScrollViewer>
                </syncfusion:TabItemExt>

                <syncfusion:TabItemExt Header="Price History"
                                       CanClose="False"
                                       Visibility="{Binding ShowPriceHistory, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <rm:PriceHistoryCard />
                </syncfusion:TabItemExt>
            </syncfusion:TabControlExt>
        </Border>
    </Grid>
</UserControl>
