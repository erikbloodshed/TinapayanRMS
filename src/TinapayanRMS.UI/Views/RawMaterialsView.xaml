<UserControl x:Class="TinapayanRMS.UI.Views.RawMaterialsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:controls="clr-namespace:TinapayanRMS.UI.Controls"
             xmlns:rm="clr-namespace:TinapayanRMS.UI.Views.RawMaterials"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="1400">
    <!--
        The list beside the selected material: its summary header, then its cards in tabs along
        the bottom. Each card is a UserControl in Views/RawMaterials that inherits this screen's
        DataContext; when a card shows is decided here.
    -->
    <Grid Background="{StaticResource PageBackgroundBrush}" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="340" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <!-- ErrorMessage as a toast, over the cards: it spans the whole Grid and puts itself in its bottom-right corner -->
        <controls:ErrorToast Grid.RowSpan="2" Grid.ColumnSpan="3" />

        <rm:MaterialListCard Grid.RowSpan="2" Grid.Column="0" />

        <rm:SummaryHeaderCard x:Name="SummaryHeader" Grid.Column="2" Margin="0,0,0,16" />

        <!--
            Every tab is part of the one form Save writes, so a new material shows them too.
            Fixed tabs, like the Settings window's: nothing to close or reopen. The strip sits
            along the bottom (TabStripPlacement), and each tab scrolls on its own, so the
            strip stays put. Price History only applies to a saved purchased material; while
            it's hidden the ViewModel moves the selection off it (SelectedDetailsTab).
        -->
        <syncfusion:TabControlExt Grid.Row="1"
                                  Grid.Column="2"
                                  TabStripPlacement="Bottom"
                                  CloseButtonType="Hide"
                                  ShowTabItemContextMenu="False"
                                  ShowTabListContextMenu="False"
                                  SelectedIndex="{Binding SelectedDetailsTab, Mode=TwoWay}">
            <!-- A material is purchased (a price) or made (a BOM), so one of the first two cards shows -->
            <syncfusion:TabItemExt Header="Cost Setup" CanClose="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <rm:PurchaseCostSetupCard Visibility="{Binding ShowPurchaseSetup, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <rm:BillOfMaterialsCard Visibility="{Binding IsEditingMade, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <rm:UsageExampleCard Grid.Column="2" />
                    </Grid>
                </ScrollViewer>
            </syncfusion:TabItemExt>

            <syncfusion:TabItemExt Header="Alternative Units" CanClose="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <rm:AlternativeUnitsCard />
                        <rm:UnitConversionCard Grid.Column="2" />
                    </Grid>
                </ScrollViewer>
            </syncfusion:TabItemExt>

            <syncfusion:TabItemExt Header="Price History"
                                   CanClose="False"
                                   Visibility="{Binding ShowPriceHistory, Converter={StaticResource BooleanToVisibilityConverter}}">
                <rm:PriceHistoryCard />
            </syncfusion:TabItemExt>
        </syncfusion:TabControlExt>
    </Grid>
</UserControl>
