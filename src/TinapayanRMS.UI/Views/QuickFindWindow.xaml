<Window x:Class="TinapayanRMS.UI.Views.QuickFindWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:skinManager="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
        xmlns:controls="clr-namespace:TinapayanRMS.UI.Controls"
        mc:Ignorable="d"
        Title="Find"
        Width="672"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        skinManager:SfSkinManager.SizeMode="Default">
    <!-- Chromeless, a card over a transparent window, as TextPromptWindow is: the margin is the shadow's room -->
    <Border Margin="16"
            Background="{StaticResource CardBackgroundBrush}"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.22" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- The heading stands in for the title bar, and like one it moves the dialog when dragged -->
            <Border Background="Transparent" Padding="16,14,16,0" MouseLeftButtonDown="Heading_MouseLeftButtonDown">
                <TextBlock Text="Find" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource HeadingForegroundBrush}" />
            </Border>

            <!-- Up and Down move the pick in the list below while the keyboard stays here (QueryTextBox_PreviewKeyDown) -->
            <syncfusion:SfTextBoxExt x:Name="QueryTextBox"
                                     Grid.Row="1"
                                     Margin="16,12,16,8"
                                     Watermark="Part of the name of a raw material, sub-assembly or product"
                                     WatermarkTemplate="{StaticResource AlignedWatermarkTemplate}"
                                     Text="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewKeyDown="QueryTextBox_PreviewKeyDown" />

            <syncfusion:SfDataGrid x:Name="ResultsGrid"
                                   Grid.Row="2"
                                   Margin="16,0,16,0"
                                   Height="320"
                                   ItemsSource="{Binding Results}"
                                   SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                                   GridLinesVisibility="Both"
                                   CurrentCellBorderBrush="{StaticResource AccentBrush}"
                                   CurrentCellBorderThickness="1"
                                   controls:GridFillerRows.IsEnabled="True"
                                   AutoGenerateColumns="False"
                                   AllowEditing="False"
                                   AllowSorting="False"
                                   SelectionMode="Single"
                                   NavigationMode="Row"
                                   ColumnSizer="Star"
                                   CellDoubleTapped="ResultsGrid_CellDoubleTapped"
                                   PreviewKeyDown="ResultsGrid_PreviewKeyDown">
                <syncfusion:SfDataGrid.Columns>
                    <syncfusion:GridTextColumn MappingName="Name" HeaderText="Name" />
                    <syncfusion:GridTextColumn MappingName="Kind" HeaderText="Kind" Width="140" />
                    <syncfusion:GridTextColumn MappingName="Group" HeaderText="Category or Role" Width="170" />
                </syncfusion:SfDataGrid.Columns>
            </syncfusion:SfDataGrid>

            <TextBlock Grid.Row="3"
                       Margin="16,8,16,0"
                       Style="{StaticResource CaptionStyle}"
                       TextWrapping="Wrap"
                       Text="{Binding ResultsNote}"
                       Visibility="{Binding ResultsNote, Converter={StaticResource NotNullToVisibilityConverter}}" />

            <!-- Inside the card's 1px border, so its corners are rounded 1 less to sit flush -->
            <Border Grid.Row="4"
                    Margin="0,12,0,0"
                    Background="{StaticResource PageBackgroundBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,7,7"
                    Padding="16,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <syncfusion:ButtonAdv Label="Open"
                                              IconTemplate="{StaticResource ApplyIconTemplate}"
                                              IsDefault="True"
                                              Click="OpenButton_Click"
                                              Margin="0,0,8,0" />
                        <syncfusion:ButtonAdv Label="Close"
                                              IconTemplate="{StaticResource CancelIconTemplate}"
                                              IsCancel="True"
                                              Click="CloseButton_Click" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource CaptionStyle}"
                               VerticalAlignment="Center"
                               Text="Up and Down to pick, Enter to open it on its screen." />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
