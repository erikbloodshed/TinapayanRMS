<UserControl x:Class="TinapayanRMS.UI.Views.RawMaterials.MaterialListCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:vim="clr-namespace:TinapayanRMS.UI.Vim"
             xmlns:controls="clr-namespace:TinapayanRMS.UI.Controls"
             xmlns:viewModels="clr-namespace:TinapayanRMS.Presentation.ViewModels;assembly=TinapayanRMS.Presentation"
             xmlns:enums="clr-namespace:TinapayanRMS.Domain.Enums;assembly=TinapayanRMS.Domain">

    <Border Style="{StaticResource CardStyle}">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <syncfusion:SfTextBoxExt DockPanel.Dock="Right"
                                         Width="190"
                                         Watermark="Search raw material"
                                         vim:VimKeys.IsSearchBox="True"
                                         WatermarkTemplate="{StaticResource AlignedWatermarkTemplate}"
                                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Raw Materials"
                           Style="{StaticResource SectionHeaderStyle}"
                           Margin="0"
                           VerticalAlignment="Center" />
            </DockPanel>

            <!--
                The list-wide commands, as the tree's menu offers them for its empty space (RawMaterialsViewModel.EmptySpaceMenu),
                as icons named in their tooltips, as on the Products list. The three New Category items share one drop-down,
                since two folder icons side by side would look the same; each item closes it (NewCategoryItem_Click), as
                Add Sub-Assembly's do on the Products screen. Not focusable, so Tab goes from the search box to the tree.
                IconWidth, IconHeight and Padding centre each glyph, as the Products list explains. The drop-down ignores
                Padding, and at 125% its folder rounded 1.5 px high, so its icon box is 16 tall with the folder at the bottom,
                1 DIP lower.
            -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                <syncfusion:ButtonAdv Label="New Raw Material"
                                      ToolTip="New Raw Material"
                                      SizeMode="Small"
                                      IconWidth="14"
                                      IconHeight="14"
                                      Padding="3,1,3,0"
                                      Focusable="False"
                                      IconTemplate="{StaticResource AddIconTemplate}"
                                      Command="{Binding NewMaterialInCommand}"
                                      Margin="0,0,6,0" />
                <syncfusion:DropDownButtonAdv x:Name="NewCategoryButton"
                                              Label="New Category"
                                              ToolTip="New Category: an ingredient, Made or packaging category"
                                              SizeMode="Small"
                                              IconWidth="14"
                                              IconHeight="16"
                                              Focusable="False"
                                              Margin="0,0,6,0">
                    <syncfusion:DropDownButtonAdv.IconTemplate>
                        <DataTemplate>
                            <ContentPresenter ContentTemplate="{StaticResource NewFolderIconTemplate}" VerticalAlignment="Bottom" />
                        </DataTemplate>
                    </syncfusion:DropDownButtonAdv.IconTemplate>
                    <StackPanel MinWidth="190" Margin="2">
                        <syncfusion:ButtonAdv Label="New Ingredient Category…"
                                              IconTemplate="{StaticResource NewFolderIconTemplate}"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Left"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Command="{Binding NewCategoryCommand}"
                                              CommandParameter="{x:Static enums:RawMaterialCategoryType.Ingredient}"
                                              Click="NewCategoryItem_Click" />
                        <syncfusion:ButtonAdv Label="New Made Category…"
                                              IconTemplate="{StaticResource NewFolderIconTemplate}"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Left"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Margin="0,2,0,0"
                                              Command="{Binding NewCategoryCommand}"
                                              CommandParameter="{x:Static enums:RawMaterialCategoryType.Made}"
                                              Click="NewCategoryItem_Click" />
                        <syncfusion:ButtonAdv Label="New Packaging Category…"
                                              IconTemplate="{StaticResource NewFolderIconTemplate}"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Left"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Margin="0,2,0,0"
                                              Command="{Binding NewCategoryCommand}"
                                              CommandParameter="{x:Static enums:RawMaterialCategoryType.Packaging}"

                                              Click="NewCategoryItem_Click" />
                    </StackPanel>
                </syncfusion:DropDownButtonAdv>
                <syncfusion:ButtonAdv Label="Expand All"
                                      ToolTip="Expand All"
                                      SizeMode="Small"
                                      IconWidth="14"
                                      IconHeight="14"
                                      Padding="3,1,3,0"
                                      Focusable="False"
                                      IconTemplate="{StaticResource ExpandAllIconTemplate}"
                                      Command="{Binding ExpandAllCommand}"
                                      Margin="0,0,6,0" />
                <syncfusion:ButtonAdv Label="Collapse All"
                                      ToolTip="Collapse All"
                                      SizeMode="Small"
                                      IconWidth="14"
                                      IconHeight="14"
                                      Padding="3,1,3,0"
                                      Focusable="False"
                                      IconTemplate="{StaticResource CollapseAllIconTemplate}"
                                      Command="{Binding CollapseAllCommand}" />
            </StackPanel>

            <!-- What the last move did, with Undo (MoveNoticeBar), under the tree and as wide as it, so a long message wraps -->
            <controls:MoveNoticeBar DockPanel.Dock="Bottom"
                                    Width="{Binding Width, ElementName=Tree}"
                                    Margin="0,8,0,0" />

            <!--
                The materials filed by type, then category (RawMaterialsViewModel.RawMaterialTree), each folder's by name. It
                works as the Products list does (ProductListCard, and PLAN.md's SfTreeView notes): clicking a folder opens or
                closes it; dragging materials onto another category of their type moves them there; a right-click opens a
                menu for the row, or for the list in its empty space; and F2, Del and Enter do what the menu shows beside
                them (ListTree). As wide as the other two lists.

                White behind it, as the grids are (ListBackgroundBrush): the theme draws the tree itself transparent and
                never reads its Background, so the fill is this Border's, rounded as the tree's own border is.
            -->
            <Border CornerRadius="4"
                    Background="{StaticResource ListBackgroundBrush}">
                <syncfusion:SfTreeView x:Name="Tree"
                                       Width="370"
                                       ItemsSource="{Binding RawMaterialTree.Roots}"
                                       SelectedItems="{Binding SelectedTreeNodes}"
                                       SelectionMode="Extended"
                                       ExpandActionTrigger="Node"
                                       FullRowSelect="True"
                                       AllowDragging="True"
                                       AllowDrop="True"
                                       controls:ListTree.IsEnabled="True"
                                       FocusVisualStyle="{x:Null}">
                    <!--
                        Stand-ins: the tree opens a row's menu only while ItemContextMenu is set, and the service a menu for
                        its empty space only while ContextMenu is; each is replaced by the one built for where the click
                        was, just before it opens (ListTree).
                    -->
                    <syncfusion:SfTreeView.ItemContextMenu>
                        <ContextMenu />
                    </syncfusion:SfTreeView.ItemContextMenu>
                    <syncfusion:SfTreeView.ContextMenu>
                        <ContextMenu />
                    </syncfusion:SfTreeView.ContextMenu>
                    <!--
                        Only a folder has rows under it, and whether it's open is kept on it (RawMaterialFolderNode.IsExpanded),
                        so it stays as it was left through a refresh. A material has no descriptor, and so no expander.
                    -->
                    <syncfusion:SfTreeView.HierarchyPropertyDescriptors>
                        <syncfusion:HierarchyPropertyDescriptor TargetType="{x:Type viewModels:RawMaterialFolderNode}"
                                                                ChildPropertyName="Children"
                                                                IsExpandedPropertyName="IsExpanded" />
                    </syncfusion:SfTreeView.HierarchyPropertyDescriptors>
                    <syncfusion:SfTreeView.ItemTemplate>
                        <!-- Every row's data is a RawMaterialTreeNode, so the one template serves folders and materials alike -->
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Glyph"
                                           Text="{Binding Glyph}"
                                           Style="{StaticResource IconGlyphStyle}"
                                           FontSize="13"
                                           Foreground="{StaticResource MutedForegroundBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <TextBlock x:Name="Title"
                                           Text="{Binding Title}"
                                           VerticalAlignment="Center" />
                                <!-- A folder's materials, muted after its name: which are empty shows without opening them -->
                                <TextBlock x:Name="Count"
                                           Text="{Binding MaterialCount, StringFormat='({0})'}"
                                           Foreground="{StaticResource MutedForegroundBrush}"
                                           VerticalAlignment="Center"
                                           Margin="6,0,0,0" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsFolder}" Value="False">
                                    <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Count" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsTypeFolder}" Value="True">
                                    <Setter TargetName="Title" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </syncfusion:SfTreeView.ItemTemplate>
                </syncfusion:SfTreeView>
            </Border>
        </DockPanel>
    </Border>
</UserControl>
