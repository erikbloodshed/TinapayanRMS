<UserControl x:Class="TinapayanRMS.UI.Views.RawMaterials.PurchaseCostSetupCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf">
    <Border Style="{StaticResource CardStyle}">
        <StackPanel>
            <TextBlock Text="Purchase Cost Setup" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,4" />
            <TextBlock Text="Enter the purchase price for one unit. The system works out the cost per base unit. Picking a unit the material doesn't have yet adds it as an alternative unit."
                       Style="{StaticResource CardCaptionStyle}" />

            <!-- The unit and what it holds, then the price and the buffer on top of it -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Purchase Unit" Style="{StaticResource FieldLabelStyle}" />
                <!-- Also lists units the material doesn't have yet: picking one adds it as an alternative unit -->
                <syncfusion:ComboBoxAdv Grid.Row="1"
                                        Grid.Column="0"
                                        ItemsSource="{Binding PurchaseUnitOptions}"
                                        DisplayMemberPath="Name"
                                        SelectedItem="{Binding EditingPurchaseUnit, Mode=TwoWay}" />

                <TextBlock Grid.Column="2" Text="Quantity per Purchase Unit" Style="{StaticResource FieldLabelStyle}" />
                <DockPanel Grid.Row="1" Grid.Column="2">
                    <Border DockPanel.Dock="Right"
                            Padding="10,0"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="0,1,1,1"
                            CornerRadius="0,4,4,0"
                            Background="{StaticResource PageBackgroundBrush}">
                        <TextBlock Text="{Binding BaseUnitAbbreviation}" VerticalAlignment="Center" Foreground="{StaticResource MutedForegroundBrush}" />
                    </Border>
                    <!--
                        The unit's multiplier: typed for a unit not saved yet, read-only otherwise. Empty rather
                        than 0.00 while there's no unit, or a new one's hasn't been typed (UseNullOption, as in
                        Syncfusion's DoubleTextBoxDemo).
                    -->
                    <syncfusion:DoubleTextBox Value="{Binding EditingPurchaseQuantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              UseNullOption="True"
                                              NullValue="{x:Null}"
                                              IsReadOnly="{Binding IsPurchaseQuantityReadOnly}"
                                              NumberDecimalDigits="2"
                                              ToolTip="Type it for a unit that isn't saved yet. A saved unit's multiplier changes with Edit in Alternative Units." />
                </DockPanel>
            </Grid>

            <!-- Cost Buffer % and Cost Buffer (the price with the buffer on top) follow each other as either is typed -->
            <Grid Margin="0,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Purchase Price" Style="{StaticResource FieldLabelStyle}" />
                <DockPanel Grid.Row="1" Grid.Column="0">
                    <Border DockPanel.Dock="Left"
                            Padding="10,0"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1,1,0,1"
                            CornerRadius="4,0,0,4"
                            Background="{StaticResource PageBackgroundBrush}">
                        <TextBlock Text="₱" VerticalAlignment="Center" Foreground="{StaticResource MutedForegroundBrush}" />
                    </Border>
                    <syncfusion:DoubleTextBox Value="{Binding EditingPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" NumberDecimalDigits="2" />
                </DockPanel>

                <TextBlock Grid.Column="2" Text="Cost Buffer %" Style="{StaticResource FieldLabelStyle}" />
                <syncfusion:DoubleTextBox Grid.Row="1"
                                          Grid.Column="2"
                                          Value="{Binding EditingCostBufferPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="A cushion on top of the cost for price swings, waste and yield variation. Recipes and products are costed with the buffered cost." />

                <TextBlock Grid.Column="4" Text="Cost Buffer" Style="{StaticResource FieldLabelStyle}" />
                <DockPanel Grid.Row="1" Grid.Column="4">
                    <Border DockPanel.Dock="Left"
                            Padding="10,0"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1,1,0,1"
                            CornerRadius="4,0,0,4"
                            Background="{StaticResource PageBackgroundBrush}">
                        <TextBlock Text="₱" VerticalAlignment="Center" Foreground="{StaticResource MutedForegroundBrush}" />
                    </Border>
                    <syncfusion:DoubleTextBox Value="{Binding EditingBufferedPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsReadOnly="{Binding IsBufferedPriceReadOnly}"
                                              NumberDecimalDigits="2"
                                              ToolTip="The purchase price with the buffer on top. Typing it works out Cost Buffer %; enter a purchase price first." />
                </DockPanel>
            </Grid>

            <Border Margin="0,12,0,0" Padding="12" CornerRadius="6" Background="{StaticResource AccentSoftBrush}">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold">
                        <Run Text="Cost per Base Unit (" /><Run Text="{Binding BaseUnitName, Mode=OneWay}" /><Run Text=")" />
                    </TextBlock>
                    <TextBlock FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"
                               Text="{Binding PurchaseCostText}" />
                    <!-- Follows Cost Buffer % as it's typed -->
                    <TextBlock Foreground="{StaticResource AccentBrush}" Text="{Binding PurchaseBufferedCostText}" />
                </StackPanel>
            </Border>

            <TextBlock Text="Save adds a changed price to Price History, dated today."
                       Style="{StaticResource CaptionStyle}"
                       Margin="0,12,0,0" />
        </StackPanel>
    </Border>
</UserControl>
