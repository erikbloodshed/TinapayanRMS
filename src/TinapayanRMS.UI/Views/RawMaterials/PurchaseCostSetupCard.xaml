<UserControl x:Class="TinapayanRMS.UI.Views.RawMaterials.PurchaseCostSetupCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:controls="clr-namespace:TinapayanRMS.UI.Controls">
    <!-- No frame of its own: it sits straight in its tab, whose card has the border and rounded corners -->
    <Border Padding="12">
        <StackPanel>
            <TextBlock Text="Purchase Cost Setup" Style="{StaticResource SectionHeaderStyle}" />

            <!--
                Typed straight into, like Alternative Units: the add row at the bottom starts a brand. The add row's item comes
                from the screen (NewBrandPriceRow), so it follows the units and the buffer before it's committed. Qty per
                Purchase Unit can only be typed for a unit the material doesn't have saved yet (GridCellEditing.AllowWhen); a
                saved unit's multiplier is corrected in the Alternative Units table.
            -->
            <syncfusion:SfDataGrid ItemsSource="{Binding BrandPriceRows}"
                                   controls:GridUndoSteps.Recorder="{Binding}"
                                   controls:NumericEditing.IsEnabled="True"
                                   SelectedItem="{Binding SelectedBrandPriceRow, Mode=TwoWay}"
                                   GridLinesVisibility="Both"
                                   CurrentCellBorderBrush="{StaticResource AccentBrush}"
                                   CurrentCellBorderThickness="1"
                                   controls:GridFillerRows.IsEnabled="True"
                                   ShowRowHeader="True"
                                   AutoGenerateColumns="False"
                                   AllowEditing="True"
                                   EditTrigger="OnTap"
                                   AddNewRowPosition="Bottom"
                                   SelectionMode="Single"
                                   ColumnSizer="Star"
                                   controls:GridEditCommit.OnFocusLeave="True"
                                   controls:GridAddNewRow.ItemFactory="{Binding NewBrandPriceRow}"
                                   controls:GridAddNewRow.DropWhenUntouched="True"
                                   controls:GridCellEditing.IsEnabled="True"
                                   controls:AutoCompleteDropDown.IsEnabled="True"
                                   Height="180">
                <syncfusion:SfDataGrid.Columns>
                    <!-- The only column without a fixed width, so the Star sizer gives it all the room the others leave -->
                    <syncfusion:GridTextColumn MappingName="Brand" HeaderText="Brand" />
                    <!-- Typing opens the list of units containing the text and picks one: the first starting with it, else the first containing it -->
                    <syncfusion:GridMultiColumnDropDownList MappingName="UnitKey"
                                                            HeaderText="Purchase Unit"
                                                            Width="120"
                                                            ItemsSource="{Binding PurchaseUnitOptions}"
                                                            DisplayMember="Name"
                                                            ValueMember="Key"
                                                            AllowAutoComplete="True"
                                                            AllowNullInput="True"
                                                            AllowIncrementalFiltering="True"
                                                            SearchCondition="Contains"
                                                            AutoGenerateColumns="False"
                                                            IsAutoPopupSize="False"
                                                            PopUpWidth="260"
                                                            PopUpHeight="220"
                                                            GridColumnSizer="Star">
                        <syncfusion:GridMultiColumnDropDownList.Columns>
                            <syncfusion:Columns>
                                <syncfusion:GridTextColumn MappingName="Name" HeaderText="Unit" />
                                <syncfusion:GridTextColumn MappingName="Abbreviation" HeaderText="Abbreviation" Width="100" />
                            </syncfusion:Columns>
                        </syncfusion:GridMultiColumnDropDownList.Columns>
                    </syncfusion:GridMultiColumnDropDownList>
                    <controls:NumericColumn MappingName="Quantity"
                                            HeaderText="Qty per Purchase Unit"
                                            Width="150"
                                            NumberDecimalDigits="1"
                                            TypedDecimalDigits="4"
                                            AllowNullValue="True"
                                            controls:GridCellEditing.AllowWhen="CanTypeQuantity" />
                    <controls:NumericColumn MappingName="Price" HeaderText="Purchase Price" Width="110" NumberDecimalDigits="2" AllowNullValue="True" />
                    <!-- How far the buffered cost is over this brand's price -->
                    <controls:NumericColumn MappingName="BufferPercent" HeaderText="Buffer %" Width="80" NumberDecimalDigits="2" AllowNullValue="True" AllowEditing="False" />
                </syncfusion:SfDataGrid.Columns>
            </syncfusion:SfDataGrid>

            <!-- Remove acts on the row picked in the grid -->
            <syncfusion:ButtonAdv HorizontalAlignment="Right" Margin="0,8,0,0" Label="Remove" IconTemplate="{StaticResource RemoveIconTemplate}" Command="{Binding RemoveBrandPriceCommand}" />

            <!--
                One fixed buffered cost for the whole material, which brand prices don't move: typed, or worked out from the
                dearest brand with the buffer % on top. The two follow each other as they're typed: the % gives the dearest brand
                with it on top, and the Buffered Cost gives what it is over the dearest brand. Every brand's Buffer % column says
                how far it is over that brand's price. It's kept per base unit; the box shows it in the unit picked beside it,
                to the centavo, and what's typed isn't rounded.
            -->
            <Grid Margin="0,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Cost Buffer %" Style="{StaticResource FieldLabelStyle}" />
                <!--
                    Both boxes: TargetNullValue={x:Null} passes an empty (null) decimal? to the box's double? as null. Without
                    it, WPF's default decimal-to-double conversion throws on null, a binding error each time one empties.
                -->
                <syncfusion:DoubleTextBox Grid.Row="1"
                                          Grid.Column="0"
                                          Value="{Binding TypedCostBufferPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue={x:Null}}"
                                          MinValue="0"
                                          MaxValue="100"
                                          ToolTip="The cushion on top of the dearest brand, for price swings, waste and yield variation. Typing it works out the Buffered Cost; typing the Buffered Cost works it out." />
                <TextBlock Grid.Column="2" Text="Buffered Cost" Style="{StaticResource FieldLabelStyle}" />
                <!-- Updated when focus leaves, since the value it shows back is rounded to the centavo -->
                <syncfusion:DoubleTextBox Grid.Row="1"
                                          Grid.Column="2"
                                          controls:FieldUndoStep.Recorder="{Binding}"
                                          controls:FieldUndoStep.LandsOnLeave="True"
                                          Value="{Binding EditingBufferedCostInUnit, Mode=TwoWay, UpdateSourceTrigger=LostFocus, TargetNullValue={x:Null}}"
                                          NumberDecimalDigits="-1"
                                          MinimumNumberDecimalDigits="2"
                                          MaximumNumberDecimalDigits="10"
                                          MinValue="0"
                                          UseNullOption="True"
                                          ToolTip="A fixed amount recipes and products are costed with. New brand prices don't move it; typing the Cost Buffer % again does." />
                <TextBlock Grid.Column="4" Text="Per" Style="{StaticResource FieldLabelStyle}" />
                <syncfusion:ComboBoxAdv Grid.Row="1"
                                        Grid.Column="4"
                                        ItemsSource="{Binding BufferedCostUnitOptions}"
                                        DisplayMemberPath="Name"
                                        controls:FieldUndoStep.Recorder="{Binding}"
                                        SelectedItem="{Binding BufferedCostUnit, Mode=TwoWay}"
                                        ToolTip="The unit the buffered cost is shown and typed in. It's kept per base unit either way." />
                <TextBlock Grid.Row="2"
                           Grid.ColumnSpan="5"
                           Margin="0,6,0,0"
                           Text="{Binding PurchaseBufferedCostText}"
                           Foreground="{StaticResource MutedForegroundBrush}"
                           TextWrapping="Wrap" />
                <TextBlock Grid.Row="3"
                           Grid.ColumnSpan="5"
                           Margin="0,4,0,0"
                           Text="{Binding BufferedCostWarningText}"
                           Foreground="{StaticResource WarningForegroundBrush}"
                           TextWrapping="Wrap" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
