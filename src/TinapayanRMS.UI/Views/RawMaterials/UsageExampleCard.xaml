<UserControl x:Class="TinapayanRMS.UI.Views.RawMaterials.UsageExampleCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf">
    <UserControl.Resources>
        <Style x:Key="BreakdownRowStyle" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
    </UserControl.Resources>

    <!--
        Always the material being edited (ExampleRawMaterial follows the selection), priced at its saved cost
        per base unit, so an edit on Cost Setup (a price, a BOM line, a share) shows here once saved.
    -->
    <Border Style="{StaticResource CardStyle}">
        <StackPanel>
            <TextBlock Text="Usage Example" Style="{StaticResource SectionHeaderStyle}" />

            <!-- The quantity has a label; the unit picker and Calculate don't, so they span both rows, bottom-aligned -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="240" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Use Quantity" Style="{StaticResource FieldLabelStyle}" />
                <syncfusion:DoubleTextBox Grid.Row="1"
                                          Grid.Column="0"
                                          Value="{Binding ExampleQuantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          NumberDecimalDigits="2" />

                <syncfusion:ComboBoxAdv Grid.RowSpan="2"
                                        Grid.Column="1"
                                        Width="84"
                                        VerticalAlignment="Bottom"
                                        ItemsSource="{Binding ExampleUnitOptions}"
                                        DisplayMemberPath="Abbreviation"
                                        SelectedItem="{Binding ExampleUnit, Mode=TwoWay}" />
                <syncfusion:ButtonAdv Grid.RowSpan="2"
                                      Grid.Column="3"
                                      VerticalAlignment="Bottom"
                                      Label="Calculate"
                                      IconTemplate="{StaticResource CalculateIconTemplate}"
                                      Command="{Binding CalculateExampleCommand}" />
            </Grid>

            <Border Margin="0,12,0,0"
                    Padding="12"
                    CornerRadius="6"
                    Background="{StaticResource SuccessBackgroundBrush}"
                    Visibility="{Binding ExampleResult, Converter={StaticResource NotNullToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="{Binding ExampleResult.Title}"
                               Foreground="{StaticResource HeadingForegroundBrush}"
                               FontWeight="SemiBold" />
                    <!-- The buffered total is what recipes and products are costed with -->
                    <TextBlock FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SuccessForegroundBrush}"
                               Text="{Binding ExampleResult.BufferedTotalCost, StringFormat='₱{0:N2}'}" />
                    <TextBlock Style="{StaticResource CaptionStyle}">
                        <Run Text="Buffered cost, with a" /><Run Text="{Binding ExampleResult.BufferPercent, StringFormat=' {0:0.##}%', Mode=OneWay}" /><Run Text=" buffer" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <StackPanel Margin="0,8,0,0"
                        Visibility="{Binding ExampleResult, Converter={StaticResource NotNullToVisibilityConverter}}">
                <TextBlock Text="Breakdown" FontWeight="SemiBold" Foreground="{StaticResource HeadingForegroundBrush}" />
                <DockPanel Style="{StaticResource BreakdownRowStyle}">
                    <TextBlock DockPanel.Dock="Right">
                        <Run Text="{Binding ExampleResult.QuantityInBaseUnits, StringFormat='{}{0:#,0.####}', Mode=OneWay}" />
                        <Run Text="{Binding ExampleResult.BaseUnitAbbreviation, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="Quantity in base unit" Style="{StaticResource CaptionStyle}" />
                </DockPanel>
                <DockPanel Style="{StaticResource BreakdownRowStyle}">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ExampleResult.CostPerBaseUnit, StringFormat='₱{0:N4}'}" />
                    <TextBlock Text="Cost per base unit" Style="{StaticResource CaptionStyle}" />
                </DockPanel>
                <DockPanel Style="{StaticResource BreakdownRowStyle}">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ExampleResult.TotalCost, StringFormat='₱{0:N2}'}" />
                    <TextBlock Text="Calculated cost" Style="{StaticResource CaptionStyle}" />
                </DockPanel>
                <DockPanel Style="{StaticResource BreakdownRowStyle}">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ExampleResult.BufferPercent, StringFormat='{}{0:0.##}%'}" />
                    <TextBlock Text="Buffer" Style="{StaticResource CaptionStyle}" />
                </DockPanel>
                <DockPanel Style="{StaticResource BreakdownRowStyle}">
                    <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold" Text="{Binding ExampleResult.BufferedTotalCost, StringFormat='₱{0:N2}'}" />
                    <TextBlock Text="Buffered cost" Style="{StaticResource CaptionStyle}" />
                </DockPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
