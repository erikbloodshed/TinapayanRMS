<UserControl x:Class="TinapayanRMS.UI.Views.RawMaterials.UnitConversionCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TinapayanRMS.UI.Controls">
    <!-- No frame of its own: it sits straight in its tab, whose card has the border and rounded corners -->
    <Border Padding="12">
        <StackPanel>
            <TextBlock Text="Unit Conversion Overview" Style="{StaticResource SectionHeaderStyle}" />
            <controls:UnitConversionOverview ItemsSource="{Binding UnitRows}" BaseUnitName="{Binding BaseUnitName}" />
        </StackPanel>
    </Border>
</UserControl>
