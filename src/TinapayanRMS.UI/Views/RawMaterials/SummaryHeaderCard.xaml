<UserControl x:Class="TinapayanRMS.UI.Views.RawMaterials.SummaryHeaderCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:controls="clr-namespace:TinapayanRMS.UI.Controls"
             xmlns:viewModels="clr-namespace:TinapayanRMS.UI.ViewModels">
    <UserControl.Resources>
        <!-- A value tile: a muted label over a larger value. -->
        <Style x:Key="TileLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldLabelStyle}">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="TileValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{StaticResource HeadingForegroundBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <!--
            The Category picker's rows: a line under its "< Add New .. >" row (RawMaterialsViewModel.AddNewCategory)
            sets it apart from the categories below it. Styling the row rather than templating it, since the picker
            needs DisplayMemberPath: the closed box shows ComboBoxAdv.Text, which is the picked item's ToString()
            unless DisplayMemberPath names the property to read — and ItemsControl refuses both that and ItemTemplate.
        -->
        <DataTemplate x:Key="AddNewCategoryTemplate">
            <Border HorizontalAlignment="Stretch"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="0,0,0,5"
                    Margin="0,0,0,3">
                <TextBlock Text="{Binding Name}" />
            </Border>
        </DataTemplate>

        <!--
            The row's own template, not the picker's ItemTemplate: the theme's row draws no border of its own to
            thicken, and ContentTemplate wins over the ContentTemplateSelector that DisplayMemberPath puts on every
            row. The categories keep that selector, so they're drawn as the theme draws any row.
        -->
        <Style x:Key="CategoryOptionStyle" TargetType="syncfusion:ComboBoxItemAdv" BasedOn="{StaticResource {x:Type syncfusion:ComboBoxItemAdv}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Id}" Value="{x:Static viewModels:RawMaterialsViewModel.AddNewCategoryId}">
                    <Setter Property="ContentTemplate" Value="{StaticResource AddNewCategoryTemplate}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TileSeparatorStyle" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="16,0" />
            <Setter Property="Background" Value="{StaticResource CardBorderBrush}" />
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource CardStyle}">
        <StackPanel>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <syncfusion:ButtonAdv Label="New" IconTemplate="{StaticResource AddIconTemplate}" Command="{Binding NewCommand}" Margin="0,0,8,0" />
                    <syncfusion:ButtonAdv Label="Save"
                                          IconTemplate="{StaticResource SaveIconTemplate}"
                                          Command="{Binding SaveCommand}"
                                          ToolTip="Saves the details, alternative units, price and bill of materials together."
                                          Margin="0,0,8,0" />
                    <syncfusion:ButtonAdv Label="Undo"
                                          IconTemplate="{StaticResource UndoIconTemplate}"
                                          Command="{Binding UndoCommand}"
                                          ToolTip="Takes back the last change: a price typed, a unit or a component added or removed. Ctrl+Z."
                                          Margin="0,0,8,0" />
                    <syncfusion:ButtonAdv Label="Redo"
                                          IconTemplate="{StaticResource RedoIconTemplate}"
                                          Command="{Binding RedoCommand}"
                                          ToolTip="Puts back the change the last Undo took. Ctrl+Y."
                                          Margin="0,0,8,0" />
                    <syncfusion:ButtonAdv Label="Delete" IconTemplate="{StaticResource DeleteIconTemplate}" Command="{Binding DeleteCommand}" />
                </StackPanel>

                <Border DockPanel.Dock="Left"
                        Width="52"
                        Height="52"
                        Margin="0,0,14,0"
                        CornerRadius="10"
                        Background="{StaticResource AccentSoftBrush}">
                    <TextBlock Text="{Binding HeaderInitial}"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding HeaderTitle}"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource HeadingForegroundBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>

            <!-- The tiles: labels in the first row, values in the second, with separators spanning both -->
            <Border Margin="0,16,0,0"
                    Padding="16,12"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- An ingredient is always in grams; packaging picks its own base unit -->
                    <TextBlock Grid.Column="0" Text="Base Unit" Style="{StaticResource TileLabelStyle}" />
                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="gram (g)"
                               Style="{StaticResource TileValueStyle}"
                               Visibility="{Binding IsEditingIngredient, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <syncfusion:ComboBoxAdv Grid.Row="1"
                                            Grid.Column="0"
                                            ItemsSource="{Binding UnitsOfMeasure}"
                                            DisplayMemberPath="Name"
                                            controls:FieldUndoStep.Recorder="{Binding}"
                                            SelectedItem="{Binding EditingBaseUnit, Mode=TwoWay}"
                                            IsEnabled="{Binding CanChangeBaseUnit}"
                                            ToolTip="Fixed once the material has alternative units, prices or packaging lines."
                                            Visibility="{Binding IsEditingPackaging, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <Border Grid.Column="1" Grid.RowSpan="2" Style="{StaticResource TileSeparatorStyle}" />
                    <!-- The saved costs, in the unit picked as Per in the Purchase Cost Setup -->
                    <TextBlock Grid.Column="2" Style="{StaticResource TileLabelStyle}">
                        <Run Text="Current Cost per" /> <Run Text="{Binding HeaderCostUnitText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Grid.Row="1"
                               Grid.Column="2"
                               Style="{StaticResource TileValueStyle}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Text="{Binding CurrentCostText}" />

                    <!-- The cost with the buffer on top: what recipes and products are costed with -->
                    <Border Grid.Column="3" Grid.RowSpan="2" Style="{StaticResource TileSeparatorStyle}" />
                    <TextBlock Grid.Column="4" Style="{StaticResource TileLabelStyle}">
                        <Run Text="Buffered Cost per" /> <Run Text="{Binding HeaderCostUnitText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Grid.Row="1"
                               Grid.Column="4"
                               Style="{StaticResource TileValueStyle}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Text="{Binding BufferedCostText}" />

                    <Border Grid.Column="5" Grid.RowSpan="2" Style="{StaticResource TileSeparatorStyle}" />
                    <TextBlock Grid.Column="6" Text="Last Updated" Style="{StaticResource TileLabelStyle}" />
                    <TextBlock Grid.Row="1" Grid.Column="6" Text="{Binding LastUpdatedText}" Style="{StaticResource TileValueStyle}" />
                </Grid>
            </Border>

            <!-- Labels in the first row, fields in the second: Name first. Packaging is always purchased; only an ingredient can be made. -->
            <Grid Margin="0,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Name" Style="{StaticResource FieldLabelStyle}" />
                <syncfusion:SfTextBoxExt x:Name="NameTextBox"
                                         Grid.Row="1"
                                         Grid.Column="0"
                                         controls:FieldUndoStep.Recorder="{Binding}"
                                         Text="{Binding EditingName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         LostFocus="NameTextBox_LostFocus" />

                <TextBlock Grid.Column="2" Text="Type" Style="{StaticResource FieldLabelStyle}" />
                <syncfusion:ComboBoxAdv Grid.Row="1"
                                        Grid.Column="2"
                                        ItemsSource="{Binding Types}"
                                        controls:FieldUndoStep.Recorder="{Binding}"
                                        SelectedItem="{Binding EditingType, Mode=TwoWay}"
                                        IsEnabled="{Binding CanChangeTypeAndSource}"
                                        ToolTip="Ingredients go in recipes; packaging goes on a product's packaging lines. Fixed once saved." />

                <TextBlock Grid.Column="4" Text="Category" Style="{StaticResource FieldLabelStyle}" />
                <syncfusion:ComboBoxAdv Grid.Row="1"
                                        Grid.Column="4"
                                        ItemsSource="{Binding CategoryOptions}"
                                        DisplayMemberPath="Name"
                                        ItemContainerStyle="{StaticResource CategoryOptionStyle}"
                                        controls:FieldUndoStep.Recorder="{Binding}"
                                        SelectedItem="{Binding EditingCategory, Mode=TwoWay}"
                                        Text="{Binding CategorySearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ToolTip="Pick a category, or &quot;&lt; Add New .. &gt;&quot; to name one now." />

                <TextBlock Grid.Column="6"
                           Text="Source"
                           Style="{StaticResource FieldLabelStyle}"
                           Visibility="{Binding IsEditingIngredient, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <syncfusion:ComboBoxAdv Grid.Row="1"
                                        Grid.Column="6"
                                        ItemsSource="{Binding Sources}"
                                        controls:FieldUndoStep.Recorder="{Binding}"
                                        SelectedItem="{Binding EditingSource, Mode=TwoWay}"
                                        IsEnabled="{Binding CanChangeTypeAndSource}"
                                        Visibility="{Binding IsEditingIngredient, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <TextBlock Grid.Column="8"
                           Text="Weight Loss %"
                           Style="{StaticResource FieldLabelStyle}"
                           Visibility="{Binding IsEditingMade, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <syncfusion:DoubleTextBox Grid.Row="1"
                                          Grid.Column="8"
                                          controls:FieldUndoStep.Recorder="{Binding}"
                                          Value="{Binding EditingWeightLossPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Visibility="{Binding IsEditingMade, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
