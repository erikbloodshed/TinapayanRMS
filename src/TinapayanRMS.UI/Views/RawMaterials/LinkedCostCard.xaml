<UserControl x:Class="TinapayanRMS.UI.Views.RawMaterials.LinkedCostCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:controls="clr-namespace:TinapayanRMS.UI.Controls">
    <!-- No frame of its own: it sits straight in its tab, whose card has the border and rounded corners -->
    <Border Padding="12">
        <StackPanel>
            <TextBlock Text="Linked Cost" Style="{StaticResource SectionHeaderStyle}" />

            <!-- The ingredient it's a part of, then the two shares and the buffer it inherits from it -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.ColumnSpan="5" Text="Linked To" Style="{StaticResource FieldLabelStyle}" />
                <!-- Typing with the list open jumps to the first name starting with it -->
                <syncfusion:ComboBoxAdv Grid.Row="1"
                                        Grid.ColumnSpan="5"
                                        ItemsSource="{Binding LinkTargets}"
                                        DisplayMemberPath="Name"
                                        IsTextSearchEnabled="True"
                                        controls:FieldUndoStep.Recorder="{Binding}"
                                        SelectedItem="{Binding EditingLinkedTo, Mode=TwoWay}"
                                        ToolTip="The ingredient this one is a part of. Any ingredient but this one: purchased, made or linked." />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Weight Share %" Style="{StaticResource FieldLabelStyle}" />
                <!--
                    Empty rather than 0.00 until typed, as Quantity per Purchase Unit is (UseNullOption). TargetNullValue={x:Null}
                    passes the empty decimal? to the box's double? as null: WPF's default conversion throws on null.
                -->
                <syncfusion:DoubleTextBox Grid.Row="4"
                                          Grid.Column="0"
                                          controls:FieldUndoStep.Recorder="{Binding}"
                                          Value="{Binding EditingWeightSharePercent, Converter={StaticResource DecimalValueConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue={x:Null}}"
                                          UseNullOption="True"
                                          NullValue="{x:Null}"
                                          NumberDecimalDigits="2"
                                          ToolTip="How much of the linked ingredient's weight this part is: egg white is about 70% of an egg." />

                <TextBlock Grid.Row="3" Grid.Column="2" Text="Cost Share %" Style="{StaticResource FieldLabelStyle}" />
                <syncfusion:DoubleTextBox Grid.Row="4"
                                          Grid.Column="2"
                                          controls:FieldUndoStep.Recorder="{Binding}"
                                          Value="{Binding EditingCostSharePercent, Converter={StaticResource DecimalValueConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue={x:Null}}"
                                          UseNullOption="True"
                                          NullValue="{x:Null}"
                                          NumberDecimalDigits="2"
                                          ToolTip="How much of the linked ingredient's cost this part carries: egg white might carry 30% of the egg's." />

                <TextBlock Grid.Row="3" Grid.Column="4" Text="Cost Buffer %" Style="{StaticResource FieldLabelStyle}" />
                <!-- Inherited, so read-only and greyed out: the linked ingredient's buffer, empty until one is picked -->
                <syncfusion:DoubleTextBox Grid.Row="4"
                                          Grid.Column="4"
                                          Value="{Binding EditingLinkedTo.CostBufferPercent, Mode=OneWay}"
                                          UseNullOption="True"
                                          NullValue="{x:Null}"
                                          IsReadOnly="True"
                                          controls:ReadOnlyText.IsGreyed="True"
                                          ToolTip="Inherited from the linked ingredient, for show: this part takes the same share of that ingredient's buffered cost as of its cost. Change the buffer there." />
            </Grid>

            <!-- Follows the link and both shares as they're typed; an info notice, in the info colours -->
            <Border Margin="0,12,0,0" Padding="12" CornerRadius="6" Background="{StaticResource InfoBackgroundBrush}">
                <TextBlock Foreground="{StaticResource InfoForegroundBrush}" TextWrapping="Wrap" Text="{Binding LinkedCostPreviewText}" />
            </Border>

            <TextBlock Text="{Binding LinkedPartsText}"
                       Style="{StaticResource CaptionStyle}"
                       TextWrapping="Wrap"
                       Margin="0,12,0,0" />
        </StackPanel>
    </Border>
</UserControl>
