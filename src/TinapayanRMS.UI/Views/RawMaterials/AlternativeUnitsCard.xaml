<UserControl x:Class="TinapayanRMS.UI.Views.RawMaterials.AlternativeUnitsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:controls="clr-namespace:TinapayanRMS.UI.Controls">
    <Border Style="{StaticResource CardStyle}">
        <StackPanel>
            <TextBlock Text="Alternative Units" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,4" />
            <TextBlock Text="Define up to two units you commonly buy or use this material in. Changes are saved with Save."
                       Style="{StaticResource CardCaptionStyle}" />

            <!--
                Typed straight into, like the Bill of Materials: the add row at the bottom starts a unit, and goes once
                there are two (CanAddUnit). That goes through GridAddNewRow.ShowWhen, not a binding on AddNewRowPosition,
                which crashes the grid when committing the second unit is what hides the add row. The add row's item
                comes from the screen (NewUnitRow), so it names its unit as soon as one is picked.
            -->
            <syncfusion:SfDataGrid ItemsSource="{Binding UnitRows}"
                                   SelectedItem="{Binding SelectedUnitRow, Mode=TwoWay}"
                                   GridLinesVisibility="Both"
                                   controls:GridFillerRows.IsEnabled="True"
                                   AutoGenerateColumns="False"
                                   AllowEditing="True"
                                   EditTrigger="OnTap"
                                   controls:GridAddNewRow.ShowWhen="{Binding CanAddUnit}"
                                   SelectionMode="Single"
                                   ColumnSizer="Star"
                                   controls:GridEditCommit.OnFocusLeave="True"
                                   controls:GridAddNewRow.ItemFactory="{Binding NewUnitRow}"
                                   controls:GridAddNewRow.DropWhenUntouched="True"
                                   controls:AutoCompleteDropDown.IsEnabled="True"
                                   Height="160">
                <syncfusion:SfDataGrid.Columns>
                    <!-- Typing opens the list of units containing the text and picks one: the first starting with it, else the first containing it -->
                    <syncfusion:GridMultiColumnDropDownList MappingName="UnitOfMeasureId"
                                                            HeaderText="Alternative Unit"
                                                            ItemsSource="{Binding UnitsOfMeasure}"
                                                            DisplayMember="Name"
                                                            ValueMember="Id"
                                                            AllowAutoComplete="True"
                                                            AllowNullInput="True"
                                                            AllowIncrementalFiltering="True"
                                                            SearchCondition="Contains"
                                                            AutoGenerateColumns="False"
                                                            IsAutoPopupSize="False"
                                                            PopUpWidth="260"
                                                            PopUpHeight="220"
                                                            GridColumnSizer="Star">
                        <syncfusion:GridMultiColumnDropDownList.Columns>
                            <syncfusion:Columns>
                                <syncfusion:GridTextColumn MappingName="Name" HeaderText="Unit" />
                                <syncfusion:GridTextColumn MappingName="Abbreviation" HeaderText="Abbreviation" Width="100" />
                            </syncfusion:Columns>
                        </syncfusion:GridMultiColumnDropDownList.Columns>
                    </syncfusion:GridMultiColumnDropDownList>
                    <syncfusion:GridTextColumn MappingName="Abbreviation" HeaderText="Abbreviation" AllowEditing="False" />
                    <controls:NumericColumn MappingName="BaseUnitsPerUnit" HeaderText="Multiplier" NumberDecimalDigits="2" />
                </syncfusion:SfDataGrid.Columns>
            </syncfusion:SfDataGrid>

            <!-- Remove acts on the row picked in the grid -->
            <DockPanel Margin="0,8,0,0">
                <syncfusion:ButtonAdv DockPanel.Dock="Right" Label="Remove" IconTemplate="{StaticResource RemoveIconTemplate}" Command="{Binding DeleteUnitCommand}" />
                <TextBlock Text="Type the units straight into the table." Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
            </DockPanel>
        </StackPanel>
    </Border>
</UserControl>
