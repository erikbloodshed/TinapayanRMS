<UserControl x:Class="TinapayanRMS.UI.Views.RawMaterials.BillOfMaterialsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:controls="clr-namespace:TinapayanRMS.UI.Controls">
    <Border Style="{StaticResource CardStyle}">
        <StackPanel>
            <TextBlock Text="Bill of Materials" Style="{StaticResource SectionHeaderStyle}" />

            <!-- Typed straight into, in grams (recipe lines have no unit of their own): the add row at the bottom starts a line, Delete removes the selected one -->
            <syncfusion:SfDataGrid ItemsSource="{Binding BomLineEdits}"
                                   SelectedItem="{Binding SelectedBomLineEdit, Mode=TwoWay}"
                                   AutoGenerateColumns="False"
                                   AllowEditing="True"
                                   AllowDeleting="True"
                                   EditTrigger="OnTap"
                                   AddNewRowPosition="Bottom"
                                   AddNewRowText="Click here to add a component"
                                   SelectionMode="Single"
                                   ColumnSizer="Star"
                                   controls:GridEditCommit.OnFocusLeave="True"
                                   controls:AutoCompleteDropDown.IsEnabled="True"
                                   Height="200">
                <syncfusion:SfDataGrid.Columns>
                    <!-- Typing completes the name and narrows the list to the ingredients that match -->
                    <syncfusion:GridMultiColumnDropDownList MappingName="IngredientId"
                                                            HeaderText="Component"
                                                            ItemsSource="{Binding Ingredients}"
                                                            DisplayMember="Name"
                                                            ValueMember="Id"
                                                            AllowAutoComplete="True"
                                                            AllowNullInput="True"
                                                            AllowIncrementalFiltering="True"
                                                            AutoGenerateColumns="False"
                                                            IsAutoPopupSize="False"
                                                            PopUpWidth="380"
                                                            PopUpHeight="260"
                                                            GridColumnSizer="Star">
                        <syncfusion:GridMultiColumnDropDownList.Columns>
                            <syncfusion:Columns>
                                <syncfusion:GridTextColumn MappingName="Name" HeaderText="Component" />
                                <syncfusion:GridTextColumn MappingName="Category.Name" HeaderText="Category" Width="100" />
                                <controls:NumericColumn MappingName="BufferedCostPerBaseUnit" HeaderText="Cost per g" Width="88" NumberDecimalDigits="4" />
                            </syncfusion:Columns>
                        </syncfusion:GridMultiColumnDropDownList.Columns>
                    </syncfusion:GridMultiColumnDropDownList>
                    <controls:NumericColumn MappingName="Grams" HeaderText="Grams" Width="120" NumberDecimalDigits="2" />
                </syncfusion:SfDataGrid.Columns>
            </syncfusion:SfDataGrid>

            <DockPanel Margin="0,8,0,0">
                <syncfusion:ButtonAdv DockPanel.Dock="Right" Label="Remove Line" IconTemplate="{StaticResource RemoveIconTemplate}" Command="{Binding RemoveBomLineCommand}" />
                <TextBlock Text="Type the lines straight into the table." Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
            </DockPanel>
        </StackPanel>
    </Border>
</UserControl>
