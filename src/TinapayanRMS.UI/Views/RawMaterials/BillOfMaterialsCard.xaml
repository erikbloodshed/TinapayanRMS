<UserControl x:Class="TinapayanRMS.UI.Views.RawMaterials.BillOfMaterialsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:controls="clr-namespace:TinapayanRMS.UI.Controls">
    <Border Style="{StaticResource CardStyle}">
        <StackPanel>
            <TextBlock Text="Bill of Materials" Style="{StaticResource SectionHeaderStyle}" />

            <syncfusion:SfDataGrid ItemsSource="{Binding BomLineEdits}"
                                   SelectedItem="{Binding SelectedBomLineEdit, Mode=TwoWay}"
                                   AutoGenerateColumns="False"
                                   AllowEditing="False"
                                   SelectionMode="Single"
                                   NavigationMode="Row"
                                   ColumnSizer="Star"
                                   Height="200">
                <syncfusion:SfDataGrid.Columns>
                    <syncfusion:GridTextColumn MappingName="Component.Name" HeaderText="Component" />
                    <controls:NumericColumn MappingName="Grams" HeaderText="Grams" Width="120" NumberDecimalDigits="2" />
                </syncfusion:SfDataGrid.Columns>
            </syncfusion:SfDataGrid>

            <!-- Labels in the first row, fields in the second. Amounts are in grams: recipe lines have no unit of their own. -->
            <Grid Margin="0,12,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Component" Style="{StaticResource FieldLabelStyle}" />
                <syncfusion:ComboBoxAdv Grid.Row="1"
                                        Grid.Column="0"
                                        ItemsSource="{Binding Ingredients}"
                                        DisplayMemberPath="Name"
                                        SelectedItem="{Binding EditingBomComponent, Mode=TwoWay}" />

                <TextBlock Grid.Column="2" Text="Grams" Style="{StaticResource FieldLabelStyle}" />
                <syncfusion:DoubleTextBox Grid.Row="1"
                                          Grid.Column="2"
                                          Value="{Binding EditingBomGrams, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <StackPanel Orientation="Horizontal">
                <syncfusion:ButtonAdv Label="Add Line" IconTemplate="{StaticResource AddIconTemplate}" Command="{Binding AddBomLineCommand}" Margin="0,0,8,0" />
                <syncfusion:ButtonAdv Label="Remove Line" IconTemplate="{StaticResource RemoveIconTemplate}" Command="{Binding RemoveBomLineCommand}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
