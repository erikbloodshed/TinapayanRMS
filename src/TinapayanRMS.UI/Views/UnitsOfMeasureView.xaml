<UserControl x:Class="TinapayanRMS.UI.Views.UnitsOfMeasureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:controls="clr-namespace:TinapayanRMS.UI.Controls"
             mc:Ignorable="d"
             d:DesignHeight="550" d:DesignWidth="1000">
    <Grid Background="{StaticResource PageBackgroundBrush}" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <controls:StatusBanner Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,12" />

        <!-- Units list -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Units of Measure" Style="{StaticResource SectionHeaderStyle}" />

                <syncfusion:SfDataGrid Grid.Row="1"
                                        ItemsSource="{Binding Units}"
                                        SelectedItem="{Binding SelectedUnit, Mode=TwoWay}"
                                        AutoGenerateColumns="False"
                                        AllowEditing="False"
                                        SelectionMode="Single"
                                        NavigationMode="Row"
                                        ColumnSizer="AutoWithLastColumnFill">
                    <syncfusion:SfDataGrid.Columns>
                        <syncfusion:GridTextColumn MappingName="Name" HeaderText="Name" />
                        <syncfusion:GridTextColumn MappingName="Abbreviation" HeaderText="Abbreviation" />
                        <syncfusion:GridCheckBoxColumn MappingName="IsLengthUnit" HeaderText="Length Unit" />
                        <controls:NumericColumn MappingName="MillimetersPerUnit" HeaderText="mm / Unit" NumberDecimalDigits="2" />
                    </syncfusion:SfDataGrid.Columns>
                </syncfusion:SfDataGrid>
            </Grid>
        </Border>

        <!-- Details -->
        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Details" Style="{StaticResource SectionHeaderStyle}" />

                <TextBlock Text="Name" Style="{StaticResource FieldLabelStyle}" />
                <syncfusion:SfTextBoxExt Text="{Binding EditingName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,12" />

                <TextBlock Text="Abbreviation" Style="{StaticResource FieldLabelStyle}" />
                <syncfusion:SfTextBoxExt Text="{Binding EditingAbbreviation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,12" />

                <CheckBox IsChecked="{Binding EditingIsLengthUnit, Mode=TwoWay}"
                          Margin="0,0,0,12">
                    <TextBlock Text="Is a length unit (can substitute for other length units as a packaging line's entry unit)" TextWrapping="Wrap" />
                </CheckBox>

                <StackPanel Visibility="{Binding EditingIsLengthUnit, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Millimeters Per Unit" Style="{StaticResource FieldLabelStyle}" />
                    <syncfusion:DoubleTextBox Value="{Binding EditingMillimetersPerUnit, Mode=TwoWay}"
                                               Margin="0,0,0,12" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <syncfusion:ButtonAdv Label="New" IconTemplate="{StaticResource AddIconTemplate}" Command="{Binding NewCommand}" Margin="0,0,8,0" />
                    <syncfusion:ButtonAdv Label="Save" IconTemplate="{StaticResource SaveIconTemplate}" Command="{Binding SaveCommand}" Margin="0,0,8,0" />
                    <syncfusion:ButtonAdv Label="Delete" IconTemplate="{StaticResource DeleteIconTemplate}" Command="{Binding DeleteCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
