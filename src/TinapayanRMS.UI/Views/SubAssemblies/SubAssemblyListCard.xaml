<UserControl x:Class="TinapayanRMS.UI.Views.SubAssemblies.SubAssemblyListCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:vim="clr-namespace:TinapayanRMS.UI.Vim"
             xmlns:viewModels="clr-namespace:TinapayanRMS.UI.ViewModels">

    <Border Style="{StaticResource CardStyle}">
        <DockPanel>
            <!-- Title and search on one row, laid out as the Raw Materials and Products list cards lay out their own -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <syncfusion:SfTextBoxExt DockPanel.Dock="Right"
                                         Width="190"
                                         Watermark="Search sub-assembly"
                                         vim:VimKeys.IsSearchBox="True"
                                         WatermarkTemplate="{StaticResource AlignedWatermarkTemplate}"
                                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Sub-Assemblies"
                           Style="{StaticResource SectionHeaderStyle}"
                           Margin="0"
                           VerticalAlignment="Center" />
            </DockPanel>

            <!--
                The list-wide commands, as the tree's menu offers them for its empty space (SubAssembliesViewModel.EmptySpaceMenu),
                as icons named in their tooltips, as on the Products list. Not focusable, so Tab goes from the search box to
                the tree.
                IconWidth, IconHeight and Padding centre each glyph, as the Products list explains.
            -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                <syncfusion:ButtonAdv Label="New Sub-Assembly"
                                      ToolTip="New Sub-Assembly"
                                      SizeMode="Small"
                                      IconWidth="14"
                                      IconHeight="14"
                                      Padding="3,1,3,0"
                                      Focusable="False"
                                      IconTemplate="{StaticResource AddIconTemplate}"
                                      Command="{Binding NewSubAssemblyInCommand}"
                                      Margin="0,0,6,0" />
                <syncfusion:ButtonAdv Label="New Role"
                                      ToolTip="New Role…"
                                      SizeMode="Small"
                                      IconWidth="14"
                                      IconHeight="14"
                                      Padding="3,1,3,0"
                                      Focusable="False"
                                      IconTemplate="{StaticResource NewFolderIconTemplate}"
                                      Command="{Binding NewRoleCommand}"
                                      Margin="0,0,6,0" />
                <syncfusion:ButtonAdv Label="Expand All"
                                      ToolTip="Expand All"
                                      SizeMode="Small"
                                      IconWidth="14"
                                      IconHeight="14"
                                      Padding="3,1,3,0"
                                      Focusable="False"
                                      IconTemplate="{StaticResource ExpandAllIconTemplate}"
                                      Command="{Binding ExpandAllCommand}"
                                      Margin="0,0,6,0" />
                <syncfusion:ButtonAdv Label="Collapse All"
                                      ToolTip="Collapse All"
                                      SizeMode="Small"
                                      IconWidth="14"
                                      IconHeight="14"
                                      Padding="3,1,3,0"
                                      Focusable="False"
                                      IconTemplate="{StaticResource CollapseAllIconTemplate}"
                                      Command="{Binding CollapseAllCommand}" />
            </StackPanel>

            <!--
                What the last move did, with Undo (SubAssembliesViewModel.MoveNotice), under the tree, as on the Raw Materials
                list: a drag or Move To saves at once, so this is where one made by mistake is taken back. It hides itself a
                few seconds on, unless the mouse is over it (the code-behind). As wide as the tree, so a long message wraps.
            -->
            <Border x:Name="MoveNoticeBar"
                    DockPanel.Dock="Bottom"
                    Width="{Binding Width, ElementName=Tree}"
                    Margin="0,8,0,0"
                    Padding="10,4,4,4"
                    CornerRadius="6"
                    Background="{StaticResource InfoBackgroundBrush}"
                    Visibility="{Binding MoveNotice, Converter={StaticResource NotNullToVisibilityConverter}}"
                    AutomationProperties.AutomationId="MoveNotice">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource ToastCloseButtonStyle}"
                            Command="{Binding DismissMoveNoticeCommand}"
                            VerticalAlignment="Center"
                            ToolTip="Close"
                            AutomationProperties.Name="Close">
                        <TextBlock Text="&#xE711;" Style="{StaticResource IconGlyphStyle}" FontSize="12" />
                    </Button>
                    <syncfusion:ButtonAdv DockPanel.Dock="Right"
                                          Label="Undo"
                                          IconTemplate="{StaticResource UndoIconTemplate}"
                                          Command="{Binding UndoMoveCommand}"
                                          VerticalAlignment="Center"
                                          Margin="8,0,4,0" />
                    <TextBlock Text="{Binding MoveNotice}"
                               Foreground="{StaticResource InfoForegroundBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!--
                The sub-assemblies filed by role (SubAssembliesViewModel.SubAssemblyTree), each folder's by name. It works as
                the Raw Materials and Products lists do (MaterialListCard, and PLAN.md's SfTreeView notes): clicking a folder
                opens or closes it; dragging recipes onto another role's folder gives them that role; a right-click opens a
                menu for the row, or for the list in its empty space; and F2, Del and Enter do what the menu shows beside them
                (the code-behind). As wide as the other two lists.

                White behind it, as the grids are (ListBackgroundBrush): the theme draws the tree itself transparent and
                never reads its Background, so the fill is this Border's, rounded as the tree's own border is.
            -->
            <Border CornerRadius="4"
                    Background="{StaticResource ListBackgroundBrush}">
                <syncfusion:SfTreeView x:Name="Tree"
                                       Width="370"
                                       ItemsSource="{Binding SubAssemblyTree.Roots}"
                                       SelectedItems="{Binding SelectedTreeNodes}"
                                       SelectionMode="Extended"
                                       ExpandActionTrigger="Node"
                                       FullRowSelect="True"
                                       AllowDragging="True"
                                       AllowDrop="True"
                                       ItemDragStarting="Tree_ItemDragStarting"
                                       ItemDragOver="Tree_ItemDragOver"
                                       ItemDropping="Tree_ItemDropping"
                                       ItemContextMenuOpening="Tree_ItemContextMenuOpening"
                                       ContextMenuOpening="Tree_ContextMenuOpening"
                                       KeyDown="Tree_KeyDown"
                                       FocusVisualStyle="{x:Null}">
                    <!--
                        Stand-ins: the tree opens a row's menu only while ItemContextMenu is set, and the service a menu for
                        its empty space only while ContextMenu is; each is replaced by the one built for where the click
                        was, just before it opens (the code-behind).
                    -->
                    <syncfusion:SfTreeView.ItemContextMenu>
                        <ContextMenu />
                    </syncfusion:SfTreeView.ItemContextMenu>
                    <syncfusion:SfTreeView.ContextMenu>
                        <ContextMenu />
                    </syncfusion:SfTreeView.ContextMenu>
                    <!--
                        Only a folder has rows under it, and whether it's open is kept on it (SubAssemblyFolderNode.IsExpanded),
                        so it stays as it was left through a refresh. A sub-assembly has no descriptor, and so no expander.
                    -->
                    <syncfusion:SfTreeView.HierarchyPropertyDescriptors>
                        <syncfusion:HierarchyPropertyDescriptor TargetType="{x:Type viewModels:SubAssemblyFolderNode}"
                                                                ChildPropertyName="Children"
                                                                IsExpandedPropertyName="IsExpanded" />
                    </syncfusion:SfTreeView.HierarchyPropertyDescriptors>
                    <syncfusion:SfTreeView.ItemTemplate>
                        <!-- Every row's data is a SubAssemblyTreeNode, so the one template serves folders and sub-assemblies alike -->
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Glyph"
                                           Text="{Binding Glyph}"
                                           Style="{StaticResource IconGlyphStyle}"
                                           FontSize="13"
                                           Foreground="{StaticResource MutedForegroundBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Title}"
                                           VerticalAlignment="Center" />
                                <!-- A folder's sub-assemblies, muted after its name: which are empty shows without opening them -->
                                <TextBlock x:Name="Count"
                                           Text="{Binding SubAssemblyCount, StringFormat='({0})'}"
                                           Foreground="{StaticResource MutedForegroundBrush}"
                                           VerticalAlignment="Center"
                                           Margin="6,0,0,0" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsFolder}" Value="False">
                                    <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Count" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </syncfusion:SfTreeView.ItemTemplate>
                </syncfusion:SfTreeView>
            </Border>
        </DockPanel>
    </Border>
</UserControl>
