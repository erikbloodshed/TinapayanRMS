<Window x:Class="TinapayanRMS.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:skinManager="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
        mc:Ignorable="d"
        Title="Settings"
        Width="1000"
        Height="640"
        MinWidth="760"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        skinManager:SfSkinManager.SizeMode="Touch"
        Background="{StaticResource PageBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Fixed tabs, like Products' sub-tabs: nothing here to close or reopen. -->
        <syncfusion:TabControlExt Grid.Row="0"
                                  Margin="8,8,8,0"
                                  CloseButtonType="Hide"
                                  ShowTabItemContextMenu="False"
                                  ShowTabListContextMenu="False">
            <syncfusion:TabItemExt x:Name="UnitsOfMeasureTab" Header="Units of Measure" CanClose="False" />
            <syncfusion:TabItemExt x:Name="CategoriesTab" Header="Categories" CanClose="False" />
        </syncfusion:TabControlExt>

        <Border Grid.Row="1"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <DockPanel>
                <syncfusion:ButtonAdv DockPanel.Dock="Right"
                                      Label="Close"
                                      IconTemplate="{StaticResource CancelIconTemplate}"
                                      IsCancel="True"
                                      Click="CloseButton_Click" />
                <TextBlock Text="Each change is saved when you click Save on its tab."
                           Style="{StaticResource CaptionStyle}"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
