<!--
    Chromeless, as MainWindow is (2026-09-29, at the user's request): an AppWindow, so the title bar is the theme's, in the
    main window's card colour and height, with its own Maximize/Restore and Close. No Minimize: the dialog is modal and
    has no taskbar button, so minimized it would only leave the main window disabled behind a sliver of title bar. The
    heading is a left header item, as the main window's is, since the theme draws ShowTitle's text flush against the
    window's left edge; Title still names the window for the Alt+Tab list and screen readers.
-->
<controls:AppWindow x:Class="TinapayanRMS.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:controls="clr-namespace:TinapayanRMS.UI.Controls"
        xmlns:skinManager="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
        xmlns:collections="clr-namespace:System.Collections;assembly=System.Runtime"
        xmlns:vim="clr-namespace:TinapayanRMS.UI.Vim"
        mc:Ignorable="d"
        Title="Settings"
        Width="1000"
        Height="640"
        MinWidth="760"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ShowIcon="False"
        ShowTitle="False"
        TitleBarHeight="30"
        ShowMinimizeButton="False"
        TitleBarBackground="{StaticResource CardBackgroundBrush}"
        TitleBarForeground="{StaticResource HeadingForegroundBrush}"
        skinManager:SfSkinManager.SizeMode="Default"
        Background="{StaticResource PageBackgroundBrush}">
    <controls:AppWindow.LeftHeaderItemsSource>
        <collections:ArrayList>
            <TextBlock Text="Settings" Style="{StaticResource AppTitleStyle}" Margin="12,0,0,0" VerticalAlignment="Center" />
        </collections:ArrayList>
    </controls:AppWindow.LeftHeaderItemsSource>

    <!-- The Vim keys' mode, as the main window shows it, while they're on -->
    <controls:AppWindow.RightHeaderItemsSource>
        <collections:ArrayList>
            <vim:VimModeIndicator />
        </collections:ArrayList>
    </controls:AppWindow.RightHeaderItemsSource>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Fixed tabs, like Products' sub-tabs: nothing here to close or reopen. -->
        <syncfusion:TabControlExt x:Name="SettingsTabs"
                                  Grid.Row="0"
                                  Margin="8,8,8,0"
                                  Background="{StaticResource PageBackgroundBrush}"
                                  TabPanelBackground="{StaticResource PageTabStripBrush}"
                                  TabItemSelectedBackground="{StaticResource PageBackgroundBrush}"
                                  TabItemHoverBackground="{StaticResource PageTabHoverBrush}"
                                  EnableLabelEdit="False"
                                  CloseButtonType="Hide"
                                  ShowTabItemContextMenu="False"
                                  ShowTabListContextMenu="False">
            <syncfusion:TabItemExt x:Name="UnitsOfMeasureTab" Header="Units of Measure" CanClose="False" />
            <syncfusion:TabItemExt x:Name="CategoriesTab" Header="Material Categories" CanClose="False" />
            <syncfusion:TabItemExt x:Name="ProductCategoriesTab" Header="Product Categories" CanClose="False" />
            <syncfusion:TabItemExt x:Name="RolesTab" Header="Roles" CanClose="False" />
            <syncfusion:TabItemExt x:Name="CostingDefaultsTab" Header="Costing Defaults" CanClose="False" />
            <syncfusion:TabItemExt x:Name="KeyboardTab" Header="Keyboard" CanClose="False" />
            <syncfusion:TabItemExt x:Name="DatabaseTab" Header="Database" CanClose="False" />
        </syncfusion:TabControlExt>

        <Border Grid.Row="1"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <syncfusion:ButtonAdv HorizontalAlignment="Right"
                                  Label="Close"
                                  IconTemplate="{StaticResource CancelIconTemplate}"
                                  IsCancel="True"
                                  Click="CloseButton_Click" />
        </Border>
    </Grid>
</controls:AppWindow>
