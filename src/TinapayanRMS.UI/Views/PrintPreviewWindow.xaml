<!--
    A print pane in a dialog of its own, chromeless as Settings is: the Production Plan's printout, or the Price Simulator report,
    previewed and printed from Syncfusion's PrintPreview. Under it, what to print when there's a choice (the Price Simulator
    report's selected products or all those shown), and the parts to include: the plan's Costs, or a report's Recipe and
    Costing, either cleared only while the other is ticked. The pane is put in by code, after the window is themed.
-->
<controls:AppWindow x:Class="TinapayanRMS.UI.Views.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:controls="clr-namespace:TinapayanRMS.UI.Controls"
        xmlns:skinManager="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
        xmlns:collections="clr-namespace:System.Collections;assembly=System.Runtime"
        Title="Print"
        Width="1200"
        Height="800"
        MinWidth="800"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ShowIcon="False"
        ShowTitle="False"
        TitleBarHeight="30"
        ShowMinimizeButton="False"
        TitleBarBackground="{StaticResource CardBackgroundBrush}"
        TitleBarForeground="{StaticResource HeadingForegroundBrush}"
        skinManager:SfSkinManager.SizeMode="Default"
        Background="{StaticResource PageBackgroundBrush}">
    <controls:AppWindow.LeftHeaderItemsSource>
        <collections:ArrayList>
            <TextBlock x:Name="Heading" Text="Print" Style="{StaticResource AppTitleStyle}" Margin="12,0,0,0" VerticalAlignment="Center" />
        </collections:ArrayList>
    </controls:AppWindow.LeftHeaderItemsSource>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ContentControl x:Name="PreviewHost" Focusable="False" />
        <Border Grid.Row="1"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="ChoiceBar" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,28,0" Visibility="Collapsed">
                    <TextBlock Text="Print" Style="{StaticResource FormLabelStyle}" Margin="0,0,12,0" />
                    <syncfusion:ComboBoxAdv x:Name="ChoiceBox"
                                            Width="240"
                                            DisplayMemberPath="Label"
                                            ToolTip="The products picked in the table, or every product it shows, as its filters and sorting have them." />
                </StackPanel>
                <StackPanel x:Name="IncludeBar" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Include" Style="{StaticResource FormLabelStyle}" Margin="0,0,12,0" />
                    <StackPanel x:Name="ProductParts" Orientation="Horizontal">
                        <CheckBox Content="Recipe"
                                  IsChecked="{Binding IncludeRecipe, Mode=TwoWay}"
                                  IsEnabled="{Binding IncludeCosting}"
                                  ToolTip="Each sub-assembly's ingredients and piece size, then the packaging, the lines a price change moves marked, with their cost now."
                                  VerticalAlignment="Center"
                                  Margin="0,0,16,0" />
                        <CheckBox Content="Costing"
                                  IsChecked="{Binding IncludeCosting, Mode=TwoWay}"
                                  IsEnabled="{Binding IncludeRecipe}"
                                  ToolTip="The price changes applied, and the costing now and with the changes. Without it the recipe shows no costs."
                                  VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
                <syncfusion:ButtonAdv Grid.Column="2"
                                      HorizontalAlignment="Right"
                                      Label="Close"
                                      IconTemplate="{StaticResource CancelIconTemplate}"
                                      IsCancel="True"
                                      Click="CloseButton_Click" />
            </Grid>
        </Border>
    </Grid>
</controls:AppWindow>
