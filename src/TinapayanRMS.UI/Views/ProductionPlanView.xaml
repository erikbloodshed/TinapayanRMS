<UserControl x:Class="TinapayanRMS.UI.Views.ProductionPlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:controls="clr-namespace:TinapayanRMS.UI.Controls"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1400">
    <!--
        The saved plans and the plan on the left, as Raw Materials has its list; what it comes to on the right, the mixing
        sheet over the purchase requisition. Cards 4px from the page's edge and from each other. Both tables on the right
        are always shown, so Export to Excel writes both.
    -->
    <Grid Background="{StaticResource PageBackgroundBrush}" Margin="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="600" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="4" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="3" Style="{StaticResource CardStyle}">
            <DockPanel>
                <Grid DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Saved Plans" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" />
                    <syncfusion:ButtonAdv Grid.Column="1"
                                          Label="Save Plan"
                                          IconTemplate="{StaticResource SaveIconTemplate}"
                                          Command="{Binding SavePlanCommand}"
                                          ToolTip="Saves the products in the plan, and whether it's in half batches, under a name, to open here again."
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0" />
                    <syncfusion:ButtonAdv Grid.Column="2"
                                          Label="Delete Plan"
                                          IconTemplate="{StaticResource DeleteIconTemplate}"
                                          Command="{Binding DeletePlanCommand}"
                                          ToolTip="Deletes the open saved plan. Its products stay in the table."
                                          VerticalAlignment="Center" />
                </Grid>
                <TextBlock DockPanel.Dock="Top"
                           Style="{StaticResource CaptionStyle}"
                           Margin="0,0,0,12"
                           Text="Plans saved under a name, newest first. Click one to open it: its products replace the plan's." />
                <!-- Clicking a saved plan opens it (ProductionPlanViewModel.SelectedPlan) -->
                <syncfusion:SfDataGrid x:Name="PlansGrid"
                                       DockPanel.Dock="Top"
                                       ItemsSource="{Binding Plans}"
                                       SelectedItem="{Binding SelectedPlan, Mode=TwoWay}"
                                       AutomationProperties.Name="Saved Plans"
                                       GridLinesVisibility="Both"
                                       CurrentCellBorderBrush="{StaticResource AccentBrush}"
                                       CurrentCellBorderThickness="1"
                                       controls:GridFillerRows.IsEnabled="True"
                                       AutoGenerateColumns="False"
                                       AllowEditing="False"
                                       AllowSorting="False"
                                       SelectionMode="Single"
                                       NavigationMode="Row"
                                       ColumnSizer="Star"
                                       Height="150"
                                       Margin="0,0,0,16">
                    <syncfusion:SfDataGrid.Columns>
                        <syncfusion:GridDateTimeColumn MappingName="SavedAt" HeaderText="Saved" Pattern="CustomPattern" CustomPattern="MMM d, yyyy  h:mm tt" Width="170" />
                        <syncfusion:GridTextColumn MappingName="Name" HeaderText="Name" />
                    </syncfusion:SfDataGrid.Columns>
                </syncfusion:SfDataGrid>

                <Grid DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Plan" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" />
                    <syncfusion:ButtonAdv Grid.Column="1"
                                          Label="Remove Line"
                                          IconTemplate="{StaticResource RemoveIconTemplate}"
                                          Command="{Binding RemoveLineCommand}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0" />
                    <syncfusion:ButtonAdv Grid.Column="2"
                                          Label="Clear Plan"
                                          IconTemplate="{StaticResource CancelIconTemplate}"
                                          Command="{Binding ClearCommand}"
                                          ToolTip="Takes every product out of the plan, and closes the open saved plan."
                                          VerticalAlignment="Center" />
                </Grid>
                <TextBlock DockPanel.Dock="Top"
                           Style="{StaticResource CaptionStyle}"
                           Margin="0,0,0,12"
                           Text="Pick each product to make and type how many sellable units: pieces, or boxes for a product sold by the box. The plan is kept for you on this computer. Sales are at each product's Current Price, with VAT; profit is over its base cost, VAT out." />

                <!-- What the plan sells for and earns, under its table -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource CaptionStyle}">
                        <Run Text="Sales" />
                        <Run Text="{Binding TotalSales, Mode=OneWay, StringFormat='{}{0:N2}'}" FontWeight="SemiBold" Foreground="{StaticResource HeadingForegroundBrush}" />
                        <Run Text="    Profit" />
                        <Run Text="{Binding TotalProfit, Mode=OneWay, StringFormat='{}{0:N2}'}" FontWeight="SemiBold" Foreground="{StaticResource HeadingForegroundBrush}" />
                        <Run Text="    Profit Margin" />
                        <Run Text="{Binding ProfitMarginPercent, Mode=OneWay, StringFormat='{}{0:N1}%'}" FontWeight="SemiBold" Foreground="{StaticResource HeadingForegroundBrush}" />
                    </TextBlock>
                    <TextBlock Text="{Binding SalesNote}"
                               Visibility="{Binding SalesNote, Converter={StaticResource NotNullToVisibilityConverter}}"
                               Foreground="{StaticResource WarningForegroundBrush}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>

                <syncfusion:SfDataGrid x:Name="PlanGrid"
                                       ItemsSource="{Binding Lines}"
                                       SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                                       controls:NumericEditing.IsEnabled="True"
                                       GridLinesVisibility="Both"
                                       CurrentCellBorderBrush="{StaticResource AccentBrush}"
                                       CurrentCellBorderThickness="1"
                                       controls:GridFillerRows.IsEnabled="True"
                                       ShowRowHeader="True"
                                       AutoGenerateColumns="False"
                                       AllowEditing="True"
                                       AllowDeleting="True"
                                       EditTrigger="OnTap"
                                       AddNewRowPosition="Bottom"
                                       SelectionMode="Single"
                                       ColumnSizer="Star"
                                       controls:GridEditCommit.OnFocusLeave="True"
                                       controls:GridAddNewRow.DropWhenUntouched="True"
                                       controls:AutoCompleteDropDown.IsEnabled="True"
                                       controls:GridAddNewRow.ItemFactory="{Binding NewLine}"
                                       controls:GridAddNewRow.ItemDropped="{Binding DropNewLine}">
                    <syncfusion:SfDataGrid.Columns>
                        <syncfusion:GridMultiColumnDropDownList MappingName="ProductId"
                                                                HeaderText="Product"
                                                                ItemsSource="{Binding Products}"
                                                                DisplayMember="Name"
                                                                ValueMember="Id"
                                                                AllowAutoComplete="True"
                                                                AllowNullInput="True"
                                                                AllowIncrementalFiltering="True"
                                                                SearchCondition="Contains"
                                                                AutoGenerateColumns="False"
                                                                IsAutoPopupSize="False"
                                                                PopUpWidth="380"
                                                                PopUpHeight="300"
                                                                GridColumnSizer="Star">
                            <syncfusion:GridMultiColumnDropDownList.Columns>
                                <syncfusion:Columns>
                                    <syncfusion:GridTextColumn MappingName="Name" HeaderText="Product" />
                                    <syncfusion:GridTextColumn MappingName="Category.Name" HeaderText="Category" Width="120" />
                                </syncfusion:Columns>
                            </syncfusion:GridMultiColumnDropDownList.Columns>
                        </syncfusion:GridMultiColumnDropDownList>
                        <controls:NumericColumn MappingName="Units" HeaderText="Units" NumberDecimalDigits="0" TypedDecimalDigits="2" Width="70" AllowNullValue="True" />
                        <syncfusion:GridTextColumn MappingName="PiecesText" HeaderText="Pieces" Width="90" AllowEditing="False" AllowFocus="False" TextAlignment="Right" />
                        <controls:NumericColumn MappingName="Sales" HeaderText="Sales" NumberDecimalDigits="2" AllowNullValue="True" AllowEditing="False" AllowFocus="False" Width="96" />
                        <controls:NumericColumn MappingName="Profit" HeaderText="Profit" NumberDecimalDigits="2" AllowNullValue="True" AllowEditing="False" AllowFocus="False" Width="96" />
                    </syncfusion:SfDataGrid.Columns>
                </syncfusion:SfDataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource CardStyle}">
            <DockPanel>
                <Grid DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Mixing Sheet" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" />
                    <!-- Syncfusion has no check box of its own outside its grids and ribbon; the Price Simulator uses WPF's too -->
                    <CheckBox Grid.Column="1"
                              Content="Half batches"
                              IsChecked="{Binding HalfBatches, Mode=TwoWay}"
                              ToolTip="Rounds each mix up to the next half batch rather than a whole one, for a kitchen that can mix half a batch."
                              VerticalAlignment="Center"
                              Margin="0,0,12,0" />
                    <syncfusion:ButtonAdv Grid.Column="2"
                                          Label="Print"
                                          IconTemplate="{StaticResource PrintIconTemplate}"
                                          Command="{Binding PrintCommand}"
                                          ToolTip="Previews and prints the plan: what to make, the mixing sheet with each mix's ingredients, and the purchase requisition."
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0" />
                    <syncfusion:ButtonAdv Grid.Column="3"
                                          Label="Export to Excel"
                                          IconTemplate="{StaticResource ExportIconTemplate}"
                                          Command="{Binding ExportCommand}"
                                          ToolTip="Saves the plan, the mixing sheet with each mix's ingredients, and the purchase requisition, as shown, to an Excel workbook."
                                          VerticalAlignment="Center" />
                </Grid>
                <TextBlock DockPanel.Dock="Top"
                           Style="{StaticResource CaptionStyle}"
                           Margin="0,0,0,12"
                           Text="Each mix in whole batches, or half ones with Half batches ticked, shared by every product it's for, and the made ingredients to prepare for them. Open a row for what goes into it. Spare is what the batches make beyond the plan." />
                <!-- What the plan couldn't work out, such as a section with no piece size yet -->
                <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Notes}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="{StaticResource WarningForegroundBrush}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Each row opens to show what goes into it (MixRow.Ingredients); the view keeps a row open while the plan changes -->
                <syncfusion:SfDataGrid x:Name="MixesGrid"
                                       ItemsSource="{Binding Mixes}"
                                       controls:GridAutoRowHeight.IsEnabled="True"
                                       GridLinesVisibility="Both"
                                       CurrentCellBorderBrush="{StaticResource AccentBrush}"
                                       CurrentCellBorderThickness="1"
                                       controls:GridFillerRows.IsEnabled="True"
                                       AutoGenerateColumns="False"
                                       AutoGenerateRelations="False"
                                       HideEmptyGridViewDefinition="True"
                                       AllowEditing="False"
                                       AllowSorting="True"
                                       SelectionMode="Single"
                                       NavigationMode="Row"
                                       ColumnSizer="Star">
                    <syncfusion:SfDataGrid.Columns>
                        <syncfusion:GridTextColumn MappingName="Name" HeaderText="Mix" Width="240" />
                        <syncfusion:GridTextColumn MappingName="For" HeaderText="For" TextWrapping="Wrap" />
                        <controls:NumericColumn MappingName="Batches" HeaderText="Batches" NumberDecimalDigits="0" AllowNullValue="True" Width="80" />
                        <controls:NumericColumn MappingName="Grams" HeaderText="Weight (g)" NumberDecimalDigits="1" Width="110" />
                        <syncfusion:GridTextColumn MappingName="Spare" HeaderText="Spare" TextWrapping="Wrap" Width="180" />
                    </syncfusion:SfDataGrid.Columns>
                    <syncfusion:SfDataGrid.DetailsViewDefinition>
                        <syncfusion:GridViewDefinition RelationalColumn="Ingredients">
                            <syncfusion:GridViewDefinition.DataGrid>
                                <syncfusion:SfDataGrid AutoGenerateColumns="False"
                                                       AllowEditing="False"
                                                       AllowSorting="False"
                                                       GridLinesVisibility="Both"
                                                       SelectionMode="None"
                                                       NavigationMode="Row"
                                                       ColumnSizer="None">
                                    <syncfusion:SfDataGrid.Columns>
                                        <syncfusion:GridTextColumn MappingName="Name" HeaderText="Ingredient" Width="240" />
                                        <controls:NumericColumn MappingName="PerBatch" HeaderText="Per Batch (g)" NumberDecimalDigits="1" AllowNullValue="True" Width="120" />
                                        <controls:NumericColumn MappingName="Grams" HeaderText="Total (g)" NumberDecimalDigits="1" Width="120" />
                                    </syncfusion:SfDataGrid.Columns>
                                </syncfusion:SfDataGrid>
                            </syncfusion:GridViewDefinition.DataGrid>
                        </syncfusion:GridViewDefinition>
                    </syncfusion:SfDataGrid.DetailsViewDefinition>
                </syncfusion:SfDataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Column="2" Grid.Row="2" Style="{StaticResource CardStyle}">
            <DockPanel>
                <Grid DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Purchase Requisition" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource CaptionStyle}">
                        <Run Text="Total Cost" />
                        <Run Text="{Binding TotalCost, Mode=OneWay, StringFormat='{}{0:N2}'}" FontWeight="SemiBold" Foreground="{StaticResource HeadingForegroundBrush}" />
                        <Run Text="    Buy Cost" />
                        <Run Text="{Binding TotalBuyCost, Mode=OneWay, StringFormat='{}{0:N2}'}" FontWeight="SemiBold" Foreground="{StaticResource HeadingForegroundBrush}" />
                    </TextBlock>
                </Grid>
                <TextBlock DockPanel.Dock="Top"
                           Style="{StaticResource CaptionStyle}"
                           Margin="0,0,0,12"
                           Text="Everything to buy: made ingredients as what they're made of, and egg white or yolk as the eggs they're cut from. Buy is in the unit of its dearest brand price, rounded up. Cost is what's needed, at buffered costs; Buy Cost is what the units to buy cost at that price." />
                <syncfusion:SfDataGrid x:Name="RequisitionGrid"
                                       ItemsSource="{Binding Requisition}"
                                       GridLinesVisibility="Both"
                                       CurrentCellBorderBrush="{StaticResource AccentBrush}"
                                       CurrentCellBorderThickness="1"
                                       controls:GridFillerRows.IsEnabled="True"
                                       AutoGenerateColumns="False"
                                       AllowEditing="False"
                                       AllowSorting="True"
                                       SelectionMode="Single"
                                       NavigationMode="Row"
                                       ColumnSizer="Star">
                    <syncfusion:SfDataGrid.Columns>
                        <syncfusion:GridTextColumn MappingName="Name" HeaderText="Raw Material" Width="260" />
                        <syncfusion:GridTextColumn MappingName="Type" HeaderText="Type" />
                        <controls:NumericColumn MappingName="Needed" HeaderText="Needed" NumberDecimalDigits="1" />
                        <syncfusion:GridTextColumn MappingName="Unit" HeaderText="Unit" Width="64" />
                        <controls:NumericColumn MappingName="Cost" HeaderText="Cost" NumberDecimalDigits="2" AllowNullValue="True" />
                        <controls:NumericColumn MappingName="Buy" HeaderText="Buy" NumberDecimalDigits="0" AllowNullValue="True" Width="80" />
                        <syncfusion:GridTextColumn MappingName="BuyUnit" HeaderText="Per" Width="110" />
                        <controls:NumericColumn MappingName="BuyCost" HeaderText="Buy Cost" NumberDecimalDigits="2" AllowNullValue="True" />
                    </syncfusion:SfDataGrid.Columns>
                </syncfusion:SfDataGrid>
            </DockPanel>
        </Border>

        <controls:ErrorToast Grid.RowSpan="3" Grid.ColumnSpan="3" />
        <controls:SuccessToast Grid.RowSpan="3" Grid.ColumnSpan="3" />
    </Grid>
</UserControl>
