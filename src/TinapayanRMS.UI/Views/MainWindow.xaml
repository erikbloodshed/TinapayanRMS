<!--
    Chromeless (2026-09-25, at the user's request): Syncfusion's ChromelessWindow draws the title bar itself, in the
    theme, with its own Minimize, Maximize/Restore and Close buttons on the right, so Windows' caption bar is gone.
    The app's header strip (the menu toggle and the heading) is the title bar's left side,
    LeftHeaderItemsSource, the way Syncfusion's own Sample Browser window puts its logo and name there: ShowTitle and
    ShowIcon off, so the window's Title (still what the taskbar shows) and icon don't draw, and TitleBarBackground in
    the card colour the strip had. No TitleBarTemplate: a Syncfusion control's template stays the theme's (App.xaml).
    The bar is still a title bar: drag it to move the window, double-click it to maximize.

    The native chrome and the fixes that make it behave like a normal window are AppWindow's (Controls/AppWindow.cs).
-->
<controls:AppWindow x:Class="TinapayanRMS.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:controls="clr-namespace:TinapayanRMS.UI.Controls"
        xmlns:skinManager="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
        xmlns:sfTheme="clr-namespace:Syncfusion.Themes.Windows11Light.WPF;assembly=Syncfusion.Themes.Windows11Light.WPF"
        xmlns:collections="clr-namespace:System.Collections;assembly=System.Runtime"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="800" Width="1400"
        ShowTitle="False"
        ShowIcon="False"
        TitleBarHeight="30"
        TitleBarBackground="{StaticResource CardBackgroundBrush}"
        TitleBarForeground="{StaticResource HeadingForegroundBrush}"
        skinManager:SfSkinManager.SizeMode="Default"
        PreviewKeyDown="Window_PreviewKeyDown">
    <controls:AppWindow.Resources>
        <!-- A menu row's glyph, in a fixed box so the labels line up whatever the glyph's width -->
        <Style x:Key="DrawerIconStyle" TargetType="TextBlock" BasedOn="{StaticResource IconGlyphStyle}">
            <Setter Property="Width" Value="20" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>

        <!--
            A destination row. The Windows11Light theme doesn't reach a plain ListBoxItem
            (SfSkinManager.ApplyThemeAsDefaultStyle is deliberately off, App.xaml.cs), so the row is
            templated here rather than left at the OS default, whose blue selection would fight the
            app's accent. Templating a *framework* control is fine; App.xaml's no-Style rule is
            about Syncfusion controls, whose templates must stay intact.
            **There is no selected state, and no focus outline**: marking the page showing here only
            repeated the tab strip right below it (dropped 2026-09-22, at the user's request). So the
            template answers hover and keyboard focus with the same wash and nothing else, and
            MainWindow.xaml.cs navigates from the click rather than from the ListBox's selection, which
            is now neither shown nor read.
        -->
        <Style x:Key="DrawerItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{StaticResource HeadingForegroundBrush}" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="NavigationMenuItem_Clicked" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="9,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#14000000" />
                            </Trigger>
                            <!--
                                Keyboard focus looks exactly like hover, deliberately: an outline of its
                                own read as "this is the current page" all over again (2026-09-22, at the
                                user's request). A row still has to show where the keyboard is, or the
                                arrows move something invisible.
                            -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#14000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </controls:AppWindow.Resources>

    <!--
        The header strip, in the title bar (see the note at the top). Its items keep the window's DataContext and
        names, so the bindings and Click handlers are as they were in the Border this strip used to be. Back and
        Forward were here too until they moved to the tab strip's right end (MainTabControl's TabPanelItem).
    -->
    <controls:AppWindow.LeftHeaderItemsSource>
        <collections:ArrayList>
            <!--
                The drawer lives in the window's content, so its scrim covers the tabs but not the title bar: the toggle
                stays visible and clickable while the menu is open, and clicking it again puts the
                menu away. Icon only, so the name lives in ToolTip/AutomationProperties.
                It hovers like the title bar's minimise and maximise buttons (2026-09-26, at the user's request),
                because it's built the way they are: the theme's WPFGlyphButtonStyle, fetched by ThemeKey as a
                DynamicResource (see the Back button for why not {sfskin:ThemeResource}), with the template
                ChromelessWindow gives them, WPFGlyphWindowButtonTemplate. That's the style's own hover (the faint
                ContentBackgroundHovered wash, the glyph darkening to IconColorHovered) with square corners.
                The template isn't published under a ThemeKey, so it's looked up by its plain key in the theme
                dictionary SfSkinManager merges into this window. A plain Button, not a ButtonAdv: ButtonAdv's
                hover is an opaque, rounded, bordered fill that Background="Transparent" doesn't reach, and its
                empty label pushed the glyph off centre. 40×32, their size. IsHitTestVisibleInChrome, as they
                set: without it the title bar's caption area takes the mouse and the button never hovers.
                Still focusable, unlike the title bar's buttons:
                CloseDrawer (MainWindow.xaml.cs) hands the keyboard back to it.
            -->
            <Button x:Name="ToggleNavigationButton"
                    Width="40"
                    Height="32"
                    Margin="0,0,8,0"
                    WindowChrome.IsHitTestVisibleInChrome="True"
                    Style="{DynamicResource {skinManager:ThemeKey Key=WPFGlyphButtonStyle, Theme={x:Type sfTheme:Windows11LightSkinHelper}}}"
                    Template="{DynamicResource WPFGlyphWindowButtonTemplate}"
                    ToolTip="Show the navigation menu"
                    AutomationProperties.Name="Navigation menu"
                    Click="ToggleNavigationButton_Click">
                <TextBlock Text="&#xE700;" Style="{StaticResource IconGlyphStyle}" />
            </Button>
            <TextBlock Text="{Binding Heading}" Style="{StaticResource AppTitleStyle}" VerticalAlignment="Center" />
        </collections:ArrayList>
    </controls:AppWindow.LeftHeaderItemsSource>

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <!--
            DisplayMode=Default: the menu is hidden until the header's hamburger summons it, slides in
            over the tabs (Transition=SlideOnTop, already the DP default) and closes when you click the
            page behind it.
            The Default control template draws no toggle button of its own and ignores Items/FooterItems
            entirely — it presents DrawerHeaderView/DrawerContentView/DrawerFooterView instead — so the
            toggle and the menu are both hand-rolled (see MainWindow.xaml.cs and PLAN.md).
            Only DrawerContentView is used: the template's three presenters are just the Auto/*/Auto rows
            of one grid, and HeaderHeight/FooterHeight are registered but never bound by it, so one Border
            gives the panel one padding and one edge.
            The size property swaps with Position, and both apply only in Default mode: DrawerWidth sizes a
            Left/Right drawer, DrawerHeight a Top/Bottom one, and under Compact neither is read (the drawer
            expands to ExpandedModeWidth), which is why the DrawerWidth="220" this screen carried under
            Compact never did anything. Position is left unset, since Left is its default.
            Position="Top" was tried and reverted (2026-09-22): a top drawer is always a full-width band,
            which forces the destinations into a row, and the user wants them stacked.
            DrawerHeight is left unset: RefreshSlider derives it from ActualHeight and re-runs on
            SizeChanged, so the panel fills the tab area.
        -->
        <syncfusion:SfNavigationDrawer x:Name="NavigationDrawer"
                                        DisplayMode="Default"
                                        DrawerWidth="240"
                                        Background="{StaticResource CardBackgroundBrush}">
            <syncfusion:SfNavigationDrawer.DrawerContentView>
                <Border BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="0,0,1,0"
                        Padding="0"
                        KeyboardNavigation.TabNavigation="Cycle"
                        PreviewKeyDown="NavigationMenu_PreviewKeyDown">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="NAVIGATE"
                                   Style="{StaticResource CaptionStyle}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="10,4,0,8" />

                        <!--
                            The destinations. Still a ListBox now that the "you are here" state is gone,
                            and not the stacked ButtonAdvs the Add Sub-Assembly drop-down uses, for the
                            hover: a flattened ButtonAdv's themed hover is an opaque #FFF9F9F9 set by the
                            template on its own border, which beats any Background set on the control and
                            is a 3-level grey step against this panel — measured. DrawerItemStyle's rows
                            own their hover outright, so it actually reads. Every row is templated, so
                            nothing of the OS default look survives.
                            Each row needs AutomationProperties.Name: its content is a glyph and a label
                            in a StackPanel, not a string, so UI Automation would otherwise read the row
                            out as "System.Windows.Controls.ListBoxItem" (checked in the running app).
                            NavigationItem's Header used to supply this.
                        -->
                        <ListBox x:Name="NavigationMenu"
                                 Grid.Row="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 ItemContainerStyle="{StaticResource DrawerItemStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBoxItem x:Name="RawMaterialsNavItem" AutomationProperties.Name="Raw Materials">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8F1;" Style="{StaticResource DrawerIconStyle}" />
                                    <TextBlock Text="Raw Materials" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem x:Name="SubAssembliesNavItem" AutomationProperties.Name="Sub-Assemblies">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8FD;" Style="{StaticResource DrawerIconStyle}" />
                                    <TextBlock Text="Sub-Assemblies" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem x:Name="ProductsNavItem" AutomationProperties.Name="Products">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE71D;" Style="{StaticResource DrawerIconStyle}" />
                                    <TextBlock Text="Products" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem x:Name="ReportsNavItem" AutomationProperties.Name="Reports">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEB05;" Style="{StaticResource DrawerIconStyle}" />
                                    <TextBlock Text="Reports" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>
                        </ListBox>

                        <!--
                            Settings opens a dialog rather than a tab, so it sits outside the list and
                            can't take its selection: the highlighted page stays the one on screen. That's
                            what ItemType="Button" in FooterItems used to buy, and it's still the bottom of
                            the drawer, where the gear was. Height overrides App.xaml.cs's 24px ButtonAdv
                            type default (a Height set in XAML wins) so the row matches the ones above it.
                        -->
                        <syncfusion:ButtonAdv x:Name="SettingsNavButton"
                                              Grid.Row="2"
                                              Label="Settings"
                                              IconTemplate="{StaticResource SettingsIconTemplate}"
                                              Height="34"
                                              Margin="0,8,0,0"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Left"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              ToolTip="Units of measure, categories, roles and costing defaults"
                                              Click="SettingsNavButton_Click" />
                    </Grid>
                </Border>
            </syncfusion:SfNavigationDrawer.DrawerContentView>

            <syncfusion:SfNavigationDrawer.ContentView>
                <!--
                    CloseMode="Hide", not the default Delete: closing a tab (the common close
                    button, a tab's own context-menu Close, etc.) only collapses its
                    TabItemExt rather than removing it from Items. This matters because
                    TabControlExt's header strip fails to redraw a header for a TabItemExt
                    instance that has ever actually left Items — re-adding the same
                    (Delete-mode-removed) instance from the drawer's click handler left the
                    tab's content showing with no header at all in the strip. With Hide mode
                    the instance never leaves Items, so MainWindow.xaml.cs's drawer handler
                    only has to flip Visibility back to Visible and select it.

                    IsDisableUnloadTabItemExtContent="True" keeps every tab's content loaded while
                    another tab is showing (the default unloads it), so a screen's scroll position,
                    sorting, sub-tab, focus and typed text are still there when you come back.
                    MainWindow.xaml.cs refreshes the screen's data on each return, and each
                    ViewModel's LoadCommand merges that data in without disturbing its state.
                -->
                <syncfusion:TabControlExt x:Name="MainTabControl" Margin="0" CloseMode="Hide"
                                          Background="{StaticResource PageBackgroundBrush}"
                                          TabPanelBackground="{StaticResource PageTabStripBrush}"
                                          TabItemSelectedBackground="{StaticResource PageBackgroundBrush}"
                                          TabItemHoverBackground="{StaticResource PageTabHoverBrush}"
                                          IsDisableUnloadTabItemExtContent="True"
                                          EnableLabelEdit="False"
                                          SelectionChanged="MainTabControl_SelectionChanged">
                    <!--
                        Back and Forward between screens, as a browser has them (NavigationHistory): a step is a change
                        of screen, and going back reopens the record that screen had open. Alt+Left and Alt+Right do the
                        same (MainWindow.xaml.cs). At the strip's right end (2026-09-25, at the user's request; they were
                        in the title bar before): TabPanelItem is the one slot the theme's tab strip has for content of
                        its own, docked right after the strip's tab-list and close buttons. The control's own scroll
                        buttons (TabScrollButtonVisibility) only scroll an overflowing strip, so they can't do this.
                        While the menu is open they're under the drawer's scrim, so a first click puts the menu away; the
                        keys still work.
                        Built like the strip's own close (✕) and tab-list (˅) buttons, so they look and behave like them
                        (2026-09-26, at the user's request): a plain WPF Button, 16×16 with an 8px margin after it, in the
                        theme's WPFGlyphButtonStyle, fetched by its ThemeKey as a DynamicResource. The Sample Browser's
                        {sfskin:ThemeResource} form doesn't work here: it looks the style up once, before OnStartup's
                        SetTheme has merged the theme's dictionaries into this window, and never again.
                        The template's TabPanelCaptionButtonsStyle is based on that style and has the same rounded hover
                        wash, pressed state and plain disabled glyph. A ButtonAdv can't match them: it has the theme's 24px
                        minimum height (and App.xaml.cs's 24px default), and an opaque hover and disabled fill that
                        Background="Transparent" doesn't reach. Not focusable, like the ✕: a focused glyph button keeps
                        its hover wash, so it would stay lit after a click.
                        The arrows are 10px Segoe Fluent glyphs, which draw about 8px, the size of the ✕ and ˅ paths.
                        They take the Button's Foreground, which the style's triggers change on hover, press and disable.
                    -->
                    <syncfusion:TabControlExt.TabPanelItem>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BackButton"
                                    Width="16"
                                    Height="16"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Focusable="False"
                                    Style="{DynamicResource {skinManager:ThemeKey Key=WPFGlyphButtonStyle, Theme={x:Type sfTheme:Windows11LightSkinHelper}}}"
                                    IsEnabled="{Binding Navigation.CanGoBack}"
                                    ToolTip="Back (Alt+Left)"
                                    AutomationProperties.Name="Back"
                                    Click="BackButton_Click">
                                <TextBlock Text="&#xE72B;" Style="{StaticResource IconGlyphStyle}" FontSize="10" />
                            </Button>
                            <Button x:Name="ForwardButton"
                                    Width="16"
                                    Height="16"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Focusable="False"
                                    Style="{DynamicResource {skinManager:ThemeKey Key=WPFGlyphButtonStyle, Theme={x:Type sfTheme:Windows11LightSkinHelper}}}"
                                    IsEnabled="{Binding Navigation.CanGoForward}"
                                    ToolTip="Forward (Alt+Right)"
                                    AutomationProperties.Name="Forward"
                                    Click="ForwardButton_Click">
                                <TextBlock Text="&#xE72A;" Style="{StaticResource IconGlyphStyle}" FontSize="10" />
                            </Button>
                        </StackPanel>
                    </syncfusion:TabControlExt.TabPanelItem>
                    <syncfusion:TabItemExt x:Name="RawMaterialsTab" Header="Raw Materials" />
                    <syncfusion:TabItemExt x:Name="SubAssembliesTab" Header="Sub-Assemblies" />
                    <syncfusion:TabItemExt x:Name="ProductsTab" Header="Products" />
                    <syncfusion:TabItemExt x:Name="ReportsTab" Header="Reports" />
                    <!--
                        Print, opened by the Products header's Print and closed with its ✕ (hidden, as CloseMode says);
                        not in the menu, since it prints what Products has open. Hidden until then.
                    -->
                    <syncfusion:TabItemExt x:Name="PrintTab" Header="Print" Visibility="Collapsed" />
                </syncfusion:TabControlExt>
            </syncfusion:SfNavigationDrawer.ContentView>
        </syncfusion:SfNavigationDrawer>
    </Grid>
</controls:AppWindow>
