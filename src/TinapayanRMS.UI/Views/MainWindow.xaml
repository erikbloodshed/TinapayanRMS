<Window x:Class="TinapayanRMS.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:skinManager="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="800" Width="1400"
        skinManager:SfSkinManager.SizeMode="Default">
    <Window.Resources>
        <!--
            A NavigationItem's Icon is dropped into a fixed-size ContentPresenter in the
            drawer's item template, so the icon element has to center itself — without
            these alignments the glyph sits wherever the box's default alignment and
            negative left margin leave it. Matches how Syncfusion's own NavigationDrawer
            demo aligns its Path icons.
        -->
        <Style x:Key="NavigationIconStyle" TargetType="TextBlock" BasedOn="{StaticResource IconGlyphStyle}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <TextBlock Text="{Binding Heading}" Style="{StaticResource AppTitleStyle}" />
        </Border>

        <!--
            DisplayMode=Compact, not the default: only the Compact/Expanded control template
            draws the drawer's own built-in hamburger toggle (two-way bound to IsOpen) and
            renders the Items collection. The Default mode's template has neither — it draws
            no toggle at all and presents DrawerContentView instead — so it would need a
            hand-rolled toggle button and a hand-rolled menu.
            Collapsed, the drawer is a CompactModeWidth-wide icon rail, which is why every
            NavigationItem needs an Icon; expanded, it overlays the content at DrawerWidth
            and shows the headers too.
        -->
        <syncfusion:SfNavigationDrawer x:Name="NavigationDrawer"
                                        Grid.Row="1"
                                        DisplayMode="Compact"
                                        DrawerWidth="220"
                                        ItemClicked="NavigationDrawer_ItemClicked">
            <syncfusion:SfNavigationDrawer.ToggleButtonContentTemplate>
                <DataTemplate>
                    <TextBlock Text="Navigate" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0,0,0" />
                </DataTemplate>
            </syncfusion:SfNavigationDrawer.ToggleButtonContentTemplate>

            <syncfusion:SfNavigationDrawer.Items>
                <syncfusion:NavigationItem x:Name="RawMaterialsNavItem" Header="Raw Materials" IsSelected="True">
                    <syncfusion:NavigationItem.Icon>
                        <TextBlock Text="&#xE8F1;" Style="{StaticResource NavigationIconStyle}" />
                    </syncfusion:NavigationItem.Icon>
                </syncfusion:NavigationItem>
                <syncfusion:NavigationItem x:Name="SubAssembliesNavItem" Header="Sub-Assemblies">
                    <syncfusion:NavigationItem.Icon>
                        <TextBlock Text="&#xE8FD;" Style="{StaticResource NavigationIconStyle}" />
                    </syncfusion:NavigationItem.Icon>
                </syncfusion:NavigationItem>
                <syncfusion:NavigationItem x:Name="ProductsNavItem" Header="Products">
                    <syncfusion:NavigationItem.Icon>
                        <TextBlock Text="&#xE71D;" Style="{StaticResource NavigationIconStyle}" />
                    </syncfusion:NavigationItem.Icon>
                </syncfusion:NavigationItem>
                <syncfusion:NavigationItem x:Name="ReportsNavItem" Header="Reports">
                    <syncfusion:NavigationItem.Icon>
                        <TextBlock Text="&#xEB05;" Style="{StaticResource NavigationIconStyle}" />
                    </syncfusion:NavigationItem.Icon>
                </syncfusion:NavigationItem>
            </syncfusion:SfNavigationDrawer.Items>

            <!--
                Settings opens a dialog rather than a tab, so it's ItemType="Button": clicking it raises
                ItemClicked without selecting it, and the highlighted page stays the one on screen.
            -->
            <syncfusion:SfNavigationDrawer.FooterItems>
                <syncfusion:NavigationItem x:Name="SettingsNavItem" Header="Settings" ItemType="Button">
                    <syncfusion:NavigationItem.Icon>
                        <TextBlock Text="&#xE713;" Style="{StaticResource NavigationIconStyle}" />
                    </syncfusion:NavigationItem.Icon>
                </syncfusion:NavigationItem>
            </syncfusion:SfNavigationDrawer.FooterItems>

            <syncfusion:SfNavigationDrawer.ContentView>
                <!--
                    CloseMode="Hide", not the default Delete: closing a tab (the common close
                    button, a tab's own context-menu Close, etc.) only collapses its
                    TabItemExt rather than removing it from Items. This matters because
                    TabControlExt's header strip fails to redraw a header for a TabItemExt
                    instance that has ever actually left Items — re-adding the same
                    (Delete-mode-removed) instance from the drawer's click handler left the
                    tab's content showing with no header at all in the strip. With Hide mode
                    the instance never leaves Items, so MainWindow.xaml.cs's drawer handler
                    only has to flip Visibility back to Visible and select it.

                    IsDisableUnloadTabItemExtContent="True" keeps every tab's content loaded while
                    another tab is showing (the default unloads it), so a screen's scroll position,
                    sorting, sub-tab, focus and typed text are still there when you come back.
                    MainWindow.xaml.cs refreshes the screen's data on each return, and each
                    ViewModel's LoadCommand merges that data in without disturbing its state.
                -->
                <syncfusion:TabControlExt x:Name="MainTabControl" Margin="8" CloseMode="Hide"
                                          IsDisableUnloadTabItemExtContent="True"
                                          SelectionChanged="MainTabControl_SelectionChanged">
                    <syncfusion:TabItemExt x:Name="RawMaterialsTab" Header="Raw Materials" />
                    <syncfusion:TabItemExt x:Name="SubAssembliesTab" Header="Sub-Assemblies" />
                    <syncfusion:TabItemExt x:Name="ProductsTab" Header="Products" />
                    <syncfusion:TabItemExt x:Name="ReportsTab" Header="Reports" />
                </syncfusion:TabControlExt>
            </syncfusion:SfNavigationDrawer.ContentView>
        </syncfusion:SfNavigationDrawer>
    </Grid>
</Window>
