<UserControl x:Class="TinapayanRMS.UI.Views.Products.ProductHeaderCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:viewModels="clr-namespace:TinapayanRMS.UI.ViewModels">
    <UserControl.Resources>
        <!-- A figure: a muted label over its value -->
        <Style x:Key="FigureLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldLabelStyle}" />
        <Style x:Key="FigureValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource HeadingForegroundBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="FigureAmountStyle" TargetType="TextBlock" BasedOn="{StaticResource FigureValueStyle}">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <!-- The markup the current price earns: red when the price doesn't cover the base cost -->
        <Style x:Key="CurrentMarkupStyle" TargetType="TextBlock" BasedOn="{StaticResource FigureAmountStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Costs.IsCurrentPriceBelowCost}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource ErrorForegroundBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            The Category picker's rows: a line under its "< Add New .. >" row (ProductsViewModel.AddNewCategory), drawn as
            Raw Materials' SummaryHeaderCard draws its own, and for the same reasons (a row's ContentTemplate, since the
            picker needs DisplayMemberPath).
        -->
        <DataTemplate x:Key="AddNewCategoryTemplate">
            <Border HorizontalAlignment="Stretch"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="0,0,0,5"
                    Margin="0,0,0,3">
                <TextBlock Text="{Binding Name}" />
            </Border>
        </DataTemplate>
        <Style x:Key="CategoryOptionStyle" TargetType="syncfusion:ComboBoxItemAdv" BasedOn="{StaticResource {x:Type syncfusion:ComboBoxItemAdv}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Id}" Value="{x:Static viewModels:ProductsViewModel.AddNewCategoryId}">
                    <Setter Property="ContentTemplate" Value="{StaticResource AddNewCategoryTemplate}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The description under the title, as a link: just its content, in the accent, underlined under the mouse -->
        <Style x:Key="DescriptionLinkStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="0,2">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LinkTextStyle" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="TextDecorations" Value="Underline" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!--
        The product's title under its initial, with its description as a link under the title (the link opens
        a pop-up to edit it), and New/Save/Delete; then a row of figures: the name, the category, the base unit, the
        material cost and selling price per piece, the price the shop charges now (entered) with the markup it earns,
        and when it was last saved.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Width="40"
                    Height="40"
                    Margin="0,0,12,0"
                    CornerRadius="8"
                    VerticalAlignment="Center"
                    Background="{StaticResource AccentSoftBrush}">
                <TextBlock Text="{Binding HeaderInitial}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="{Binding HeaderTitle}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource HeadingForegroundBrush}"
                           TextTrimming="CharacterEllipsis" />

                <Button x:Name="DescriptionLink"
                        Style="{StaticResource DescriptionLinkStyle}"
                        Command="{Binding EditDescriptionCommand}"
                        ToolTip="Edit the description">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE70F;" Style="{StaticResource IconGlyphStyle}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DescriptionLinkText}" Style="{StaticResource LinkTextStyle}" />
                    </StackPanel>
                </Button>

                <!--
                    The description's editor, under the link. It edits the form's description as it's typed:
                    Done or a click elsewhere keeps it, Cancel (or Esc) puts back what was there. Save saves it.
                -->
                <Popup IsOpen="{Binding IsDescriptionEditorOpen, Mode=TwoWay}"
                       PlacementTarget="{Binding ElementName=DescriptionLink}"
                       Placement="Bottom"
                       VerticalOffset="4"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       Opened="OnDescriptionEditorOpened">
                    <Border Width="420"
                            Margin="0,0,8,8"
                            Padding="12"
                            CornerRadius="8"
                            Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.18" />
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Description" Style="{StaticResource FieldLabelStyle}" />
                            <syncfusion:SfTextBoxExt x:Name="DescriptionBox"
                                                     Height="64"
                                                     MaxLength="500"
                                                     TextWrapping="Wrap"
                                                     VerticalContentAlignment="Top"
                                                     Text="{Binding EditingDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <syncfusion:SfTextBoxExt.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding CloseDescriptionEditorCommand}" />
                                    <KeyBinding Key="Escape" Command="{Binding CancelDescriptionEditCommand}" />
                                </syncfusion:SfTextBoxExt.InputBindings>
                            </syncfusion:SfTextBoxExt>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <syncfusion:ButtonAdv Label="Cancel" IconTemplate="{StaticResource CancelIconTemplate}" Command="{Binding CancelDescriptionEditCommand}" Margin="0,0,8,0" />
                                <syncfusion:ButtonAdv Label="Done" IconTemplate="{StaticResource ApplyIconTemplate}" Command="{Binding CloseDescriptionEditorCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                <syncfusion:ButtonAdv Label="New" IconTemplate="{StaticResource AddIconTemplate}" Command="{Binding NewCommand}" Margin="0,0,8,0" />
                <syncfusion:ButtonAdv Label="Save"
                                      IconTemplate="{StaticResource SaveIconTemplate}"
                                      Command="{Binding SaveCommand}"
                                      ToolTip="Saves the details, recipe, packaging and costing together."
                                      Margin="0,0,8,0" />
                <syncfusion:ButtonAdv Label="Delete" IconTemplate="{StaticResource DeleteIconTemplate}" Command="{Binding DeleteCommand}" />
            </StackPanel>
        </Grid>

        <!-- The figures: labels over values. Every cost and price on this screen is per piece, worked out from the form as it's edited. -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="1.3*" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="Product Name" Style="{StaticResource FigureLabelStyle}" />
            <syncfusion:SfTextBoxExt x:Name="NameTextBox"
                                     Grid.Row="1"
                                     Text="{Binding EditingName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Column="2" Text="Category" Style="{StaticResource FigureLabelStyle}" />
            <syncfusion:ComboBoxAdv Grid.Row="1"
                                    Grid.Column="2"
                                    ItemsSource="{Binding CategoryOptions}"
                                    DisplayMemberPath="Name"
                                    ItemContainerStyle="{StaticResource CategoryOptionStyle}"
                                    SelectedItem="{Binding EditingCategory, Mode=TwoWay}"
                                    Text="{Binding CategorySearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    ToolTip="What the Products list groups it under. Pick a category, or &quot;&lt; Add New .. &gt;&quot; to name one now." />

            <TextBlock Grid.Column="4" Text="Base Unit" Style="{StaticResource FigureLabelStyle}" />
            <TextBlock Grid.Row="1" Grid.Column="4" Text="piece (pc)" Style="{StaticResource FigureValueStyle}" />

            <TextBlock Grid.Column="6" Text="Material Cost" Style="{StaticResource FigureLabelStyle}" ToolTip="Per piece: its sub-assemblies' share and its packaging" />
            <TextBlock Grid.Row="1" Grid.Column="6" Text="{Binding Costs.Material, StringFormat='₱{0:N4}'}" Style="{StaticResource FigureAmountStyle}" />

            <TextBlock Grid.Column="8" Text="Selling Price" Style="{StaticResource FigureLabelStyle}" ToolTip="Per piece, with VAT" />
            <TextBlock Grid.Row="1"
                       Grid.Column="8"
                       Text="{Binding Costs.SellingPrice, StringFormat='₱{0:N2}'}"
                       Style="{StaticResource FigureAmountStyle}"
                       Foreground="{StaticResource AccentBrush}" />

            <!-- Entered, and saved with the product. Empty rather than 0.00 until typed (UseNullOption). -->
            <TextBlock Grid.Column="10" Text="Current Price" Style="{StaticResource FigureLabelStyle}" ToolTip="Per piece, with VAT: what the shop charges now" />
            <syncfusion:CurrencyTextBox Grid.Row="1"
                                        Grid.Column="10"
                                        Value="{Binding EditingCurrentPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        UseNullOption="True"
                                        NullValue="{x:Null}"
                                        MinValue="0"
                                        CurrencySymbol="₱"
                                        CurrencyDecimalDigits="2"
                                        ToolTip="Per piece, with VAT: what the shop charges now. Markup % shows what it earns." />

            <TextBlock Grid.Column="12"
                       Text="Markup %"
                       Style="{StaticResource FigureLabelStyle}"
                       ToolTip="What the current price earns on the base cost, VAT taken out: the costing's Markup % at that price" />
            <TextBlock Grid.Row="1"
                       Grid.Column="12"
                       Text="{Binding Costs.CurrentMarkupPercent, StringFormat='{}{0:N2}%', TargetNullValue='—'}"
                       Style="{StaticResource CurrentMarkupStyle}" />

            <TextBlock Grid.Column="14" Text="Last Updated" Style="{StaticResource FigureLabelStyle}" />
            <TextBlock Grid.Row="1"
                       Grid.Column="14"
                       Text="{Binding LastUpdatedText}"
                       ToolTip="{Binding LastUpdatedText}"
                       Style="{StaticResource FigureValueStyle}" />
        </Grid>
    </Grid>
</UserControl>
