<UserControl x:Class="TinapayanRMS.UI.Views.Products.ProductHeaderCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:controls="clr-namespace:TinapayanRMS.UI.Controls">
    <UserControl.Resources>
        <!-- A figure: a muted label over its value -->
        <Style x:Key="FigureLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldLabelStyle}" />
        <Style x:Key="FigureValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource HeadingForegroundBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="FigureSeparatorStyle" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="16,0" />
            <Setter Property="Background" Value="{StaticResource CardBorderBrush}" />
        </Style>
        <Style x:Key="FigureAmountStyle" TargetType="TextBlock" BasedOn="{StaticResource FigureValueStyle}">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <!-- The markup the current price earns: red when the price doesn't cover the base cost -->
        <Style x:Key="CurrentMarkupStyle" TargetType="TextBlock" BasedOn="{StaticResource FigureAmountStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Costs.IsCurrentPriceBelowCost}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource ErrorForegroundBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The description under the title, as a link: just its content, in the accent, underlined under the mouse -->
        <Style x:Key="DescriptionLinkStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="0,2">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LinkTextStyle" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="TextDecorations" Value="Underline" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!--
        The product's title under its initial, with its description as a link under the title (the link opens
        a pop-up to edit it), and New/Save/Delete; then a row of figures, nothing typed into: the material cost and
        base cost for one sellable unit, the price the shop charges now with the markup it earns, and when it was
        last saved. The name, category, quantity required and current price are typed in under the header
        (ProductDetailsCard).
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="{Binding HeaderTitle}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource HeadingForegroundBrush}"
                           TextTrimming="CharacterEllipsis" />

                <Button x:Name="DescriptionLink"
                        Style="{StaticResource DescriptionLinkStyle}"
                        Command="{Binding EditDescriptionCommand}"
                        ToolTip="Edit the description">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE70F;" Style="{StaticResource IconGlyphStyle}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DescriptionLinkText}" Style="{StaticResource LinkTextStyle}" />
                    </StackPanel>
                </Button>

                <!--
                    The description's editor, under the link. It edits the form's description as it's typed:
                    Done or a click elsewhere keeps it, Cancel (or Esc) puts back what was there. Save saves it.
                -->
                <Popup IsOpen="{Binding IsDescriptionEditorOpen, Mode=TwoWay}"
                       PlacementTarget="{Binding ElementName=DescriptionLink}"
                       Placement="Bottom"
                       VerticalOffset="4"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       Opened="OnDescriptionEditorOpened">
                    <Border Width="420"
                            Margin="0,0,8,8"
                            Padding="12"
                            CornerRadius="8"
                            Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.18" />
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Description" Style="{StaticResource FieldLabelStyle}" />
                            <syncfusion:SfTextBoxExt x:Name="DescriptionBox"
                                                     Height="64"
                                                     MaxLength="500"
                                                     TextWrapping="Wrap"
                                                     VerticalContentAlignment="Top"
                                                     controls:FieldUndoStep.Recorder="{Binding}"
                                                     Text="{Binding EditingDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <syncfusion:SfTextBoxExt.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding CloseDescriptionEditorCommand}" />
                                    <KeyBinding Key="Escape" Command="{Binding CancelDescriptionEditCommand}" />
                                </syncfusion:SfTextBoxExt.InputBindings>
                            </syncfusion:SfTextBoxExt>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <syncfusion:ButtonAdv Label="Cancel" IconTemplate="{StaticResource CancelIconTemplate}" Command="{Binding CancelDescriptionEditCommand}" Margin="0,0,8,0" />
                                <syncfusion:ButtonAdv Label="Done" IconTemplate="{StaticResource ApplyIconTemplate}" Command="{Binding CloseDescriptionEditorCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <syncfusion:ButtonAdv Label="New" IconTemplate="{StaticResource AddIconTemplate}" Command="{Binding NewCommand}" Margin="0,0,8,0" />
                <syncfusion:ButtonAdv Label="Save"
                                      IconTemplate="{StaticResource SaveIconTemplate}"
                                      Command="{Binding SaveCommand}"
                                      ToolTip="Saves the details, recipe, packaging and costing together."
                                      Margin="0,0,8,0" />
                <!-- One finished change at a time, where Revert below throws away everything since the last Save. -->
                <syncfusion:ButtonAdv Label="Undo"
                                      IconTemplate="{StaticResource UndoIconTemplate}"
                                      Command="{Binding UndoCommand}"
                                      ToolTip="Takes back the last change: a quantity typed, a line added or removed, a sub-assembly put in. Ctrl+Z."
                                      Margin="0,0,8,0" />
                <syncfusion:ButtonAdv Label="Redo"
                                      IconTemplate="{StaticResource RedoIconTemplate}"
                                      Command="{Binding RedoCommand}"
                                      ToolTip="Puts back the change the last Undo took. Ctrl+Y."
                                      Margin="0,0,8,0" />

                <!-- The one discard on the screen: the sub-assembly form has none of its own, so a section being added goes with the rest. -->
                <syncfusion:ButtonAdv Label="Revert"
                                      IconTemplate="{StaticResource CancelIconTemplate}"
                                      Command="{Binding RevertCommand}"
                                      ToolTip="Puts the product back as it was last saved: the details, recipe, packaging and costing, and any sub-assembly being added or edited."
                                      Margin="0,0,8,0" />
                <syncfusion:ButtonAdv Label="Delete" IconTemplate="{StaticResource DeleteIconTemplate}" Command="{Binding DeleteCommand}" />
            </StackPanel>
        </Grid>

        <!--
            The figures: labels over values, nothing typed into. Every cost and price on this screen is for one whole
            sellable unit — a piece, unless Quantity Required says otherwise, which CostUnitCaption spells out in each
            tooltip — worked out from the form as it's edited; the current price shows as it's typed in under the header.
        -->
        <Grid Grid.Row="1" Margin="0,4,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1.3*" />
            </Grid.ColumnDefinitions>

            <!-- A thin line between each figure and the next, as the Raw Materials header has -->
            <Border Grid.Column="1" Grid.RowSpan="2" Style="{StaticResource FigureSeparatorStyle}" />
            <Border Grid.Column="3" Grid.RowSpan="2" Style="{StaticResource FigureSeparatorStyle}" />
            <Border Grid.Column="5" Grid.RowSpan="2" Style="{StaticResource FigureSeparatorStyle}" />
            <Border Grid.Column="7" Grid.RowSpan="2" Style="{StaticResource FigureSeparatorStyle}" />

            <TextBlock Text="Material Cost"
                       Style="{StaticResource FigureLabelStyle}"
                       ToolTip="{Binding CostUnitCaption, StringFormat='{}{0}: the share of every sub-assembly it holds, plus its packaging'}" />
            <TextBlock Grid.Row="1" Text="{Binding Costs.Material, StringFormat='{}{0:N2}'}" Style="{StaticResource FigureAmountStyle}" />

            <TextBlock Grid.Column="2"
                       Text="Base Cost"
                       Style="{StaticResource FigureLabelStyle}"
                       ToolTip="{Binding CostUnitCaption, StringFormat='{}{0}: the material cost with labor, overhead and administrative on top, before markup and VAT'}" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Costs.BaseCost, StringFormat='{}{0:N2}'}" Style="{StaticResource FigureAmountStyle}" />

            <TextBlock Grid.Column="4"
                       Text="Current Price"
                       Style="{StaticResource FigureLabelStyle}"
                       ToolTip="{Binding CostUnitCaption, StringFormat='{}{0}, with VAT: what the shop charges now'}" />
            <TextBlock Grid.Row="1"
                       Grid.Column="4"
                       Text="{Binding EditingCurrentPrice, StringFormat='{}{0:N2}', TargetNullValue='—'}"
                       Style="{StaticResource FigureAmountStyle}"
                       Foreground="{StaticResource AccentBrush}" />

            <TextBlock Grid.Column="6"
                       Text="Markup %"
                       Style="{StaticResource FigureLabelStyle}"
                       ToolTip="What the current price earns on the base cost, VAT taken out: the costing's Markup % at that price" />
            <TextBlock Grid.Row="1"
                       Grid.Column="6"
                       Text="{Binding Costs.CurrentMarkupPercent, StringFormat='{}{0:N2}%', TargetNullValue='—'}"
                       Style="{StaticResource CurrentMarkupStyle}" />

            <TextBlock Grid.Column="8" Text="Last Updated" Style="{StaticResource FigureLabelStyle}" />
            <TextBlock Grid.Row="1"
                       Grid.Column="8"
                       Text="{Binding LastUpdatedText}"
                       ToolTip="{Binding LastUpdatedText}"
                       Style="{StaticResource FigureAmountStyle}" />
        </Grid>
    </Grid>
</UserControl>
