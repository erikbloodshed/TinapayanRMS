<UserControl x:Class="TinapayanRMS.UI.Views.Products.ProductHeaderCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf">
    <UserControl.Resources>
        <!-- A value tile: a muted label over a larger value. -->
        <Style x:Key="TileLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldLabelStyle}">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="TileValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{StaticResource HeadingForegroundBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TileAmountStyle" TargetType="TextBlock" BasedOn="{StaticResource TileValueStyle}">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="TileSeparatorStyle" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="16,0" />
            <Setter Property="Background" Value="{StaticResource CardBorderBrush}" />
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource CardStyle}">
        <StackPanel>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <syncfusion:ButtonAdv Label="New" IconTemplate="{StaticResource AddIconTemplate}" Command="{Binding NewCommand}" Margin="0,0,8,0" />
                    <syncfusion:ButtonAdv Label="Save"
                                          IconTemplate="{StaticResource SaveIconTemplate}"
                                          Command="{Binding SaveCommand}"
                                          ToolTip="Saves the details, recipe, packaging and costing together."
                                          Margin="0,0,8,0" />
                    <syncfusion:ButtonAdv Label="Delete" IconTemplate="{StaticResource DeleteIconTemplate}" Command="{Binding DeleteCommand}" />
                </StackPanel>

                <Border DockPanel.Dock="Left"
                        Width="52"
                        Height="52"
                        Margin="0,0,14,0"
                        CornerRadius="10"
                        Background="{StaticResource AccentSoftBrush}">
                    <TextBlock Text="{Binding HeaderInitial}"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding HeaderTitle}"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource HeadingForegroundBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding HeaderCaption}" Style="{StaticResource CaptionStyle}" />
                </StackPanel>
            </DockPanel>

            <!-- The tiles: labels in the first row, values in the second, with separators spanning both -->
            <Border Margin="0,16,0,0"
                    Padding="16,12"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Product Name" Style="{StaticResource TileLabelStyle}" />
                    <syncfusion:SfTextBoxExt x:Name="NameTextBox"
                                             Grid.Row="1"
                                             Grid.Column="0"
                                             Text="{Binding EditingName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- Every cost and price on this screen is per piece -->
                    <Border Grid.Column="1" Grid.RowSpan="2" Style="{StaticResource TileSeparatorStyle}" />
                    <TextBlock Grid.Column="2" Text="Base Unit" Style="{StaticResource TileLabelStyle}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="piece (pc)" Style="{StaticResource TileValueStyle}" />

                    <!-- Worked out from the form as it's edited, so unsaved changes show -->
                    <Border Grid.Column="3" Grid.RowSpan="2" Style="{StaticResource TileSeparatorStyle}" />
                    <TextBlock Grid.Column="4"
                               Text="Material Cost"
                               Style="{StaticResource TileLabelStyle}"
                               ToolTip="Per piece: its sub-assemblies' share and its packaging" />
                    <TextBlock Grid.Row="1"
                               Grid.Column="4"
                               Style="{StaticResource TileAmountStyle}"
                               Text="{Binding Costs.Material, StringFormat='₱{0:N4}'}" />

                    <Border Grid.Column="5" Grid.RowSpan="2" Style="{StaticResource TileSeparatorStyle}" />
                    <TextBlock Grid.Column="6" Text="Selling Price" Style="{StaticResource TileLabelStyle}" />
                    <TextBlock Grid.Row="1"
                               Grid.Column="6"
                               Style="{StaticResource TileAmountStyle}"
                               Foreground="{StaticResource AccentBrush}"
                               Text="{Binding Costs.SellingPrice, StringFormat='₱{0:N2}'}" />

                    <Border Grid.Column="7" Grid.RowSpan="2" Style="{StaticResource TileSeparatorStyle}" />
                    <!-- When it was last saved: the date, and the time under it -->
                    <TextBlock Grid.Column="8" Text="Last Updated" Style="{StaticResource TileLabelStyle}" />
                    <StackPanel Grid.Row="1" Grid.Column="8" VerticalAlignment="Center">
                        <TextBlock Text="{Binding LastUpdatedText}" Style="{StaticResource TileValueStyle}" />
                        <TextBlock Text="{Binding LastUpdatedTimeText}" Style="{StaticResource CaptionStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="Description" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,4" />
            <syncfusion:SfTextBoxExt MaxLength="500"
                                     Watermark="A short description, e.g. soft bread with a creamy filling"
                                     WatermarkTemplate="{StaticResource AlignedWatermarkTemplate}"
                                     Text="{Binding EditingDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
    </Border>
</UserControl>
