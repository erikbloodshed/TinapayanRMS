<UserControl x:Class="TinapayanRMS.UI.Views.Products.ProductHeaderCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf">
    <UserControl.Resources>
        <!-- A figure: its label (FigureTileLabelStyle) over its value, both centred in its tile (2026-09-25, at the user's request) -->
        <Style x:Key="FigureValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{StaticResource HeadingForegroundBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="6,0,6,8" />
        </Style>
        <Style x:Key="FigureAmountStyle" TargetType="TextBlock" BasedOn="{StaticResource FigureValueStyle}">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <!-- The markup the current price earns: red when the price doesn't cover the base cost -->
        <Style x:Key="CurrentMarkupStyle" TargetType="TextBlock" BasedOn="{StaticResource FigureAmountStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Costs.IsCurrentPriceBelowCost}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource ErrorForegroundBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!--
        The product's title (with, for one not saved yet, where Save will file it) and New (a product, or a composite one)/Save/Delete, a line under them, then a row of figures, nothing typed into: the material cost and
        base cost for one sellable unit, the price the shop charges now with the markup it earns, and when it was
        last saved. The name, category, quantity required and current price are typed in under the header
        (ProductDetailsCard).
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--
                The title, and while the product isn't saved yet, where Save will file it (NewProductTag), styled as the
                "Moves to Sub-Assemblies on Save" badge. Left-aligned with the tag docked first, so the tag sits just after
                the name and a long name trims while the tag stays in sight.
            -->
            <DockPanel HorizontalAlignment="Left" Margin="0,0,12,0">
                <Border DockPanel.Dock="Right"
                        Style="{StaticResource LinkedBadgeStyle}"
                        ToolTip="Where Save files this new product in the Products list: Research and Development after New, or the folder New Product Here was picked on."
                        Visibility="{Binding NewProductTag, Converter={StaticResource NotNullToVisibilityConverter}}">
                    <TextBlock Text="{Binding NewProductTag}" FontSize="13" Foreground="{StaticResource WarningForegroundBrush}" />
                </Border>
                <TextBlock Text="{Binding HeaderTitle}"
                           VerticalAlignment="Center"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource HeadingForegroundBrush}"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <!--
                    New starts a product made of sub-assemblies; its arrow offers a composite product, made of other
                    products, too. A SplitButtonAdv is a DropDownButtonAdv with a button of its own, so its drop-down is
                    built as Add Sub-Assembly's is: flattened ButtonAdv items, each closing the drop-down on its click
                    (NewItem_Click), properties only so the theme's templates stay intact.
                -->
                <syncfusion:SplitButtonAdv x:Name="NewButton"
                                           Label="New"
                                           IconTemplate="{StaticResource AddIconTemplate}"
                                           Command="{Binding NewCommand}"
                                           ToolTip="A new product. The arrow offers a composite product, made of other products, too."
                                           Margin="0,0,8,0">
                    <StackPanel MinWidth="190" Margin="2">
                        <syncfusion:ButtonAdv Label="New product"
                                              ToolTip="A product made of sub-assemblies: its recipe, its packaging and its costing."
                                              IconTemplate="{StaticResource AddIconTemplate}"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Left"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Command="{Binding NewCommand}"
                                              Click="NewItem_Click" />
                        <syncfusion:ButtonAdv Label="New composite product"
                                              ToolTip="A product made of two or more other products, such as a Pasalubong Box, with its own packaging and any topping or filling over the whole. Each product brings its recipe cost."
                                              IconTemplate="{StaticResource CompositeIconTemplate}"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Left"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Margin="0,2,0,0"
                                              Command="{Binding NewCompositeCommand}"
                                              Click="NewItem_Click" />
                    </StackPanel>
                </syncfusion:SplitButtonAdv>
                <syncfusion:ButtonAdv Label="Save"
                                      IconTemplate="{StaticResource SaveIconTemplate}"
                                      Command="{Binding SaveCommand}"
                                      ToolTip="Saves the details, recipe, packaging and costing together."
                                      Margin="0,0,8,0" />
                <!-- One finished change at a time, where Revert below throws away everything since the last Save. -->
                <syncfusion:ButtonAdv Label="Undo"
                                      IconTemplate="{StaticResource UndoIconTemplate}"
                                      Command="{Binding UndoCommand}"
                                      ToolTip="Takes back the last change: a quantity typed, a line added or removed, a sub-assembly put in. Ctrl+Z."
                                      Margin="0,0,8,0" />
                <syncfusion:ButtonAdv Label="Redo"
                                      IconTemplate="{StaticResource RedoIconTemplate}"
                                      Command="{Binding RedoCommand}"
                                      ToolTip="Puts back the change the last Undo took. Ctrl+Y."
                                      Margin="0,0,8,0" />

                <!-- The one discard on the screen: the sub-assembly form has none of its own, so a section being added goes with the rest. -->
                <syncfusion:ButtonAdv Label="Revert"
                                      IconTemplate="{StaticResource CancelIconTemplate}"
                                      Command="{Binding RevertCommand}"
                                      ToolTip="Puts the product back as it was last saved: the details, recipe, packaging and costing, and any sub-assembly being added or edited."
                                      Margin="0,0,8,0" />

                <!-- The product as the screen shows it, unsaved edits included, on the main window's Print tab (ProductPrintView). -->
                <syncfusion:ButtonAdv Label="Print"
                                      IconTemplate="{StaticResource PrintIconTemplate}"
                                      Command="{Binding PrintCommand}"
                                      ToolTip="Opens the Print tab, which previews and prints this product's recipe and costing as this screen shows them."
                                      Margin="0,0,8,0" />
                <syncfusion:ButtonAdv Label="Delete" IconTemplate="{StaticResource DeleteIconTemplate}" Command="{Binding DeleteCommand}" />
            </StackPanel>
        </Grid>

        <!-- A line between the title row and the figures, as the Sub-Assemblies and Raw Materials headers have -->
        <Border Grid.Row="1" Style="{StaticResource SectionDividerStyle}" />

        <!--
            The figures: labels over values, nothing typed into. Every cost and price on this screen is for one whole
            sellable unit — a piece, unless Quantity Required says otherwise, which CostUnitCaption spells out in each
            tooltip — worked out from the form as it's edited; the current price shows as it's typed in under the header.
        -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--
                Each figure on a tile of its own colour, a gap between each and the next, as the Raw Materials and
                Sub-Assemblies headers have. Current Price is on the accent's Sky, so its value is plain Text: Sky's Deep
                shade makes only 4.4:1 on the Sky Wash.
            -->
            <Border Grid.Column="0" Grid.RowSpan="2" Style="{StaticResource FigureTileStyle}" Background="{StaticResource PeachTileBrush}" />
            <Border Grid.Column="1" Grid.RowSpan="2" Style="{StaticResource FigureTileGapStyle}" />
            <Border Grid.Column="2" Grid.RowSpan="2" Style="{StaticResource FigureTileStyle}" Background="{StaticResource PinkTileBrush}" />
            <Border Grid.Column="3" Grid.RowSpan="2" Style="{StaticResource FigureTileGapStyle}" />
            <Border Grid.Column="4" Grid.RowSpan="2" Style="{StaticResource FigureTileStyle}" Background="{StaticResource SkyTileBrush}" />
            <Border Grid.Column="5" Grid.RowSpan="2" Style="{StaticResource FigureTileGapStyle}" />
            <Border Grid.Column="6" Grid.RowSpan="2" Style="{StaticResource FigureTileStyle}" Background="{StaticResource GreenTileBrush}" />
            <Border Grid.Column="7" Grid.RowSpan="2" Style="{StaticResource FigureTileGapStyle}" />
            <Border Grid.Column="8" Grid.RowSpan="2" Style="{StaticResource FigureTileStyle}" Background="{StaticResource MauveTileBrush}" />

            <TextBlock Text="Material Cost"
                       Style="{StaticResource FigureTileLabelStyle}"
                       ToolTip="{Binding MaterialCostTooltip}" />
            <TextBlock Grid.Row="1" Text="{Binding Costs.Material, StringFormat='{}{0:N2}'}" Style="{StaticResource FigureAmountStyle}" />

            <TextBlock Grid.Column="2"
                       Text="Base Cost"
                       Style="{StaticResource FigureTileLabelStyle}"
                       ToolTip="{Binding CostUnitCaption, StringFormat='{}{0}: the material cost with labor, overhead and administrative on top, before markup and VAT'}" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Costs.BaseCost, StringFormat='{}{0:N2}'}" Style="{StaticResource FigureAmountStyle}" />

            <TextBlock Grid.Column="4"
                       Text="Current Price"
                       Style="{StaticResource FigureTileLabelStyle}"
                       ToolTip="{Binding CostUnitCaption, StringFormat='{}{0}, with VAT: what the shop charges now'}" />
            <TextBlock Grid.Row="1"
                       Grid.Column="4"
                       Text="{Binding EditingCurrentPrice, StringFormat='{}{0:N2}', TargetNullValue='—'}"
                       Style="{StaticResource FigureAmountStyle}" />

            <TextBlock Grid.Column="6"
                       Text="Markup %"
                       Style="{StaticResource FigureTileLabelStyle}"
                       ToolTip="What the current price earns on the base cost, VAT taken out: the costing's Markup % at that price" />
            <TextBlock Grid.Row="1"
                       Grid.Column="6"
                       Text="{Binding Costs.CurrentMarkupPercent, StringFormat='{}{0:N2}%', TargetNullValue='—'}"
                       Style="{StaticResource CurrentMarkupStyle}" />

            <TextBlock Grid.Column="8" Text="Last Updated" Style="{StaticResource FigureTileLabelStyle}" />
            <TextBlock Grid.Row="1"
                       Grid.Column="8"
                       Text="{Binding LastUpdatedText}"
                       ToolTip="{Binding LastUpdatedText}"
                       Style="{StaticResource FigureAmountStyle}" />
        </Grid>
    </Grid>
</UserControl>
