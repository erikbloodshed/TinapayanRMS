<UserControl x:Class="TinapayanRMS.UI.Views.Products.ProductListCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:vim="clr-namespace:TinapayanRMS.UI.Vim"
             xmlns:viewModels="clr-namespace:TinapayanRMS.UI.ViewModels">
    <!-- The screen's first region: its title with the search box beside it, then the products in their folders filling the rest. -->
    <Border Style="{StaticResource CardStyle}">
        <DockPanel>
            <!-- Title and search on one row, laid out as the Raw Materials list card lays out its own -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <syncfusion:SfTextBoxExt DockPanel.Dock="Right"
                                         Width="190"
                                         Watermark="Search products"
                                         vim:VimKeys.IsSearchBox="True"
                                         WatermarkTemplate="{StaticResource AlignedWatermarkTemplate}"
                                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Products"
                           Style="{StaticResource PanelHeaderStyle}"
                           Margin="0"
                           VerticalAlignment="Center" />
            </DockPanel>

            <!--
                The list-wide commands, as the tree's menu offers them for its empty space (ProductsViewModel.EmptySpaceMenu),
                as icons named in their tooltips: Small mode shows the icon alone. Not focusable, so Tab goes from the search
                box straight to the tree. The Raw Materials and Sub-Assemblies lists have the same row.
                Centring the glyph takes two settings. A Small button gets Padding 2,0,4,0, so Padding 3,0,3,0 evens it out.
                Its icon box is 16 × 16, with the 14 px glyph drawn in its top-left corner, so IconWidth and IconHeight
                size the box to the glyph.
            -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                <syncfusion:ButtonAdv Label="New Product"
                                      ToolTip="New Product"
                                      SizeMode="Small"
                                      IconWidth="14"
                                      IconHeight="14"
                                      Padding="3,1,3,0"
                                      Focusable="False"
                                      IconTemplate="{StaticResource AddIconTemplate}"
                                      Command="{Binding NewProductInCommand}"
                                      Margin="0,0,6,0" />
                <syncfusion:ButtonAdv Label="New Composite Product"
                                      ToolTip="New Composite Product"
                                      SizeMode="Small"
                                      IconWidth="14"
                                      IconHeight="14"
                                      Padding="3,1,3,0"
                                      Focusable="False"
                                      IconTemplate="{StaticResource CompositeIconTemplate}"
                                      Command="{Binding NewCompositeProductInCommand}"
                                      Margin="0,0,6,0" />
                <syncfusion:ButtonAdv Label="New Category"
                                      ToolTip="New Category…"
                                      SizeMode="Small"
                                      IconWidth="14"
                                      IconHeight="14"
                                      Padding="3,1,3,0"
                                      Focusable="False"
                                      IconTemplate="{StaticResource NewFolderIconTemplate}"
                                      Command="{Binding NewCategoryCommand}"
                                      Margin="0,0,6,0" />
                <syncfusion:ButtonAdv Label="Print All Products"
                                      ToolTip="Print All Products"
                                      SizeMode="Small"
                                      IconWidth="14"
                                      IconHeight="14"
                                      Padding="3,1,3,0"
                                      Focusable="False"
                                      IconTemplate="{StaticResource PrintIconTemplate}"
                                      Command="{Binding PrintAllCommand}"
                                      Margin="0,0,6,0" />
                <syncfusion:ButtonAdv Label="Expand All"
                                      ToolTip="Expand All"
                                      SizeMode="Small"
                                      IconWidth="14"
                                      IconHeight="14"
                                      Padding="3,1,3,0"
                                      Focusable="False"
                                      IconTemplate="{StaticResource ExpandAllIconTemplate}"
                                      Command="{Binding ExpandAllCommand}"
                                      Margin="0,0,6,0" />
                <syncfusion:ButtonAdv Label="Collapse All"
                                      ToolTip="Collapse All"
                                      SizeMode="Small"
                                      IconWidth="14"
                                      IconHeight="14"
                                      Padding="3,1,3,0"
                                      Focusable="False"
                                      IconTemplate="{StaticResource CollapseAllIconTemplate}"
                                      Command="{Binding CollapseAllCommand}" />
            </StackPanel>

            <!--
                What the last move did, with Undo (ProductsViewModel.MoveNotice), under the tree: a drag, Move To or Promote
                saves at once, so this is where one made by mistake is taken back. It hides itself a few seconds on, unless
                the mouse is over it (the code-behind). As wide as the tree, so a long message wraps rather than widening
                the card.
            -->
            <Border x:Name="MoveNoticeBar"
                    DockPanel.Dock="Bottom"
                    Width="{Binding Width, ElementName=Tree}"
                    Margin="0,8,0,0"
                    Padding="10,4,4,4"
                    CornerRadius="6"
                    Background="{StaticResource InfoBackgroundBrush}"
                    Visibility="{Binding MoveNotice, Converter={StaticResource NotNullToVisibilityConverter}}"
                    AutomationProperties.AutomationId="MoveNotice">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource ToastCloseButtonStyle}"
                            Command="{Binding DismissMoveNoticeCommand}"
                            VerticalAlignment="Center"
                            ToolTip="Close"
                            AutomationProperties.Name="Close">
                        <TextBlock Text="&#xE711;" Style="{StaticResource IconGlyphStyle}" FontSize="12" />
                    </Button>
                    <syncfusion:ButtonAdv DockPanel.Dock="Right"
                                          Label="Undo"
                                          IconTemplate="{StaticResource UndoIconTemplate}"
                                          Command="{Binding UndoMoveCommand}"
                                          VerticalAlignment="Center"
                                          Margin="8,0,4,0" />
                    <TextBlock Text="{Binding MoveNotice}"
                               Foreground="{StaticResource InfoForegroundBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!--
                The products filed by stage, then category (ProductsViewModel.ProductTree), each folder's by name, and the
                deleted ones in the Deleted folder after the stages. Clicking a folder opens or closes it; dragging a product onto one moves it there, with Ctrl or Shift held several at
                once; a right-click opens a menu for the row, or for the list in its empty space; and F2, Del and Enter do
                what the menu shows beside them (the code-behind). As wide as the Raw Materials list's two columns, so the
                three lists are the same width.

                White behind it, as the Raw Materials and Sub-Assemblies grids are (ListBackgroundBrush). The theme's template
                draws the tree itself transparent and never reads its Background, so the fill is this Border's, rounded as the
                tree's own border is (the theme's CornerRadius4).
            -->
            <Border CornerRadius="4"
                    Background="{StaticResource ListBackgroundBrush}">
                <syncfusion:SfTreeView x:Name="Tree"
                                       Width="370"
                                       ItemsSource="{Binding ProductTree.Roots}"
                                       SelectedItems="{Binding SelectedTreeNodes}"
                                       SelectionMode="Extended"
                                       ExpandActionTrigger="Node"
                                       FullRowSelect="True"
                                       AllowDragging="True"
                                       AllowDrop="True"
                                       ItemDragStarting="Tree_ItemDragStarting"
                                       ItemDragOver="Tree_ItemDragOver"
                                       ItemDropping="Tree_ItemDropping"
                                       ItemContextMenuOpening="Tree_ItemContextMenuOpening"
                                       ContextMenuOpening="Tree_ContextMenuOpening"
                                       KeyDown="Tree_KeyDown"
                                       FocusVisualStyle="{x:Null}">
                    <!--
                        Stand-ins: the tree opens a row's menu only while ItemContextMenu is set, and the service a menu for
                        its empty space only while ContextMenu is; each is replaced by the one built for where the click
                        was, just before it opens (the code-behind).
                    -->
                    <syncfusion:SfTreeView.ItemContextMenu>
                        <ContextMenu />
                    </syncfusion:SfTreeView.ItemContextMenu>
                    <syncfusion:SfTreeView.ContextMenu>
                        <ContextMenu />
                    </syncfusion:SfTreeView.ContextMenu>
                    <!--
                        Only a folder has rows under it, and whether it's open is kept on it (ProductFolderNode.IsExpanded), so it
                        stays as it was left through a refresh. A product has no descriptor, and so no expander.
                    -->
                    <syncfusion:SfTreeView.HierarchyPropertyDescriptors>
                        <syncfusion:HierarchyPropertyDescriptor TargetType="{x:Type viewModels:ProductFolderNode}"
                                                                ChildPropertyName="Children"
                                                                IsExpandedPropertyName="IsExpanded" />
                    </syncfusion:SfTreeView.HierarchyPropertyDescriptors>
                    <syncfusion:SfTreeView.ItemTemplate>
                        <!-- Every row's data is a ProductTreeNode, so the one template serves folders and products alike -->
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Glyph"
                                           Text="{Binding Glyph}"
                                           Style="{StaticResource IconGlyphStyle}"
                                           FontSize="13"
                                           Foreground="{StaticResource MutedForegroundBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <!--
                                    A product's full-colour image (ProductTreeNode.IconKind), a trigger below setting the file;
                                    none for a folder, or a product in another category or none. The 64 px file shrinks to 16
                                    (20 px at 125% scaling): a clear reduction stays sharp, where enlarging a smaller one blurs.
                                    Rounded to whole pixels, or it lands between them and blurs anyway.
                                -->
                                <Image x:Name="Icon"
                                       Width="16"
                                       Height="16"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       UseLayoutRounding="True"
                                       Visibility="Collapsed"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                                <TextBlock x:Name="Title"
                                           Text="{Binding Title}"
                                           VerticalAlignment="Center" />
                                <!-- A folder's products, muted after its name: which are empty shows without opening them -->
                                <TextBlock x:Name="Count"
                                           Text="{Binding ProductCount, StringFormat='({0})'}"
                                           Foreground="{StaticResource MutedForegroundBrush}"
                                           VerticalAlignment="Center"
                                           Margin="6,0,0,0" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsFolder}" Value="False">
                                    <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Count" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <!-- Each kind's image (Assets/Icons) -->
                                <DataTrigger Binding="{Binding IconKind}" Value="Breads">
                                    <Setter TargetName="Icon" Property="Source" Value="/Assets/Icons/Bread_64px.png" />
                                    <Setter TargetName="Icon" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IconKind}" Value="Loaves">
                                    <Setter TargetName="Icon" Property="Source" Value="/Assets/Icons/Loaf_64px.png" />
                                    <Setter TargetName="Icon" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IconKind}" Value="Cakes">
                                    <Setter TargetName="Icon" Property="Source" Value="/Assets/Icons/Cake_64px.png" />
                                    <Setter TargetName="Icon" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IconKind}" Value="Pastries">
                                    <Setter TargetName="Icon" Property="Source" Value="/Assets/Icons/Pastry_64px.png" />
                                    <Setter TargetName="Icon" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IconKind}" Value="Rolls">
                                    <Setter TargetName="Icon" Property="Source" Value="/Assets/Icons/Roll_Cake_64px.png" />
                                    <Setter TargetName="Icon" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IconKind}" Value="Composite">
                                    <Setter TargetName="Icon" Property="Source" Value="/Assets/Icons/Composite_64px.png" />
                                    <Setter TargetName="Icon" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <!-- The top-level folders: the two stages, and Deleted -->
                                <DataTrigger Binding="{Binding IsTopLevel}" Value="True">
                                    <Setter TargetName="Title" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </syncfusion:SfTreeView.ItemTemplate>
                </syncfusion:SfTreeView>
            </Border>
        </DockPanel>
    </Border>
</UserControl>
