<UserControl x:Class="TinapayanRMS.UI.Views.Products.ProductListCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:controls="clr-namespace:TinapayanRMS.UI.Controls">
    <!-- The screen's first region: its title with the search box beside it, then the list filling the rest, padded with empty rows. -->
    <Border Style="{StaticResource CardStyle}">
        <DockPanel>
            <!-- Title and search on one row, laid out as the Raw Materials list card lays out its own -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <syncfusion:SfTextBoxExt DockPanel.Dock="Right"
                                         Width="190"
                                         Watermark="Search products"
                                         WatermarkTemplate="{StaticResource AlignedWatermarkTemplate}"
                                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Products"
                           Style="{StaticResource PanelHeaderStyle}"
                           Margin="0"
                           VerticalAlignment="Center" />
            </DockPanel>

            <!-- A flat, name-sorted list (VisibleProducts is sorted). Category has a fixed width and Name takes the rest; a product without a category shows an empty cell. -->
            <syncfusion:SfDataGrid ItemsSource="{Binding VisibleProducts}"
                                   SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                                   GridLinesVisibility="Both"
                                   CurrentCellBorderBrush="{StaticResource AccentBrush}"
                                   CurrentCellBorderThickness="1"
                                   controls:GridFillerRows.IsEnabled="True"
                                   AutoGenerateColumns="False"
                                   AllowEditing="False"
                                   SelectionMode="Single"
                                   NavigationMode="Row">
                <syncfusion:SfDataGrid.Columns>
                    <!-- The Raw Materials list's widths, so the three lists are the same width -->
                    <syncfusion:GridTextColumn MappingName="Name" HeaderText="Name" Width="210" />
                    <syncfusion:GridTextColumn MappingName="Category.Name" HeaderText="Category" Width="160" />
                </syncfusion:SfDataGrid.Columns>
            </syncfusion:SfDataGrid>
        </DockPanel>
    </Border>
</UserControl>
