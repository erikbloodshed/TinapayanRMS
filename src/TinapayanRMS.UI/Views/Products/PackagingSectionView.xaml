<UserControl x:Class="TinapayanRMS.UI.Views.Products.PackagingSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:controls="clr-namespace:TinapayanRMS.UI.Controls">
    <!--
        The recipe's packaging, the content of its Recipe Structure tab: its lines, typed straight into the table
        as a sub-assembly's are. The add row at the bottom starts a line, Delete removes the selected one. Linked
        packaging is the linked product's, so it only shows: AllowEditing is off and the add row goes with it.
    -->
    <StackPanel Margin="8">
        <!-- The name and what it's for, then the cost per piece -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Packaging" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource HeadingForegroundBrush}" />
                <Border Grid.Column="1"
                        HorizontalAlignment="Left"
                        Style="{StaticResource LinkedBadgeStyle}"
                        Visibility="{Binding IsPackagingLinked, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding PackagingLinkedToText}" FontSize="11" Foreground="{StaticResource WarningForegroundBrush}" />
                </Border>
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="Wrappers, ribbon and labels for one piece. A pack's own box goes on the Packs tab." Style="{StaticResource CaptionStyle}" />
            </Grid>

            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Cost per piece" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding Costs.Packaging, StringFormat='₱{0:N4}'}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource HeadingForegroundBrush}"
                           HorizontalAlignment="Right" />
            </StackPanel>
        </Grid>

        <!-- A line's quantity is how much of the material one piece takes, always in the material's base unit -->
        <syncfusion:SfDataGrid ItemsSource="{Binding LineEdits}"
                               SelectedItem="{Binding SelectedLineEdit, Mode=TwoWay}"
                               GridLinesVisibility="Both"
                               CurrentCellBorderBrush="{StaticResource AccentBrush}"
                               CurrentCellBorderThickness="1"
                               controls:GridFillerRows.IsEnabled="True"
                               ShowRowHeader="True"
                               AutoGenerateColumns="False"
                               AllowEditing="{Binding IsPackagingEditable}"
                               AllowDeleting="{Binding IsPackagingEditable}"
                               EditTrigger="OnTap"
                               AddNewRowPosition="{Binding IsPackagingEditable, Converter={StaticResource AddNewRowPositionConverter}}"
                               SelectionMode="Single"
                               ColumnSizer="Star"
                               controls:GridEditCommit.OnFocusLeave="True"
                               controls:GridAddNewRow.DropWhenUntouched="True"
                               controls:AutoCompleteDropDown.IsEnabled="True"
                               controls:GridAddNewRow.ItemFactory="{Binding NewLineEdit}"
                               Height="200">
            <syncfusion:SfDataGrid.Columns>
                <!-- Typing opens the list of names containing the text and picks one: the first starting with it, else the first containing it -->
                <syncfusion:GridMultiColumnDropDownList MappingName="PackagingMaterialId"
                                                        HeaderText="Material"
                                                        ItemsSource="{Binding PackagingMaterials}"
                                                        DisplayMember="Name"
                                                        ValueMember="Id"
                                                        AllowAutoComplete="True"
                                                        AllowNullInput="True"
                                                        AllowIncrementalFiltering="True"
                                                        SearchCondition="Contains"
                                                        AutoGenerateColumns="False"
                                                        IsAutoPopupSize="False"
                                                        PopUpWidth="380"
                                                        PopUpHeight="260"
                                                        GridColumnSizer="Star">
                    <syncfusion:GridMultiColumnDropDownList.Columns>
                        <syncfusion:Columns>
                            <syncfusion:GridTextColumn MappingName="Name" HeaderText="Material" />
                            <syncfusion:GridTextColumn MappingName="Category.Name" HeaderText="Category" Width="100" />
                            <syncfusion:GridTextColumn MappingName="BaseUnit.Abbreviation" HeaderText="Unit" Width="52" />
                            <controls:NumericColumn MappingName="BufferedCostPerBaseUnit" HeaderText="Cost per Unit" Width="96" NumberDecimalDigits="4" />
                        </syncfusion:Columns>
                    </syncfusion:GridMultiColumnDropDownList.Columns>
                </syncfusion:GridMultiColumnDropDownList>
                <controls:NumericColumn MappingName="QtyPerUnit" HeaderText="Qty" Width="96" NumberDecimalDigits="4" />
                <syncfusion:GridTextColumn MappingName="Unit" HeaderText="Unit" Width="64" AllowEditing="False" />
                <controls:NumericColumn MappingName="UnitCost" HeaderText="Unit Cost" Width="88" NumberDecimalDigits="4" AllowEditing="False" />
                <controls:NumericColumn MappingName="CostPerUnit" HeaderText="Cost per Piece" Width="104" NumberDecimalDigits="4" AllowEditing="False" />
            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>

        <Grid Margin="0,8,0,0" Visibility="{Binding IsPackagingEditable, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Type the lines straight into the table. Delete removes the selected one." Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
            <syncfusion:ButtonAdv Grid.Column="1" Label="Remove Line" IconTemplate="{StaticResource RemoveIconTemplate}" Command="{Binding RemoveLineCommand}" />
        </Grid>

        <TextBlock Text="It's the linked product's packaging: change it there, or unlink it in Links &amp; Clone."
                   Style="{StaticResource CaptionStyle}"
                   Margin="0,8,0,0"
                   Visibility="{Binding IsPackagingLinked, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </StackPanel>
</UserControl>
