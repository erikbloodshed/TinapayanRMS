<UserControl x:Class="TinapayanRMS.UI.Views.Products.PackagingSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:controls="clr-namespace:TinapayanRMS.UI.Controls"
             xmlns:local="clr-namespace:TinapayanRMS.UI.Views.Products">
    <!--
        The recipe's packaging, the content of its Recipe Structure tab: a row for every packaging line, laid
        out like a sub-assembly's. Add Packaging opens the form under the header; pick a line, then Edit or
        Remove it below. Linked packaging can't be changed here.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The name and what it's for, then the cost per piece and Add Packaging -->
        <Grid Margin="8,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Packaging" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource HeadingForegroundBrush}" />
                <Border Grid.Column="1"
                        HorizontalAlignment="Left"
                        Style="{StaticResource LinkedBadgeStyle}"
                        Visibility="{Binding IsPackagingLinked, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding PackagingLinkedToText}" FontSize="11" Foreground="{StaticResource WarningForegroundBrush}" />
                </Border>
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="Boxes, wrappers, ribbon and labels for one piece" Style="{StaticResource CaptionStyle}" />
            </Grid>

            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                <TextBlock Text="Cost per piece" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding Costs.Packaging, StringFormat='₱{0:N4}'}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource HeadingForegroundBrush}"
                           HorizontalAlignment="Right" />
            </StackPanel>
            <syncfusion:ButtonAdv Grid.Column="2"
                                  VerticalAlignment="Center"
                                  Label="Add Packaging"
                                  IconTemplate="{StaticResource AddIconTemplate}"
                                  Command="{Binding AddLineCommand}" />
        </Grid>

        <local:PackagingLineFormPanel Grid.Row="1"
                                      Margin="8,0,8,8"
                                      Visibility="{Binding IsLineFormOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <!-- Nothing to show yet, and no form open to add it with -->
        <Border Grid.Row="2" Visibility="{Binding HasPackaging, Converter={StaticResource EmptyStateVisibilityConverter}}">
            <TextBlock Style="{StaticResource EmptyStateStyle}"
                       Margin="8,16,8,24"
                       Text="No packaging yet. Add the boxes, wrappers, ribbon and labels that go with one piece."
                       Visibility="{Binding IsLineFormOpen, Converter={StaticResource EmptyStateVisibilityConverter}}" />
        </Border>

        <!-- No height of its own: it shows every line, and passes the wheel on to the tab (MouseWheelForwarding) -->
        <syncfusion:SfDataGrid Grid.Row="3"
                               ItemsSource="{Binding LineEdits}"
                               SelectedItem="{Binding SelectedLineEdit, Mode=TwoWay}"
                               GridLinesVisibility="Both"
                               CurrentCellBorderBrush="{StaticResource AccentBrush}"
                               CurrentCellBorderThickness="1"
                               AutoGenerateColumns="False"
                               AllowEditing="False"
                               SelectionMode="Single"
                               NavigationMode="Row"
                               ColumnSizer="Star"
                               controls:MouseWheelForwarding.IsEnabled="True"
                               Visibility="{Binding HasPackaging, Converter={StaticResource BooleanToVisibilityConverter}}">
            <syncfusion:SfDataGrid.Columns>
                <syncfusion:GridTextColumn MappingName="PackagingMaterial.Name" HeaderText="Material" />
                <controls:NumericColumn MappingName="QtyPerPiece" HeaderText="Qty per Piece" Width="96" NumberDecimalDigits="4" />
                <syncfusion:GridTextColumn MappingName="Unit.Abbreviation" HeaderText="Unit" Width="52" Padding="12,0,0,0" />
                <controls:NumericColumn MappingName="PiecesPerPackagingUnit" HeaderText="Pieces per Unit" Width="104" NumberDecimalDigits="4" />
                <controls:NumericColumn MappingName="UnitCost" HeaderText="Unit Cost" Width="88" NumberDecimalDigits="4" />
                <controls:NumericColumn MappingName="CostPerPiece" HeaderText="Cost per Piece" Width="104" NumberDecimalDigits="4" />
            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>

        <!-- The table's total, under its Cost per Piece column: the same widths as the grid's columns -->
        <Border Grid.Row="4"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,1,0,1"
                Background="{StaticResource PageBackgroundBrush}"
                Visibility="{Binding HasPackaging, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="104" />
                    <ColumnDefinition Width="88" />
                    <ColumnDefinition Width="104" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource SectionTotalDividerStyle}" />
                <Border Grid.Column="1" Style="{StaticResource SectionTotalDividerStyle}" />
                <Border Grid.Column="2" Style="{StaticResource SectionTotalDividerStyle}" />
                <Border Grid.Column="3" Style="{StaticResource SectionTotalDividerStyle}" />
                <Border Grid.Column="4" Style="{StaticResource SectionTotalDividerStyle}" />
                <TextBlock Text="Total" Style="{StaticResource SectionTotalCellStyle}" HorizontalAlignment="Left" />
                <TextBlock Grid.Column="5" Text="{Binding Costs.Packaging, StringFormat='{}{0:N4}'}" Style="{StaticResource SectionTotalCellStyle}" />
            </Grid>
        </Border>

        <!-- Edit and Remove act on the line picked in the grid, when there are lines and they're the product's own -->
        <Border Grid.Row="5" Visibility="{Binding HasPackaging, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal"
                        Margin="8"
                        Visibility="{Binding IsPackagingLinked, Converter={StaticResource EmptyStateVisibilityConverter}}">
                <syncfusion:ButtonAdv Label="Edit" IconTemplate="{StaticResource EditIconTemplate}" Command="{Binding EditLineCommand}" Margin="0,0,8,0" />
                <syncfusion:ButtonAdv Label="Remove" IconTemplate="{StaticResource RemoveIconTemplate}" Command="{Binding RemoveLineCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
