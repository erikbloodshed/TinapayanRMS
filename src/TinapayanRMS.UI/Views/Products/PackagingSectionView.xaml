<UserControl x:Class="TinapayanRMS.UI.Views.Products.PackagingSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:controls="clr-namespace:TinapayanRMS.UI.Controls">
    <!--
        The recipe's packaging, the content of its Recipe Structure tab, which Add Sub-Assembly adds in the Packaging
        role: its lines, typed straight into the table as a sub-assembly's are. The add row at the bottom starts a line,
        Delete removes the selected one. Linked packaging (another product's, or a packaging set) is kept where it's
        from, so it only shows: AllowEditing is off and the add row goes with it.
    -->
    <StackPanel Margin="8">
        <!--
            No title: its tab already says Packaging. A badge when it's linked, and what a piece of it costs at the far
            right of the same row, as the recipe's other sub-assemblies have them (UsageFormPanel's badge row).
        -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border HorizontalAlignment="Left"
                    Style="{StaticResource LinkedBadgeStyle}"
                    Margin="0,0,0,10"
                    Visibility="{Binding IsPackagingLinked, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding PackagingLinkedToText}" FontSize="11" Foreground="{StaticResource WarningForegroundBrush}" />
            </Border>
            <TextBlock Grid.Column="1"
                       Style="{StaticResource CaptionStyle}"
                       VerticalAlignment="Center"
                       Margin="12,0,0,10">
                <Run Text="{Binding CostUnitCaption, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Costs.Packaging, StringFormat='{}{0:N2}', Mode=OneWay}" />
            </TextBlock>
        </Grid>

        <!--
            A line's quantity is how much of the material one whole sellable unit takes — a piece, unless the product's
            Quantity Required says otherwise — always in the material's base unit. Quantities are typed, so changing
            Quantity Required doesn't rescale them; the caption above says what a unit is.
        -->
        <syncfusion:SfDataGrid ItemsSource="{Binding LineEdits}"
                               controls:GridUndoSteps.Recorder="{Binding}"
                               controls:NumericEditing.IsEnabled="True"
                               SelectedItem="{Binding SelectedLineEdit, Mode=TwoWay}"
                               GridLinesVisibility="Both"
                               CurrentCellBorderBrush="{StaticResource AccentBrush}"
                               CurrentCellBorderThickness="1"
                               controls:GridFillerRows.IsEnabled="True"
                               ShowRowHeader="True"
                               AutoGenerateColumns="False"
                               AllowEditing="{Binding IsPackagingEditable}"
                               AllowDeleting="{Binding IsPackagingEditable}"
                               EditTrigger="OnTap"
                               AddNewRowPosition="{Binding IsPackagingEditable, Converter={StaticResource AddNewRowPositionConverter}}"
                               SelectionMode="Single"
                               ColumnSizer="Star"
                               controls:GridEditCommit.OnFocusLeave="True"
                               controls:GridAddNewRow.DropWhenUntouched="True"
                               controls:AutoCompleteDropDown.IsEnabled="True"
                               controls:GridAddNewRow.ItemFactory="{Binding NewLineEdit}"
                               Height="200">
            <syncfusion:SfDataGrid.Columns>
                <!-- Typing opens the list of names containing the text and picks one: the first starting with it, else the first containing it -->
                <syncfusion:GridMultiColumnDropDownList MappingName="PackagingMaterialId"
                                                        HeaderText="Material"
                                                        ItemsSource="{Binding PackagingMaterials}"
                                                        DisplayMember="Name"
                                                        ValueMember="Id"
                                                        AllowAutoComplete="True"
                                                        AllowNullInput="True"
                                                        AllowIncrementalFiltering="True"
                                                        SearchCondition="Contains"
                                                        AutoGenerateColumns="False"
                                                        IsAutoPopupSize="False"
                                                        PopUpWidth="380"
                                                        PopUpHeight="260"
                                                        GridColumnSizer="Star">
                    <syncfusion:GridMultiColumnDropDownList.Columns>
                        <syncfusion:Columns>
                            <syncfusion:GridTextColumn MappingName="Name" HeaderText="Material" />
                            <syncfusion:GridTextColumn MappingName="Category.Name" HeaderText="Category" Width="100" />
                            <syncfusion:GridTextColumn MappingName="BaseUnit.Abbreviation" HeaderText="Unit" Width="52" />
                            <controls:NumericColumn MappingName="BufferedCostPerBaseUnit" HeaderText="Cost per Unit" Width="96" NumberDecimalDigits="4" />
                        </syncfusion:Columns>
                    </syncfusion:GridMultiColumnDropDownList.Columns>
                </syncfusion:GridMultiColumnDropDownList>
                <controls:NumericColumn MappingName="QtyPerUnit" HeaderText="Qty" Width="96" NumberDecimalDigits="1" TypedDecimalDigits="4" AllowNullValue="True" />
                <!--
                    The unit the Qty is typed in: the material's base unit, or one of its alternative units. Each row has its
                    own material, so its list comes from the row (PackagingUnitSelector). Editable, so the unit can be typed
                    as well as picked. What the quantity comes to in base units is never shown — the conversion is behind
                    the scenes, in Unit Cost (what one of the picked unit costs) and in the line's own total.
                -->
                <syncfusion:GridComboBoxColumn MappingName="UnitKey"
                                               HeaderText="Unit"
                                               Width="72"
                                               ItemsSourceSelector="{StaticResource PackagingUnitSelector}"
                                               DisplayMemberPath="Abbreviation"
                                               SelectedValuePath="Key"
                                               IsEditable="True" />
                <controls:NumericColumn MappingName="UnitCost" HeaderText="Unit Cost" Width="88" NumberDecimalDigits="4" AllowEditing="False" />
                <controls:NumericColumn MappingName="CostPerUnit" HeaderText="Cost per Unit" Width="104" NumberDecimalDigits="4" AllowEditing="False" />
            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>

        <!-- Remove Line only while its lines are this product's own; the cost per unit is up in the badge row -->
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <syncfusion:ButtonAdv Grid.Column="1"
                                  Label="Remove Line"
                                  IconTemplate="{StaticResource RemoveIconTemplate}"
                                  Command="{Binding RemoveLineCommand}"
                                  Visibility="{Binding IsPackagingEditable, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>

        <!-- Linked packaging only shows here: Make a Copy makes its lines this product's own, and Save drops the link -->
        <Grid Margin="0,8,0,0" Visibility="{Binding IsPackagingLinked, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Its lines are kept where it's linked from, and follow every change there. Make a Copy to change them here."
                       Style="{StaticResource CaptionStyle}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,12,0" />
            <syncfusion:ButtonAdv Grid.Column="1"
                                  Label="Make a Copy"
                                  ToolTip="Make these lines this product's own, to change them here. It stops following where it's from."
                                  IconTemplate="{StaticResource CopyIconTemplate}"
                                  Command="{Binding CopyPackagingCommand}" />
        </Grid>
    </StackPanel>
</UserControl>
