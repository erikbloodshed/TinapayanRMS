<UserControl x:Class="TinapayanRMS.UI.Views.Products.ScalingCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:skinManager="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF">
    <!--
        The recipe scaled to a number of sellable units: how many is typed at the top, and the tree under it has each
        section in the whole batches that make them, with its lines under it (a made ingredient opening into what it's
        made from), each product a composite holds scaled to its share, and the packaging. Everything is worked out by the
        ViewModel (ScalingRows); nothing here is typed into but the quantity, which isn't saved.
    -->
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="Sellable Units" Style="{StaticResource FormLabelStyle}" />
            <syncfusion:IntegerTextBox Grid.Column="1"
                                       Width="110"
                                       MinValue="1"
                                       Value="{Binding ScalingUnits, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       ToolTip="How many to make: boxes for a Box of 8, pieces for a product sold by the piece. Only for this tab: it isn't saved." />
            <TextBlock Grid.Column="2"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       Text="{Binding ScalingPiecesText}"
                       Style="{StaticResource CaptionStyle}" />

            <TextBlock Grid.Column="4" VerticalAlignment="Center" Style="{StaticResource FormLabelStyle}" Margin="0">
                <Run Text="Total Cost" /><Run Text="{Binding ScalingTotalCost, StringFormat='  {0:N2}', Mode=OneWay}" FontWeight="SemiBold" />
            </TextBlock>
        </Grid>

        <!--
            The other way round (2026-10-29): how many sellable units an amount of one ingredient makes, the most whose
            whole batches it's enough for. Scale to puts that in Sellable Units. Nothing here is saved.
        -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="From What You Have" Style="{StaticResource FormLabelStyle}" />
            <syncfusion:ComboBoxAdv Grid.Column="1"
                                    ItemsSource="{Binding ScalingIngredients}"
                                    SelectedItem="{Binding ScalingHaveIngredient, Mode=TwoWay}"
                                    DisplayMemberPath="Name"
                                    IsEditable="True"
                                    AutoCompleteMode="Suggest"
                                    DefaultText="Ingredient"
                                    ToolTip="An ingredient there's only so much of: the tab works out how many it makes." />
            <syncfusion:DoubleTextBox Grid.Column="2"
                                      Width="110"
                                      Margin="8,0,0,0"
                                      MinValue="0"
                                      NumberDecimalDigits="2"
                                      UseNullOption="True"
                                      WatermarkText="Amount"
                                      Value="{Binding ScalingHaveAmount, Converter={StaticResource DecimalValueConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue={x:Null}}" />
            <syncfusion:ComboBoxAdv Grid.Column="3"
                                    Width="90"
                                    Margin="6,0,0,0"
                                    ItemsSource="{Binding ScalingHaveUnits}"
                                    SelectedItem="{Binding ScalingHaveUnit, Mode=TwoWay}"
                                    DisplayMemberPath="Name"
                                    ToolTip="Grams, or one of the ingredient's own units." />
            <syncfusion:ButtonAdv Grid.Column="4"
                                  Margin="10,0,0,0"
                                  Label="{Binding ScaleToHaveLabel}"
                                  IconTemplate="{StaticResource ApplyIconTemplate}"
                                  Command="{Binding ScaleToHaveCommand}"
                                  Visibility="{Binding HasScalingHaveMakes, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  ToolTip="Puts this in Sellable Units, so the table shows it." />
            <TextBlock Grid.Column="5"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Text="{Binding ScalingHaveText}"
                       Style="{StaticResource CaptionStyle}" />
        </Grid>

        <TextBlock DockPanel.Dock="Top"
                   Margin="0,0,0,8"
                   TextWrapping="Wrap"
                   Style="{StaticResource CaptionStyle}"
                   Text="Each section is made in whole batches, so the amounts and the total cost include the extra pieces. A made ingredient opens into what it's made from." />

        <!--
            Read-only: every row is worked out, and a rebuild replaces them all, so every level shows open.

            It's themed on its own (SfSkinManager.Theme set here, not inherited from the window). The theme's SfTreeGrid
            dictionary merges in SfGrid's unthemed Control/Themes/Generic.xaml, whose implicit GridCell, header cell and
            row styles are the ones the SfDataGrid dictionary themes. Inherited, it joined the window's theme dictionaries
            after SfDataGrid's, so its unthemed styles won and every data grid in the app lost the theme (2026-09-30).
            Set here, its dictionaries go into this grid's own resources instead.

            FontSize is the app's 14px body text: the theme's cell style is one the generic ones outrank, so the cells
            inherit the grid's own FontSize (12) where the header cells take the app's theme settings.
        -->
        <syncfusion:SfTreeGrid skinManager:SfSkinManager.Theme="{skinManager:SkinManagerExtension ThemeName=Windows11Light}"
                               skinManager:SfSkinManager.SizeMode="Default"
                               ItemsSource="{Binding ScalingRows}"
                               ChildPropertyName="Children"
                               AutoExpandMode="AllNodesExpanded"
                               ExpanderColumn="Name"
                               AutoGenerateColumns="False"
                               AllowEditing="False"
                               AllowSorting="False"
                               SelectionMode="Single"
                               NavigationMode="Row"
                               GridLinesVisibility="Both"
                               CurrentCellBorderBrush="{StaticResource AccentBrush}"
                               CurrentCellBorderThickness="1"
                               ColumnSizer="Star"
                               FontSize="14">
            <syncfusion:SfTreeGrid.Columns>
                <syncfusion:TreeGridTemplateColumn MappingName="Name" HeaderText="Item">
                    <syncfusion:TreeGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <DockPanel VerticalAlignment="Center" Margin="4,0">
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource HeadingForegroundBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Margin="10,0,0,0"
                                           Text="{Binding Detail}"
                                           Foreground="{StaticResource MutedForegroundBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </DataTemplate>
                    </syncfusion:TreeGridTemplateColumn.CellTemplate>
                </syncfusion:TreeGridTemplateColumn>
                <syncfusion:TreeGridTextColumn MappingName="AmountText" HeaderText="Amount" Width="150" TextAlignment="Right" />
                <syncfusion:TreeGridNumericColumn MappingName="Cost" HeaderText="Cost" Width="130" NumberDecimalDigits="2" />
            </syncfusion:SfTreeGrid.Columns>
        </syncfusion:SfTreeGrid>
    </DockPanel>
</UserControl>
