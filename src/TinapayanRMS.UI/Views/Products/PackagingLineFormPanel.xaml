<UserControl x:Class="TinapayanRMS.UI.Views.Products.PackagingLineFormPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf">
    <!--
        Add a packaging line, or change one. Its amount is entered either way round (a ribbon as cm per
        piece, a box as pieces per box); the other is worked out. Apply only puts it in the recipe.
    -->
    <Border Padding="8" CornerRadius="6" Background="{StaticResource PageBackgroundBrush}">
        <StackPanel>
            <TextBlock Text="{Binding LineFormTitle}"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource HeadingForegroundBrush}"
                       Margin="0,0,0,8" />

            <!-- Labels in the first row, fields in the second -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Packaging Material" Style="{StaticResource FieldLabelStyle}" />
                <syncfusion:ComboBoxAdv Grid.Row="1"
                                        Grid.Column="0"
                                        ItemsSource="{Binding PackagingMaterials}"
                                        DisplayMemberPath="Name"
                                        SelectedItem="{Binding EditingLinePackagingMaterial, Mode=TwoWay}" />

                <TextBlock Grid.Column="2" Text="Unit" Style="{StaticResource FieldLabelStyle}" />
                <syncfusion:ComboBoxAdv Grid.Row="1"
                                        Grid.Column="2"
                                        ItemsSource="{Binding EntryUnitOptions}"
                                        DisplayMemberPath="Name"
                                        SelectedItem="{Binding EditingLineUnit, Mode=TwoWay}" />

                <TextBlock Grid.Column="4" Text="Entered As" Style="{StaticResource FieldLabelStyle}" />
                <syncfusion:ComboBoxAdv Grid.Row="1"
                                        Grid.Column="4"
                                        ItemsSource="{Binding EntryOptions}"
                                        DisplayMemberPath="Name"
                                        SelectedItem="{Binding EditingLineEntry, Mode=TwoWay}" />

                <TextBlock Grid.Column="6" Text="{Binding LineValueLabel}" Style="{StaticResource FieldLabelStyle}" TextTrimming="CharacterEllipsis" />
                <syncfusion:DoubleTextBox Grid.Row="1"
                                          Grid.Column="6"
                                          Value="{Binding EditingLineAuthoredValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          NumberDecimalDigits="4" />
            </Grid>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding LineFormPreviewText}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <syncfusion:ButtonAdv Label="Cancel" IconTemplate="{StaticResource CancelIconTemplate}" Command="{Binding CancelLineCommand}" Margin="0,0,8,0" />
                    <syncfusion:ButtonAdv Label="Apply" IconTemplate="{StaticResource ApplyIconTemplate}" Command="{Binding ApplyLineCommand}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
