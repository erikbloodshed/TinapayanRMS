<UserControl x:Class="TinapayanRMS.UI.Views.Products.ProductDetailsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:controls="clr-namespace:TinapayanRMS.UI.Controls"
             xmlns:viewModels="clr-namespace:TinapayanRMS.UI.ViewModels">
    <UserControl.Resources>
        <!--
            The Category picker's rows: a line under its "< Add New .. >" row (ProductsViewModel.AddNewCategory), drawn as
            Raw Materials' SummaryHeaderCard draws its own, and for the same reasons (a row's ContentTemplate, since the
            picker needs DisplayMemberPath).
        -->
        <DataTemplate x:Key="AddNewCategoryTemplate">
            <Border HorizontalAlignment="Stretch"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="0,0,0,5"
                    Margin="0,0,0,3">
                <TextBlock Text="{Binding Name}" />
            </Border>
        </DataTemplate>
        <Style x:Key="CategoryOptionStyle" TargetType="syncfusion:ComboBoxItemAdv" BasedOn="{StaticResource {x:Type syncfusion:ComboBoxItemAdv}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Id}" Value="{x:Static viewModels:ProductsViewModel.AddNewCategoryId}">
                    <Setter Property="ContentTemplate" Value="{StaticResource AddNewCategoryTemplate}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!--
        What's typed in about the product itself, under the header's figures: its name, its category, how many pieces
        make one sellable unit, and the price the shop charges now. Labels in the first row, fields in the second, as
        Raw Materials lays out its own. Save writes them with the rest of the form.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Text="Product Name" Style="{StaticResource FieldLabelStyle}" />
        <syncfusion:SfTextBoxExt x:Name="NameTextBox"
                                 Grid.Row="1"
                                 Text="{Binding EditingName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 controls:FieldUndoStep.Recorder="{Binding}" />

        <TextBlock Grid.Column="2" Text="Category" Style="{StaticResource FieldLabelStyle}" />
        <syncfusion:ComboBoxAdv Grid.Row="1"
                                Grid.Column="2"
                                ItemsSource="{Binding CategoryOptions}"
                                DisplayMemberPath="Name"
                                ItemContainerStyle="{StaticResource CategoryOptionStyle}"
                                controls:FieldUndoStep.Recorder="{Binding}"
                                SelectedItem="{Binding EditingCategory, Mode=TwoWay}"
                                Text="{Binding CategorySearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="What the Products list groups it under. Pick a category, or &quot;&lt; Add New .. &gt;&quot; to name one now." />

        <!--
            How many finished pieces one sellable unit holds: 1 for a product sold by the piece, 8 for a "Box of 8".
            The recipe stays per piece; every figure in the header and on the Costing tab is for one whole unit, so
            this multiplies the recipe's share of it. The packaging lines are already for one unit and don't rescale.
        -->
        <TextBlock Grid.Column="4"
                   Text="Quantity Required"
                   Style="{StaticResource FieldLabelStyle}"
                   ToolTip="How many finished pieces make one sellable unit. 1 for a product sold by the piece." />
        <syncfusion:IntegerTextBox Grid.Row="1"
                                   Grid.Column="4"
                                   controls:FieldUndoStep.Recorder="{Binding}"
                                   Value="{Binding EditingQuantityRequired, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   MinValue="1"
                                   ToolTip="How many finished pieces make one sellable unit: 1 by the piece, 8 for a &quot;Box of 8&quot;. The recipe stays per piece; the costing multiplies by this." />

        <!-- Saved with the product. Empty rather than 0.00 until typed (UseNullOption). -->
        <TextBlock Grid.Column="6" Text="Current Price" Style="{StaticResource FieldLabelStyle}" ToolTip="{Binding CostUnitCaption, StringFormat='{}{0}, with VAT: what the shop charges now'}" />
        <syncfusion:CurrencyTextBox Grid.Row="1"
                                    Grid.Column="6"
                                    controls:FieldUndoStep.Recorder="{Binding}"
                                    Value="{Binding EditingCurrentPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    UseNullOption="True"
                                    NullValue="{x:Null}"
                                    MinValue="0"
                                    CurrencySymbol="₱"
                                    CurrencyDecimalDigits="2"
                                    ToolTip="{Binding CostUnitCaption, StringFormat='{}{0}, with VAT: what the shop charges now. The Markup % in the header shows what it earns.'}" />
    </Grid>
</UserControl>
