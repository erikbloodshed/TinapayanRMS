<UserControl x:Class="TinapayanRMS.UI.Views.Products.CostingSummaryCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf">
    <UserControl.Resources>
        <!-- A costing input as a tile: a coloured edge, its label and field, then what it comes to in the price. -->
        <Style x:Key="CostTileStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PageBackgroundBrush}" />
            <Setter Property="BorderThickness" Value="4,0,0,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="TileCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}">
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <SolidColorBrush x:Key="LaborTileBrush" Color="#0F766E" />
        <SolidColorBrush x:Key="OverheadTileBrush" Color="#D97706" />
        <SolidColorBrush x:Key="AdministrativeTileBrush" Color="#7C3AED" />
        <SolidColorBrush x:Key="MarkupTileBrush" Color="#BE123C" />
        <SolidColorBrush x:Key="VatTileBrush" Color="#0369A1" />
    </UserControl.Resources>

    <Border Style="{StaticResource CardStyle}">
        <StackPanel>
            <TextBlock Text="Costing Summary" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,4" />
            <TextBlock Text="Labor, overhead and administrative costs are pesos per piece. The markup goes on the base cost, then VAT on top. Changes are saved with Save."
                       Style="{StaticResource CardCaptionStyle}" />

            <UniformGrid Columns="5">
                <Border Style="{StaticResource CostTileStyle}" BorderBrush="{StaticResource LaborTileBrush}">
                    <StackPanel>
                        <TextBlock Text="Labor" Style="{StaticResource FieldLabelStyle}" />
                        <syncfusion:DoubleTextBox Value="{Binding EditingLaborCost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource TileCaptionStyle}" Text="{Binding Costs.LaborShare, StringFormat='{}{0:N1}% of the price'}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CostTileStyle}" BorderBrush="{StaticResource OverheadTileBrush}">
                    <StackPanel>
                        <TextBlock Text="Overhead" Style="{StaticResource FieldLabelStyle}" />
                        <syncfusion:DoubleTextBox Value="{Binding EditingOverheadCost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource TileCaptionStyle}" Text="{Binding Costs.OverheadShare, StringFormat='{}{0:N1}% of the price'}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CostTileStyle}" BorderBrush="{StaticResource AdministrativeTileBrush}">
                    <StackPanel>
                        <TextBlock Text="Administrative" Style="{StaticResource FieldLabelStyle}" />
                        <syncfusion:DoubleTextBox Value="{Binding EditingAdministrativeCost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource TileCaptionStyle}" Text="{Binding Costs.AdministrativeShare, StringFormat='{}{0:N1}% of the price'}" />
                    </StackPanel>
                </Border>

                <!-- The two percentages also show what they come to in pesos -->
                <Border Style="{StaticResource CostTileStyle}" BorderBrush="{StaticResource MarkupTileBrush}">
                    <StackPanel>
                        <TextBlock Text="Markup %" Style="{StaticResource FieldLabelStyle}" />
                        <syncfusion:DoubleTextBox Value="{Binding EditingMarginPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource TileCaptionStyle}" Text="{Binding Costs.Markup, StringFormat='₱{0:N4}'}" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding Costs.MarkupShare, StringFormat='{}{0:N1}% of the price'}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CostTileStyle}" BorderBrush="{StaticResource VatTileBrush}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="VAT %" Style="{StaticResource FieldLabelStyle}" />
                        <syncfusion:DoubleTextBox Value="{Binding EditingVatPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource TileCaptionStyle}" Text="{Binding Costs.Vat, StringFormat='₱{0:N4}'}" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding Costs.VatShare, StringFormat='{}{0:N1}% of the price'}" />
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </Border>
</UserControl>
