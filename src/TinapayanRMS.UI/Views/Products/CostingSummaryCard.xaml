<UserControl x:Class="TinapayanRMS.UI.Views.Products.CostingSummaryCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf">
    <UserControl.Resources>
        <!-- A costing input: a coloured edge beside its label and field, then what it comes to in the price. No box around it. -->
        <Style x:Key="CostTileStyle" TargetType="Border">
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="Padding" Value="10,0,0,0" />
        </Style>
        <Style x:Key="TileCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}">
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <SolidColorBrush x:Key="LaborTileBrush" Color="#0F766E" />
        <SolidColorBrush x:Key="OverheadTileBrush" Color="#D97706" />
        <SolidColorBrush x:Key="AdministrativeTileBrush" Color="#7C3AED" />
        <SolidColorBrush x:Key="MarkupTileBrush" Color="#BE123C" />
        <SolidColorBrush x:Key="VatTileBrush" Color="#0369A1" />
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="Costing Summary" Style="{StaticResource PanelHeaderStyle}" />
        <TextBlock Text="Labor, overhead and administrative are percentages of the material cost. The markup goes on the base cost, then VAT on top. Changes are saved with Save."
                   Style="{StaticResource PanelCaptionStyle}" />

        <!-- Every input is a percentage, and shows what it comes to in pesos: five equal columns with gaps between -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CostTileStyle}" BorderBrush="{StaticResource LaborTileBrush}">
                <StackPanel>
                    <TextBlock Text="Labor %" Style="{StaticResource FieldLabelStyle}" />
                    <syncfusion:DoubleTextBox Value="{Binding EditingLaborPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource TileCaptionStyle}" Text="{Binding Costs.Labor, StringFormat='₱{0:N4}'}" />
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding Costs.LaborShare, StringFormat='{}{0:N1}% of the price'}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CostTileStyle}" BorderBrush="{StaticResource OverheadTileBrush}">
                <StackPanel>
                    <TextBlock Text="Overhead %" Style="{StaticResource FieldLabelStyle}" />
                    <syncfusion:DoubleTextBox Value="{Binding EditingOverheadPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource TileCaptionStyle}" Text="{Binding Costs.Overhead, StringFormat='₱{0:N4}'}" />
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding Costs.OverheadShare, StringFormat='{}{0:N1}% of the price'}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource CostTileStyle}" BorderBrush="{StaticResource AdministrativeTileBrush}">
                <StackPanel>
                    <TextBlock Text="Administrative %" Style="{StaticResource FieldLabelStyle}" />
                    <syncfusion:DoubleTextBox Value="{Binding EditingAdministrativePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource TileCaptionStyle}" Text="{Binding Costs.Administrative, StringFormat='₱{0:N4}'}" />
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding Costs.AdministrativeShare, StringFormat='{}{0:N1}% of the price'}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="6" Style="{StaticResource CostTileStyle}" BorderBrush="{StaticResource MarkupTileBrush}">
                <StackPanel>
                    <TextBlock Text="Markup %" Style="{StaticResource FieldLabelStyle}" />
                    <syncfusion:DoubleTextBox Value="{Binding EditingMarginPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource TileCaptionStyle}" Text="{Binding Costs.Markup, StringFormat='₱{0:N4}'}" />
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding Costs.MarkupShare, StringFormat='{}{0:N1}% of the price'}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="8" Style="{StaticResource CostTileStyle}" BorderBrush="{StaticResource VatTileBrush}">
                <StackPanel>
                    <TextBlock Text="VAT %" Style="{StaticResource FieldLabelStyle}" />
                    <syncfusion:DoubleTextBox Value="{Binding EditingVatPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource TileCaptionStyle}" Text="{Binding Costs.Vat, StringFormat='₱{0:N4}'}" />
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding Costs.VatShare, StringFormat='{}{0:N1}% of the price'}" />
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
