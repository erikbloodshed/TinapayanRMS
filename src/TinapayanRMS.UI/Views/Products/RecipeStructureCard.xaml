<UserControl x:Class="TinapayanRMS.UI.Views.Products.RecipeStructureCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:local="clr-namespace:TinapayanRMS.UI.Views.Products"
             xmlns:vm="clr-namespace:TinapayanRMS.UI.ViewModels">
    <!--
        What goes into one piece, in tabs (RecipeTabs): a sub-assembly's for each one in the recipe, in role
        order, then Add Sub-Assembly, which opens the form to add one, then Packaging, which is always there.
        Each tab's content is picked by its type from the templates below, and each takes the screen's DataContext
        back from this card: they all show one of the screen's forms, or its packaging.
    -->
    <UserControl.Resources>
        <!-- A sub-assembly's tab is the form that edits it: its lines for the product's own, read-only for a link -->
        <DataTemplate DataType="{x:Type vm:SubAssemblyRecipeTab}">
            <Border Padding="8">
                <local:UsageFormPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=local:RecipeStructureCard}}" />
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:AddSubAssemblyRecipeTab}">
            <Border Padding="8">
                <local:UsageFormPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=local:RecipeStructureCard}}"
                                      Visibility="{Binding IsUsageFormOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PackagingRecipeTab}">
            <local:PackagingSectionView DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=local:RecipeStructureCard}}" />
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="Recipe Structure" Style="{StaticResource PanelHeaderStyle}" />
        <TextBlock Text="What goes into one piece: each sub-assembly's ingredients, in grams a batch, then the packaging. A sub-assembly is made here, or linked or copied from another product or the Sub-Assemblies screen. Moving to another tab applies what you typed; Save saves it."
                   Style="{StaticResource PanelCaptionStyle}" />

        <!--
            Fixed tabs, like the screen's own: nothing to close, and no tab menus. Headers are the tab's glyph
            and name. The scroll arrows only show when the tabs don't fit. The ViewModel picks the tab showing
            when tabs come and go (SelectedRecipeTab), so the control mustn't pick one itself: CloseMode="Hide"
            (its default) reselects the tab shown before when one is removed (removing a sub-assembly jumped to
            Add Sub-Assembly), and SelectOnCreatingNewItem selects every tab added.
        -->
        <syncfusion:TabControlExt ItemsSource="{Binding RecipeTabs}"
                                  SelectedItem="{Binding SelectedRecipeTab, Mode=TwoWay}"
                                  CloseButtonType="Hide"
                                  CloseMode="Delete"
                                  SelectOnCreatingNewItem="False"
                                  ShowTabItemContextMenu="False"
                                  ShowTabListContextMenu="False"
                                  TabScrollButtonVisibility="Auto">
            <syncfusion:TabControlExt.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconGlyphStyle}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding Header}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </syncfusion:TabControlExt.ItemTemplate>
        </syncfusion:TabControlExt>
    </StackPanel>
</UserControl>
