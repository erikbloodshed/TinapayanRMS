<UserControl x:Class="TinapayanRMS.UI.Views.Products.ComponentsSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:controls="clr-namespace:TinapayanRMS.UI.Controls">
    <!--
        A composite product's Products tab: the products it holds, and how many of each, typed straight into the table as
        the Packaging tab's lines are. The add row at the bottom starts a line, Delete removes the selected one, and lines
        are dragged into order. Each line brings its product's recipe cost (Recipe Cost, for one of its sellable units)
        times its Qty; the product's own packaging stays out.
    -->
    <StackPanel Margin="8">
        <!-- What a line brings, and what the products come to at the far right, as the Packaging tab has its cost -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource CaptionStyle}"
                       VerticalAlignment="Center"
                       Margin="0,0,12,10"
                       Text="Each product brings its recipe (ingredients) cost for how many of it go in. Its own packaging stays out: this product's Packaging covers the box and anything wrapping the pieces. A topping or filling over the whole goes on a tab of its own, with Add Sub-Assembly." />
            <TextBlock Grid.Column="1"
                       Style="{StaticResource CaptionStyle}"
                       VerticalAlignment="Center"
                       Margin="12,0,0,10">
                <Run Text="{Binding CostUnitCaption, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding ComponentsCost, StringFormat='{}{0:N2}', Mode=OneWay}" />
            </TextBlock>
        </Grid>

        <!--
            Qty counts the product's sellable units: pieces for one sold by the piece, boxes for a Box of 8. A whole number;
            Save refuses a line without one, and a composite of fewer than two different products.
        -->
        <syncfusion:SfDataGrid ItemsSource="{Binding ComponentEdits}"
                               controls:GridUndoSteps.Recorder="{Binding}"
                               controls:GridRowReordering.IsEnabled="True"
                               SelectedItem="{Binding SelectedComponentEdit, Mode=TwoWay}"
                               GridLinesVisibility="Both"
                               CurrentCellBorderBrush="{StaticResource AccentBrush}"
                               CurrentCellBorderThickness="1"
                               controls:GridFillerRows.IsEnabled="True"
                               ShowRowHeader="True"
                               AutoGenerateColumns="False"
                               AllowEditing="True"
                               AllowDeleting="True"
                               EditTrigger="OnTap"
                               AddNewRowPosition="Bottom"
                               SelectionMode="Single"
                               ColumnSizer="Star"
                               controls:GridEditCommit.OnFocusLeave="True"
                               controls:GridAddNewRow.DropWhenUntouched="True"
                               controls:AutoCompleteDropDown.IsEnabled="True"
                               controls:GridAddNewRow.ItemFactory="{Binding NewComponentRow}"
                               Height="200">
            <syncfusion:SfDataGrid.Columns>
                <!--
                    Typing opens the list of names containing the text and picks one: the first starting with it, else the first
                    containing it. The list leaves out this product and any composite holding it (ComponentProductOptions).
                -->
                <syncfusion:GridMultiColumnDropDownList MappingName="ComponentProductId"
                                                        HeaderText="Product"
                                                        ItemsSource="{Binding ComponentProductOptions}"
                                                        DisplayMember="Name"
                                                        ValueMember="Id"
                                                        AllowAutoComplete="True"
                                                        AllowNullInput="True"
                                                        AllowIncrementalFiltering="True"
                                                        SearchCondition="Contains"
                                                        AutoGenerateColumns="False"
                                                        IsAutoPopupSize="False"
                                                        PopUpWidth="380"
                                                        PopUpHeight="260"
                                                        GridColumnSizer="Star">
                    <syncfusion:GridMultiColumnDropDownList.Columns>
                        <syncfusion:Columns>
                            <syncfusion:GridTextColumn MappingName="Name" HeaderText="Product" />
                            <syncfusion:GridTextColumn MappingName="Category.Name" HeaderText="Category" Width="120" />
                        </syncfusion:Columns>
                    </syncfusion:GridMultiColumnDropDownList.Columns>
                </syncfusion:GridMultiColumnDropDownList>
                <controls:NumericColumn MappingName="Quantity" HeaderText="Qty" Width="96" NumberDecimalDigits="0" AllowNullValue="True" />
                <controls:NumericColumn MappingName="RecipeCost"
                                        HeaderText="Recipe Cost"
                                        Width="104"
                                        NumberDecimalDigits="2"
                                        AllowNullValue="True"
                                        AllowEditing="False" />
                <controls:NumericColumn MappingName="Cost" HeaderText="Cost" Width="104" NumberDecimalDigits="2" AllowEditing="False" />
            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <syncfusion:ButtonAdv Grid.Column="1"
                                  Label="Remove Line"
                                  IconTemplate="{StaticResource RemoveIconTemplate}"
                                  Command="{Binding RemoveComponentCommand}" />
        </Grid>
    </StackPanel>
</UserControl>
