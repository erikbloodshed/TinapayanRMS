<UserControl x:Class="TinapayanRMS.UI.Views.Products.PieceConversionCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TinapayanRMS.UI.Controls">
    <!--
        Each sub-assembly's batch and the pieces it makes. A row each (ShowAsRows): stacked in this narrow
        column, the diagram's boxes would read as one batch turning into the next.
    -->
    <StackPanel>
        <TextBlock Text="Unit Conversion Overview" Style="{StaticResource PanelHeaderStyle}" />

        <TextBlock Style="{StaticResource EmptyStateStyle}"
                   Margin="0,16"
                   Text="No sub-assemblies yet. Add one to see how many pieces a batch makes."
                   Visibility="{Binding HasUsages, Converter={StaticResource EmptyStateVisibilityConverter}}" />

        <controls:UnitConversionOverview ItemsSource="{Binding UsageEdits}"
                                         BaseUnitName="piece"
                                         ShowAsRows="True"
                                         Visibility="{Binding HasUsages, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </StackPanel>
</UserControl>
