<UserControl x:Class="TinapayanRMS.UI.Views.Products.UsageFormPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:controls="clr-namespace:TinapayanRMS.UI.Controls">
    <!--
        Add a sub-assembly to the recipe: a new one of the product's own, a link to an existing one
        (another product's, or a standalone one from the Sub-Assemblies screen), or a copy of one. Or change one already in it: an own one's role, name, lines and piece size, a
        linked one's piece size and add-ins only. Apply only puts it in the recipe; Save saves it. It is the whole of its
        Recipe Structure tab, so it has no box of its own, and for a section already in the recipe it carries
        that section's heading (EditingUsage) in place of the add form's title. A section is called by its role, and
        by its name too where the recipe has more than one in the role. Taking one out of the recipe is the card's Delete Sub-Assembly.
    -->
    <UserControl.Resources>
        <!--
            The percentage column's header, "Baker's %" or "Absolute %" (UsageFormPercentHeader). A template binding the view's own
            DataContext, not HeaderText="{Binding}": a bound HeaderText reaches the header cell only through the grid's
            row generator, which left each Recipe Structure tab's grid showing the header of the tab shown before it.
        -->
        <DataTemplate x:Key="PercentHeaderTemplate">
            <TextBlock Text="{Binding DataContext.UsageFormPercentHeader, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </DataTemplate>

        <!-- Show Add-Ins' chevron: down while the add-ins table is shut, up once it's open, as ExpandChevronStyle points. -->
        <DataTemplate x:Key="AddInsToggleIconTemplate">
            <TextBlock x:Name="Chevron" Text="&#xE70D;" Style="{StaticResource IconGlyphStyle}" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsFormAddInsExpanded, RelativeSource={RelativeSource AncestorType=syncfusion:ButtonAdv}}" Value="True">
                    <Setter TargetName="Chevron" Property="Text" Value="&#xE70E;" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="{Binding UsageFormTitle}"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource HeadingForegroundBrush}"
                   Margin="0,0,0,8"
                   Visibility="{Binding IsAddingUsage, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <!-- The section's role, which is what it's called, its badges, and what a piece of it costs as the form stands. -->
        <Grid Margin="0,0,0,10" Visibility="{Binding IsAddingUsage, Converter={StaticResource EmptyStateVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding EditingUsage.SectionName}"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource HeadingForegroundBrush}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
            <Border Grid.Column="1"
                    Style="{StaticResource LinkedBadgeStyle}"
                    ToolTip="Its lines come from where it's kept, and follow its changes."
                    Visibility="{Binding EditingUsage.IsLinked, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding EditingUsage.LinkedFromText}" FontSize="11" Foreground="{StaticResource WarningForegroundBrush}" />
            </Border>
            <Border Grid.Column="2"
                    HorizontalAlignment="Left"
                    Style="{StaticResource LinkedBadgeStyle}"
                    ToolTip="Changing its lines changes theirs too."
                    Visibility="{Binding EditingUsage.IsShared, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding EditingUsage.SharedText}" FontSize="11" Foreground="{StaticResource WarningForegroundBrush}" TextTrimming="CharacterEllipsis" />
            </Border>

            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock Text="Cost per piece" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding UsageFormCostPerPieceText}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource HeadingForegroundBrush}"
                           HorizontalAlignment="Right" />
            </StackPanel>
        </Grid>

        <!-- Where it comes from, while adding. Labels in the first row, fields in the second. -->
        <Grid Margin="0,0,0,8" Visibility="{Binding IsAddingUsage, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Sub-Assembly" Style="{StaticResource FieldLabelStyle}" />
            <syncfusion:ComboBoxAdv Grid.Row="1"
                                    Grid.Column="0"
                                    IsEditable="False"
                                    ItemsSource="{Binding UsageFormModes}"
                                    DisplayMemberPath="Name"
                                    SelectedItem="{Binding EditingUsageMode, Mode=TwoWay}" />

            <TextBlock Grid.Column="2"
                       Text="Existing Sub-Assembly or Packaging"
                       Style="{StaticResource FieldLabelStyle}"
                       Visibility="{Binding IsFormPickingSource, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <syncfusion:ComboBoxAdv Grid.Row="1"
                                    Grid.Column="2"
                                    ItemsSource="{Binding LinkableSubAssemblies}"
                                    DisplayMemberPath="DisplayName"
                                    SelectedItem="{Binding EditingUsageSource, Mode=TwoWay}"
                                    ToolTip="Another product's, or a standalone one from the Sub-Assemblies screen; or packaging: a packaging set, or another product's. A link follows every change made to it where it's kept; a copy is this product's own from then on."
                                    Visibility="{Binding IsFormPickingSource, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>

        <!--
            The product's own sub-assembly's role, which is what it's called, and its optional name, which tells it apart
            from others in that role ("Filling: Ube" beside "Filling: Cheese"). A linked one's are its owner's. In the add
            form's columns, under the Sub-Assembly and source pickers. Packaging has no name: there's only ever one.
        -->
        <Grid Margin="0,0,0,8" Visibility="{Binding IsFormEditingLines, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Role" Style="{StaticResource FieldLabelStyle}" />
            <syncfusion:ComboBoxAdv Grid.Row="1"
                                    Grid.Column="0"
                                    ItemsSource="{Binding FormRoleOptions}"
                                    DisplayMemberPath="Name"
                                    SelectedItem="{Binding EditingUsageRole, Mode=TwoWay}"
                                    ToolTip="What it's called in the recipe. Roles are added in Settings → Roles." />

            <TextBlock Grid.Column="2"
                       Text="Name (optional)"
                       Style="{StaticResource FieldLabelStyle}"
                       Visibility="{Binding IsFormPackaging, Converter={StaticResource EmptyStateVisibilityConverter}}" />
            <syncfusion:SfTextBoxExt Grid.Row="1"
                                     Grid.Column="2"
                                     Text="{Binding EditingUsageName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Watermark="e.g. Ube"
                                     ToolTip="Tells it apart from the recipe's other sub-assemblies in the same role: its tab reads Filling: Ube beside Filling: Cheese. One in a role can go without."
                                     Visibility="{Binding IsFormPackaging, Converter={StaticResource EmptyStateVisibilityConverter}}" />
        </Grid>

        <!--
            The product's packaging, when the form adds it (IsFormPackaging: the Packaging role, or packaging picked to
            link or copy): how much of each material one piece takes, the Packaging tab's own columns. Typed into for a
            new or copied one; a link's lines are kept where it's from, so they only show.
        -->
        <StackPanel Visibility="{Binding IsFormPackaging, Converter={StaticResource BooleanToVisibilityConverter}}">
            <syncfusion:SfDataGrid ItemsSource="{Binding FormPackagingLines}"
                                   controls:NumericEditing.IsEnabled="True"
                                   SelectedItem="{Binding SelectedFormPackagingLine, Mode=TwoWay}"
                                   GridLinesVisibility="Both"
                                   CurrentCellBorderBrush="{StaticResource AccentBrush}"
                                   CurrentCellBorderThickness="1"
                                   controls:GridFillerRows.IsEnabled="True"
                                   ShowRowHeader="True"
                                   AutoGenerateColumns="False"
                                   AllowEditing="{Binding IsFormEditingPackaging}"
                                   AllowDeleting="{Binding IsFormEditingPackaging}"
                                   EditTrigger="OnTap"
                                   AddNewRowPosition="{Binding IsFormEditingPackaging, Converter={StaticResource AddNewRowPositionConverter}}"
                                   SelectionMode="Single"
                                   ColumnSizer="Star"
                                   controls:GridEditCommit.OnFocusLeave="True"
                                   controls:GridAddNewRow.DropWhenUntouched="True"
                                   controls:AutoCompleteDropDown.IsEnabled="True"
                                   controls:GridAddNewRow.ItemFactory="{Binding NewFormPackagingLine}"
                                   Height="200">
                <syncfusion:SfDataGrid.Columns>
                    <!-- Typing opens the list of names containing the text and picks one: the first starting with it, else the first containing it -->
                    <syncfusion:GridMultiColumnDropDownList MappingName="PackagingMaterialId"
                                                            HeaderText="Material"
                                                            ItemsSource="{Binding PackagingMaterials}"
                                                            DisplayMember="Name"
                                                            ValueMember="Id"
                                                            AllowAutoComplete="True"
                                                            AllowNullInput="True"
                                                            AllowIncrementalFiltering="True"
                                                            SearchCondition="Contains"
                                                            AutoGenerateColumns="False"
                                                            IsAutoPopupSize="False"
                                                            PopUpWidth="380"
                                                            PopUpHeight="260"
                                                            GridColumnSizer="Star">
                        <syncfusion:GridMultiColumnDropDownList.Columns>
                            <syncfusion:Columns>
                                <syncfusion:GridTextColumn MappingName="Name" HeaderText="Material" />
                                <syncfusion:GridTextColumn MappingName="Category.Name" HeaderText="Category" Width="100" />
                                <syncfusion:GridTextColumn MappingName="BaseUnit.Abbreviation" HeaderText="Unit" Width="52" />
                                <controls:NumericColumn MappingName="BufferedCostPerBaseUnit" HeaderText="Cost per Unit" Width="96" NumberDecimalDigits="4" />
                            </syncfusion:Columns>
                        </syncfusion:GridMultiColumnDropDownList.Columns>
                    </syncfusion:GridMultiColumnDropDownList>
                    <controls:NumericColumn MappingName="QtyPerUnit" HeaderText="Qty" Width="96" NumberDecimalDigits="1" TypedDecimalDigits="4" AllowNullValue="True" />
                    <syncfusion:GridTextColumn MappingName="Unit" HeaderText="Unit" Width="64" AllowEditing="False" />
                    <controls:NumericColumn MappingName="UnitCost" HeaderText="Unit Cost" Width="88" NumberDecimalDigits="4" AllowEditing="False" />
                    <controls:NumericColumn MappingName="CostPerUnit" HeaderText="Cost per Piece" Width="104" NumberDecimalDigits="4" AllowEditing="False" />
                </syncfusion:SfDataGrid.Columns>
            </syncfusion:SfDataGrid>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="How much of each material one piece takes, in its unit. It's the product's packaging: Apply puts it on the Packaging tab."
                           Style="{StaticResource CaptionStyle}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,12,0"
                           Visibility="{Binding IsFormEditingPackaging, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Text="Linked: its lines are kept where it's from, and follow every change there, one set per piece."
                           Style="{StaticResource CaptionStyle}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,12,0"
                           Visibility="{Binding IsFormEditingPackaging, Converter={StaticResource EmptyStateVisibilityConverter}}" />
                <syncfusion:ButtonAdv Grid.Column="1"
                                      Label="Remove Line"
                                      IconTemplate="{StaticResource RemoveIconTemplate}"
                                      Command="{Binding RemoveFormPackagingLineCommand}"
                                      Visibility="{Binding IsFormEditingPackaging, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </StackPanel>

        <!-- A recipe section's lines, add-ins and piece size: none of it applies to packaging. -->
        <StackPanel Visibility="{Binding IsFormPackaging, Converter={StaticResource EmptyStateVisibilityConverter}}">
            <!--
                The lines that make one batch, in grams. The product's own are typed straight into: the add row at
                the bottom starts a line, Delete removes the selected one. A linked one's are its owner's, so they
                only show: AllowEditing is off and the add row goes with it (AddNewRowPositionConverter).
            -->
            <StackPanel Visibility="{Binding IsFormShowingLines, Converter={StaticResource BooleanToVisibilityConverter}}">
                <!-- Named only when it's a linked recipe, which add-ins go on top of; a product's own lines are just "the lines". -->
                <TextBlock Text="Linked Recipe"
                           Style="{StaticResource PanelHeaderStyle}"
                           Visibility="{Binding IsFormOfferingAddIns, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <syncfusion:SfDataGrid ItemsSource="{Binding FormLines}"
                                       controls:NumericEditing.IsEnabled="True"
                                       controls:GridAddNewRow.HideCheckBoxes="True"
                                       controls:GridCellEditing.IsEnabled="True"
                                       controls:GridCellEmphasis.IsEnabled="True"
                                       SelectedItem="{Binding SelectedFormLine, Mode=TwoWay}"
                                       GridLinesVisibility="Both"
                                       CurrentCellBorderBrush="{StaticResource AccentBrush}"
                                       CurrentCellBorderThickness="1"
                                       controls:GridFillerRows.IsEnabled="True"
                                       ShowRowHeader="True"
                                       AutoGenerateColumns="False"
                                       AllowEditing="{Binding IsFormEditingLines}"
                                       AllowDeleting="{Binding IsFormEditingLines}"
                                       EditTrigger="OnTap"
                                       AddNewRowPosition="{Binding IsFormEditingLines, Converter={StaticResource AddNewRowPositionConverter}}"
                                       SelectionMode="Single"
                                       ColumnSizer="Star"
                                       controls:GridEditCommit.OnFocusLeave="True"
                                       controls:GridAddNewRow.DropWhenUntouched="True"
                                       controls:AutoCompleteDropDown.IsEnabled="True"
                                       controls:GridAddNewRow.ItemFactory="{Binding NewFormLine}"
                                       Height="200">
                    <syncfusion:SfDataGrid.Columns>
                        <!-- Typing opens the list of names containing the text and picks one: the first starting with it, else the first containing it -->
                        <syncfusion:GridMultiColumnDropDownList MappingName="IngredientId"
                                                                HeaderText="Ingredient"
                                                                ItemsSource="{Binding Ingredients}"
                                                                DisplayMember="Name"
                                                                ValueMember="Id"
                                                                AllowAutoComplete="True"
                                                                AllowNullInput="True"
                                                                AllowIncrementalFiltering="True"
                                                                SearchCondition="Contains"
                                                                AutoGenerateColumns="False"
                                                                IsAutoPopupSize="False"
                                                                PopUpWidth="380"
                                                                PopUpHeight="260"
                                                                GridColumnSizer="Star">
                            <syncfusion:GridMultiColumnDropDownList.Columns>
                                <syncfusion:Columns>
                                    <syncfusion:GridTextColumn MappingName="Name" HeaderText="Ingredient" />
                                    <syncfusion:GridTextColumn MappingName="Category.Name" HeaderText="Category" Width="100" />
                                    <controls:NumericColumn MappingName="BufferedCostPerBaseUnit" HeaderText="Cost per g" Width="88" NumberDecimalDigits="4" />
                                </syncfusion:Columns>
                            </syncfusion:GridMultiColumnDropDownList.Columns>
                        </syncfusion:GridMultiColumnDropDownList>
                        <controls:NumericColumn MappingName="Grams" HeaderText="Grams" Width="110" NumberDecimalDigits="1" TypedDecimalDigits="4" AllowNullValue="True" />
                        <controls:NumericColumn MappingName="Percent"
                                                HeaderTemplate="{StaticResource PercentHeaderTemplate}"
                                                Width="86"
                                                NumberDecimalDigits="1"
                                                AllowNullValue="True"
                                                controls:GridCellEditing.AllowWhen="CanTypeBakersPercent"
                                                controls:GridCellEmphasis.When="IsPercentTyped" />
                        <controls:NumericColumn MappingName="Cost" HeaderText="Cost" Width="110" NumberDecimalDigits="2" AllowEditing="False" />
                        <!-- The formula's 100% base for baker's percentage, usually the flour; a linked one's is its owner's to set. -->
                        <syncfusion:GridCheckBoxColumn MappingName="IsFormulaBase"
                                                       HeaderText="Base"
                                                       Width="54"
                                                       HorizontalHeaderContentAlignment="Center"
                                                       AllowEditing="{Binding IsFormEditingLines}" />
                    </syncfusion:SfDataGrid.Columns>
                </syncfusion:SfDataGrid>

                <Grid Margin="0,8,0,8" Visibility="{Binding IsFormEditingLines, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <syncfusion:ButtonAdv Grid.Column="1" Label="Remove Line" IconTemplate="{StaticResource RemoveIconTemplate}" Command="{Binding RemoveFormLineCommand}" />
                </Grid>

                <!-- What the percentages are read against, and the figure a batch is scaled by. -->
                <TextBlock Text="{Binding UsageFormBaseCaption}" Style="{StaticResource CaptionStyle}" Margin="0,8,0,0" TextWrapping="Wrap" />

                <!-- Whose a linked one's lines are, and Show Add-Ins, which opens the table of this product's own extras under them -->
                <Grid Margin="0,8,0,8" Visibility="{Binding IsFormEditingLines, Converter={StaticResource EmptyStateVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Its lines are its owner's: change them where it's kept, or make this product a copy of it. Anything extra just for this product goes in its add-ins."
                               Style="{StaticResource CaptionStyle}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <syncfusion:ButtonAdv Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Label="{Binding FormAddInsToggleText}"
                                          ToolTip="This product's own extras on top of the linked recipe: a colouring, a flavouring, an inclusion"
                                          IconTemplate="{StaticResource AddInsToggleIconTemplate}"
                                          Command="{Binding ToggleFormAddInsCommand}" />
                </Grid>
            </StackPanel>

            <!--
                This product's own extras on top of the linked recipe: colouring, flavouring, inclusions. They go
                into the batch, so the Total Weight below is the recipe's lines plus these, and a piece takes its
                share of the whole thing, shown or not. Only a linked sub-assembly has them, and it's always this
                product's to type into, so the grid is plainly editable rather than bound like the one above. Show
                Add-Ins opens it; it's open to start with only when there are add-ins (IsFormAddInsExpanded).
            -->
            <StackPanel Margin="0,6,0,0" Visibility="{Binding IsFormShowingAddIns, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="This Product's Add-Ins" Style="{StaticResource PanelHeaderStyle}" />

                <syncfusion:SfDataGrid ItemsSource="{Binding FormAddIns}"
                                       controls:NumericEditing.IsEnabled="True"
                                       controls:GridCellEditing.IsEnabled="True"
                                       SelectedItem="{Binding SelectedFormAddIn, Mode=TwoWay}"
                                       GridLinesVisibility="Both"
                                       CurrentCellBorderBrush="{StaticResource AccentBrush}"
                                       CurrentCellBorderThickness="1"
                                       controls:GridFillerRows.IsEnabled="True"
                                       ShowRowHeader="True"
                                       AutoGenerateColumns="False"
                                       AllowEditing="True"
                                       AllowDeleting="True"
                                       EditTrigger="OnTap"
                                       AddNewRowPosition="Bottom"
                                       SelectionMode="Single"
                                       ColumnSizer="Star"
                                       controls:GridEditCommit.OnFocusLeave="True"
                                       controls:GridAddNewRow.DropWhenUntouched="True"
                                       controls:AutoCompleteDropDown.IsEnabled="True"
                                       controls:GridAddNewRow.ItemFactory="{Binding NewFormAddIn}"
                                       Height="140">
                    <syncfusion:SfDataGrid.Columns>
                        <!-- The same columns as the recipe above, so the two tables read as one batch. -->
                        <syncfusion:GridMultiColumnDropDownList MappingName="IngredientId"
                                                                HeaderText="Ingredient"
                                                                ItemsSource="{Binding Ingredients}"
                                                                DisplayMember="Name"
                                                                ValueMember="Id"
                                                                AllowAutoComplete="True"
                                                                AllowNullInput="True"
                                                                AllowIncrementalFiltering="True"
                                                                SearchCondition="Contains"
                                                                AutoGenerateColumns="False"
                                                                IsAutoPopupSize="False"
                                                                PopUpWidth="380"
                                                                PopUpHeight="260"
                                                                GridColumnSizer="Star">
                            <syncfusion:GridMultiColumnDropDownList.Columns>
                                <syncfusion:Columns>
                                    <syncfusion:GridTextColumn MappingName="Name" HeaderText="Ingredient" />
                                    <syncfusion:GridTextColumn MappingName="Category.Name" HeaderText="Category" Width="100" />
                                    <controls:NumericColumn MappingName="BufferedCostPerBaseUnit" HeaderText="Cost per g" Width="88" NumberDecimalDigits="4" />
                                </syncfusion:Columns>
                            </syncfusion:GridMultiColumnDropDownList.Columns>
                        </syncfusion:GridMultiColumnDropDownList>
                        <controls:NumericColumn MappingName="Grams" HeaderText="Grams" Width="110" NumberDecimalDigits="1" TypedDecimalDigits="4" AllowNullValue="True" />
                        <controls:NumericColumn MappingName="Percent"
                                                HeaderTemplate="{StaticResource PercentHeaderTemplate}"
                                                Width="86"
                                                NumberDecimalDigits="1"
                                                AllowNullValue="True"
                                                controls:GridCellEditing.AllowWhen="CanTypeBakersPercent" />
                        <controls:NumericColumn MappingName="Cost" HeaderText="Cost" Width="110" NumberDecimalDigits="2" AllowEditing="False" />
                    </syncfusion:SfDataGrid.Columns>
                </syncfusion:SfDataGrid>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding UsageFormAddInsCaption}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <syncfusion:ButtonAdv Grid.Column="1" Label="Remove Add-In" IconTemplate="{StaticResource RemoveIconTemplate}" Command="{Binding RemoveFormAddInCommand}" />
                </Grid>
            </StackPanel>

            <!-- The piece size: type the yield or the weight per piece, and the other follows from the batch -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Total Weight (g)" Style="{StaticResource FieldLabelStyle}" />
                <syncfusion:SfTextBoxExt Grid.Row="1"
                                         Grid.Column="0"
                                         IsReadOnly="True"
                                         Focusable="False"
                                         Text="{Binding UsageFormTotalWeightText, Mode=OneWay}"
                                         ToolTip="The batch: the sum of its lines, and of this product's add-ins to them." />

                <TextBlock Grid.Column="2" Text="Yield (pcs)" Style="{StaticResource FieldLabelStyle}" />
                <syncfusion:DoubleTextBox Grid.Row="1"
                                          Grid.Column="2"
                                          Value="{Binding EditingUsageYield, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          NumberDecimalDigits="2"
                                          ToolTip="Pieces one batch makes. Type it, and the weight per piece is worked out." />

                <TextBlock Grid.Column="4" Text="Weight per Piece (g)" Style="{StaticResource FieldLabelStyle}" />
                <syncfusion:DoubleTextBox Grid.Row="1"
                                          Grid.Column="4"
                                          Value="{Binding EditingUsageWeightPerPiece, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          NumberDecimalDigits="2"
                                          ToolTip="Grams of the batch in one piece. Type it, and the yield is worked out." />
            </Grid>

            <TextBlock Text="{Binding UsageFormPieceSizeCaption}" Style="{StaticResource CaptionStyle}" Margin="0,6,0,0" />
        </StackPanel>

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding UsageFormPreviewText}"
                       Style="{StaticResource CaptionStyle}"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"
                       Visibility="{Binding IsAddingUsage, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <syncfusion:ButtonAdv Label="Make a Copy"
                                      ToolTip="Make it this product's own copy, to change its lines here. It stops following where it's from."
                                      IconTemplate="{StaticResource CopyIconTemplate}"
                                      Command="{Binding MakeCopyCommand}"
                                      CommandParameter="{Binding EditingUsage}"
                                      Visibility="{Binding IsEditingLinkedUsage, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      Margin="0,0,8,0" />
                <syncfusion:ButtonAdv Label="Cancel" IconTemplate="{StaticResource CancelIconTemplate}" Command="{Binding CancelUsageCommand}" Margin="0,0,8,0" />
                <syncfusion:ButtonAdv Label="Apply" IconTemplate="{StaticResource ApplyIconTemplate}" Command="{Binding ApplyUsageCommand}" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
