<UserControl x:Class="TinapayanRMS.UI.Views.Products.UsageFormPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:controls="clr-namespace:TinapayanRMS.UI.Controls"
             xmlns:skinManager="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
             xmlns:sfTheme="clr-namespace:Syncfusion.Themes.Windows11Light.WPF;assembly=Syncfusion.Themes.Windows11Light.WPF">
    <!--
        Add a sub-assembly to the recipe: a new one of the product's own, a link to an existing one
        (another product's, or a standalone one from the Sub-Assemblies screen), or a copy of one — which of the three
        it is was picked on Add Sub-Assembly's drop-down before the form opened, and a link's or copy's title says which (UsageFormTitle).
        Or change one already in it: an own one's role, name, lines and piece size, a
        linked one's piece size and add-ins only. Apply only puts it in the recipe; Save saves it. It is all that shows under a
        sub-assembly's Recipe Structure tab (one panel for every tab, RecipeStructureCard), so it has no box of its own, and for a section already in the recipe it carries
        that section's heading (EditingUsage) in place of the add form's title. A section is called by its role, and
        by its name too where the recipe has more than one in the role. Taking one out of the recipe is the card's Delete Sub-Assembly.
    -->
    <UserControl.Resources>
        <!--
            The piece-size column's pieces: a figure's tile, a group's small heading, and a label-and-value row ruled off
            from the next. A tile's caption and value are centred in it (2026-09-25, at the user's request), as the
            headers' tiles are.
        -->
        <Style x:Key="StatTileStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PageBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <Style x:Key="StatCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}">
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style x:Key="StatValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource HeadingForegroundBrush}" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="GroupHeadingStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,14,0,4" />
        </Style>
        <Style x:Key="ParamRowStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="0,6" />
        </Style>
        <Style x:Key="ParamLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource HeadingForegroundBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ComputedValueStyle" TargetType="TextBlock" BasedOn="{StaticResource ParamLabelStyle}">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <!--
            The percentage column's header, "Baker's %" or "Absolute %" (UsageFormPercentHeader). A template binding the view's own
            DataContext, not HeaderText="{Binding}": a bound HeaderText reaches the header cell only through the grid's
            row generator, which left each Recipe Structure tab's grid showing the header of the tab shown before it.
        -->
        <DataTemplate x:Key="PercentHeaderTemplate">
            <TextBlock Text="{Binding DataContext.UsageFormPercentHeader, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </DataTemplate>
    </UserControl.Resources>

    <!-- The shared-size scope for PieceSizeColumn: the add-ins badge's layer lines up with the tables' columns. -->
    <StackPanel x:Name="FormRoot" Grid.IsSharedSizeScope="True">
        <!--
            A link's or a copy's title (IsFormPickingSource is only ever on while adding one). A new sub-assembly has no
            title: in its place, the badge saying Save keeps it on the Sub-Assemblies screen, which it does unless its
            role is product-owned (Settings → Roles) or packaging — then neither shows, and the row takes no room.
        -->
        <TextBlock Text="{Binding UsageFormTitle}"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource HeadingForegroundBrush}"
                   Margin="0,0,0,8"
                   Visibility="{Binding IsFormPickingSource, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <Border Style="{StaticResource LinkedBadgeStyle}"
                HorizontalAlignment="Left"
                Margin="0,0,0,8"
                ToolTip="Save puts it on the Sub-Assemblies screen, named after this product and its role, and this product links it there. Pick a product-owned role to keep it this product's own."
                Visibility="{Binding IsFormNewMovingToSubAssemblies, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="Moves to Sub-Assemblies on Save" FontSize="13" Foreground="{StaticResource WarningForegroundBrush}" />
        </Border>

        <!--
            Which existing sub-assembly is linked or copied. Nothing here asks *how* any more: Add Sub-Assembly's
            drop-down picks that before the form opens (RecipeStructureCard), and the title above says which way it is.
            So the row shows only while there's a source to pick (IsFormPickingSource, not IsAddingUsage) — a new
            sub-assembly has no row at all rather than an empty one — and the picker takes the rest of the width after its
            label (FormLabelStyle, on its left), which its longest entries ("Chocolate Glaze — Sub-Assemblies (Glaze)") need.
        -->
        <Grid Margin="0,0,0,8" Visibility="{Binding IsFormPickingSource, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Existing Sub-Assembly or Packaging" Style="{StaticResource FormLabelStyle}" />
            <!--
                IsEditable and AutoCompleteMode are spelled out here, unlike every other picker, which takes them from
                App's ApplyPickerDefaults as it loads (2026-09-22, at the user's request: "the combobox for selecting
                Existing Sub-Assembly or Packaging is not searchable"). This form is a UserControl inside a collapsed
                Border (RecipeStructureCard), so it isn't measured with the screen, its template never applies, and its
                pickers never raise Loaded — the class handler that sets those two properties never sees them. Set in
                XAML they hold from the first template application. Same for Role below.
            -->
            <syncfusion:ComboBoxAdv Grid.Column="1"
                                    ItemsSource="{Binding LinkableSubAssemblies}"
                                    DisplayMemberPath="DisplayName"
                                    IsEditable="True"
                                    AutoCompleteMode="Suggest"
                                    controls:FieldUndoStep.Recorder="{Binding}"
                                    SelectedItem="{Binding EditingUsageSource, Mode=TwoWay}"
                                    ToolTip="One from the Sub-Assemblies screen; or packaging: a packaging set, or another product's. A link follows every change made to it where it's kept; a copy is saved there as a new one, named after this product." />
        </Grid>

        <!--
            One row under the source picker. On the left, a section's badge: a linked one's, which opens it where it's
            kept, or "Moves to Sub-Assemblies on Save". Beside it, an own or new section's role, which is what it's
            called, and its optional name, which tells it apart from others in that role ("Filling: Ube" beside
            "Filling: Cheese"), each label on the left of its field (FormLabelStyle); a linked one's are the Sub-Assemblies
            screen's, so they don't show. An own one has no badge (the user's call, 2026-09-24): its Role and Name take
            the badge's place, level with its Move to Sub-Assemblies, as a linked one's badge is level with its Unlink
            and Copy. At the far right, those actions, never both sets. Packaging has no name: there's only ever one.
            Each piece carries the row's bottom margin itself, so a row with nothing showing takes no room. The two badges
            are collapsed by FallbackValue while adding: there's no EditingUsage then, and a binding through a null reads
            as Visibility's default, Visible, which showed both on every add form. What a piece of it costs is the
            piece-size column's first tile; a packaging section's stays under its own table.
        -->
        <Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Move to Sub-Assemblies was pressed: Save moves it there and links it -->
                    <Border Style="{StaticResource LinkedBadgeStyle}"
                            Margin="0,0,16,8"
                            ToolTip="Save puts it on the Sub-Assemblies screen, keeping its name and these lines, and this product links it there. Undo or Revert to keep it this product's own."
                            Visibility="{Binding EditingUsage.IsReleasing, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                        <TextBlock Text="Moves to Sub-Assemblies on Save" FontSize="13" Foreground="{StaticResource WarningForegroundBrush}" />
                    </Border>
                    <!-- A linked one's badge is a link: it opens the sub-assembly on the Sub-Assemblies screen (MainWindow subscribes to SubAssemblyOpenRequests) -->
                    <Button Style="{StaticResource LinkedBadgeLinkStyle}"
                            Margin="0,0,4,8"
                            Content="{Binding EditingUsage.LinkedFromText}"
                            Command="{Binding OpenSubAssemblyCommand}"
                            CommandParameter="{Binding EditingUsage.SubAssemblyId}"
                            ToolTip="It's kept on the Sub-Assemblies screen, and every product linking it uses its lines. Change them here or there: Save here writes them there. Click to open it there."
                            Visibility="{Binding IsShowingLinkBadge, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <!--
                        Edit beside the badge: links another sub-assembly in its place, keeping this product's piece size and
                        add-ins. An icon only, in the theme's glyph-button style as the window's own icon buttons are
                        (MainWindow), so it hovers as they do; the name lives in ToolTip and AutomationProperties.
                    -->
                    <Button Width="24"
                            Height="24"
                            Margin="0,0,16,8"
                            VerticalAlignment="Center"
                            Style="{DynamicResource {skinManager:ThemeKey Key=WPFGlyphButtonStyle, Theme={x:Type sfTheme:Windows11LightSkinHelper}}}"
                            Command="{Binding StartChangingLinkCommand}"
                            ToolTip="Link another sub-assembly in its place, keeping this product's piece size and add-ins. The one linked now stays on the Sub-Assemblies screen."
                            AutomationProperties.Name="Change link"
                            Visibility="{Binding IsShowingLinkBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="&#xE70F;" Style="{StaticResource IconGlyphStyle}" />
                    </Button>

                    <!--
                        The badge's place while its link is changed: what it could link instead, searchable as the add form's
                        source picker is (IsEditable and AutoCompleteMode spelled out for the same reason), and a cancel
                        glyph that puts the badge back. Picking one relinks the section.
                    -->
                    <syncfusion:ComboBoxAdv Width="360"
                                            Margin="0,0,4,8"
                                            VerticalAlignment="Center"
                                            ItemsSource="{Binding ChangeLinkOptions}"
                                            DisplayMemberPath="DisplayName"
                                            IsEditable="True"
                                            AutoCompleteMode="Suggest"
                                            DefaultText="Link instead…"
                                            SelectedItem="{Binding ChangeLinkTarget, Mode=TwoWay}"
                                            ToolTip="A sub-assembly from the Sub-Assemblies screen to link in this one's place"
                                            Visibility="{Binding IsChangingLink, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Width="24"
                            Height="24"
                            Margin="0,0,16,8"
                            VerticalAlignment="Center"
                            Style="{DynamicResource {skinManager:ThemeKey Key=WPFGlyphButtonStyle, Theme={x:Type sfTheme:Windows11LightSkinHelper}}}"
                            Command="{Binding CancelChangingLinkCommand}"
                            ToolTip="Keep the link as it is"
                            AutomationProperties.Name="Cancel changing link"
                            Visibility="{Binding IsChangingLink, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="&#xE711;" Style="{StaticResource IconGlyphStyle}" />
                    </Button>
                </StackPanel>

                <Grid Grid.Column="1" Margin="0,0,0,8" VerticalAlignment="Center" Visibility="{Binding IsFormEditingLines, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <!--
                        Every column hugs what's in it, with the spacer as the gap: both fields are a fixed width, so a
                        share-of-the-width column left a gap between them that grew with the window.
                    -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Role" Style="{StaticResource FormLabelStyle}" />
                    <!--
                        Fixed width, unlike the source picker above: a role is one short word and a name a few, so stretching
                        them across the form only spread the text out.
                    -->
                    <syncfusion:ComboBoxAdv Grid.Column="1"
                                            Width="180"
                                            HorizontalAlignment="Left"
                                            ItemsSource="{Binding FormRoleOptions}"
                                            DisplayMemberPath="Name"
                                            IsEditable="True"
                                            AutoCompleteMode="Suggest"
                                            controls:FieldUndoStep.Recorder="{Binding}"
                                            SelectedItem="{Binding EditingUsageRole, Mode=TwoWay}"
                                            ToolTip="What it's called in the recipe. Roles are added in Settings → Roles." />

                    <TextBlock Grid.Column="3"
                               Text="Name (optional)"
                               Style="{StaticResource FormLabelStyle}"
                               Visibility="{Binding IsFormPackaging, Converter={StaticResource EmptyStateVisibilityConverter}}" />
                    <syncfusion:SfTextBoxExt Grid.Column="4"
                                             Width="240"
                                             HorizontalAlignment="Left"
                                             controls:FieldUndoStep.Recorder="{Binding}"
                                             Text="{Binding EditingUsageName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Watermark="e.g. Ube"
                                             ToolTip="Tells it apart from the recipe's other sub-assemblies in the same role: its tab reads Filling: Ube beside Filling: Cheese. One in a role can go without. Save keeps it on the Sub-Assemblies screen named after the product and role, with this after them: Cheese Roll Filling: Ube."
                                             Visibility="{Binding IsFormPackaging, Converter={StaticResource EmptyStateVisibilityConverter}}" />
                </Grid>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0,0,8"
                            Visibility="{Binding IsAddingUsage, Converter={StaticResource EmptyStateVisibilityConverter}}">
                    <syncfusion:ButtonAdv Label="Unlink"
                                          ToolTip="Make it this product's own copy, to change its lines for this product alone, whatever its role. The one on the Sub-Assemblies screen stays as it is. Save keeps the copy with this product, named after it: other products can copy it but not link it."
                                          IconTemplate="{StaticResource UnlinkIconTemplate}"
                                          Command="{Binding UnlinkCommand}"
                                          CommandParameter="{Binding EditingUsage}"
                                          Visibility="{Binding IsEditingLinkedUsage, Converter={StaticResource BooleanToVisibilityConverter}}"
                                          Margin="0,0,8,0" />
                    <syncfusion:ButtonAdv Label="Copy"
                                          ToolTip="Make a copy of it, to change its lines for this product alone. Save keeps the copy named after this product, and uses it instead: as its own in a product-owned role, otherwise on the Sub-Assemblies screen, linked."
                                          IconTemplate="{StaticResource CopyIconTemplate}"
                                          Command="{Binding MakeCopyCommand}"
                                          CommandParameter="{Binding EditingUsage}"
                                          Visibility="{Binding IsEditingLinkedUsage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <syncfusion:ButtonAdv Label="Move to Sub-Assemblies"
                                          ToolTip="Save puts it on the Sub-Assemblies screen, keeping its name and lines, and this product links it there. Other products can then link it too, and its lines are edited on the Sub-Assemblies screen."
                                          IconTemplate="{StaticResource LinkIconTemplate}"
                                          Command="{Binding MoveToSubAssembliesCommand}"
                                          CommandParameter="{Binding EditingUsage}"
                                          Visibility="{Binding IsEditingOwnedUsage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Grid>

            <!--
                A linked one's add-ins badge, level with its linked badge and aligned on the top right corner of its lines
                table (2026-09-28, at the user's request): whether the product adds anything to the recipe, so it reads
                without scrolling down to the add-ins table. A layer over the row above, in the tables' columns (the
                piece-size column's width shared through PieceSizeColumn, the gap the same 16), so the badge's right
                edge is the table's while Unlink and Copy keep the far right. Without a background the layer lets clicks
                through to the row under it. With add-ins the badge is a link, in the link colours as the linked badge
                is, and a click (or Enter or Space) scrolls down to the table and puts focus in it; with none it's a
                plain grey tag. It shows while a link is being added too, where the add-ins table does.
            -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PieceSizeColumn" />
                </Grid.ColumnDefinitions>
                <Button HorizontalAlignment="Right"
                        Margin="0,0,0,8"
                        Style="{StaticResource LinkedBadgeLinkStyle}"
                        Content="{Binding FormAddInsBadgeText}"
                        Click="AddInsBadge_Click"
                        ToolTip="This product adds its own extras to the linked recipe. Click to scroll down to them."
                        AutomationProperties.Name="{Binding FormAddInsBadgeText, StringFormat='{}{0}: go to the add-ins table'}"
                        Visibility="{Binding HasFormAddIns, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,0,8"
                        Background="{StaticResource PageBackgroundBrush}"
                        CornerRadius="4"
                        Padding="6,1"
                        ToolTip="This product adds nothing to the linked recipe. Add a colouring, a flavouring or an inclusion in the Add-Ins table under its lines."
                        Visibility="{Binding IsFormShowingNoAddIns, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding FormAddInsBadgeText}" FontSize="13" Foreground="{StaticResource MutedForegroundBrush}" />
                </Border>
            </Grid>
        </Grid>

        <!--
            The product's packaging, when the form adds it (IsFormPackaging: the Packaging role, or packaging picked to
            link or copy): how much of each material one piece takes, the Packaging tab's own columns. Typed into for a
            new or copied one; a link's lines are kept where it's from, so they only show.
        -->
        <StackPanel Visibility="{Binding IsFormPackaging, Converter={StaticResource BooleanToVisibilityConverter}}">
            <syncfusion:SfDataGrid ItemsSource="{Binding FormPackagingLines}"
                                   controls:GridUndoSteps.Recorder="{Binding}"
                                   controls:CostBasisColumns.Basis="{Binding CostBasis}"
                                   controls:GridRowReordering.IsEnabled="True"
                                   controls:NumericEditing.IsEnabled="True"
                                   SelectedItem="{Binding SelectedFormPackagingLine, Mode=TwoWay}"
                                   GridLinesVisibility="Both"
                                   CurrentCellBorderBrush="{StaticResource AccentBrush}"
                                   CurrentCellBorderThickness="1"
                                   controls:GridFillerRows.IsEnabled="True"
                                   ShowRowHeader="True"
                                   AutoGenerateColumns="False"
                                   AllowEditing="{Binding IsFormEditingPackaging}"
                                   AllowDeleting="{Binding IsFormEditingPackaging}"
                                   EditTrigger="OnTap"
                                   AddNewRowPosition="{Binding IsFormEditingPackaging, Converter={StaticResource AddNewRowPositionConverter}}"
                                   SelectionMode="Single"
                                   ColumnSizer="Star"
                                   controls:GridEditCommit.OnFocusLeave="True"
                                   controls:GridAddNewRow.DropWhenUntouched="True"
                                   controls:AutoCompleteDropDown.IsEnabled="True"
                                   controls:GridAddNewRow.ItemFactory="{Binding NewFormPackagingLine}"
                                   Height="200">
                <syncfusion:SfDataGrid.Columns>
                    <!-- Typing opens the list of names containing the text and picks one: the first starting with it, else the first containing it -->
                    <syncfusion:GridMultiColumnDropDownList MappingName="PackagingMaterialId"
                                                            HeaderText="Material"
                                                            ItemsSource="{Binding PackagingMaterials}"
                                                            DisplayMember="Name"
                                                            ValueMember="Id"
                                                            AllowAutoComplete="True"
                                                            AllowNullInput="True"
                                                            AllowIncrementalFiltering="True"
                                                            SearchCondition="Contains"
                                                            AutoGenerateColumns="False"
                                                            IsAutoPopupSize="False"
                                                            PopUpWidth="380"
                                                            PopUpHeight="260"
                                                            GridColumnSizer="Star">
                        <syncfusion:GridMultiColumnDropDownList.Columns>
                            <syncfusion:Columns>
                                <syncfusion:GridTextColumn MappingName="Name" HeaderText="Material" />
                                <syncfusion:GridTextColumn MappingName="Category.Name" HeaderText="Category" Width="100" />
                                <syncfusion:GridTextColumn MappingName="BaseUnit.Abbreviation" HeaderText="Unit" Width="52" />
                                <controls:NumericColumn MappingName="BufferedCostPerBaseUnit" HeaderText="Cost per Unit" Width="96" NumberDecimalDigits="4" controls:CostBasisColumns.Shows="Buffered" />
                                <controls:NumericColumn MappingName="CostPerBaseUnit" HeaderText="Cost per Unit" Width="96" NumberDecimalDigits="4" IsHidden="True" controls:CostBasisColumns.Shows="Unbuffered" />
                            </syncfusion:Columns>
                        </syncfusion:GridMultiColumnDropDownList.Columns>
                    </syncfusion:GridMultiColumnDropDownList>
                    <controls:NumericColumn MappingName="QtyPerUnit" HeaderText="Qty" Width="96" NumberDecimalDigits="1" TypedDecimalDigits="4" AllowNullValue="True" />
                    <!--
                        The unit the Qty is typed in: the material's base unit, or one of its alternative units. Each row has its
                        own material, so its list comes from the row (PackagingUnitSelector). Editable, so the unit can be typed
                        as well as picked. What the quantity comes to in base units is never shown — the conversion is behind
                        the scenes, in Unit Cost (what one of the picked unit costs) and in the line's own total.
                    -->
                    <syncfusion:GridComboBoxColumn MappingName="UnitKey"
                                                   HeaderText="Unit"
                                                   Width="72"
                                                   ItemsSourceSelector="{StaticResource PackagingUnitSelector}"
                                                   DisplayMemberPath="Abbreviation"
                                                   SelectedValuePath="Key"
                                                   IsEditable="True" />
                    <controls:NumericColumn MappingName="UnitCost" HeaderText="Unit Cost" Width="88" NumberDecimalDigits="4" AllowEditing="False" />
                    <controls:NumericColumn MappingName="CostPerUnit" HeaderText="Cost per Piece" Width="104" NumberDecimalDigits="2" AllowEditing="False" />
                </syncfusion:SfDataGrid.Columns>
            </syncfusion:SfDataGrid>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- What a piece of it costs, on the same row as Remove Line, read as the other sections' -->
                <TextBlock Grid.Column="1"
                           Style="{StaticResource CaptionStyle}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0">
                    <Run Text="Cost per piece · " /><Run Text="{Binding UsageFormCostPerPieceText, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="How much of each material one piece takes, in its unit. It's the product's packaging: Apply puts it on the Packaging tab."
                           Style="{StaticResource CaptionStyle}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,12,0"
                           Visibility="{Binding IsFormEditingPackaging, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Text="Linked: its lines are kept where it's from, and follow every change there, one set per piece."
                           Style="{StaticResource CaptionStyle}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,12,0"
                           Visibility="{Binding IsFormEditingPackaging, Converter={StaticResource EmptyStateVisibilityConverter}}" />
                <syncfusion:ButtonAdv Grid.Column="2"
                                      Label="Remove Line"
                                      IconTemplate="{StaticResource RemoveIconTemplate}"
                                      Command="{Binding RemoveFormPackagingLineCommand}"
                                      Visibility="{Binding IsFormEditingPackaging, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </StackPanel>

        <!--
            The tables on the left, the piece size on the right: the batch's lines and this product's
            add-ins to them are as wide as the form allows, and the three piece-size boxes sit beside
            them in a column of their own.
        -->
        <Grid Visibility="{Binding IsFormPackaging, Converter={StaticResource EmptyStateVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="PieceSizeColumn" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <!--
                    The lines that make one batch, in grams, typed straight into: the add row at the bottom starts a
                    line, Insert puts one in above the current one, Delete removes the selected one. A linked one's too, which Save writes to the sub-assembly where
                    it's kept. Only a link being picked shows its lines read-only: AllowEditing is off and the add row goes
                    with it (AddNewRowPositionConverter).
                -->
                <StackPanel Visibility="{Binding IsFormShowingLines, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <syncfusion:SfDataGrid x:Name="LinesGrid"
                                           ItemsSource="{Binding FormLines}"
                                           controls:GridUndoSteps.Recorder="{Binding}"
                                           controls:CostBasisColumns.Basis="{Binding CostBasis}"
                                           controls:GridRowReordering.IsEnabled="True"
                                           controls:GridRowInserting.IsEnabled="True"
                                           controls:NumericEditing.IsEnabled="True"
                                           controls:GridAddNewRow.HideCheckBoxes="True"
                                           controls:GridCellEditing.IsEnabled="True"
                                           SelectedItem="{Binding SelectedFormLine, Mode=TwoWay}"
                                           GridLinesVisibility="Both"
                                           CurrentCellBorderBrush="{StaticResource AccentBrush}"
                                           CurrentCellBorderThickness="1"
                                           controls:GridFillerRows.IsEnabled="True"
                                           ShowRowHeader="True"
                                           AutoGenerateColumns="False"
                                           AllowEditing="{Binding IsFormLinesEditable}"
                                           AllowDeleting="{Binding IsFormLinesEditable}"
                                           EditTrigger="OnTap"
                                           AddNewRowPosition="{Binding IsFormLinesEditable, Converter={StaticResource AddNewRowPositionConverter}}"
                                           SelectionMode="Single"
                                           ColumnSizer="Star"
                                           controls:GridEditCommit.OnFocusLeave="True"
                                           controls:GridAddNewRow.DropWhenUntouched="True"
                                           controls:AutoCompleteDropDown.IsEnabled="True"
                                           controls:GridAddNewRow.ItemFactory="{Binding NewFormLine}"
                                           Height="314">
                        <syncfusion:SfDataGrid.Columns>
                            <!-- Typing opens the list of names containing the text and picks one: the first starting with it, else the first containing it -->
                            <syncfusion:GridMultiColumnDropDownList MappingName="IngredientId"
                                                                    HeaderText="Ingredient"
                                                                    ItemsSource="{Binding Ingredients}"
                                                                    DisplayMember="Name"
                                                                    ValueMember="Id"
                                                                    AllowAutoComplete="True"
                                                                    AllowNullInput="True"
                                                                    AllowIncrementalFiltering="True"
                                                                    SearchCondition="Contains"
                                                                    AutoGenerateColumns="False"
                                                                    IsAutoPopupSize="False"
                                                                    PopUpWidth="380"
                                                                    PopUpHeight="260"
                                                                    GridColumnSizer="Star">
                                <syncfusion:GridMultiColumnDropDownList.Columns>
                                    <syncfusion:Columns>
                                        <syncfusion:GridTextColumn MappingName="Name" HeaderText="Ingredient" />
                                        <syncfusion:GridTextColumn MappingName="Category.Name" HeaderText="Category" Width="100" />
                                        <controls:NumericColumn MappingName="BufferedCostPerBaseUnit" HeaderText="Cost/g" Width="88" NumberDecimalDigits="4" controls:CostBasisColumns.Shows="Buffered" />
                                        <controls:NumericColumn MappingName="CostPerBaseUnit" HeaderText="Cost/g" Width="88" NumberDecimalDigits="4" IsHidden="True" controls:CostBasisColumns.Shows="Unbuffered" />
                                    </syncfusion:Columns>
                                </syncfusion:GridMultiColumnDropDownList.Columns>
                            </syncfusion:GridMultiColumnDropDownList>
                            <!-- The four figure columns are one width, so they read as a row of equals. -->
                            <controls:NumericColumn MappingName="Grams" HeaderText="Grams" Width="96" NumberDecimalDigits="1" TypedDecimalDigits="4" AllowNullValue="True" />
                            <controls:NumericColumn MappingName="Percent"
                                                    HeaderTemplate="{StaticResource PercentHeaderTemplate}"
                                                    Width="96"
                                                    NumberDecimalDigits="1"
                                                    AllowNullValue="True"
                                                    controls:GridCellEditing.AllowWhen="CanTypeBakersPercent" />
                            <!-- The ingredient's buffered cost per gram, as the picker's own column shows it: the rate this line's Cost comes from. -->
                            <controls:NumericColumn MappingName="CostPerGram" HeaderText="Cost/g" Width="96" NumberDecimalDigits="4" AllowEditing="False" />
                            <controls:NumericColumn MappingName="Cost" HeaderText="Cost" Width="96" NumberDecimalDigits="2" AllowEditing="False" />
                            <!-- The formula's 100% base for baker's percentage, usually the flour. -->
                            <syncfusion:GridCheckBoxColumn MappingName="IsFormulaBase"
                                                           HeaderText="Base"
                                                           Width="54"
                                                           HorizontalHeaderContentAlignment="Center"
                                                           AllowEditing="{Binding IsFormLinesEditable}" />
                        </syncfusion:SfDataGrid.Columns>
                    </syncfusion:SfDataGrid>

                    <!-- The formula caption on the left; Insert Line and Remove Line only while the lines can be typed into -->
                    <Grid Margin="0,8,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- What the percentages are read against, and the figure a batch is scaled by. -->
                        <TextBlock Text="{Binding UsageFormBaseCaption}"
                                   Style="{StaticResource CaptionStyle}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,0,12,0" />
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Visibility="{Binding IsFormLinesEditable, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <syncfusion:ButtonAdv Label="Insert Line"
                                                  IconTemplate="{StaticResource AddIconTemplate}"
                                                  Command="{x:Static controls:GridRowInserting.InsertLine}"
                                                  CommandTarget="{Binding ElementName=LinesGrid}"
                                                  ToolTip="Puts a blank line in above the selected one, or at the bottom with none selected. Insert."
                                                  Margin="0,0,8,0" />
                            <syncfusion:ButtonAdv Label="Remove Line"
                                                  IconTemplate="{StaticResource RemoveIconTemplate}"
                                                  Command="{Binding RemoveFormLineCommand}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!--
                    This product's own extras on top of the linked recipe: colouring, flavouring, inclusions. They go
                    into the batch, so the Total Weight below is the recipe's lines plus these, and a piece takes its
                    share of the whole thing. Only a linked sub-assembly has them, and it's always this product's to
                    type into, so the grid is plainly editable rather than bound like the one above. Always shown,
                    empty or not: a Show/Hide Add-Ins toggle shut it before (until 2026-09-28), which hid that the batch
                    had extras in it. The badge above the lines says whether it has any, and scrolls here.
                -->
                <StackPanel x:Name="AddInsSection" Margin="0,6,0,0" Visibility="{Binding IsFormShowingAddIns, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <!--
                        The table's heading, and on the right, over the table's top right corner as the add-ins badge is over
                        the lines', a Go to top badge (2026-09-28, at the user's request), the add-ins badge's way back: a
                        click (or Enter or Space) scrolls to the top of the form and puts focus in the lines table.
                    -->
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="Add-Ins" Style="{StaticResource GroupHeadingStyle}" Margin="0" VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right"
                                Style="{StaticResource LinkedBadgeLinkStyle}"
                                Content="Go to top"
                                Click="GoToTopBadge_Click"
                                ToolTip="Scroll back up to the linked recipe's lines."
                                AutomationProperties.Name="Go to top: the linked recipe's lines" />
                    </Grid>
                    <syncfusion:SfDataGrid x:Name="AddInsGrid"
                                           ItemsSource="{Binding FormAddIns}"
                                           controls:GridUndoSteps.Recorder="{Binding}"
                                           controls:CostBasisColumns.Basis="{Binding CostBasis}"
                                           controls:GridRowReordering.IsEnabled="True"
                                           controls:GridRowInserting.IsEnabled="True"
                                           controls:NumericEditing.IsEnabled="True"
                                           controls:GridCellEditing.IsEnabled="True"
                                           SelectedItem="{Binding SelectedFormAddIn, Mode=TwoWay}"
                                           GridLinesVisibility="Both"
                                           CurrentCellBorderBrush="{StaticResource AccentBrush}"
                                           CurrentCellBorderThickness="1"
                                           controls:GridFillerRows.IsEnabled="True"
                                           ShowRowHeader="True"
                                           AutoGenerateColumns="False"
                                           AllowEditing="True"
                                           AllowDeleting="True"
                                           EditTrigger="OnTap"
                                           AddNewRowPosition="Bottom"
                                           SelectionMode="Single"
                                           ColumnSizer="Star"
                                           controls:GridEditCommit.OnFocusLeave="True"
                                           controls:GridAddNewRow.DropWhenUntouched="True"
                                           controls:AutoCompleteDropDown.IsEnabled="True"
                                           controls:GridAddNewRow.ItemFactory="{Binding NewFormAddIn}"
                                           Height="140">
                        <syncfusion:SfDataGrid.Columns>
                            <!-- The same columns as the recipe above, so the two tables read as one batch. -->
                            <syncfusion:GridMultiColumnDropDownList MappingName="IngredientId"
                                                                    HeaderText="Ingredient"
                                                                    ItemsSource="{Binding Ingredients}"
                                                                    DisplayMember="Name"
                                                                    ValueMember="Id"
                                                                    AllowAutoComplete="True"
                                                                    AllowNullInput="True"
                                                                    AllowIncrementalFiltering="True"
                                                                    SearchCondition="Contains"
                                                                    AutoGenerateColumns="False"
                                                                    IsAutoPopupSize="False"
                                                                    PopUpWidth="380"
                                                                    PopUpHeight="260"
                                                                    GridColumnSizer="Star">
                                <syncfusion:GridMultiColumnDropDownList.Columns>
                                    <syncfusion:Columns>
                                        <syncfusion:GridTextColumn MappingName="Name" HeaderText="Ingredient" />
                                        <syncfusion:GridTextColumn MappingName="Category.Name" HeaderText="Category" Width="100" />
                                        <controls:NumericColumn MappingName="BufferedCostPerBaseUnit" HeaderText="Cost/g" Width="88" NumberDecimalDigits="4" controls:CostBasisColumns.Shows="Buffered" />
                                        <controls:NumericColumn MappingName="CostPerBaseUnit" HeaderText="Cost/g" Width="88" NumberDecimalDigits="4" IsHidden="True" controls:CostBasisColumns.Shows="Unbuffered" />
                                    </syncfusion:Columns>
                                </syncfusion:GridMultiColumnDropDownList.Columns>
                            </syncfusion:GridMultiColumnDropDownList>
                            <!-- The figure columns one width, as above (2026-09-28, with Cost/g added at the user's request), so they line up under the recipe's. -->
                            <controls:NumericColumn MappingName="Grams" HeaderText="Grams" Width="96" NumberDecimalDigits="1" TypedDecimalDigits="4" AllowNullValue="True" />
                            <controls:NumericColumn MappingName="Percent"
                                                    HeaderTemplate="{StaticResource PercentHeaderTemplate}"
                                                    Width="96"
                                                    NumberDecimalDigits="1"
                                                    AllowNullValue="True"
                                                    controls:GridCellEditing.AllowWhen="CanTypeBakersPercent" />
                            <controls:NumericColumn MappingName="CostPerGram" HeaderText="Cost/g" Width="96" NumberDecimalDigits="4" AllowEditing="False" />
                            <controls:NumericColumn MappingName="Cost" HeaderText="Cost" Width="96" NumberDecimalDigits="2" AllowEditing="False" />
                        </syncfusion:SfDataGrid.Columns>
                    </syncfusion:SfDataGrid>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding UsageFormAddInsCaption}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <syncfusion:ButtonAdv Label="Insert Add-In"
                                                  IconTemplate="{StaticResource AddIconTemplate}"
                                                  Command="{x:Static controls:GridRowInserting.InsertLine}"
                                                  CommandTarget="{Binding ElementName=AddInsGrid}"
                                                  ToolTip="Puts a blank add-in in above the selected one, or at the bottom with none selected. Insert."
                                                  Margin="0,0,8,0" />
                            <syncfusion:ButtonAdv Label="Remove Add-In" IconTemplate="{StaticResource RemoveIconTemplate}" Command="{Binding RemoveFormAddInCommand}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>

            <!--
                The piece size, as a summary beside the tables: what a piece and the whole batch cost, then the three
                figures typed in (what the batch loses being made, then the weight per piece or the yield: type either
                and the other follows from what the batch makes, the total weight less that shrinkage), then the two
                weights they work out to.
            -->
            <StackPanel Grid.Column="2" Width="230">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource StatTileStyle}"
                            ToolTip="What one piece of the product takes of this section: the batch's cost shared out by weight per piece.">
                        <StackPanel>
                            <TextBlock Text="Cost/piece" Style="{StaticResource StatCaptionStyle}" />
                            <TextBlock Text="{Binding UsageFormCostPerPieceText}" Style="{StaticResource StatValueStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2"
                            Style="{StaticResource StatTileStyle}"
                            ToolTip="What the whole batch costs: its lines, and this product's add-ins to them.">
                        <StackPanel>
                            <TextBlock Text="Batch cost" Style="{StaticResource StatCaptionStyle}" />
                            <TextBlock Text="{Binding UsageFormBatchCostText}" Style="{StaticResource StatValueStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Text="Batch parameters" Style="{StaticResource GroupHeadingStyle}" />
                <Border Style="{StaticResource ParamRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Shrinkage %" Style="{StaticResource ParamLabelStyle}" />
                        <syncfusion:DoubleTextBox Grid.Column="1"
                                                  Width="80"
                                                  controls:FieldUndoStep.Recorder="{Binding}"
                                                  MinValue="0"
                                                  MaxValue="99.99"
                                                  Value="{Binding EditingUsageShrinkagePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  NumberDecimalDigits="2"
                                                  ToolTip="How much of the batch's weight this product loses making it — baking a dough off, reducing a filling. The pieces come out of what's left, so the batch's cost is spread over fewer of them. A new section starts at the default in Settings → Costing Defaults; set it to 0 if nothing is lost." />
                    </Grid>
                </Border>
                <Border Style="{StaticResource ParamRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Weight/piece (g)" Style="{StaticResource ParamLabelStyle}" />
                        <syncfusion:DoubleTextBox Grid.Column="1"
                                                  Width="80"
                                                  controls:FieldUndoStep.Recorder="{Binding}"
                                                  Value="{Binding EditingUsageWeightPerPiece, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  NumberDecimalDigits="2"
                                                  ToolTip="What one finished piece weighs, out of the batch's final weight. Type it, and the yield is worked out." />
                    </Grid>
                </Border>
                <Border Style="{StaticResource ParamRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Yield (pcs)" Style="{StaticResource ParamLabelStyle}" />
                        <syncfusion:DoubleTextBox Grid.Column="1"
                                                  Width="80"
                                                  controls:FieldUndoStep.Recorder="{Binding}"
                                                  Value="{Binding EditingUsageYield, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  NumberDecimalDigits="2"
                                                  ToolTip="Pieces one batch makes. Type it, and the weight per piece is worked out." />
                    </Grid>
                </Border>

                <!--
                    TextBlocks, not read-only text boxes: WPF hooks every TextBox up to Windows' text services, whatever
                    its focus or IsReadOnly, and each change of its text then waits on them (about 115 ms a product
                    picked, measured; far more on some machines).
                -->
                <TextBlock Text="Computed" Style="{StaticResource GroupHeadingStyle}" />
                <Border Style="{StaticResource ParamRowStyle}"
                        ToolTip="The batch that goes in: the sum of its lines, and of this product's add-ins to them.">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Total weight" Style="{StaticResource ParamLabelStyle}" />
                        <TextBlock Grid.Column="1" Text="{Binding UsageFormTotalWeightText}" Style="{StaticResource ComputedValueStyle}" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource ParamRowStyle}"
                        ToolTip="What the batch makes: the total weight less its shrinkage. This is what the yield and the weight per piece share out.">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Final weight" Style="{StaticResource ParamLabelStyle}" />
                        <TextBlock Grid.Column="1" Text="{Binding UsageFormFinalWeightText}" Style="{StaticResource ComputedValueStyle}" />
                    </Grid>
                </Border>

                <TextBlock Text="{Binding UsageFormPieceSizeCaption}" Style="{StaticResource CaptionStyle}" Margin="0,8,0,0" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
