<UserControl x:Class="TinapayanRMS.UI.Views.Products.HistoryCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:controls="clr-namespace:TinapayanRMS.UI.Controls"
             xmlns:vm="clr-namespace:TinapayanRMS.UI.ViewModels">
    <!--
        The product's versions (ProductVersionHistory) in the order they're used: the table, what changed in the version
        picked, then Restore. The table takes the tab's whole width, since its eight columns need it on a small screen
        (beside the changes, at 1366 px and 125%, its figures scrolled out of sight); the changes under it scroll on their
        own. No frame of its own: the details card around the tabs has it.
    -->
    <Border Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="120" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Version History" Style="{StaticResource SectionHeaderStyle}" />
            <TextBlock Grid.Row="1"
                       Style="{StaticResource CaptionStyle}"
                       Margin="0,0,0,12"
                       TextWrapping="Wrap"
                       Text="A version is recorded each time a Save changes the recipe, packaging, costing or price. Then is what it cost when it was saved; Today is the same recipe at what its materials cost now. Type a note into a version to say what it was for." />

            <Grid Grid.Row="2">
                <syncfusion:SfDataGrid ItemsSource="{Binding VersionHistory.Rows}"
                                       SelectedItem="{Binding VersionHistory.SelectedRow, Mode=TwoWay}"
                                       controls:GridHeaderHeight.Lines="2"
                                       GridLinesVisibility="Both"
                                       CurrentCellBorderBrush="{StaticResource AccentBrush}"
                                       CurrentCellBorderThickness="1"
                                       controls:GridFillerRows.IsEnabled="True"
                                       AutoGenerateColumns="False"
                                       AllowEditing="True"
                                       EditTrigger="OnTap"
                                       controls:GridEditCommit.OnFocusLeave="True"
                                       SelectionMode="Single"
                                       ColumnSizer="Star">
                    <!-- Headings wrap onto two lines, so the figure columns can be narrow -->
                    <syncfusion:SfDataGrid.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" />
                        </DataTemplate>
                    </syncfusion:SfDataGrid.HeaderTemplate>
                    <syncfusion:SfDataGrid.Columns>
                        <syncfusion:GridNumericColumn MappingName="Number" HeaderText="Version" NumberDecimalDigits="0" AllowEditing="False" Width="64" />
                        <syncfusion:GridTextColumn MappingName="SavedText" HeaderText="Saved" AllowEditing="False" Width="164" />
                        <syncfusion:GridTextColumn MappingName="Note" HeaderText="Note" AllowEditing="True" MinimumWidth="120" />
                        <controls:NumericColumn MappingName="BaseCostThen" HeaderText="Base Cost Then" NumberDecimalDigits="2" AllowEditing="False" Width="84" />
                        <controls:NumericColumn MappingName="SuggestedPriceThen" HeaderText="Suggested Price Then" NumberDecimalDigits="2" AllowEditing="False" Width="84" />
                        <controls:NumericColumn MappingName="BaseCostToday" HeaderText="Base Cost Today" NumberDecimalDigits="2" AllowEditing="False" Width="84" />
                        <controls:NumericColumn MappingName="SuggestedPriceToday" HeaderText="Suggested Price Today" NumberDecimalDigits="2" AllowEditing="False" Width="84" />
                        <controls:NumericColumn MappingName="CurrentPrice" HeaderText="Current Price" NumberDecimalDigits="2" AllowNullValue="True" AllowEditing="False" Width="84" />
                    </syncfusion:SfDataGrid.Columns>
                </syncfusion:SfDataGrid>

                <!-- Over the empty table: a product saved before versions were kept has none until its next Save -->
                <TextBlock Style="{StaticResource CaptionStyle}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="360"
                           Visibility="{Binding VersionHistory.IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Text="No versions yet. The next Save that changes this product's recipe, packaging, costing or price records how it was before and how it is after." />
            </Grid>

            <!-- What changed in the version picked: the heading and Compare With on one line, then the list -->
            <StackPanel Grid.Row="3" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="240" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Changes" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Grid.Column="1" Text="Compare With" Style="{StaticResource FormLabelStyle}" />
                    <syncfusion:ComboBoxAdv Grid.Column="2"
                                            VerticalAlignment="Center"
                                            ItemsSource="{x:Static vm:ProductVersionHistory.CompareChoices}"
                                            SelectedIndex="{Binding VersionHistory.CompareIndex, Mode=TwoWay}" />
                </Grid>

                <TextBlock Style="{StaticResource CaptionStyle}"
                           Margin="0,0,0,6"
                           TextWrapping="Wrap"
                           Text="{Binding VersionHistory.ChangesCaption}" />

                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="132">
                    <ItemsControl ItemsSource="{Binding VersionHistory.Changes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="•" />
                                    <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

            <!-- Print Version is the header's Print, which prints the version picked while this tab shows -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0">
                <syncfusion:ButtonAdv Label="Print Version"
                                      IconTemplate="{StaticResource PrintIconTemplate}"
                                      Command="{Binding PrintCommand}"
                                      ToolTip="Shows this version's recipe, packaging and costing, at its costs then, in the Print tab." />
                <syncfusion:ButtonAdv Label="Restore"
                                      Margin="8,0,0,0"
                                      IconTemplate="{StaticResource RestoreIconTemplate}"
                                      Command="{Binding RestoreVersionCommand}"
                                      ToolTip="Puts this version's recipe, packaging, costing and price into the form. Save keeps it; Undo takes it back." />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
