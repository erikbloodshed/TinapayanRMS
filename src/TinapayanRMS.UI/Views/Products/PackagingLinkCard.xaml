<UserControl x:Class="TinapayanRMS.UI.Views.Products.TabLinksCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf">
    <!-- Live Template links: saved as soon as they're made or removed, without Save. -->
    <Border Style="{StaticResource CardStyle}">
        <StackPanel>
            <TextBlock Text="Live Template Links" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,4" />
            <TextBlock Text="A linked role or the packaging reads through to the same part of another product, and follows its changes. Unlinking keeps a copy of what it showed. Links apply at once."
                       Style="{StaticResource CardCaptionStyle}" />

            <syncfusion:SfDataGrid ItemsSource="{Binding TabLinks}"
                                   SelectedItem="{Binding SelectedTabLink, Mode=TwoWay}"
                                   AutoGenerateColumns="False"
                                   AllowEditing="False"
                                   SelectionMode="Single"
                                   NavigationMode="Row"
                                   ColumnSizer="Star"
                                   MinHeight="96"
                                   MaxHeight="200">
                <syncfusion:SfDataGrid.Columns>
                    <syncfusion:GridTextColumn MappingName="TabName" HeaderText="Tab" />
                    <syncfusion:GridTextColumn MappingName="LinkedToProductName" HeaderText="Linked To" />
                </syncfusion:SfDataGrid.Columns>
            </syncfusion:SfDataGrid>

            <syncfusion:ButtonAdv Label="Unlink Selected Tab"
                                  HorizontalAlignment="Left"
                                  IconTemplate="{StaticResource RemoveIconTemplate}"
                                  Command="{Binding UnlinkTabCommand}"
                                  Margin="0,8,0,0" />

            <TextBlock Text="Link a Tab" FontWeight="SemiBold" Foreground="{StaticResource HeadingForegroundBrush}" Margin="0,20,0,8" />

            <!-- Labels in the first row, fields in the second -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Tab Kind" Style="{StaticResource FieldLabelStyle}" />
                <syncfusion:ComboBoxAdv Grid.Row="1"
                                        Grid.Column="0"
                                        ItemsSource="{Binding TabKindOptions}"
                                        SelectedItem="{Binding EditingLinkTabKind, Mode=TwoWay}" />

                <TextBlock Grid.Column="2" Text="Role (for a role's tab)" Style="{StaticResource FieldLabelStyle}" />
                <syncfusion:ComboBoxAdv Grid.Row="1"
                                        Grid.Column="2"
                                        ItemsSource="{Binding Roles}"
                                        DisplayMemberPath="Name"
                                        SelectedItem="{Binding EditingLinkRole, Mode=TwoWay}" />

                <TextBlock Grid.Column="4" Text="Link To Product" Style="{StaticResource FieldLabelStyle}" />
                <syncfusion:ComboBoxAdv Grid.Row="1"
                                        Grid.Column="4"
                                        ItemsSource="{Binding LinkTargetProductOptions}"
                                        DisplayMemberPath="Name"
                                        SelectedItem="{Binding EditingLinkTargetProduct, Mode=TwoWay}" />
            </Grid>

            <syncfusion:ButtonAdv Label="Link Tab"
                                  HorizontalAlignment="Left"
                                  IconTemplate="{StaticResource AddIconTemplate}"
                                  Command="{Binding LinkTabCommand}"
                                  Margin="0,12,0,0" />
        </StackPanel>
    </Border>
</UserControl>
