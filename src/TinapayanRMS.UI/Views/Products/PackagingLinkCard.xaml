<UserControl x:Class="TinapayanRMS.UI.Views.Products.PackagingLinkCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf">
    <!-- A packaging link: saved as soon as it's made or removed, without Save. -->
    <StackPanel>
        <TextBlock Text="Packaging Link" Style="{StaticResource PanelHeaderStyle}" />
        <TextBlock Text="Linked packaging reads through to another product's, and follows its changes. Unlinking keeps a copy of what it showed. Links apply at once. (A sub-assembly is shared by linking it in the recipe.)"
                   Style="{StaticResource PanelCaptionStyle}" />

        <Border Style="{StaticResource WarningBannerStyle}"
                Margin="0,0,0,8"
                Visibility="{Binding IsPackagingLinked, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding PackagingLinkedToText}"
                           Foreground="{StaticResource WarningForegroundBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />
                <syncfusion:ButtonAdv Grid.Column="1"
                                      Label="Unlink"
                                      IconTemplate="{StaticResource RemoveIconTemplate}"
                                      Command="{Binding UnlinkPackagingCommand}" />
            </Grid>
        </Border>
        <TextBlock Text="This product has its own packaging."
                   Style="{StaticResource CaptionStyle}"
                   Margin="0,0,0,8"
                   Visibility="{Binding IsPackagingLinked, Converter={StaticResource EmptyStateVisibilityConverter}}" />

        <!-- Labels in the first row, fields in the second -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Link Packaging To" Style="{StaticResource FieldLabelStyle}" />
            <syncfusion:ComboBoxAdv Grid.Row="1"
                                    Grid.Column="0"
                                    ItemsSource="{Binding LinkTargetProductOptions}"
                                    DisplayMemberPath="Name"
                                    SelectedItem="{Binding EditingPackagingLinkTarget, Mode=TwoWay}" />

            <syncfusion:ButtonAdv Grid.RowSpan="2"
                                  Grid.Column="2"
                                  VerticalAlignment="Bottom"
                                  Label="Link"
                                  IconTemplate="{StaticResource LinkIconTemplate}"
                                  Command="{Binding LinkPackagingCommand}" />
        </Grid>
    </StackPanel>
</UserControl>
