<UserControl x:Class="TinapayanRMS.UI.Views.Products.PacksCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:controls="clr-namespace:TinapayanRMS.UI.Controls">
    <!--
        The product's sellable packs. The top table is the packs themselves — a name and how many pieces go in.
        Picking one opens its own packaging below it: the box, label and ribbon that pack takes, paid once a pack
        rather than once a piece. Cost and Price are read-only: they come from the screen's cost summary, so they
        follow the recipe, the per-piece packaging and the Costing tab's percentages.
    -->
    <StackPanel Margin="8">
        <TextBlock Text="Packs" Style="{StaticResource PanelHeaderStyle}" />
        <TextBlock Text="How this product is sold in multiples — a pack of 8, a pack of 12. A pack costs the pieces it holds plus its own box, and is priced with the same margin and VAT as one piece."
                   Style="{StaticResource PanelCaptionStyle}"
                   TextWrapping="Wrap" />

        <syncfusion:SfDataGrid ItemsSource="{Binding PackEdits}"
                               SelectedItem="{Binding SelectedPackEdit, Mode=TwoWay}"
                               GridLinesVisibility="Both"
                               CurrentCellBorderBrush="{StaticResource AccentBrush}"
                               CurrentCellBorderThickness="1"
                               controls:GridFillerRows.IsEnabled="True"
                               ShowRowHeader="True"
                               AutoGenerateColumns="False"
                               AllowEditing="True"
                               EditTrigger="OnTap"
                               SelectionMode="Single"
                               ColumnSizer="Star"
                               controls:GridEditCommit.OnFocusLeave="True"
                               Margin="0,10,0,0"
                               Height="170">
            <syncfusion:SfDataGrid.Columns>
                <syncfusion:GridTextColumn MappingName="Name" HeaderText="Pack" />
                <controls:NumericColumn MappingName="PiecesPerPack" HeaderText="Pieces" Width="88" NumberDecimalDigits="0" />
                <controls:NumericColumn MappingName="MaterialCost" HeaderText="Material Cost" Width="120" NumberDecimalDigits="4" AllowEditing="False" />
                <controls:NumericColumn MappingName="SellingPrice" HeaderText="Selling Price" Width="120" NumberDecimalDigits="2" AllowEditing="False" />
            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Add a pack, then name it and set how many pieces it holds."
                       Style="{StaticResource CaptionStyle}"
                       VerticalAlignment="Center" />
            <syncfusion:ButtonAdv Grid.Column="1" Label="Add Pack" IconTemplate="{StaticResource AddIconTemplate}" Command="{Binding AddPackCommand}" Margin="0,0,8,0" />
            <syncfusion:ButtonAdv Grid.Column="2" Label="Remove Pack" IconTemplate="{StaticResource RemoveIconTemplate}" Command="{Binding RemovePackCommand}" />
        </Grid>

        <!-- The selected pack's own packaging: shown only once a pack is picked, so an empty screen stays quiet -->
        <StackPanel Margin="0,20,0,0"
                    DataContext="{Binding SelectedPackEdit}"
                    Visibility="{Binding Converter={StaticResource NotNullToVisibilityConverter}}">
            <TextBlock Style="{StaticResource PanelHeaderStyle}">
                <Run Text="Packaging for one " /><Run Text="{Binding Name, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Text="The box, label and ribbon this pack takes — once a pack, however many pieces go in. Quantities are in each material's own base unit."
                       Style="{StaticResource PanelCaptionStyle}"
                       TextWrapping="Wrap" />

            <syncfusion:SfDataGrid ItemsSource="{Binding LineEdits}"
                                   SelectedItem="{Binding SelectedLineEdit, Mode=TwoWay}"
                                   GridLinesVisibility="Both"
                                   CurrentCellBorderBrush="{StaticResource AccentBrush}"
                                   CurrentCellBorderThickness="1"
                                   controls:GridFillerRows.IsEnabled="True"
                                   ShowRowHeader="True"
                                   AutoGenerateColumns="False"
                                   AllowEditing="True"
                                   AllowDeleting="True"
                                   EditTrigger="OnTap"
                                   AddNewRowPosition="Bottom"
                                   SelectionMode="Single"
                                   ColumnSizer="Star"
                                   controls:GridEditCommit.OnFocusLeave="True"
                                   controls:GridAddNewRow.DropWhenUntouched="True"
                                   controls:AutoCompleteDropDown.IsEnabled="True"
                                   controls:GridAddNewRow.ItemFactory="{Binding NewLineEdit}"
                                   Margin="0,10,0,0"
                                   Height="180">
                <syncfusion:SfDataGrid.Columns>
                    <syncfusion:GridMultiColumnDropDownList MappingName="PackagingMaterialId"
                                                            HeaderText="Material"
                                                            ItemsSource="{Binding DataContext.PackagingMaterials, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            DisplayMember="Name"
                                                            ValueMember="Id"
                                                            AllowAutoComplete="True"
                                                            AllowNullInput="True"
                                                            AllowIncrementalFiltering="True"
                                                            SearchCondition="Contains"
                                                            AutoGenerateColumns="False"
                                                            IsAutoPopupSize="False"
                                                            PopUpWidth="380"
                                                            PopUpHeight="260"
                                                            GridColumnSizer="Star">
                        <syncfusion:GridMultiColumnDropDownList.Columns>
                            <syncfusion:Columns>
                                <syncfusion:GridTextColumn MappingName="Name" HeaderText="Material" />
                                <syncfusion:GridTextColumn MappingName="Category.Name" HeaderText="Category" Width="100" />
                                <syncfusion:GridTextColumn MappingName="BaseUnit.Abbreviation" HeaderText="Unit" Width="52" />
                                <controls:NumericColumn MappingName="BufferedCostPerBaseUnit" HeaderText="Cost per Unit" Width="96" NumberDecimalDigits="4" />
                            </syncfusion:Columns>
                        </syncfusion:GridMultiColumnDropDownList.Columns>
                    </syncfusion:GridMultiColumnDropDownList>
                    <controls:NumericColumn MappingName="QtyPerUnit" HeaderText="Qty" Width="96" NumberDecimalDigits="4" />
                    <syncfusion:GridTextColumn MappingName="Unit" HeaderText="Unit" Width="64" AllowEditing="False" />
                    <controls:NumericColumn MappingName="UnitCost" HeaderText="Unit Cost" Width="88" NumberDecimalDigits="4" AllowEditing="False" />
                    <controls:NumericColumn MappingName="CostPerUnit" HeaderText="Cost per Pack" Width="104" NumberDecimalDigits="4" AllowEditing="False" />
                </syncfusion:SfDataGrid.Columns>
            </syncfusion:SfDataGrid>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Type the lines straight into the table." Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                <syncfusion:ButtonAdv Grid.Column="1"
                                      Label="Remove Line"
                                      IconTemplate="{StaticResource RemoveIconTemplate}"
                                      Command="{Binding DataContext.RemovePackLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            </Grid>
        </StackPanel>
    </StackPanel>
</UserControl>
