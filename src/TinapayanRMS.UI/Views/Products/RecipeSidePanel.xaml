<UserControl x:Class="TinapayanRMS.UI.Views.Products.RecipeSidePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TinapayanRMS.UI.Views.Products">
    <!-- The Recipe tab's right-hand column, beside the Recipe Structure: what the recipe comes to, a line between each section. -->
    <StackPanel>
        <local:CostOverviewCard />
        <Border Style="{StaticResource SectionDividerStyle}" />
        <local:PieceConversionCard />
        <Border Style="{StaticResource SectionDividerStyle}" />
        <local:RecipeUsageExampleCard />
    </StackPanel>
</UserControl>
