<UserControl x:Class="TinapayanRMS.UI.Views.Products.ProfitMarginCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The markup is the profit on a piece; its margin is that profit's share of the price before VAT. -->
    <Border Style="{StaticResource CardStyle}">
        <StackPanel>
            <TextBlock Text="Profit Margin" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,4" />
            <TextBlock Text="What the shop keeps from one piece once its costs are covered. VAT isn't counted: it goes to the government."
                       Style="{StaticResource CardCaptionStyle}" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Estimated Profit" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Text="{Binding Costs.Markup, StringFormat='₱{0:N2}'}"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource HeadingForegroundBrush}" />
                    <TextBlock Style="{StaticResource CaptionStyle}">
                        <Run Text="per piece, a" /><Run Text="{Binding Costs.MarginPercent, StringFormat=' {0:0.##}%', Mode=OneWay}" /><Run Text=" markup on cost" />
                    </TextBlock>
                </StackPanel>

                <Border Grid.Column="2"
                        MinWidth="110"
                        Padding="16,10"
                        CornerRadius="8"
                        VerticalAlignment="Center"
                        Background="{StaticResource SuccessBackgroundBrush}">
                    <StackPanel>
                        <TextBlock Text="Margin" Foreground="{StaticResource SuccessForegroundBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding Costs.ProfitMarginPercent, StringFormat='{}{0:N1}%'}"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SuccessForegroundBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
