<UserControl x:Class="TinapayanRMS.UI.Views.Products.CostingCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf">
    <UserControl.Resources>
        <!-- A costing input: a coloured edge beside its label and field, then what it comes to in the price. No box around it. -->
        <Style x:Key="CostTileStyle" TargetType="Border">
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="Padding" Value="10,0,0,0" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="TileCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}">
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <SolidColorBrush x:Key="LaborTileBrush" Color="#0F766E" />
        <SolidColorBrush x:Key="OverheadTileBrush" Color="#D97706" />
        <SolidColorBrush x:Key="AdministrativeTileBrush" Color="#7C3AED" />
        <SolidColorBrush x:Key="MarkupTileBrush" Color="#BE123C" />
        <SolidColorBrush x:Key="VatTileBrush" Color="#0369A1" />

        <!-- The breakdown table's cells -->
        <Style x:Key="HeaderCellStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="8,5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
        </Style>
        <Style x:Key="LabelCellStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="8,5" />
            <Setter Property="Foreground" Value="{StaticResource HeadingForegroundBrush}" />
        </Style>
        <Style x:Key="AmountCellStyle" TargetType="TextBlock" BasedOn="{StaticResource LabelCellStyle}">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style x:Key="ShareCellStyle" TargetType="TextBlock" BasedOn="{StaticResource AmountCellStyle}">
            <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
        </Style>
        <!-- A thin line under a row, across all three columns -->
        <Style x:Key="RowRuleStyle" TargetType="Border">
            <Setter Property="Grid.ColumnSpan" Value="3" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
    </UserControl.Resources>

    <!--
        The product's costing in one place: the five percentages typed in on the left, each with what it comes to, and on
        the right one piece's selling price from its materials up, each part per piece and as a share of the price.
    -->
    <StackPanel>
        <TextBlock Text="Costing Summary" Style="{StaticResource PanelHeaderStyle}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="200" />
                <ColumnDefinition Width="33" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!-- The costing parameters, one under another -->
            <StackPanel>
                <Border Style="{StaticResource CostTileStyle}" BorderBrush="{StaticResource LaborTileBrush}">
                    <StackPanel>
                        <TextBlock Text="Labor %" Style="{StaticResource FieldLabelStyle}" ToolTip="Of the material cost per piece" />
                        <syncfusion:DoubleTextBox Value="{Binding EditingLaborPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource TileCaptionStyle}">
                            <Run Text="{Binding Costs.Labor, StringFormat='₱{0:N4}', Mode=OneWay}" /><Run Text="{Binding Costs.LaborShare, StringFormat=' · {0:N1}% of the price', Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CostTileStyle}" BorderBrush="{StaticResource OverheadTileBrush}">
                    <StackPanel>
                        <TextBlock Text="Overhead %" Style="{StaticResource FieldLabelStyle}" ToolTip="Of the material cost per piece" />
                        <syncfusion:DoubleTextBox Value="{Binding EditingOverheadPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource TileCaptionStyle}">
                            <Run Text="{Binding Costs.Overhead, StringFormat='₱{0:N4}', Mode=OneWay}" /><Run Text="{Binding Costs.OverheadShare, StringFormat=' · {0:N1}% of the price', Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CostTileStyle}" BorderBrush="{StaticResource AdministrativeTileBrush}">
                    <StackPanel>
                        <TextBlock Text="Administrative %" Style="{StaticResource FieldLabelStyle}" ToolTip="Of the material cost per piece: office, permits, bookkeeping" />
                        <syncfusion:DoubleTextBox Value="{Binding EditingAdministrativePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource TileCaptionStyle}">
                            <Run Text="{Binding Costs.Administrative, StringFormat='₱{0:N4}', Mode=OneWay}" /><Run Text="{Binding Costs.AdministrativeShare, StringFormat=' · {0:N1}% of the price', Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CostTileStyle}" BorderBrush="{StaticResource MarkupTileBrush}">
                    <StackPanel>
                        <TextBlock Text="Markup %" Style="{StaticResource FieldLabelStyle}" ToolTip="On the base cost: materials, labor, overhead and administrative" />
                        <syncfusion:DoubleTextBox Value="{Binding EditingMarginPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource TileCaptionStyle}">
                            <Run Text="{Binding Costs.Markup, StringFormat='₱{0:N4}', Mode=OneWay}" /><Run Text="{Binding Costs.MarkupShare, StringFormat=' · {0:N1}% of the price', Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CostTileStyle}" BorderBrush="{StaticResource VatTileBrush}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="VAT %" Style="{StaticResource FieldLabelStyle}" ToolTip="On top of the marked-up price" />
                        <syncfusion:DoubleTextBox Value="{Binding EditingVatPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource TileCaptionStyle}">
                            <Run Text="{Binding Costs.Vat, StringFormat='₱{0:N4}', Mode=OneWay}" /><Run Text="{Binding Costs.VatShare, StringFormat=' · {0:N1}% of the price', Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Column="1" Width="1" HorizontalAlignment="Center" Background="{StaticResource CardBorderBrush}" />

            <!-- The recipe cost breakdown: one piece's selling price, from its materials up -->
            <Grid Grid.Column="2" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" MinWidth="120" />
                    <ColumnDefinition Width="Auto" MinWidth="90" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.ColumnSpan="3" CornerRadius="4" Background="{StaticResource PageBackgroundBrush}" />
                <TextBlock Text="Component" Style="{StaticResource HeaderCellStyle}" />
                <TextBlock Grid.Column="1" Text="Cost per Piece" Style="{StaticResource HeaderCellStyle}" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="2" Text="% of Price" Style="{StaticResource HeaderCellStyle}" HorizontalAlignment="Right" />

                <Border Grid.Row="1" Style="{StaticResource RowRuleStyle}" />
                <TextBlock Grid.Row="1" Text="Sub-assemblies (ingredients)" Style="{StaticResource LabelCellStyle}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Costs.SubAssemblies, StringFormat='₱{0:N4}'}" Style="{StaticResource AmountCellStyle}" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Costs.SubAssembliesShare, StringFormat='{}{0:N1}%'}" Style="{StaticResource ShareCellStyle}" />

                <Border Grid.Row="2" Style="{StaticResource RowRuleStyle}" />
                <TextBlock Grid.Row="2" Text="Packaging" Style="{StaticResource LabelCellStyle}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Costs.Packaging, StringFormat='₱{0:N4}'}" Style="{StaticResource AmountCellStyle}" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Costs.PackagingShare, StringFormat='{}{0:N1}%'}" Style="{StaticResource ShareCellStyle}" />

                <Border Grid.Row="3" Style="{StaticResource RowRuleStyle}" />
                <TextBlock Grid.Row="3" Style="{StaticResource LabelCellStyle}">
                    <Run Text="Labor (" /><Run Text="{Binding Costs.LaborPercent, StringFormat='{}{0:0.##}', Mode=OneWay}" /><Run Text="% of materials)" />
                </TextBlock>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Costs.Labor, StringFormat='₱{0:N4}'}" Style="{StaticResource AmountCellStyle}" />
                <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Costs.LaborShare, StringFormat='{}{0:N1}%'}" Style="{StaticResource ShareCellStyle}" />

                <Border Grid.Row="4" Style="{StaticResource RowRuleStyle}" />
                <TextBlock Grid.Row="4" Style="{StaticResource LabelCellStyle}">
                    <Run Text="Overhead (" /><Run Text="{Binding Costs.OverheadPercent, StringFormat='{}{0:0.##}', Mode=OneWay}" /><Run Text="% of materials)" />
                </TextBlock>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Costs.Overhead, StringFormat='₱{0:N4}'}" Style="{StaticResource AmountCellStyle}" />
                <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding Costs.OverheadShare, StringFormat='{}{0:N1}%'}" Style="{StaticResource ShareCellStyle}" />

                <Border Grid.Row="5" Style="{StaticResource RowRuleStyle}" />
                <TextBlock Grid.Row="5" Style="{StaticResource LabelCellStyle}">
                    <Run Text="Administrative (" /><Run Text="{Binding Costs.AdministrativePercent, StringFormat='{}{0:0.##}', Mode=OneWay}" /><Run Text="% of materials)" />
                </TextBlock>
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Costs.Administrative, StringFormat='₱{0:N4}'}" Style="{StaticResource AmountCellStyle}" />
                <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding Costs.AdministrativeShare, StringFormat='{}{0:N1}%'}" Style="{StaticResource ShareCellStyle}" />

                <!-- The base cost the markup goes on -->
                <Border Grid.Row="6" Grid.ColumnSpan="3" Margin="0,4" CornerRadius="4" Background="{StaticResource AccentSoftBrush}" />
                <TextBlock Grid.Row="6" Text="Subtotal (base cost)" Style="{StaticResource LabelCellStyle}" FontWeight="SemiBold" Margin="8,8" />
                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Costs.BaseCost, StringFormat='₱{0:N4}'}" Style="{StaticResource AmountCellStyle}" FontWeight="SemiBold" Margin="8,8" />
                <TextBlock Grid.Row="6" Grid.Column="2" Text="{Binding Costs.BaseCostShare, StringFormat='{}{0:N1}%'}" Style="{StaticResource ShareCellStyle}" Margin="8,8" />

                <Border Grid.Row="7" Style="{StaticResource RowRuleStyle}" />
                <TextBlock Grid.Row="7" Style="{StaticResource LabelCellStyle}">
                    <Run Text="Markup (" /><Run Text="{Binding Costs.MarginPercent, StringFormat='{}{0:0.##}', Mode=OneWay}" /><Run Text="%)" />
                </TextBlock>
                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Costs.Markup, StringFormat='₱{0:N4}'}" Style="{StaticResource AmountCellStyle}" />
                <TextBlock Grid.Row="7" Grid.Column="2" Text="{Binding Costs.MarkupShare, StringFormat='{}{0:N1}%'}" Style="{StaticResource ShareCellStyle}" />

                <TextBlock Grid.Row="8" Style="{StaticResource LabelCellStyle}">
                    <Run Text="VAT (" /><Run Text="{Binding Costs.VatPercent, StringFormat='{}{0:0.##}', Mode=OneWay}" /><Run Text="%)" />
                </TextBlock>
                <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Costs.Vat, StringFormat='₱{0:N4}'}" Style="{StaticResource AmountCellStyle}" />
                <TextBlock Grid.Row="8" Grid.Column="2" Text="{Binding Costs.VatShare, StringFormat='{}{0:N1}%'}" Style="{StaticResource ShareCellStyle}" />

                <!-- The price one piece sells for -->
                <Border Grid.Row="9"
                        Grid.ColumnSpan="3"
                        Margin="0,8,0,0"
                        Padding="8"
                        CornerRadius="6"
                        Background="{StaticResource AccentSoftBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Total Selling Price (per piece)" Foreground="{StaticResource HeadingForegroundBrush}" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1"
                                   Text="{Binding Costs.SellingPrice, StringFormat='₱{0:N2}'}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Grid.RowSpan="2"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontWeight="SemiBold"
                                   Text="{Binding Costs.SellingPriceShare, StringFormat='{}{0:N0}%'}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </StackPanel>
</UserControl>
