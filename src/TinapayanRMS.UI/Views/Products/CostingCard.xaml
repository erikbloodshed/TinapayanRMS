<UserControl x:Class="TinapayanRMS.UI.Views.Products.CostingCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:controls="clr-namespace:TinapayanRMS.UI.Controls">
    <UserControl.Resources>
        <!-- A costing input: a coloured edge beside its label and field, then what it comes to in the price. No box around it. -->
        <Style x:Key="CostTileStyle" TargetType="Border">
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="Padding" Value="10,0,0,0" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="TileCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}">
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <!-- The tiles' edges, Latte hues in rainbow order down the column, ending on the accent's Sky at the price -->
        <SolidColorBrush x:Key="LaborTileBrush" Color="{StaticResource LattePeachColor}" />
        <SolidColorBrush x:Key="OverheadTileBrush" Color="{StaticResource LatteYellowColor}" />
        <SolidColorBrush x:Key="AdministrativeTileBrush" Color="{StaticResource LatteGreenColor}" />
        <SolidColorBrush x:Key="MarkupTileBrush" Color="{StaticResource LatteTealColor}" />
        <SolidColorBrush x:Key="VatTileBrush" Color="{StaticResource LatteSkyColor}" />

        <!-- The breakdown table's cells -->
        <Style x:Key="HeaderCellStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="8,5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
        </Style>
        <Style x:Key="LabelCellStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="8,5" />
            <Setter Property="Foreground" Value="{StaticResource HeadingForegroundBrush}" />
        </Style>
        <Style x:Key="AmountCellStyle" TargetType="TextBlock" BasedOn="{StaticResource LabelCellStyle}">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style x:Key="ShareCellStyle" TargetType="TextBlock" BasedOn="{StaticResource AmountCellStyle}">
            <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
        </Style>
        <!-- A part of the row above it (each sub-assembly under Sub-assemblies): indented, smaller and muted -->
        <Style x:Key="PartLabelCellStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="24,2,8,2" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="PartAmountCellStyle" TargetType="TextBlock" BasedOn="{StaticResource PartLabelCellStyle}">
            <Setter Property="Margin" Value="8,2" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <!-- A thin line under a row, across all three columns -->
        <Style x:Key="RowRuleStyle" TargetType="Border">
            <Setter Property="Grid.ColumnSpan" Value="3" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
    </UserControl.Resources>

    <!--
        The product's costing in one place: on the left the four metrics, each a percentage and what it comes to in pesos,
        either one typed in, and VAT's percentage; and on
        the right one sellable unit's selling price from its materials up, each part per unit and as a share of the
        price. A unit is one piece unless the product's Quantity Required says otherwise (CostUnitCaption).
    -->
    <StackPanel>
        <TextBlock Text="Costing Summary" Style="{StaticResource PanelHeaderStyle}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="200" />
                <ColumnDefinition Width="33" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!--
                The costing parameters, one under another: each label on the left of its boxes (FormLabelStyle), with its
                share of the price under them. The five labels share one column (CostLabel), so the boxes line up.

                A metric's two boxes: its percentage, always with its % sign and to one decimal, and what that comes to in
                pesos, to two; either one typed sets the other. PercentValue is in percent (35 for 35%) in the default
                DoubleMode, as the costing keeps it; PercentMode would read it as a fraction and show 3,500.0%. Their settings
                are on each box rather than in a Style, which would replace the Windows 11 theme's (SfSkinManager.SetTheme).
            -->
            <StackPanel Grid.IsSharedSizeScope="True">
                <Border Style="{StaticResource CostTileStyle}" BorderBrush="{StaticResource LaborTileBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CostLabel" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Labor Metric" Style="{StaticResource FormLabelStyle}" ToolTip="{Binding CostUnitCaption, StringFormat='Of the sub-assemblies (ingredients) cost, packaging not included. {0}.'}" />
                        <syncfusion:PercentTextBox Grid.Column="1" PercentDecimalDigits="1" PercentPositivePattern="1" MinValue="0" PercentValue="{Binding EditingLaborPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" controls:FieldUndoStep.Recorder="{Binding}" />
                        <syncfusion:DoubleTextBox Grid.Column="3"
                                                  NumberDecimalDigits="2"
                                                  MinValue="0"
                                                  Value="{Binding EditingLaborAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  controls:FieldUndoStep.Recorder="{Binding}"
                                                  ToolTip="{Binding CostUnitCaption, StringFormat='The labor cost, {0}. Typing it sets the percentage.'}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource TileCaptionStyle}" Text="{Binding Costs.LaborShare, StringFormat='{}{0:N1}% of the price'}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource CostTileStyle}" BorderBrush="{StaticResource OverheadTileBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CostLabel" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Overhead Metric" Style="{StaticResource FormLabelStyle}" ToolTip="{Binding CostUnitCaption, StringFormat='Of the sub-assemblies (ingredients) cost, packaging not included. {0}.'}" />
                        <syncfusion:PercentTextBox Grid.Column="1" PercentDecimalDigits="1" PercentPositivePattern="1" MinValue="0" PercentValue="{Binding EditingOverheadPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" controls:FieldUndoStep.Recorder="{Binding}" />
                        <syncfusion:DoubleTextBox Grid.Column="3"
                                                  NumberDecimalDigits="2"
                                                  MinValue="0"
                                                  Value="{Binding EditingOverheadAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  controls:FieldUndoStep.Recorder="{Binding}"
                                                  ToolTip="{Binding CostUnitCaption, StringFormat='The overhead cost, {0}. Typing it sets the percentage.'}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource TileCaptionStyle}" Text="{Binding Costs.OverheadShare, StringFormat='{}{0:N1}% of the price'}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource CostTileStyle}" BorderBrush="{StaticResource AdministrativeTileBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CostLabel" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Admin Metric" Style="{StaticResource FormLabelStyle}" ToolTip="{Binding CostUnitCaption, StringFormat='Administrative: office, permits, bookkeeping. Of the sub-assemblies (ingredients) cost, packaging not included. {0}.'}" />
                        <syncfusion:PercentTextBox Grid.Column="1" PercentDecimalDigits="1" PercentPositivePattern="1" MinValue="0" PercentValue="{Binding EditingAdministrativePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" controls:FieldUndoStep.Recorder="{Binding}" />
                        <syncfusion:DoubleTextBox Grid.Column="3"
                                                  NumberDecimalDigits="2"
                                                  MinValue="0"
                                                  Value="{Binding EditingAdministrativeAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  controls:FieldUndoStep.Recorder="{Binding}"
                                                  ToolTip="{Binding CostUnitCaption, StringFormat='The administrative cost, {0}. Typing it sets the percentage.'}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource TileCaptionStyle}" Text="{Binding Costs.AdministrativeShare, StringFormat='{}{0:N1}% of the price'}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource CostTileStyle}" BorderBrush="{StaticResource MarkupTileBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CostLabel" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Markup Metric" Style="{StaticResource FormLabelStyle}" ToolTip="On the base cost: materials, labor, overhead and administrative" />
                        <syncfusion:PercentTextBox Grid.Column="1" PercentDecimalDigits="1" PercentPositivePattern="1" MinValue="0" PercentValue="{Binding EditingMarginPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" controls:FieldUndoStep.Recorder="{Binding}" />
                        <syncfusion:DoubleTextBox Grid.Column="3"
                                                  NumberDecimalDigits="2"
                                                  MinValue="0"
                                                  Value="{Binding EditingMarkupAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  controls:FieldUndoStep.Recorder="{Binding}"
                                                  ToolTip="{Binding CostUnitCaption, StringFormat='The markup, {0}, before VAT. Typing it sets the percentage.'}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource TileCaptionStyle}" Text="{Binding Costs.MarkupShare, StringFormat='{}{0:N1}% of the price'}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource CostTileStyle}" BorderBrush="{StaticResource VatTileBrush}" Margin="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CostLabel" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="VAT %" Style="{StaticResource FormLabelStyle}" ToolTip="On top of the marked-up price" />
                        <syncfusion:PercentTextBox Grid.Column="1" PercentDecimalDigits="1" PercentPositivePattern="1" MinValue="0" PercentValue="{Binding EditingVatPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" controls:FieldUndoStep.Recorder="{Binding}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource TileCaptionStyle}">
                            <Run Text="{Binding Costs.Vat, StringFormat='{}{0:N2}', Mode=OneWay}" /><Run Text="{Binding Costs.VatShare, StringFormat=' · {0:N1}% of the price', Mode=OneWay}" />
                        </TextBlock>
                    </Grid>
                </Border>
            </StackPanel>

            <Border Grid.Column="1" Width="1" HorizontalAlignment="Center" Background="{StaticResource CardBorderBrush}" />

            <!-- The recipe cost breakdown: one sellable unit's selling price, from its materials up -->
            <Grid Grid.Column="2" VerticalAlignment="Top" Grid.IsSharedSizeScope="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" MinWidth="120" SharedSizeGroup="CostAmount" />
                    <ColumnDefinition Width="Auto" MinWidth="90" SharedSizeGroup="CostShare" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.ColumnSpan="3" CornerRadius="4" Background="{StaticResource PageBackgroundBrush}" />
                <TextBlock Text="Component" Style="{StaticResource HeaderCellStyle}" />
                <TextBlock Grid.Column="1" Text="{Binding CostUnitCaption}" Style="{StaticResource HeaderCellStyle}" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="2" Text="% of Price" Style="{StaticResource HeaderCellStyle}" HorizontalAlignment="Right" />

                <TextBlock Grid.Row="1" Text="Sub-assemblies (ingredients)" Style="{StaticResource LabelCellStyle}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Costs.SubAssemblies, StringFormat='{}{0:N2}'}" Style="{StaticResource AmountCellStyle}" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Costs.SubAssembliesShare, StringFormat='{}{0:N1}%'}" Style="{StaticResource ShareCellStyle}" />

                <!--
                    What the sub-assemblies come to, one by one in recipe order, indented under their total and in the
                    muted colour, so they read as its parts rather than as more rows to add up. The shared column groups
                    line their figures up with the table's.
                -->
                <Border Grid.Row="2" Style="{StaticResource RowRuleStyle}" />
                <ItemsControl Grid.Row="2" Grid.ColumnSpan="3" Margin="0,0,0,4" ItemsSource="{Binding Costs.SubAssemblyLines}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="CostAmount" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="CostShare" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource PartLabelCellStyle}" />
                                <TextBlock Grid.Column="1" Text="{Binding Cost, StringFormat='{}{0:N2}'}" Style="{StaticResource PartAmountCellStyle}" />
                                <TextBlock Grid.Column="2" Text="{Binding Share, StringFormat='{}{0:N1}%'}" Style="{StaticResource PartAmountCellStyle}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Grid.Row="3" Style="{StaticResource RowRuleStyle}" />
                <TextBlock Grid.Row="3" Text="Packaging" Style="{StaticResource LabelCellStyle}" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Costs.Packaging, StringFormat='{}{0:N2}'}" Style="{StaticResource AmountCellStyle}" />
                <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Costs.PackagingShare, StringFormat='{}{0:N1}%'}" Style="{StaticResource ShareCellStyle}" />

                <Border Grid.Row="4" Style="{StaticResource RowRuleStyle}" />
                <TextBlock Grid.Row="4" Style="{StaticResource LabelCellStyle}">
                    <Run Text="Labor (" /><Run Text="{Binding Costs.LaborPercent, StringFormat='{}{0:0.##}', Mode=OneWay}" /><Run Text="% of sub-assemblies)" />
                </TextBlock>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Costs.Labor, StringFormat='{}{0:N2}'}" Style="{StaticResource AmountCellStyle}" />
                <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding Costs.LaborShare, StringFormat='{}{0:N1}%'}" Style="{StaticResource ShareCellStyle}" />

                <Border Grid.Row="5" Style="{StaticResource RowRuleStyle}" />
                <TextBlock Grid.Row="5" Style="{StaticResource LabelCellStyle}">
                    <Run Text="Overhead (" /><Run Text="{Binding Costs.OverheadPercent, StringFormat='{}{0:0.##}', Mode=OneWay}" /><Run Text="% of sub-assemblies)" />
                </TextBlock>
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Costs.Overhead, StringFormat='{}{0:N2}'}" Style="{StaticResource AmountCellStyle}" />
                <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding Costs.OverheadShare, StringFormat='{}{0:N1}%'}" Style="{StaticResource ShareCellStyle}" />

                <Border Grid.Row="6" Style="{StaticResource RowRuleStyle}" />
                <TextBlock Grid.Row="6" Style="{StaticResource LabelCellStyle}">
                    <Run Text="Administrative (" /><Run Text="{Binding Costs.AdministrativePercent, StringFormat='{}{0:0.##}', Mode=OneWay}" /><Run Text="% of sub-assemblies)" />
                </TextBlock>
                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Costs.Administrative, StringFormat='{}{0:N2}'}" Style="{StaticResource AmountCellStyle}" />
                <TextBlock Grid.Row="6" Grid.Column="2" Text="{Binding Costs.AdministrativeShare, StringFormat='{}{0:N1}%'}" Style="{StaticResource ShareCellStyle}" />

                <!-- The base cost the markup goes on -->
                <Border Grid.Row="7" Grid.ColumnSpan="3" Margin="0,4" CornerRadius="4" Background="{StaticResource AccentSoftBrush}" />
                <TextBlock Grid.Row="7" Text="Subtotal (base cost)" Style="{StaticResource LabelCellStyle}" FontWeight="SemiBold" Margin="8,8" />
                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Costs.BaseCost, StringFormat='{}{0:N2}'}" Style="{StaticResource AmountCellStyle}" FontWeight="SemiBold" Margin="8,8" />
                <TextBlock Grid.Row="7" Grid.Column="2" Text="{Binding Costs.BaseCostShare, StringFormat='{}{0:N1}%'}" Style="{StaticResource ShareCellStyle}" Margin="8,8" />

                <Border Grid.Row="8" Style="{StaticResource RowRuleStyle}" />
                <TextBlock Grid.Row="8" Style="{StaticResource LabelCellStyle}">
                    <Run Text="Markup (" /><Run Text="{Binding Costs.MarginPercent, StringFormat='{}{0:0.##}', Mode=OneWay}" /><Run Text="%)" />
                </TextBlock>
                <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Costs.Markup, StringFormat='{}{0:N2}'}" Style="{StaticResource AmountCellStyle}" />
                <TextBlock Grid.Row="8" Grid.Column="2" Text="{Binding Costs.MarkupShare, StringFormat='{}{0:N1}%'}" Style="{StaticResource ShareCellStyle}" />

                <TextBlock Grid.Row="9" Style="{StaticResource LabelCellStyle}">
                    <Run Text="VAT (" /><Run Text="{Binding Costs.VatPercent, StringFormat='{}{0:0.##}', Mode=OneWay}" /><Run Text="%)" />
                </TextBlock>
                <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding Costs.Vat, StringFormat='{}{0:N2}'}" Style="{StaticResource AmountCellStyle}" />
                <TextBlock Grid.Row="9" Grid.Column="2" Text="{Binding Costs.VatShare, StringFormat='{}{0:N1}%'}" Style="{StaticResource ShareCellStyle}" />

                <!--
                    The price one sellable unit sells for: one row like the others, the price under the unit's column and
                    its share under % of Price, in the label's size. The top margin clears the gap above the band.
                -->
                <Border Grid.Row="10" Grid.ColumnSpan="3" Margin="0,8,0,0" CornerRadius="6" Background="{StaticResource AccentSoftBrush}" />
                <TextBlock Grid.Row="10"
                           Text="{Binding CostUnitCaption, StringFormat='Total Selling Price ({0})'}"
                           Style="{StaticResource LabelCellStyle}"
                           FontWeight="SemiBold"
                           Margin="8,16,8,8" />
                <TextBlock Grid.Row="10"
                           Grid.Column="1"
                           Text="{Binding Costs.SellingPrice, StringFormat='{}{0:N2}'}"
                           Style="{StaticResource AmountCellStyle}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentForegroundBrush}"
                           Margin="8,16,8,8" />
                <TextBlock Grid.Row="10"
                           Grid.Column="2"
                           Text="{Binding Costs.SellingPriceShare, StringFormat='{}{0:N0}%'}"
                           Style="{StaticResource ShareCellStyle}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentForegroundBrush}"
                           Margin="8,16,8,8" />
            </Grid>
        </Grid>
    </StackPanel>
</UserControl>
