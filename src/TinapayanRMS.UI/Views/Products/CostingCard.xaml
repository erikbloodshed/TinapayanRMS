<UserControl x:Class="TinapayanRMS.UI.Views.Products.CostingCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:controls="clr-namespace:TinapayanRMS.UI.Controls">
    <UserControl.Resources>
        <!-- A costing input: a coloured edge beside its label and field, then what it comes to in the price. No box around it. -->
        <Style x:Key="CostTileStyle" TargetType="Border">
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="Padding" Value="10,0,0,0" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="TileCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}">
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <!-- The tiles' edges, a step darker down the column, as each input builds on the ones before toward the price -->
        <SolidColorBrush x:Key="LaborTileBrush" Color="{StaticResource Amber400Color}" />
        <SolidColorBrush x:Key="OverheadTileBrush" Color="{StaticResource Amber500Color}" />
        <SolidColorBrush x:Key="AdministrativeTileBrush" Color="{StaticResource Amber600Color}" />
        <SolidColorBrush x:Key="MarkupTileBrush" Color="{StaticResource Amber700Color}" />
        <SolidColorBrush x:Key="VatTileBrush" Color="{StaticResource Amber800Color}" />

        <!-- The breakdown table's cells -->
        <Style x:Key="HeaderCellStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="8,5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
        </Style>
        <Style x:Key="LabelCellStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="8,5" />
            <Setter Property="Foreground" Value="{StaticResource HeadingForegroundBrush}" />
        </Style>
        <Style x:Key="AmountCellStyle" TargetType="TextBlock" BasedOn="{StaticResource LabelCellStyle}">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style x:Key="ShareCellStyle" TargetType="TextBlock" BasedOn="{StaticResource AmountCellStyle}">
            <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
        </Style>
        <!-- A thin line under a row, across all three columns -->
        <Style x:Key="RowRuleStyle" TargetType="Border">
            <Setter Property="Grid.ColumnSpan" Value="3" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
    </UserControl.Resources>

    <!--
        The product's costing in one place: the five percentages typed in on the left, each with what it comes to, and on
        the right one sellable unit's selling price from its materials up, each part per unit and as a share of the
        price. A unit is one piece unless the product's Quantity Required says otherwise (CostUnitCaption).
    -->
    <StackPanel>
        <TextBlock Text="Costing Summary" Style="{StaticResource PanelHeaderStyle}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="200" />
                <ColumnDefinition Width="33" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!--
                The costing parameters, one under another: each label on the left of its box (FormLabelStyle), with
                what it comes to under the box. The five labels share one column (CostLabel), so the boxes line up.
            -->
            <StackPanel Grid.IsSharedSizeScope="True">
                <Border Style="{StaticResource CostTileStyle}" BorderBrush="{StaticResource LaborTileBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CostLabel" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Labor %" Style="{StaticResource FormLabelStyle}" ToolTip="{Binding CostUnitCaption, StringFormat='Of the sub-assemblies (ingredients) cost, packaging not included. {0}.'}" />
                        <syncfusion:DoubleTextBox Grid.Column="1" Value="{Binding EditingLaborPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" controls:FieldUndoStep.Recorder="{Binding}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource TileCaptionStyle}">
                            <Run Text="{Binding Costs.Labor, StringFormat='{}{0:N2}', Mode=OneWay}" /><Run Text="{Binding Costs.LaborShare, StringFormat=' · {0:N1}% of the price', Mode=OneWay}" />
                        </TextBlock>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CostTileStyle}" BorderBrush="{StaticResource OverheadTileBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CostLabel" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Overhead %" Style="{StaticResource FormLabelStyle}" ToolTip="{Binding CostUnitCaption, StringFormat='Of the sub-assemblies (ingredients) cost, packaging not included. {0}.'}" />
                        <syncfusion:DoubleTextBox Grid.Column="1" Value="{Binding EditingOverheadPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" controls:FieldUndoStep.Recorder="{Binding}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource TileCaptionStyle}">
                            <Run Text="{Binding Costs.Overhead, StringFormat='{}{0:N2}', Mode=OneWay}" /><Run Text="{Binding Costs.OverheadShare, StringFormat=' · {0:N1}% of the price', Mode=OneWay}" />
                        </TextBlock>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CostTileStyle}" BorderBrush="{StaticResource AdministrativeTileBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CostLabel" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Administrative %" Style="{StaticResource FormLabelStyle}" ToolTip="{Binding CostUnitCaption, StringFormat='Of the sub-assemblies (ingredients) cost, packaging not included: office, permits, bookkeeping. {0}.'}" />
                        <syncfusion:DoubleTextBox Grid.Column="1" Value="{Binding EditingAdministrativePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" controls:FieldUndoStep.Recorder="{Binding}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource TileCaptionStyle}">
                            <Run Text="{Binding Costs.Administrative, StringFormat='{}{0:N2}', Mode=OneWay}" /><Run Text="{Binding Costs.AdministrativeShare, StringFormat=' · {0:N1}% of the price', Mode=OneWay}" />
                        </TextBlock>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CostTileStyle}" BorderBrush="{StaticResource MarkupTileBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CostLabel" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Markup %" Style="{StaticResource FormLabelStyle}" ToolTip="On the base cost: materials, labor, overhead and administrative" />
                        <syncfusion:DoubleTextBox Grid.Column="1" Value="{Binding EditingMarginPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" controls:FieldUndoStep.Recorder="{Binding}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource TileCaptionStyle}">
                            <Run Text="{Binding Costs.Markup, StringFormat='{}{0:N2}', Mode=OneWay}" /><Run Text="{Binding Costs.MarkupShare, StringFormat=' · {0:N1}% of the price', Mode=OneWay}" />
                        </TextBlock>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CostTileStyle}" BorderBrush="{StaticResource VatTileBrush}" Margin="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CostLabel" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="VAT %" Style="{StaticResource FormLabelStyle}" ToolTip="On top of the marked-up price" />
                        <syncfusion:DoubleTextBox Grid.Column="1" Value="{Binding EditingVatPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" controls:FieldUndoStep.Recorder="{Binding}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource TileCaptionStyle}">
                            <Run Text="{Binding Costs.Vat, StringFormat='{}{0:N2}', Mode=OneWay}" /><Run Text="{Binding Costs.VatShare, StringFormat=' · {0:N1}% of the price', Mode=OneWay}" />
                        </TextBlock>
                    </Grid>
                </Border>
            </StackPanel>

            <Border Grid.Column="1" Width="1" HorizontalAlignment="Center" Background="{StaticResource CardBorderBrush}" />

            <!-- The recipe cost breakdown: one sellable unit's selling price, from its materials up -->
            <Grid Grid.Column="2" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" MinWidth="120" />
                    <ColumnDefinition Width="Auto" MinWidth="90" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.ColumnSpan="3" CornerRadius="4" Background="{StaticResource PageBackgroundBrush}" />
                <TextBlock Text="Component" Style="{StaticResource HeaderCellStyle}" />
                <TextBlock Grid.Column="1" Text="{Binding CostUnitCaption}" Style="{StaticResource HeaderCellStyle}" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="2" Text="% of Price" Style="{StaticResource HeaderCellStyle}" HorizontalAlignment="Right" />

                <Border Grid.Row="1" Style="{StaticResource RowRuleStyle}" />
                <TextBlock Grid.Row="1" Text="Sub-assemblies (ingredients)" Style="{StaticResource LabelCellStyle}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Costs.SubAssemblies, StringFormat='{}{0:N2}'}" Style="{StaticResource AmountCellStyle}" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Costs.SubAssembliesShare, StringFormat='{}{0:N1}%'}" Style="{StaticResource ShareCellStyle}" />

                <Border Grid.Row="2" Style="{StaticResource RowRuleStyle}" />
                <TextBlock Grid.Row="2" Text="Packaging" Style="{StaticResource LabelCellStyle}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Costs.Packaging, StringFormat='{}{0:N2}'}" Style="{StaticResource AmountCellStyle}" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Costs.PackagingShare, StringFormat='{}{0:N1}%'}" Style="{StaticResource ShareCellStyle}" />

                <Border Grid.Row="3" Style="{StaticResource RowRuleStyle}" />
                <TextBlock Grid.Row="3" Style="{StaticResource LabelCellStyle}">
                    <Run Text="Labor (" /><Run Text="{Binding Costs.LaborPercent, StringFormat='{}{0:0.##}', Mode=OneWay}" /><Run Text="% of sub-assemblies)" />
                </TextBlock>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Costs.Labor, StringFormat='{}{0:N2}'}" Style="{StaticResource AmountCellStyle}" />
                <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Costs.LaborShare, StringFormat='{}{0:N1}%'}" Style="{StaticResource ShareCellStyle}" />

                <Border Grid.Row="4" Style="{StaticResource RowRuleStyle}" />
                <TextBlock Grid.Row="4" Style="{StaticResource LabelCellStyle}">
                    <Run Text="Overhead (" /><Run Text="{Binding Costs.OverheadPercent, StringFormat='{}{0:0.##}', Mode=OneWay}" /><Run Text="% of sub-assemblies)" />
                </TextBlock>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Costs.Overhead, StringFormat='{}{0:N2}'}" Style="{StaticResource AmountCellStyle}" />
                <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding Costs.OverheadShare, StringFormat='{}{0:N1}%'}" Style="{StaticResource ShareCellStyle}" />

                <Border Grid.Row="5" Style="{StaticResource RowRuleStyle}" />
                <TextBlock Grid.Row="5" Style="{StaticResource LabelCellStyle}">
                    <Run Text="Administrative (" /><Run Text="{Binding Costs.AdministrativePercent, StringFormat='{}{0:0.##}', Mode=OneWay}" /><Run Text="% of sub-assemblies)" />
                </TextBlock>
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Costs.Administrative, StringFormat='{}{0:N2}'}" Style="{StaticResource AmountCellStyle}" />
                <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding Costs.AdministrativeShare, StringFormat='{}{0:N1}%'}" Style="{StaticResource ShareCellStyle}" />

                <!-- The base cost the markup goes on -->
                <Border Grid.Row="6" Grid.ColumnSpan="3" Margin="0,4" CornerRadius="4" Background="{StaticResource AccentSoftBrush}" />
                <TextBlock Grid.Row="6" Text="Subtotal (base cost)" Style="{StaticResource LabelCellStyle}" FontWeight="SemiBold" Margin="8,8" />
                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Costs.BaseCost, StringFormat='{}{0:N2}'}" Style="{StaticResource AmountCellStyle}" FontWeight="SemiBold" Margin="8,8" />
                <TextBlock Grid.Row="6" Grid.Column="2" Text="{Binding Costs.BaseCostShare, StringFormat='{}{0:N1}%'}" Style="{StaticResource ShareCellStyle}" Margin="8,8" />

                <Border Grid.Row="7" Style="{StaticResource RowRuleStyle}" />
                <TextBlock Grid.Row="7" Style="{StaticResource LabelCellStyle}">
                    <Run Text="Markup (" /><Run Text="{Binding Costs.MarginPercent, StringFormat='{}{0:0.##}', Mode=OneWay}" /><Run Text="%)" />
                </TextBlock>
                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Costs.Markup, StringFormat='{}{0:N2}'}" Style="{StaticResource AmountCellStyle}" />
                <TextBlock Grid.Row="7" Grid.Column="2" Text="{Binding Costs.MarkupShare, StringFormat='{}{0:N1}%'}" Style="{StaticResource ShareCellStyle}" />

                <TextBlock Grid.Row="8" Style="{StaticResource LabelCellStyle}">
                    <Run Text="VAT (" /><Run Text="{Binding Costs.VatPercent, StringFormat='{}{0:0.##}', Mode=OneWay}" /><Run Text="%)" />
                </TextBlock>
                <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Costs.Vat, StringFormat='{}{0:N2}'}" Style="{StaticResource AmountCellStyle}" />
                <TextBlock Grid.Row="8" Grid.Column="2" Text="{Binding Costs.VatShare, StringFormat='{}{0:N1}%'}" Style="{StaticResource ShareCellStyle}" />

                <!--
                    The price one sellable unit sells for: one row like the others, the price under the unit's column and
                    its share under % of Price, in the label's size. The top margin clears the gap above the band.
                -->
                <Border Grid.Row="9" Grid.ColumnSpan="3" Margin="0,8,0,0" CornerRadius="6" Background="{StaticResource AccentSoftBrush}" />
                <TextBlock Grid.Row="9"
                           Text="{Binding CostUnitCaption, StringFormat='Total Selling Price ({0})'}"
                           Style="{StaticResource LabelCellStyle}"
                           FontWeight="SemiBold"
                           Margin="8,16,8,8" />
                <TextBlock Grid.Row="9"
                           Grid.Column="1"
                           Text="{Binding Costs.SellingPrice, StringFormat='{}{0:N2}'}"
                           Style="{StaticResource AmountCellStyle}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}"
                           Margin="8,16,8,8" />
                <TextBlock Grid.Row="9"
                           Grid.Column="2"
                           Text="{Binding Costs.SellingPriceShare, StringFormat='{}{0:N0}%'}"
                           Style="{StaticResource ShareCellStyle}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}"
                           Margin="8,16,8,8" />
            </Grid>
        </Grid>
    </StackPanel>
</UserControl>
