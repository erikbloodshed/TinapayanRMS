<UserControl x:Class="TinapayanRMS.UI.Views.Products.SubAssemblySectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:controls="clr-namespace:TinapayanRMS.UI.Controls">
    <UserControl.Resources>
        <!-- The piece-size figure the user typed is the one in bold: it's the one that stays put. -->
        <Style x:Key="TypedFigureRunStyle" TargetType="Run">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="{StaticResource HeadingForegroundBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!--
        One sub-assembly of the recipe, the content of its Recipe Structure tab: a ProductUsageEdit. Its header,
        then its ingredient lines scaled to one piece, then their total, which is its cost per piece. Its buttons
        call the screen's commands (the DataContext of the tab control, an ItemsControl) with the section. A linked
        one has read-only lines: Edit changes its piece size, and Make a Copy turns it into the product's own.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Name, badges and "Dough · 1,700 g batch · 28.33 pcs · 60 g per piece", then the cost per piece and the buttons -->
        <Grid Margin="8,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding Name}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource HeadingForegroundBrush}"
                           TextTrimming="CharacterEllipsis" />
                <Border Grid.Column="1"
                        Style="{StaticResource LinkedBadgeStyle}"
                        ToolTip="Its lines come from that product and follow its changes."
                        Visibility="{Binding IsLinked, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding LinkedFromText}" FontSize="11" Foreground="{StaticResource WarningForegroundBrush}" />
                </Border>
                <Border Grid.Column="2"
                        HorizontalAlignment="Left"
                        Style="{StaticResource LinkedBadgeStyle}"
                        ToolTip="Changing its lines changes theirs too."
                        Visibility="{Binding IsShared, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding SharedText}" FontSize="11" Foreground="{StaticResource WarningForegroundBrush}" TextTrimming="CharacterEllipsis" />
                </Border>

                <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource CaptionStyle}">
                    <Run Text="{Binding RoleName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding BatchText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding YieldText, Mode=OneWay}" Tag="{Binding IsYieldAuthored}" Style="{StaticResource TypedFigureRunStyle}" /><Run Text=" · " /><Run Text="{Binding WeightText, Mode=OneWay}" Tag="{Binding IsWeightAuthored}" Style="{StaticResource TypedFigureRunStyle}" />
                </TextBlock>
            </Grid>

            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                <TextBlock Text="Cost per piece" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding CostPerPiece, StringFormat='₱{0:N4}'}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource HeadingForegroundBrush}"
                           HorizontalAlignment="Right" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <syncfusion:ButtonAdv SizeMode="Small"
                                      Label="Edit"
                                      ToolTip="Change its piece size, and for the product's own, its name, role and lines"
                                      IconTemplate="{StaticResource EditIconTemplate}"
                                      Command="{Binding DataContext.EditUsageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                      CommandParameter="{Binding}"
                                      Margin="0,0,4,0" />
                <syncfusion:ButtonAdv SizeMode="Small"
                                      Label="Make a Copy"
                                      ToolTip="Make it this product's own copy, to change its lines here. It stops following where it's from."
                                      IconTemplate="{StaticResource CopyIconTemplate}"
                                      Command="{Binding DataContext.MakeCopyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                      CommandParameter="{Binding}"
                                      Visibility="{Binding IsLinked, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      Margin="0,0,4,0" />
                <syncfusion:ButtonAdv SizeMode="Small"
                                      Label="Remove"
                                      ToolTip="Take it out of the recipe"
                                      IconTemplate="{StaticResource RemoveIconTemplate}"
                                      Command="{Binding DataContext.RemoveUsageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                      CommandParameter="{Binding}" />
            </StackPanel>
        </Grid>

        <!-- No height of its own: it shows every line, and passes the wheel on to the tab (MouseWheelForwarding) -->
        <syncfusion:SfDataGrid Grid.Row="1"
                               ItemsSource="{Binding IngredientRows}"
                               GridLinesVisibility="Both"
                               AutoGenerateColumns="False"
                               AllowEditing="False"
                               SelectionMode="None"
                               ColumnSizer="Star"
                               controls:MouseWheelForwarding.IsEnabled="True">
            <syncfusion:SfDataGrid.Columns>
                <syncfusion:GridTextColumn MappingName="IngredientName" HeaderText="Ingredient" />
                <controls:NumericColumn MappingName="GramsPerPiece" HeaderText="Grams per Piece" Width="104" NumberDecimalDigits="4" />
                <controls:NumericColumn MappingName="CostPerGram" HeaderText="Cost per g" Width="88" NumberDecimalDigits="4" />
                <controls:NumericColumn MappingName="CostPerPiece" HeaderText="Cost per Piece" Width="104" NumberDecimalDigits="4" />
                <controls:NumericColumn MappingName="PercentOfSection" HeaderText="% of Cost" Width="76" NumberDecimalDigits="1" />
            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>

        <!-- The table's total, under its Cost per Piece and % of Cost columns: the same widths as the grid's columns -->
        <Border Grid.Row="2"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,1,0,0"
                Background="{StaticResource PageBackgroundBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="104" />
                    <ColumnDefinition Width="88" />
                    <ColumnDefinition Width="104" />
                    <ColumnDefinition Width="76" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource SectionTotalDividerStyle}" />
                <Border Grid.Column="1" Style="{StaticResource SectionTotalDividerStyle}" />
                <Border Grid.Column="2" Style="{StaticResource SectionTotalDividerStyle}" />
                <Border Grid.Column="3" Style="{StaticResource SectionTotalDividerStyle}" />
                <TextBlock Text="Total" Style="{StaticResource SectionTotalCellStyle}" HorizontalAlignment="Left" />
                <TextBlock Grid.Column="1" Text="{Binding WeightPerPiece, StringFormat='{}{0:N4}'}" Style="{StaticResource SectionTotalCellStyle}" />
                <TextBlock Grid.Column="3" Text="{Binding CostPerPiece, StringFormat='{}{0:N4}'}" Style="{StaticResource SectionTotalCellStyle}" />
                <TextBlock Grid.Column="4" Text="{Binding PercentTotal, StringFormat='{}{0:N1}'}" Style="{StaticResource SectionTotalCellStyle}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
