<UserControl x:Class="TinapayanRMS.UI.Views.Products.SubAssemblySectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:controls="clr-namespace:TinapayanRMS.UI.Controls">
    <!--
        One sub-assembly of the recipe: the Recipe Structure's item, a ProductUsageEdit. Its header, then
        its ingredient lines scaled to one piece, which add up to its cost per piece. Edit and Remove call
        the screen's commands (the ItemsControl's DataContext) with the usage; a linked one has neither.
    -->
    <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="12,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="Cost per piece" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding CostPerPiece, StringFormat='₱{0:N4}'}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource HeadingForegroundBrush}"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                    <syncfusion:ButtonAdv SizeMode="Small"
                                          Label="Edit"
                                          ToolTip="Change its weight per piece"
                                          IconTemplate="{StaticResource EditIconTemplate}"
                                          Command="{Binding DataContext.EditUsageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                          CommandParameter="{Binding}"
                                          Visibility="{Binding IsLinked, Converter={StaticResource EmptyStateVisibilityConverter}}"
                                          Margin="0,0,4,0" />
                    <syncfusion:ButtonAdv SizeMode="Small"
                                          Label="Remove"
                                          ToolTip="Take it out of the recipe"
                                          IconTemplate="{StaticResource RemoveIconTemplate}"
                                          Command="{Binding DataContext.RemoveUsageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                          CommandParameter="{Binding}"
                                          Visibility="{Binding IsLinked, Converter={StaticResource EmptyStateVisibilityConverter}}"
                                          Margin="0,0,4,0" />
                    <syncfusion:ButtonAdv x:Name="CollapseToggle"
                                          SizeMode="Small"
                                          Label="Collapse"
                                          IsCheckable="True"
                                          ToolTip="Show or hide its ingredients"
                                          IconTemplate="{StaticResource ExpandIconTemplate}" />
                </StackPanel>

                <Border DockPanel.Dock="Left" Style="{StaticResource GlyphTileStyle}">
                    <TextBlock Text="&#xE8FD;" Style="{StaticResource GlyphTileIconStyle}" />
                </Border>

                <Grid VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding Name}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource HeadingForegroundBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <Border Grid.Column="1"
                            HorizontalAlignment="Left"
                            Style="{StaticResource LinkedBadgeStyle}"
                            Visibility="{Binding IsLinked, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding LinkedToText}" FontSize="11" Foreground="{StaticResource WarningForegroundBrush}" />
                    </Border>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding DetailsText}" Style="{StaticResource CaptionStyle}" />
                </Grid>
            </DockPanel>

            <!-- The table's total, under its Cost per Piece and % of Cost columns: the same widths as the grid's columns -->
            <Border DockPanel.Dock="Bottom"
                    CornerRadius="0,0,7,7"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Background="{StaticResource PageBackgroundBrush}"
                    Visibility="{Binding IsChecked, ElementName=CollapseToggle, Converter={StaticResource EmptyStateVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="76" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Total" Style="{StaticResource SectionTotalCellStyle}" HorizontalAlignment="Left" />
                    <TextBlock Grid.Column="4" Text="{Binding CostPerPiece, StringFormat='{}{0:N4}'}" Style="{StaticResource SectionTotalCellStyle}" />
                    <TextBlock Grid.Column="5" Text="{Binding PercentTotal, StringFormat='{}{0:N1}'}" Style="{StaticResource SectionTotalCellStyle}" />
                </Grid>
            </Border>

            <!-- No height of its own: it shows every line, and passes the wheel on to the tab (MouseWheelForwarding) -->
            <syncfusion:SfDataGrid ItemsSource="{Binding IngredientRows}"
                                   AutoGenerateColumns="False"
                                   AllowEditing="False"
                                   SelectionMode="None"
                                   ColumnSizer="Star"
                                   controls:MouseWheelForwarding.IsEnabled="True"
                                   Visibility="{Binding IsChecked, ElementName=CollapseToggle, Converter={StaticResource EmptyStateVisibilityConverter}}">
                <syncfusion:SfDataGrid.Columns>
                    <syncfusion:GridTextColumn MappingName="IngredientName" HeaderText="Ingredient" />
                    <controls:NumericColumn MappingName="QuantityPerPiece" HeaderText="Qty per Piece" Width="96" NumberDecimalDigits="4" />
                    <syncfusion:GridTextColumn MappingName="Unit" HeaderText="Unit" Width="52" Padding="12,0,0,0" />
                    <controls:NumericColumn MappingName="UnitCost" HeaderText="Unit Cost" Width="88" NumberDecimalDigits="4" />
                    <controls:NumericColumn MappingName="CostPerPiece" HeaderText="Cost per Piece" Width="104" NumberDecimalDigits="4" />
                    <controls:NumericColumn MappingName="PercentOfSection" HeaderText="% of Cost" Width="76" NumberDecimalDigits="1" />
                </syncfusion:SfDataGrid.Columns>
            </syncfusion:SfDataGrid>
        </DockPanel>
    </Border>
</UserControl>
