<UserControl x:Class="TinapayanRMS.UI.Views.Products.CloneCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf">
    <StackPanel>
        <TextBlock Text="Clone This Product" Style="{StaticResource PanelHeaderStyle}" />
        <TextBlock Text="Makes an independent copy of the product as saved: its own copy of every sub-assembly (linked ones too), its packaging, costing and description. The copy links nothing. Unsaved changes aren't copied."
                   Style="{StaticResource PanelCaptionStyle}" />

        <TextBlock Text="New Product Name" Style="{StaticResource FieldLabelStyle}" />
        <syncfusion:SfTextBoxExt Text="{Binding EditingCloneName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

        <syncfusion:ButtonAdv Label="Clone" HorizontalAlignment="Left" IconTemplate="{StaticResource AddIconTemplate}" Command="{Binding CloneCommand}" />
    </StackPanel>
</UserControl>
