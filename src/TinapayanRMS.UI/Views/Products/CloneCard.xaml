<UserControl x:Class="TinapayanRMS.UI.Views.Products.CloneCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:controls="clr-namespace:TinapayanRMS.UI.Controls">
    <StackPanel>
        <TextBlock Text="Clone This Product" Style="{StaticResource PanelHeaderStyle}" />

        <!-- The label on the left of its field (FormLabelStyle) -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="New Product Name" Style="{StaticResource FormLabelStyle}" />
            <syncfusion:SfTextBoxExt Grid.Column="1" Text="{Binding EditingCloneName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" controls:FieldUndoStep.Recorder="{Binding}" />
        </Grid>

        <StackPanel Orientation="Horizontal">
            <syncfusion:ButtonAdv Label="Clone" IconTemplate="{StaticResource CopyIconTemplate}" Command="{Binding CloneCommand}" />
            <syncfusion:ButtonAdv Label="Create Variant"
                                  Margin="8,0,0,0"
                                  IconTemplate="{StaticResource LinkIconTemplate}"
                                  Command="{Binding CreateVariantCommand}" />
        </StackPanel>

        <!-- Capped at the card's MinWidth, so it wraps rather than widening the card -->
        <TextBlock Style="{StaticResource CaptionStyle}"
                   MaxWidth="420"
                   HorizontalAlignment="Left"
                   Margin="0,8,0,0"
                   Text="Both link the same sub-assemblies, at piece sizes the new product can change. Clone copies the packaging: the new product's own from then on. Create Variant links it instead, so the new product follows every change made to it here." />
    </StackPanel>
</UserControl>
