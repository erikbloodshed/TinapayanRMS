<UserControl x:Class="TinapayanRMS.UI.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="1400">
    <Grid Background="{StaticResource PageBackgroundBrush}" Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Price Trend -->
        <Border Grid.Column="0" Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="Price Trend" Style="{StaticResource SectionHeaderStyle}" />

                <StackPanel Width="280" HorizontalAlignment="Left" Margin="0,0,0,12">
                    <TextBlock Text="Raw Material" Style="{StaticResource FieldLabelStyle}" />
                    <syncfusion:ComboBoxAdv ItemsSource="{Binding RawMaterials}"
                                             DisplayMemberPath="Name"
                                             SelectedItem="{Binding SelectedRawMaterial, Mode=TwoWay}" />
                </StackPanel>

                <syncfusion:SfChart Header="Price Per Purchase Unit Over Time" Height="480">
                    <syncfusion:SfChart.PrimaryAxis>
                        <syncfusion:DateTimeAxis Header="Date" />
                    </syncfusion:SfChart.PrimaryAxis>
                    <syncfusion:SfChart.SecondaryAxis>
                        <syncfusion:NumericalAxis Header="Price" />
                    </syncfusion:SfChart.SecondaryAxis>
                    <syncfusion:SfChart.Series>
                        <syncfusion:LineSeries ItemsSource="{Binding PricePoints}"
                                                XBindingPath="Date"
                                                YBindingPath="Price"
                                                Label="Price"
                                                Interior="{StaticResource AccentBrush}"
                                                ShowTooltip="True" />
                    </syncfusion:SfChart.Series>
                </syncfusion:SfChart>
            </StackPanel>
        </Border>

        <!-- Margin Overview -->
        <Border Grid.Column="2" Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="Margin Overview" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,0" />
                <TextBlock Text="As of today — not historized." Style="{StaticResource CaptionStyle}" Margin="0,-8,0,12" />

                <syncfusion:SfChart Header="Cost vs. Selling Price, Per Piece" Height="530">
                    <syncfusion:SfChart.PrimaryAxis>
                        <syncfusion:CategoryAxis Header="Product" />
                    </syncfusion:SfChart.PrimaryAxis>
                    <syncfusion:SfChart.SecondaryAxis>
                        <syncfusion:NumericalAxis Header="Pesos" />
                    </syncfusion:SfChart.SecondaryAxis>
                    <syncfusion:SfChart.Series>
                        <syncfusion:ColumnSeries ItemsSource="{Binding MarginRows}"
                                                  XBindingPath="ProductName"
                                                  YBindingPath="BaseCost"
                                                  Label="Base Cost"
                                                  Interior="{StaticResource ChartBaseCostBrush}"
                                                  ShowTooltip="True">
                            <syncfusion:ColumnSeries.AdornmentsInfo>
                                <syncfusion:ChartAdornmentInfo ShowLabel="True" />
                            </syncfusion:ColumnSeries.AdornmentsInfo>
                        </syncfusion:ColumnSeries>
                        <syncfusion:ColumnSeries ItemsSource="{Binding MarginRows}"
                                                  XBindingPath="ProductName"
                                                  YBindingPath="SellingPrice"
                                                  Label="Selling Price"
                                                  Interior="{StaticResource ChartSellingPriceBrush}"
                                                  ShowTooltip="True">
                            <syncfusion:ColumnSeries.AdornmentsInfo>
                                <syncfusion:ChartAdornmentInfo ShowLabel="True" />
                            </syncfusion:ColumnSeries.AdornmentsInfo>
                        </syncfusion:ColumnSeries>
                    </syncfusion:SfChart.Series>
                    <syncfusion:SfChart.Legend>
                        <syncfusion:ChartLegend />
                    </syncfusion:SfChart.Legend>
                </syncfusion:SfChart>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
