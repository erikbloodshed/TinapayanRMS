<UserControl x:Class="TinapayanRMS.UI.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:controls="clr-namespace:TinapayanRMS.UI.Controls"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="1400">
    <!-- One card, 4px from the page's edge, as on Raw Materials -->
    <Grid Background="{StaticResource PageBackgroundBrush}" Margin="4">
        <Border Style="{StaticResource CardStyle}" Padding="4">
            <!--
                One report per tab, fixed like Raw Materials' and Products' detail tabs: nothing to close, reopen or
                drag into another order, and the strip along the bottom. Each grid only reads, and sorts by a click
                on its column's header. The name, stage and pieces columns have fixed widths; the others share what's left.
            -->
            <syncfusion:TabControlExt BorderThickness="0"
                                      Background="{StaticResource CardBackgroundBrush}"
                                      TabPanelBackground="{StaticResource CardTabStripBrush}"
                                      TabItemSelectedBackground="{StaticResource CardBackgroundBrush}"
                                      TabItemHoverBackground="{StaticResource CardTabHoverBrush}"
                                      AllowDragDrop="False"
                                      EnableLabelEdit="False"
                                      TabStripPlacement="Bottom"
                                      CloseButtonType="Hide"
                                      ShowTabItemContextMenu="False"
                                      ShowTabListContextMenu="False">
                <syncfusion:TabItemExt Header="Product Cost Summary" CanClose="False">
                    <Border Padding="12">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Product Cost Summary" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" />
                                <!-- The table as it's shown, sorted, filtered and with its shown columns, to an Excel workbook (Exporting/ExcelExport) -->
                                <syncfusion:ButtonAdv Grid.Column="1"
                                                      Label="Export to Excel"
                                                      IconTemplate="{StaticResource ExportIconTemplate}"
                                                      Command="{Binding ExportProductCostsCommand}"
                                                      ToolTip="Saves this table to an Excel workbook as it's shown: in its order, with its filters, and with only the columns showing."
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,8,0" />
                                <!--
                                    Which columns show: a tick box for each but Product, ticked while it shows, bound to the
                                    column's IsHidden (ColumnChoices, filled from the grid's columns in ReportsView). A
                                    DropDownButtonAdv stays open while its tick boxes are clicked, so several can be changed in
                                    one go. The choice lasts while the app is open, as the filters do; a hidden column's filter
                                    still applies.
                                -->
                                <syncfusion:DropDownButtonAdv Grid.Column="2"
                                                              Label="Columns"
                                                              ToolTip="Choose which columns show. Product always does."
                                                              IconTemplate="{StaticResource ColumnsIconTemplate}"
                                                              VerticalAlignment="Center">
                                    <ItemsControl x:Name="ColumnChoices" Margin="8,6" MinWidth="170">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding HeaderText}"
                                                          IsChecked="{Binding IsHidden, Converter={StaticResource InverseBooleanConverter}}"
                                                          Margin="0,3" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </syncfusion:DropDownButtonAdv>
                            </Grid>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="Every product as it's saved, costed at today's prices. Each figure is for one sellable unit of the pieces shown; Markup % is what the current price earns on the base cost. Filter by product, stage or category from the funnel in its heading, and double-click a product to open it."
                                       Style="{StaticResource CaptionStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12" />
                            <!--
                                Double-clicking a product opens it on Products (CellDoubleTapped, which a header cell doesn't raise).
                                Thirteen columns don't fit a laptop's screen with their headings on one line, so the headings wrap
                                onto two, right-aligned like the figures' (Product, Stage and Category are single words, which
                                never wrap). Each column is kept wide enough for its widest heading word with the sort arrow beside
                                it, so a word never breaks, sorted or not: the word at 14px, 11 for the cell's padding and border,
                                and 25 for the arrow (Syncfusion's GridColumnSizer.SortIconWidth), and Category another 28 for its
                                filter's funnel (FilterIconWidth). Base Cost's is a four-digit figure's instead, which is wider
                                than "Base". They all fit a 1536px window (1920 at 125%); a narrower one, such as 1366px, scrolls
                                the figures sideways under the frozen Product column.

                                Product, Stage and Category filter, each from a funnel in its heading: a list of its values to tick,
                                with a search box (CheckboxFilter alone, without the Text Filters conditions, and without the pop-up's
                                own Sort A to Z and Z to A, which a click on the heading does). The pop-up is 340px wide, for the
                                longest product name, and its list fills it (CheckboxFilterFill).
                            -->
                            <syncfusion:SfDataGrid x:Name="ProductCostsGrid"
                                                   ItemsSource="{Binding ProductCosts}"
                                                   CellDoubleTapped="ProductCosts_CellDoubleTapped"
                                                   controls:GridHeaderHeight.Lines="2"
                                                   controls:CheckboxFilterFill.IsEnabled="True"
                                                   FrozenColumnCount="1"
                                                   GridLinesVisibility="Both"
                                                   CurrentCellBorderBrush="{StaticResource AccentBrush}"
                                                   CurrentCellBorderThickness="1"
                                                   controls:GridFillerRows.IsEnabled="True"
                                                   AutoGenerateColumns="False"
                                                   AllowEditing="False"
                                                   AllowSorting="True"
                                                   SelectionMode="Single"
                                                   NavigationMode="Row"
                                                   ColumnSizer="Star">
                                <syncfusion:SfDataGrid.FilterPopupStyle>
                                    <Style TargetType="syncfusion:GridFilterControl">
                                        <Setter Property="FilterMode" Value="CheckboxFilter" />
                                        <Setter Property="SortOptionVisibility" Value="Collapsed" />
                                        <Setter Property="FilterPopupWidth" Value="340" />
                                    </Style>
                                </syncfusion:SfDataGrid.FilterPopupStyle>
                                <syncfusion:SfDataGrid.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Right" />
                                    </DataTemplate>
                                </syncfusion:SfDataGrid.HeaderTemplate>
                                <syncfusion:SfDataGrid.Columns>
                                    <syncfusion:GridTextColumn MappingName="ProductName" HeaderText="Product" Width="280" AllowFiltering="True" />
                                    <syncfusion:GridTextColumn MappingName="Stage" HeaderText="Stage" Width="190" AllowFiltering="True" />
                                    <syncfusion:GridTextColumn MappingName="Category" HeaderText="Category" MinimumWidth="120" AllowFiltering="True" />
                                    <controls:NumericColumn MappingName="Pieces" HeaderText="Pieces" NumberDecimalDigits="0" Width="76" AllowNullValue="True" />
                                    <controls:NumericColumn MappingName="IngredientsCost" HeaderText="Ingredients Cost" NumberDecimalDigits="2" MinimumWidth="106" />
                                    <controls:NumericColumn MappingName="WastageCost" HeaderText="Wastage Cost" NumberDecimalDigits="2" MinimumWidth="90" />
                                    <controls:NumericColumn MappingName="PackagingCost" HeaderText="Packaging Cost" NumberDecimalDigits="2" MinimumWidth="100" />
                                    <controls:NumericColumn MappingName="LaborCost" HeaderText="Labor Cost" NumberDecimalDigits="2" MinimumWidth="72" />
                                    <controls:NumericColumn MappingName="OverheadCost" HeaderText="Overhead Cost" NumberDecimalDigits="2" MinimumWidth="98" />
                                    <controls:NumericColumn MappingName="AdministrativeCost" HeaderText="Admin Cost" NumberDecimalDigits="2" MinimumWidth="78" />
                                    <controls:NumericColumn MappingName="BaseCost" HeaderText="Base Cost" NumberDecimalDigits="2" MinimumWidth="66" />
                                    <controls:NumericColumn MappingName="SuggestedPrice" HeaderText="Suggested Price" NumberDecimalDigits="2" MinimumWidth="102" />
                                    <controls:NumericColumn MappingName="RoundedPrice" HeaderText="Rounded Price" NumberDecimalDigits="2" MinimumWidth="96" />
                                    <controls:NumericColumn MappingName="CurrentPrice" HeaderText="Current Price" NumberDecimalDigits="2" AllowNullValue="True" MinimumWidth="84" />
                                    <controls:NumericColumn MappingName="MarkupPercent" HeaderText="Markup %" NumberDecimalDigits="2" AllowNullValue="True" MinimumWidth="84" />
                                    <controls:NumericColumn MappingName="TargetMarkupPercent" HeaderText="Target Markup %" NumberDecimalDigits="2" MinimumWidth="84" />
                                    <controls:NumericColumn MappingName="ShortOfTargetMarkup" HeaderText="Short By" NumberDecimalDigits="2" AllowNullValue="True" MinimumWidth="70" />
                                </syncfusion:SfDataGrid.Columns>
                            </syncfusion:SfDataGrid>
                        </DockPanel>
                    </Border>
                </syncfusion:TabItemExt>

                <syncfusion:TabItemExt Header="Raw Materials Price Summary" CanClose="False">
                    <Border Padding="12">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Raw Materials Price Summary" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" />
                                <syncfusion:ButtonAdv Grid.Column="1"
                                                      Label="Export to Excel"
                                                      IconTemplate="{StaticResource ExportIconTemplate}"
                                                      Command="{Binding ExportRawMaterialPricesCommand}"
                                                      ToolTip="Saves this table to an Excel workbook as it's shown, in its order."
                                                      VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="Every purchased material's latest price, from its price history. Change % is how far that price moved its cost from the price before it. Double-click a material to open it."
                                       Style="{StaticResource CaptionStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12" />
                            <!-- Double-clicking a material opens it on Raw Materials, as a product opens on Products above -->
                            <syncfusion:SfDataGrid x:Name="RawMaterialPricesGrid"
                                                   ItemsSource="{Binding RawMaterialPrices}"
                                                   CellDoubleTapped="RawMaterialPrices_CellDoubleTapped"
                                                   GridLinesVisibility="Both"
                                                   CurrentCellBorderBrush="{StaticResource AccentBrush}"
                                                   CurrentCellBorderThickness="1"
                                                   controls:GridFillerRows.IsEnabled="True"
                                                   AutoGenerateColumns="False"
                                                   AllowEditing="False"
                                                   AllowSorting="True"
                                                   SelectionMode="Single"
                                                   NavigationMode="Row"
                                                   ColumnSizer="Star">
                                <syncfusion:SfDataGrid.Columns>
                                    <syncfusion:GridTextColumn MappingName="Name" HeaderText="Raw Material" Width="280" />
                                    <syncfusion:GridTextColumn MappingName="Type" HeaderText="Type" />
                                    <syncfusion:GridTextColumn MappingName="Category" HeaderText="Category" />
                                    <syncfusion:GridTextColumn MappingName="UnitName" HeaderText="Unit" />
                                    <controls:NumericColumn MappingName="Price" HeaderText="Price" NumberDecimalDigits="2" AllowNullValue="True" />
                                    <controls:NumericColumn MappingName="ChangePercent" HeaderText="Change %" NumberDecimalDigits="2" AllowNullValue="True" />
                                    <syncfusion:GridDateTimeColumn MappingName="PriceDate" HeaderText="Since" AllowNullValue="True" />
                                </syncfusion:SfDataGrid.Columns>
                            </syncfusion:SfDataGrid>
                        </DockPanel>
                    </Border>
                </syncfusion:TabItemExt>

                <!-- 2026-10-29: the purchased materials whose fixed buffered cost rising prices have worn below its target buffer -->
                <syncfusion:TabItemExt Header="Cost Buffers" CanClose="False">
                    <Border Padding="12">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Cost Buffers" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" />
                                <!-- Syncfusion has no check box of its own outside its grids and ribbon; the Price Simulator uses WPF's too -->
                                <CheckBox Grid.Column="1"
                                          Content="Only below target"
                                          IsChecked="{Binding OnlyBelowTarget, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0" />
                                <syncfusion:ButtonAdv Grid.Column="2"
                                                      Label="Re-apply Target Buffer"
                                                      IconTemplate="{StaticResource ApplyIconTemplate}"
                                                      Command="{Binding ReapplyTargetBuffersCommand}"
                                                      ToolTip="Puts the target buffer back on top of the brand each one is costed at (its Cost From brand, else the dearest) for the materials picked, or for every one shown below target. Asks first."
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,8,0" />
                                <syncfusion:ButtonAdv Grid.Column="3"
                                                      Label="Export to Excel"
                                                      IconTemplate="{StaticResource ExportIconTemplate}"
                                                      Command="{Binding ExportCostBuffersCommand}"
                                                      ToolTip="Saves this table to an Excel workbook as it's shown, in its order."
                                                      VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="Every purchased material's buffered cost against the brand it's costed at now (its Cost From brand, else the dearest). Brand prices don't move the buffered cost, so a rise wears the buffer down; Target % is the buffer last typed for it. Pick materials (Ctrl or Shift for several), or none for all shown, and Re-apply Target Buffer puts it back on top. Double-click one to open it."
                                       Style="{StaticResource CaptionStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12" />
                            <syncfusion:SfDataGrid x:Name="CostBuffersGrid"
                                                   ItemsSource="{Binding CostBuffers}"
                                                   CellDoubleTapped="CostBuffers_CellDoubleTapped"
                                                   GridLinesVisibility="Both"
                                                   CurrentCellBorderBrush="{StaticResource AccentBrush}"
                                                   CurrentCellBorderThickness="1"
                                                   controls:GridFillerRows.IsEnabled="True"
                                                   AutoGenerateColumns="False"
                                                   AllowEditing="False"
                                                   AllowSorting="True"
                                                   SelectionMode="Extended"
                                                   NavigationMode="Row"
                                                   ColumnSizer="Star">
                                <syncfusion:SfDataGrid.Columns>
                                    <syncfusion:GridTextColumn MappingName="Name" HeaderText="Raw Material" Width="280" />
                                    <syncfusion:GridTextColumn MappingName="Type" HeaderText="Type" />
                                    <syncfusion:GridTextColumn MappingName="Category" HeaderText="Category" />
                                    <syncfusion:GridTextColumn MappingName="Per" HeaderText="Per" Width="70" />
                                    <controls:NumericColumn MappingName="DearestCost" HeaderText="Brand Cost" NumberDecimalDigits="4" />
                                    <controls:NumericColumn MappingName="BufferedCost" HeaderText="Buffered Cost" NumberDecimalDigits="4" />
                                    <controls:NumericColumn MappingName="BufferPercent" HeaderText="Buffer %" NumberDecimalDigits="2" />
                                    <controls:NumericColumn MappingName="TargetPercent" HeaderText="Target %" NumberDecimalDigits="2" />
                                    <controls:NumericColumn MappingName="ShortBy" HeaderText="Short By" NumberDecimalDigits="2" AllowNullValue="True" />
                                </syncfusion:SfDataGrid.Columns>
                            </syncfusion:SfDataGrid>
                        </DockPanel>
                    </Border>
                </syncfusion:TabItemExt>

                <!-- 2026-10-29: the purchased materials that make up most of what the products in Production cost -->
                <syncfusion:TabItemExt Header="Cost Drivers" CanClose="False">
                    <Border Padding="12">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Cost Drivers" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" />
                                <syncfusion:ButtonAdv Grid.Column="1"
                                                      Label="Export to Excel"
                                                      IconTemplate="{StaticResource ExportIconTemplate}"
                                                      Command="{Binding ExportCostDriversCommand}"
                                                      ToolTip="Saves this table to an Excel workbook as it's shown, in its order."
                                                      VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="The purchased materials that make up most of the products in Production's material cost, one sellable unit of each, at buffered costs: a material is counted however it gets into a product, through a made or linked ingredient too. Cumulative % adds each row to those above it, so the top few that make up most of the cost show where a price rise would hurt. Double-click a material to open it."
                                       Style="{StaticResource CaptionStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12" />
                            <syncfusion:SfDataGrid x:Name="CostDriversGrid"
                                                   ItemsSource="{Binding CostDrivers}"
                                                   CellDoubleTapped="CostDrivers_CellDoubleTapped"
                                                   GridLinesVisibility="Both"
                                                   CurrentCellBorderBrush="{StaticResource AccentBrush}"
                                                   CurrentCellBorderThickness="1"
                                                   controls:GridFillerRows.IsEnabled="True"
                                                   AutoGenerateColumns="False"
                                                   AllowEditing="False"
                                                   AllowSorting="True"
                                                   SelectionMode="Single"
                                                   NavigationMode="Row"
                                                   ColumnSizer="Star">
                                <syncfusion:SfDataGrid.Columns>
                                    <syncfusion:GridTextColumn MappingName="Name" HeaderText="Raw Material" Width="260" />
                                    <syncfusion:GridTextColumn MappingName="Category" HeaderText="Category" />
                                    <controls:NumericColumn MappingName="Products" HeaderText="Products" NumberDecimalDigits="0" Width="90" />
                                    <controls:NumericColumn MappingName="CostInProducts" HeaderText="Cost in Products" NumberDecimalDigits="2" />
                                    <controls:NumericColumn MappingName="ShareOfAll" HeaderText="Share %" NumberDecimalDigits="2" />
                                    <controls:NumericColumn MappingName="CumulativeShare" HeaderText="Cumulative %" NumberDecimalDigits="2" />
                                    <controls:NumericColumn MappingName="LargestShare" HeaderText="Largest Share %" NumberDecimalDigits="2" />
                                    <syncfusion:GridTextColumn MappingName="LargestIn" HeaderText="Largest In" Width="220" />
                                </syncfusion:SfDataGrid.Columns>
                            </syncfusion:SfDataGrid>
                        </DockPanel>
                    </Border>
                </syncfusion:TabItemExt>

                <!-- 2026-10-29: each product's markup at its current price as it stood on a day, against now -->
                <syncfusion:TabItemExt Header="Margin Erosion" CanClose="False">
                    <Border Padding="12">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Margin Erosion" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Since" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <syncfusion:SfDatePicker Grid.Column="2"
                                                         Width="160"
                                                         FormatString="MMM d, yyyy"
                                                         Value="{Binding MarginErosionSince, Mode=TwoWay}"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,12,0" />
                                <!-- Syncfusion has no check box of its own outside its grids and ribbon; the Price Simulator uses WPF's too -->
                                <CheckBox Grid.Column="3"
                                          Content="Only dropped"
                                          IsChecked="{Binding OnlyDropped, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0" />
                                <syncfusion:ButtonAdv Grid.Column="4"
                                                      Label="Export to Excel"
                                                      IconTemplate="{StaticResource ExportIconTemplate}"
                                                      Command="{Binding ExportMarginErosionCommand}"
                                                      ToolTip="Saves this table to an Excel workbook as it's shown, in its order."
                                                      VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="Each product's markup at its Current Price as it stood on the day picked, its latest version saved by then at its costs then, against now. A product with no version by then, or no Current Price then or now, isn't listed. Change is in percentage points: below 0 means it earns less now. Double-click a product to open it."
                                       Style="{StaticResource CaptionStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12" />
                            <syncfusion:SfDataGrid x:Name="MarginErosionGrid"
                                                   ItemsSource="{Binding MarginErosion}"
                                                   CellDoubleTapped="MarginErosion_CellDoubleTapped"
                                                   GridLinesVisibility="Both"
                                                   CurrentCellBorderBrush="{StaticResource AccentBrush}"
                                                   CurrentCellBorderThickness="1"
                                                   controls:GridFillerRows.IsEnabled="True"
                                                   AutoGenerateColumns="False"
                                                   AllowEditing="False"
                                                   AllowSorting="True"
                                                   SelectionMode="Single"
                                                   NavigationMode="Row"
                                                   ColumnSizer="Star">
                                <syncfusion:SfDataGrid.Columns>
                                    <syncfusion:GridTextColumn MappingName="ProductName" HeaderText="Product" Width="240" />
                                    <syncfusion:GridTextColumn MappingName="Stage" HeaderText="Stage" />
                                    <syncfusion:GridTextColumn MappingName="Category" HeaderText="Category" />
                                    <controls:NumericColumn MappingName="VersionNumber" HeaderText="Version" NumberDecimalDigits="0" Width="80" />
                                    <syncfusion:GridDateTimeColumn MappingName="VersionSavedAt" HeaderText="Saved" Pattern="CustomPattern" CustomPattern="MMM d, yyyy" />
                                    <controls:NumericColumn MappingName="BaseCostThen" HeaderText="Base Cost Then" NumberDecimalDigits="2" />
                                    <controls:NumericColumn MappingName="BaseCostNow" HeaderText="Base Cost Now" NumberDecimalDigits="2" />
                                    <controls:NumericColumn MappingName="CurrentPriceThen" HeaderText="Price Then" NumberDecimalDigits="2" />
                                    <controls:NumericColumn MappingName="CurrentPriceNow" HeaderText="Price Now" NumberDecimalDigits="2" />
                                    <controls:NumericColumn MappingName="MarkupThen" HeaderText="Markup % Then" NumberDecimalDigits="2" />
                                    <controls:NumericColumn MappingName="MarkupNow" HeaderText="Markup % Now" NumberDecimalDigits="2" />
                                    <controls:NumericColumn MappingName="Change" HeaderText="Change" NumberDecimalDigits="2" />
                                </syncfusion:SfDataGrid.Columns>
                            </syncfusion:SfDataGrid>
                        </DockPanel>
                    </Border>
                </syncfusion:TabItemExt>
            </syncfusion:TabControlExt>
        </Border>

        <!-- ErrorMessage as a toast, over the card: a report that couldn't be read or exported says why -->
        <controls:ErrorToast />
        <!-- SuccessMessage: where an exported workbook was saved -->
        <controls:SuccessToast />
    </Grid>
</UserControl>
