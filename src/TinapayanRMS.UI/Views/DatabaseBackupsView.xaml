<UserControl x:Class="TinapayanRMS.UI.Views.DatabaseBackupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:controls="clr-namespace:TinapayanRMS.UI.Controls"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="900">
    <Grid Background="{StaticResource PageBackgroundBrush}" Margin="16">
        <!-- ErrorMessage and SuccessMessage as toasts, over the card -->
        <controls:ErrorToast />
        <controls:SuccessToast />

        <Border Style="{StaticResource CardStyle}" Width="640" HorizontalAlignment="Left" VerticalAlignment="Top">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Database Backups" Style="{StaticResource SectionHeaderStyle}" />
                <TextBlock DockPanel.Dock="Top"
                           Style="{StaticResource CaptionStyle}"
                           Margin="0,0,0,12"
                           Text="Copies of all of the app's data. One is taken automatically each day, when the app starts or within the hour while it stays open, and the last 14 of those are kept. Set a second folder, such as a USB stick or a OneDrive folder, and each one is copied there too, so a broken computer doesn't take every copy with it." />

                <!-- Where they're kept, label on the left as every form's is, and why the last automatic backup wasn't taken -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="1"
                               Grid.Column="1"
                               Grid.ColumnSpan="2"
                               Margin="0,4,0,0"
                               Text="{Binding BackupProblemText}"
                               Foreground="{StaticResource WarningForegroundBrush}"
                               TextWrapping="Wrap"
                               Visibility="{Binding BackupProblemText, Converter={StaticResource NotNullToVisibilityConverter}}" />
                    <TextBlock Text="Folder" Style="{StaticResource FormLabelStyle}" />
                    <TextBlock Grid.Column="1" Text="{Binding Folder}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Folder}" />
                    <syncfusion:ButtonAdv Grid.Column="2"
                                          Label="Open Folder"
                                          IconTemplate="{StaticResource FolderIconTemplate}"
                                          ToolTip="Shows the backups folder in File Explorer."
                                          Margin="8,0,0,0"
                                          Click="OpenFolder_Click" />
                </Grid>

                <!-- 2026-10-29: a second folder each automatic backup is copied to as well, and why the last copy failed -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Also Copy To" Style="{StaticResource FormLabelStyle}" />
                    <TextBlock Grid.Column="1" Text="{Binding CopyFolderText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding CopyFolderText}" />
                    <syncfusion:ButtonAdv Grid.Column="2"
                                          Label="Choose…"
                                          IconTemplate="{StaticResource FolderIconTemplate}"
                                          Command="{Binding ChooseCopyFolderCommand}"
                                          ToolTip="A second folder each automatic backup is copied to as well, keeping the newest 14 there too. Kept for you on this computer."
                                          Margin="8,0,0,0" />
                    <syncfusion:ButtonAdv Grid.Column="3"
                                          Label="Stop Copying"
                                          IconTemplate="{StaticResource CancelIconTemplate}"
                                          Command="{Binding ClearCopyFolderCommand}"
                                          ToolTip="Stops copying automatic backups to the second folder. What's there stays."
                                          Margin="8,0,0,0" />
                    <TextBlock Grid.Row="1"
                               Grid.Column="1"
                               Grid.ColumnSpan="3"
                               Margin="0,4,0,0"
                               Text="{Binding CopyProblemText}"
                               Foreground="{StaticResource WarningForegroundBrush}"
                               TextWrapping="Wrap"
                               Visibility="{Binding CopyProblemText, Converter={StaticResource NotNullToVisibilityConverter}}" />
                </Grid>

                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <syncfusion:ButtonAdv Label="Back Up Now"
                                          IconTemplate="{StaticResource SaveIconTemplate}"
                                          Command="{Binding BackUpNowCommand}"
                                          ToolTip="Takes a backup of all of the app's data now."
                                          Margin="0,0,8,0" />
                    <syncfusion:ButtonAdv Label="Copy to…"
                                          IconTemplate="{StaticResource CopyIconTemplate}"
                                          Command="{Binding CopyToCommand}"
                                          ToolTip="Copies the picked backup somewhere else, such as a USB stick."
                                          Margin="0,0,8,0" />
                    <syncfusion:ButtonAdv Label="Restore"
                                          IconTemplate="{StaticResource RestoreIconTemplate}"
                                          Command="{Binding RestoreCommand}"
                                          ToolTip="Replaces all of the app's data with the picked backup's, after a safety backup. The app restarts."
                                          Margin="0,0,8,0" />
                    <syncfusion:ButtonAdv Label="Restore from File…"
                                          IconTemplate="{StaticResource FolderIconTemplate}"
                                          Command="{Binding RestoreFromFileCommand}"
                                          ToolTip="Restores a backup file from somewhere else, such as a USB stick or another computer." />
                </WrapPanel>

                <!-- What's running, since a backup or restore of a large database takes a while -->
                <TextBlock DockPanel.Dock="Bottom"
                           Margin="0,8,0,0"
                           FontWeight="SemiBold"
                           Text="{Binding BusyText}"
                           Visibility="{Binding BusyText, Converter={StaticResource NotNullToVisibilityConverter}}" />

                <!-- Newest first; pick one to copy or restore it -->
                <syncfusion:SfDataGrid ItemsSource="{Binding Backups}"
                                       SelectedItem="{Binding SelectedBackup, Mode=TwoWay}"
                                       Height="300"
                                       GridLinesVisibility="Both"
                                       CurrentCellBorderBrush="{StaticResource AccentBrush}"
                                       CurrentCellBorderThickness="1"
                                       controls:GridFillerRows.IsEnabled="True"
                                       AutoGenerateColumns="False"
                                       AllowEditing="False"
                                       AllowSorting="False"
                                       SelectionMode="Single"
                                       NavigationMode="Row"
                                       ColumnSizer="Star">
                    <syncfusion:SfDataGrid.Columns>
                        <syncfusion:GridDateTimeColumn MappingName="TakenAt" HeaderText="Taken" Pattern="CustomPattern" CustomPattern="MMM d, yyyy  h:mm tt" Width="220" />
                        <syncfusion:GridTextColumn MappingName="Kind" HeaderText="Kind" />
                        <controls:NumericColumn MappingName="SizeMegabytes" HeaderText="Size (MB)" NumberDecimalDigits="1" Width="110" />
                    </syncfusion:SfDataGrid.Columns>
                </syncfusion:SfDataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
