<UserControl x:Class="TinapayanRMS.UI.Views.IngredientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:controls="clr-namespace:TinapayanRMS.UI.Controls"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1300">
    <Grid Background="{StaticResource PageBackgroundBrush}" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <controls:StatusBanner Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,12" />

        <!-- Ingredients list -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Ingredients" Style="{StaticResource SectionHeaderStyle}" />

                <syncfusion:SfDataGrid Grid.Row="1"
                                        ItemsSource="{Binding Ingredients}"
                                        SelectedItem="{Binding SelectedIngredient, Mode=TwoWay}"
                                        AutoGenerateColumns="False"
                                        AllowEditing="False"
                                        SelectionMode="Single"
                                        NavigationMode="Row"
                                        ColumnSizer="AutoWithLastColumnFill">
                    <syncfusion:SfDataGrid.Columns>
                        <syncfusion:GridTextColumn MappingName="Name" HeaderText="Name" />
                        <syncfusion:GridTextColumn MappingName="IngredientCategory.Name" HeaderText="Category" />
                        <syncfusion:GridTextColumn MappingName="Source" HeaderText="Source" />
                        <syncfusion:GridTextColumn MappingName="PurchaseUnit.Abbreviation" HeaderText="Purchase Unit" />
                        <syncfusion:GridNumericColumn MappingName="PurchaseUnitQty" HeaderText="Purchase Qty" NumberDecimalDigits="2" />
                        <syncfusion:GridCurrencyColumn MappingName="CurrentCost" HeaderText="Current Cost" CurrencySymbol="₱" CurrencyDecimalDigits="2" />
                        <syncfusion:GridCurrencyColumn MappingName="CostPerGram" HeaderText="Cost / Gram" CurrencySymbol="₱" CurrencyDecimalDigits="4" />
                    </syncfusion:SfDataGrid.Columns>
                </syncfusion:SfDataGrid>
            </Grid>
        </Border>

        <!-- Right rail: details, price history/BOM, lookups -->
        <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Details" Style="{StaticResource SectionHeaderStyle}" />

                        <TextBlock Text="Name" Style="{StaticResource FieldLabelStyle}" />
                        <syncfusion:SfTextBoxExt Text="{Binding EditingName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Margin="0,0,0,12" />

                        <TextBlock Text="Category" Style="{StaticResource FieldLabelStyle}" />
                        <syncfusion:SfTextBoxExt AutoCompleteSource="{Binding Categories}"
                                                  SearchItemPath="Name"
                                                  SelectedItem="{Binding EditingCategory, Mode=TwoWay}"
                                                  AutoCompleteMode="Suggest"
                                                  SuggestionMode="Contains"
                                                  Margin="0,0,0,12" />

                        <TextBlock Text="Source" Style="{StaticResource FieldLabelStyle}" />
                        <syncfusion:ComboBoxAdv ItemsSource="{Binding Sources}"
                                                 SelectedItem="{Binding EditingSource, Mode=TwoWay}"
                                                 Margin="0,0,0,12" />

                        <StackPanel Visibility="{Binding IsEditingPurchased, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Purchase Unit" Style="{StaticResource FieldLabelStyle}" />
                            <syncfusion:SfTextBoxExt AutoCompleteSource="{Binding PurchaseUnits}"
                                                      SearchItemPath="Name"
                                                      SelectedItem="{Binding EditingPurchaseUnit, Mode=TwoWay}"
                                                      AutoCompleteMode="Suggest"
                                                      SuggestionMode="Contains"
                                                      Margin="0,0,0,12" />

                            <TextBlock Text="Purchase Unit Qty (grams)" Style="{StaticResource FieldLabelStyle}" />
                            <syncfusion:DoubleTextBox Value="{Binding EditingPurchaseUnitQty, Mode=TwoWay}"
                                                       Margin="0,0,0,12" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsEditingMade, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Weight Loss %" Style="{StaticResource FieldLabelStyle}" />
                            <syncfusion:DoubleTextBox Value="{Binding EditingWeightLossPercent, Mode=TwoWay}"
                                                       Margin="0,0,0,12" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <syncfusion:ButtonAdv Label="New" IconTemplate="{StaticResource AddIconTemplate}" Command="{Binding NewCommand}" Margin="0,0,8,0" />
                            <syncfusion:ButtonAdv Label="Save" IconTemplate="{StaticResource SaveIconTemplate}" Command="{Binding SaveCommand}" Margin="0,0,8,0" />
                            <syncfusion:ButtonAdv Label="Delete" IconTemplate="{StaticResource DeleteIconTemplate}" Command="{Binding DeleteCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16" MinHeight="120"
                        Visibility="{Binding SelectedIngredient, Converter={StaticResource EmptyStateVisibilityConverter}}">
                    <TextBlock Text="Select an ingredient to see its price history or bill of materials." Style="{StaticResource EmptyStateStyle}" />
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"
                        Visibility="{Binding ShowPriceHistory, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Price History" Style="{StaticResource SectionHeaderStyle}" />

                        <syncfusion:SfDataGrid ItemsSource="{Binding PriceHistory}"
                                                SelectedItem="{Binding SelectedPriceHistoryEntry, Mode=TwoWay}"
                                                AutoGenerateColumns="False"
                                                AllowEditing="False"
                                                SelectionMode="Single"
                                                NavigationMode="Row"
                                                ColumnSizer="Star"
                                                Height="200">
                            <syncfusion:SfDataGrid.Columns>
                                <syncfusion:GridDateTimeColumn MappingName="Date" HeaderText="Date" />
                                <syncfusion:GridCurrencyColumn MappingName="Price" HeaderText="Price" CurrencySymbol="₱" CurrencyDecimalDigits="2" />
                            </syncfusion:SfDataGrid.Columns>
                        </syncfusion:SfDataGrid>

                        <TextBlock Text="Date" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,4" />
                        <syncfusion:DateTimeEdit DateTime="{Binding EditingPriceDate, Mode=TwoWay}"
                                                  Pattern="ShortDate"
                                                  Margin="0,0,0,12" />

                        <TextBlock Text="Price (per purchase unit)" Style="{StaticResource FieldLabelStyle}" />
                        <syncfusion:DoubleTextBox Value="{Binding EditingPrice, Mode=TwoWay}"
                                                   Margin="0,0,0,12" />

                        <StackPanel Orientation="Horizontal">
                            <syncfusion:ButtonAdv Label="Add Price" IconTemplate="{StaticResource AddIconTemplate}" Command="{Binding AddPriceCommand}" Margin="0,0,8,0" />
                            <syncfusion:ButtonAdv Label="Delete Price" IconTemplate="{StaticResource DeleteIconTemplate}" Command="{Binding DeletePriceCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"
                        Visibility="{Binding ShowBomEditor, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Bill of Materials" Style="{StaticResource SectionHeaderStyle}" />

                        <syncfusion:SfDataGrid ItemsSource="{Binding BomLineEdits}"
                                                SelectedItem="{Binding SelectedBomLineEdit, Mode=TwoWay}"
                                                AutoGenerateColumns="False"
                                                AllowEditing="False"
                                                SelectionMode="Single"
                                                NavigationMode="Row"
                                                ColumnSizer="Star"
                                                Height="200">
                            <syncfusion:SfDataGrid.Columns>
                                <syncfusion:GridTextColumn MappingName="Component.Name" HeaderText="Component" />
                                <syncfusion:GridNumericColumn MappingName="Grams" HeaderText="Grams" NumberDecimalDigits="2" />
                            </syncfusion:SfDataGrid.Columns>
                        </syncfusion:SfDataGrid>

                        <TextBlock Text="Component" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,4" />
                        <syncfusion:ComboBoxAdv ItemsSource="{Binding Ingredients}"
                                                 DisplayMemberPath="Name"
                                                 SelectedItem="{Binding EditingBomComponent, Mode=TwoWay}"
                                                 Margin="0,0,0,12" />

                        <TextBlock Text="Grams" Style="{StaticResource FieldLabelStyle}" />
                        <syncfusion:DoubleTextBox Value="{Binding EditingBomGrams, Mode=TwoWay}"
                                                   Margin="0,0,0,12" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <syncfusion:ButtonAdv Label="Add Line" IconTemplate="{StaticResource AddIconTemplate}" Command="{Binding AddBomLineCommand}" Margin="0,0,8,0" />
                            <syncfusion:ButtonAdv Label="Remove Line" IconTemplate="{StaticResource RemoveIconTemplate}" Command="{Binding RemoveBomLineCommand}" />
                        </StackPanel>

                        <syncfusion:ButtonAdv Label="Save BOM" IconTemplate="{StaticResource SaveIconTemplate}" Command="{Binding SaveBomCommand}" />
                    </StackPanel>
                </Border>

                <Expander Header="Manage categories" IsExpanded="False">
                    <Border Style="{StaticResource CardStyle}" Margin="0,8,0,0">
                        <StackPanel>
                            <syncfusion:SfDataGrid ItemsSource="{Binding Categories}"
                                                    SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                                    AutoGenerateColumns="False"
                                                    AllowEditing="False"
                                                    SelectionMode="Single"
                                                    NavigationMode="Row"
                                                    ColumnSizer="Star"
                                                    Height="180">
                                <syncfusion:SfDataGrid.Columns>
                                    <syncfusion:GridTextColumn MappingName="Name" HeaderText="Name" />
                                </syncfusion:SfDataGrid.Columns>
                            </syncfusion:SfDataGrid>

                            <TextBlock Text="Name" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,4" />
                            <syncfusion:SfTextBoxExt Text="{Binding EditingCategoryName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Margin="0,0,0,12" />

                            <StackPanel Orientation="Horizontal">
                                <syncfusion:ButtonAdv Label="New" IconTemplate="{StaticResource AddIconTemplate}" Command="{Binding NewCategoryCommand}" Margin="0,0,8,0" />
                                <syncfusion:ButtonAdv Label="Save" IconTemplate="{StaticResource SaveIconTemplate}" Command="{Binding SaveCategoryCommand}" Margin="0,0,8,0" />
                                <syncfusion:ButtonAdv Label="Delete" IconTemplate="{StaticResource DeleteIconTemplate}" Command="{Binding DeleteCategoryCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
