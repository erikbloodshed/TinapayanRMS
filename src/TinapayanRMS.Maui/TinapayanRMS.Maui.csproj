<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Satori GC, an experiment (2026-11-08): github.com/VSadov/Satori, a low-pause garbage collector that isn't .NET's.
       The SDK swaps the runtime's own files (coreclr, the JIT, System.Private.CoreLib) for Satori's builds of them, so it
       only works for a self-contained app. Off unless asked for: -p:UseSatoriGC=true (below). Its runtime is built from
       .NET's release/11.0, so choose an 11.0.0-satori.* version (nuget.org/packages/PublishWithSatoriGC). -->
  <Sdk Name="PublishWithSatoriGC" Version="11.0.0-satori.42242472725.2" />

  <!-- The app: a .NET MAUI Blazor Hybrid window that draws the screens (TinapayanRMS.Components) in its WebView2.
       Windows only. Ported from the TinapayanRMS_Web repo's on 2026-11-07, without its shop accounts or its Mac target,
       and the WPF app it ran beside was dropped. -->
  <PropertyGroup>
    <TargetFramework>$(WindowsTargetFramework)</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <!-- The web view's stylesheets are Blazor's, not MAUI's. -->
    <EnableDefaultCssItems>false</EnableDefaultCssItems>

    <ApplicationTitle>TinapayanRMS</ApplicationTitle>
    <ApplicationId>com.tinapayanfestivalbakeshoppe.tinapayanrms</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- The WPF app's icon, for the .exe, the taskbar and Alt+Tab: the window takes it from the .exe. -->
    <ApplicationIcon>Resources\AppIcon\tinapayan-rms-icon.ico</ApplicationIcon>

    <!-- Unpackaged, as an .exe in a folder, with the Windows App SDK in that folder too, so the PC needs nothing installed
         for it. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- The code LibraryImport writes for the calls into user32 and dwmapi (SingleInstance, AppWindowChrome). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <!-- Satori GC stays off: its SDK turns it on by default, and a -p:UseSatoriGC=true on the command line still wins over
       this. With it on, the app is built self-contained, with its own copy of .NET (Satori's runtime over it), into
       bin\Satori\ rather than bin\, so it never mixes with the everyday build. dotnet build, run and publish all take
       it. The app logs which collector it started with (MauiProgram). -->
  <PropertyGroup>
    <UseSatoriGC>false</UseSatoriGC>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UseSatoriGC)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <OutputPath>bin\Satori\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- The database to use, built into the app (MauiProgram reads it). The two servers and the test fixtures link it too. -->
    <EmbeddedResource Include="appsettings.json" LogicalName="appsettings.json" />
    <None Remove="appsettings.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" />
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Syncfusion.Licensing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TinapayanRMS.Components\TinapayanRMS.Components.csproj" />
  </ItemGroup>

  <!-- The Syncfusion licence key, taken from the SYNCFUSION_LICENSE_KEY environment variable when the app is built, so
       the installed app doesn't need the variable, as the WPF app's was. MauiProgram reads it back by its key. -->
  <ItemGroup Condition="'$(SYNCFUSION_LICENSE_KEY)' != ''">
    <AssemblyMetadata Include="SyncfusionLicenseKey" Value="$(SYNCFUSION_LICENSE_KEY)" />
  </ItemGroup>

  <!-- A publish without the key would make an app that shows Syncfusion's licence notice. -->
  <Target Name="RequireSyncfusionLicenseKey" BeforeTargets="PrepareForPublish" Condition="'$(SYNCFUSION_LICENSE_KEY)' == ''">
    <Error Text="Set the SYNCFUSION_LICENSE_KEY environment variable before publishing. The key is compiled into the app." />
  </Target>

  <!-- Syncfusion's static files the app doesn't use are left out, so they're neither copied beside the app nor read by
       Windows' resource indexer (MakePri):
       - every theme but the one the app links, fluent2-lite.css (index.html): the themes package has every theme
         Syncfusion makes, some 240 MB, whose names (bootstrap5.3-dark.css) MakePri takes for resource qualifiers and
         warns about;
       - the all-components script, syncfusion-blazor.min.js (7 MB): the page loads only its components' scripts
         (wwwroot/syncfusion.js). -->
  <Target Name="LeaveOutUnusedSyncfusionFiles" AfterTargets="UpdateExistingPackageStaticWebAssets">
    <ItemGroup>
      <_UnusedSyncfusionFile Include="@(StaticWebAsset)" Condition="'%(SourceId)' == 'Syncfusion.Blazor.Themes' and '%(RelativePath)' != 'fluent2-lite.css'" />
      <_UnusedSyncfusionFile Include="@(StaticWebAsset)" Condition="'%(SourceId)' == 'Syncfusion.Blazor.Core' and '%(RelativePath)' == 'scripts/syncfusion-blazor.min.js'" />
      <StaticWebAsset Remove="@(_UnusedSyncfusionFile)" />
    </ItemGroup>
  </Target>

</Project>
