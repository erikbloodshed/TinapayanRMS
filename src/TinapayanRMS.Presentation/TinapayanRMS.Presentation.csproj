<Project Sdk="Microsoft.NET.Sdk">

  <!-- The screens' state classes, with no UI framework: the app's Blazor screens (TinapayanRMS.Components) draw them.
       Keep MAUI, Blazor and Syncfusion out of it, so they're tested without a window (Presentation.Tests). -->

  <ItemGroup>
    <PackageReference Include="DynamicData" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="System.Reactive" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TinapayanRMS.Domain\TinapayanRMS.Domain.csproj" />
    <ProjectReference Include="..\TinapayanRMS.ApplicationCore\TinapayanRMS.ApplicationCore.csproj" />
    <!-- Failure, which puts what the database refused into words, and the backups' services. -->
    <!-- What a saved product costs, read the one way the screens and the two servers read it. -->
    <ProjectReference Include="..\TinapayanRMS.Pricing\TinapayanRMS.Pricing.csproj" />
    <!-- What the screens can do with the records, a screen at a time (docs/adr/0002): Sub-Assemblies', Raw Materials'
         and Products' so far. -->
    <ProjectReference Include="..\TinapayanRMS.UseCases\TinapayanRMS.UseCases.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- A draft's property tests change what it's worked out from as only its form may (ProductCostingTests: the costing's
         inputs and cost basis), through members kept internal so nothing else can. -->
    <InternalsVisibleTo Include="TinapayanRMS.Presentation.Tests" />
  </ItemGroup>

</Project>
