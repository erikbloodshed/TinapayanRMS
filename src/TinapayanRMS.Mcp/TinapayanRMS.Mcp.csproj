<Project Sdk="Microsoft.NET.Sdk">

  <!-- A Model Context Protocol server over stdio, for AI coding tools: reads and prices the dev database's products with
       the app's own code, and never writes (Program). It prices with TinapayanRMS.Pricing (SavedProductReader, the Price
       Simulator's SimulatedPriceChange), so its figures are the screens', and has nothing of the UI. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TinapayanRMS.Infrastructure\TinapayanRMS.Infrastructure.csproj" />
    <ProjectReference Include="..\TinapayanRMS.Pricing\TinapayanRMS.Pricing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The app's own, so it reads the database the app saves to. -->
    <Content Include="..\TinapayanRMS.UI\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TinapayanRMS.Mcp.Tests" />
  </ItemGroup>

</Project>
