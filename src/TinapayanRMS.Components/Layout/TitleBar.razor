@implements IAsyncDisposable
@inject IAppWindow Window
@inject MainWindowViewModel Shell
@inject AppLock Lock
@inject IJSRuntime JS

@* The window's title bar, drawn by the page: the window has none of Windows' (IAppWindow). On the left, the menu toggle
   and the heading; on the right, the Vim keys' mode, Find, Lock, Back and Forward, then Minimize, Maximize (Restore while
   maximized) and Close. The rest of the bar is the window's caption, which Windows itself drags, double-clicks and
   right-clicks (wwwroot/app.js, watchTitleBar). The menu opens under it, so its toggle stays where it is to put the
   menu away again. Lock puts the sign-in panel over the window (AppLock); while it's locked the bar keeps only the app's
   name and the window's own buttons, so the window can still be moved, sized and closed. *@
<header class="app-titlebar" @ref="_bar">
    @if (Locked)
    {
        <span class="app-heading">@Shell.Title</span>
    }
    else
    {
        <button type="button" class="titlebar-button" title="Show the navigation menu" aria-label="Navigation menu" @onclick="OnMenu">
            <Icon Of="AppIcon.Menu" />
        </button>
        <span class="app-heading">@Shell.Heading</span>
    }

    <span class="titlebar-fill"></span>

    @if (!Locked)
    {
        @RightOfHeading
    }

    @* The window's own buttons are drawn here, not taken from an icon font: Syncfusion's icons have none for them. *@
    <div class="caption-buttons">
        <button type="button" class="titlebar-button caption-button" title="Minimize" aria-label="Minimize" @onclick="Window.Minimize">
            <svg class="caption-glyph" viewBox="0 0 10 10" aria-hidden="true"><path d="M0 5.5h10" /></svg>
        </button>
        <button type="button" class="titlebar-button caption-button" title="@(_maximized ? "Restore Down" : "Maximize")"
                aria-label="@(_maximized ? "Restore Down" : "Maximize")" @onclick="Window.ToggleMaximize">
            @if (_maximized)
            {
                <svg class="caption-glyph" viewBox="0 0 10 10" aria-hidden="true"><path d="M2.5 2.5v-2h7v7h-2" /><rect x=".5" y="2.5" width="7" height="7" /></svg>
            }
            else
            {
                <svg class="caption-glyph" viewBox="0 0 10 10" aria-hidden="true"><rect x=".5" y=".5" width="9" height="9" /></svg>
            }
        </button>
        <button type="button" class="titlebar-button caption-button caption-close" title="Close" aria-label="Close" @onclick="Window.Close">
            <svg class="caption-glyph" viewBox="0 0 10 10" aria-hidden="true"><path d="M.5.5l9 9m0-9l-9 9" /></svg>
        </button>
    </div>
</header>

@code {
    private ElementReference _bar;
    private DotNetObjectReference<TitleBar>? _self;
    private IJSObjectReference? _watch;
    private bool _disposed;
    private bool _maximized;
    private bool _canGoBack;
    private bool _canGoForward;

    /// <summary>The menu toggle's click: MainLayout opens or closes the menu.</summary>
    [Parameter] public EventCallback OnMenu { get; set; }

    /// <summary>Whether the window is locked (AppLock): the bar keeps only the app's name and the window's buttons.</summary>
    [Parameter] public bool Locked { get; set; }

    // The Vim keys' mode, Find, Lock, Back and Forward, which a locked window leaves out: the Vim keys and Find's key go
    // with their components.
    private RenderFragment RightOfHeading => __builder =>
    {
        <VimKeys />
        <FindHost />
        <button type="button" class="titlebar-button titlebar-small-glyph" title="Lock: put the sign-in panel over the window until the password is given"
                aria-label="Lock" @onclick="Lock.Lock">
            <Icon Of="AppIcon.Lock" />
        </button>
        @* Back and Forward between the screens' addresses (a record's included), as Alt+Left and Alt+Right, and the Vim keys'
           H and L, go. The screen being left asks about its unsaved changes first. *@
        <button type="button" class="titlebar-button titlebar-small-glyph" title="Back (Alt+Left)" aria-label="Back"
                disabled="@(!_canGoBack)" @onclick="GoBackAsync">
            <Icon Of="AppIcon.Back" />
        </button>
        <button type="button" class="titlebar-button titlebar-small-glyph" title="Forward (Alt+Right)" aria-label="Forward"
                disabled="@(!_canGoForward)" @onclick="GoForwardAsync">
            <Icon Of="AppIcon.Forward" />
        </button>
    };

    protected override void OnInitialized()
    {
        _maximized = Window.IsMaximized;
        Window.StateChanged += OnWindowStateChanged;
        Shell.PropertyChanged += OnShellChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            _watch = await JS.InvokeAsync<IJSObjectReference>("tinapayan.watchTitleBar", _bar, _self).KeepUnlessGoneAsync(() => _disposed);
        }
    }

    /// <summary>Where the bar and its buttons are, in device pixels, each time either moves or changes size.</summary>
    [JSInvokable]
    public void SetTitleBar(DeviceRect titleBar, DeviceRect[] buttons) => Window.SetTitleBar(titleBar, buttons);

    /// <summary>Whether the web view's history has an address before and after the one showing, each time it moves.</summary>
    [JSInvokable]
    public Task HistoryChanged(bool canGoBack, bool canGoForward) => InvokeAsync(() =>
    {
        (_canGoBack, _canGoForward) = (canGoBack, canGoForward);
        StateHasChanged();
    });

    private async Task GoBackAsync() => await JS.InvokeVoidAsync("history.back");

    private async Task GoForwardAsync() => await JS.InvokeVoidAsync("history.forward");

    private void OnWindowStateChanged() => InvokeAsync(() =>
    {
        _maximized = Window.IsMaximized;
        StateHasChanged();
    });

    private void OnShellChanged(object? sender, PropertyChangedEventArgs e) => InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Window.StateChanged -= OnWindowStateChanged;
        Shell.PropertyChanged -= OnShellChanged;
        await _watch.StopAsync();
        _self?.Dispose();
    }
}
