@* The navigation menu: the screens, with their icons, then Settings. Print isn't listed: it opens from Products,
   with what to print chosen there. *@
<nav class="nav-menu">
    <div class="nav-section">NAVIGATE</div>
    @foreach (var item in Items)
    {
        <NavLink class="nav-item" href="@item.Href" Match="NavLinkMatch.Prefix" @onclick="Navigated">
            <Icon Of="item.Icon" />
            <span>@item.Label</span>
        </NavLink>
    }

    <div class="nav-separator"></div>
    <NavLink class="nav-item" href="settings" Match="NavLinkMatch.Prefix" @onclick="Navigated">
        <Icon Of="AppIcon.Settings" />
        <span>Settings</span>
    </NavLink>
</nav>

@code {
    /// <summary>Raised when a link is followed, so the floating menu can close.</summary>
    [Parameter] public EventCallback Navigated { get; set; }

    private sealed record NavItem(string Label, AppIcon Icon, string Href);

    private static readonly NavItem[] Items =
    [
        new("Raw Materials", AppIcon.RawMaterials, "raw-materials"),
        new("Sub-Assemblies", AppIcon.SubAssemblies, "sub-assemblies"),
        new("Products", AppIcon.Products, "products"),
        new("Reports", AppIcon.Reports, "reports"),
        new("Price Simulator", AppIcon.PriceSimulator, "price-simulator"),
    ];
}
