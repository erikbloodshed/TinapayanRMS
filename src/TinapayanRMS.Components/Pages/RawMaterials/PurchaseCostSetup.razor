@* A purchased material's prices: one line per brand, each in a purchase unit it's bought
   in, with what it comes to per base unit (Unit Price); Basis, the brand it's costed at (the dearest unless one is picked); then the Cost Buffer % and the fixed
   Buffered Cost, which follow each other as either is typed, in a unit picked to show it in. While prices have moved the
   buffer off the target last typed, the target shows, with Re-apply Target to type it again. *@
<div class="tab-card">
    <h2 class="section-header">Purchase Cost Setup</h2>

    <LineGrid TRow="BrandPriceRow" Items="State.PurchaseCost.BrandPriceRows" NewItem="State.PurchaseCost.NewBrandPriceRow" @bind-SelectedItem="State.PurchaseCost.SelectedBrandPriceRow">
        <Header>
            <th>Brand</th>
            <th class="col-unit">Purchase Unit</th>
            <th class="col-number col-wide">Qty per Purchase Unit</th>
            <th class="col-number">Purchase Price</th>
            <th class="col-number" title="What one @State.BaseUnitName costs at this price: Purchase Price ÷ Qty per Purchase Unit">Unit Price</th>
            <th class="col-number">Buffer %</th>
        </Header>
        <Row Context="row">
            <td><TextField Value="@row.Brand" ValueChanged="v => row.Brand = v" CssClass="cell-field" /></td>
            <td>
                <PickField TItem="PurchaseUnitChoice" Items="State.PurchaseCost.PurchaseUnitOptions" TextField="Name" CssClass="cell-field" Deferred="true" PopupWidth="260px"
                           Value="State.PurchaseCost.PurchaseUnitOptions.FirstOrDefault(o => o.Key == row.UnitKey)" ValueChanged="o => row.UnitKey = o?.Key">
                    <ItemTemplate Context="option"><span class="pick-columns"><span>@option.Name</span><span class="muted">@option.Abbreviation</span></span></ItemTemplate>
                </PickField>
            </td>
            <td><NumberField TValue="decimal?" Value="row.Quantity" ValueChanged="v => row.Quantity = v" Format="#,0.####" Min="0" ReadOnly="!row.CanTypeQuantity" CssClass="cell-field" /></td>
            <td><NumberField TValue="decimal?" Value="row.Price" ValueChanged="v => row.Price = v" Format="N2" Min="0" CssClass="cell-field" /></td>
            <td class="cell-number">@row.CostPerBaseUnit?.ToString("N4")</td>
            <td class="cell-number">@row.BufferPercent?.ToString("N2")</td>
        </Row>
    </LineGrid>
    <div class="cost-from-row form-extra">
        <label class="form-label" for="rm-cost-from">Basis</label>
        <PickField ID="rm-cost-from" TItem="CostFromOption" Items="State.PurchaseCost.CostFromOptions" TextOf="o => o.Label"
                   Value="State.PurchaseCost.CostFrom" ValueChanged="o => State.PurchaseCost.CostFrom = o" CssClass="cost-from-picker" PopupWidth="340px"
                   Tooltip="The brand it's costed at: the dearest, or a picked brand's price (its dearest unit). Save keeps it." />
        <CommandButton Command="State.PurchaseCost.RemoveBrandPriceCommand" CssClass="remove-line" Icon="AppIcon.Remove" Label="Remove" />
    </div>

    <div class="buffer-row">
        <div class="field-stack">
            <label class="field-label" for="rm-buffer-percent">Cost Buffer %</label>
            <NumberField ID="rm-buffer-percent" TValue="decimal?" @bind-Value="State.PurchaseCost.TypedCostBufferPercent" Min="0" Max="100"
                         Tooltip="A cushion over the Basis brand's cost for price swings and waste. Typing it sets the Buffered Cost, and vice versa." />
        </div>
        <div class="field-stack">
            <label class="field-label" for="rm-buffered-cost">Buffered Cost</label>
            <NumberField ID="rm-buffered-cost" TValue="decimal?" @bind-Value="State.PurchaseCost.EditingBufferedCostInUnit" Min="0" LandsOnLeave="true"
                         Tooltip="The fixed cost recipes use. New prices don't move it; retyping the Cost Buffer % does." />
        </div>
        <div class="field-stack">
            <label class="field-label" for="rm-buffered-unit">Per</label>
            <PickField ID="rm-buffered-unit" TItem="PurchaseUnitChoice" Items="State.PurchaseCost.BufferedCostUnitOptions" TextField="Name" @bind-Value="State.PurchaseCost.BufferedCostUnit"
                       Tooltip="The unit the buffered cost is shown in. It's stored per base unit." />
        </div>
    </div>
    @if (State.PurchaseCost.IsBufferOffTarget)
    {
        <div class="target-buffer-row">
            <span>@State.PurchaseCost.TargetBufferText</span>
            <CommandButton Command="State.PurchaseCost.ReapplyTargetBufferCommand" Icon="AppIcon.Apply" Label="Re-apply Target"
                           Tooltip="Reapplies the target buffer over the Basis brand's cost. Save keeps it." />
        </div>
    }
    <p class="caption">@State.PurchaseCost.PurchaseBufferedCostText</p>
    @if (!string.IsNullOrEmpty(State.PurchaseCost.BufferedCostWarningText))
    {
        <p class="warning-text">@State.PurchaseCost.BufferedCostWarningText</p>
    }
</div>

@code {
    [Parameter, EditorRequired] public RawMaterialForm State { get; set; } = null!;
}
