@using TinapayanRMS.Domain.Enums

@* The picked material's header: Save, Undo, Redo and Delete, as icons, each named by its tooltip (no name: its tab shows
   it; no New: the list's toolbar has it); its figures
   in coloured tiles (Base Unit, Current and Buffered Cost per its purchase unit, a made ingredient's Total Weight and
   Total Cost as its BOM stands, and Last Updated); then its fields on one row, Name first. Packaging is always
   purchased, so it has no Source and picks its Base Unit there instead; only a made ingredient has Weight Loss %. *@
<section class="card header-card">
    <div class="header-title-row">
        <div class="button-row">
            <CommandButton Command="State.SaveCommand" Icon="AppIcon.Save" Primary="true" Tooltip="Save: saves the details, units, price and bill of materials." />
            <CommandButton Command="State.UndoCommand" Icon="AppIcon.Undo" Tooltip="Undo: takes back the last change. Ctrl+Z." />
            <CommandButton Command="State.RedoCommand" Icon="AppIcon.Redo" Tooltip="Redo: puts back the change the last Undo took. Ctrl+Y." />
            <CommandButton Command="State.DeleteCommand" Icon="AppIcon.Delete"
                           Tooltip="Delete: deletes it with its prices and units (asks first), unless something uses it." />
        </div>
    </div>

    <div class="section-divider"></div>

    <div class="figure-tiles">
        <div class="figure-tile tile-rosewater">
            <div class="figure-label">Base Unit</div>
            <div class="figure-value">@State.SavedBaseUnitText</div>
        </div>
        <div class="figure-tile tile-peach">
            <div class="figure-label">Current Cost per @State.PurchaseCost.HeaderCostUnitText</div>
            <div class="figure-value">@State.PurchaseCost.CurrentCostText</div>
        </div>
        <div class="figure-tile tile-yellow">
            <div class="figure-label">Buffered Cost per @State.PurchaseCost.HeaderCostUnitText</div>
            <div class="figure-value">@State.PurchaseCost.BufferedCostText</div>
        </div>
        @if (State.IsEditingMade)
        {
            <div class="figure-tile tile-teal" data-title="What the batch yields as the BOM stands: its grams less the weight loss.">
                <div class="figure-label">Total Weight</div>
                <div class="figure-value">@State.Recipe.BomTotalWeight.ToString("#,0.##") g</div>
            </div>
            <div class="figure-tile tile-flamingo" data-title="The BOM's cost at buffered costs (the grid's Cost column). Over Total Weight, it's the Buffered Cost per gram.">
                <div class="figure-label">Total Cost</div>
                <div class="figure-value">@State.Recipe.BomTotalCost.ToString("N2")</div>
            </div>
        }
        <div class="figure-tile tile-mauve" data-title="When its cost last changed: a price, buffer or recipe edit, or a component's change.">
            <div class="figure-label">Last Updated</div>
            <div class="figure-value">@State.LastUpdatedText</div>
        </div>
    </div>

    <div class="header-fields">
        <label class="form-label" for="rm-name">Name</label>
        <TextField ID="rm-name" @bind-Value="State.EditingName" OnLeave="State.CheckNameAvailability" CssClass="field-roomy" />

        <label class="form-label" for="rm-type">Type</label>
        <PickField ID="rm-type" TItem="RawMaterialType" Items="State.Types" Value="State.EditingType" ValueChanged="State.ChangeType" Disabled="!State.CanChangeTypeAndSource"
                   Tooltip="Ingredients go in recipes, packaging on packaging lines. Fixed once saved." />

        <label class="form-label" for="rm-category">Category</label>
        <PickField ID="rm-category" TItem="RawMaterialCategory" Items="State.CategoryOptions" TextField="Name"
                   Value="State.EditingCategory" ValueChanged="PickCategory" AllowEmpty="true" CssClass="field-roomy"
                   OnArrive="ArriveAtCategory" OnTyped="t => State.CategorySearchText = t" OnLeave="State.CommitCategoryTextAsync"
                   Tooltip="Pick a category, or type a new one's name to add it." />

        @if (State.IsEditingIngredient)
        {
            <label class="form-label" for="rm-source">Source</label>
            <PickField ID="rm-source" TItem="RawMaterialSource" Items="State.Sources" Value="State.EditingSource" ValueChanged="State.ChangeSource" Disabled="!State.CanChangeTypeAndSource" />
        }
        @if (State.IsEditingPackaging)
        {
            <label class="form-label" for="rm-base-unit">Base Unit</label>
            <PickField ID="rm-base-unit" TItem="UnitOfMeasure" Items="State.UnitsOfMeasure" TextField="Name" Value="State.EditingBaseUnit" ValueChanged="State.ChangeBaseUnit" Disabled="!State.CanChangeBaseUnit"
                       Tooltip="Fixed once the material has alternative units, prices or packaging lines." />
        }
        @if (State.IsEditingMade)
        {
            <label class="form-label" for="rm-weight-loss">Weight Loss %</label>
            <NumberField ID="rm-weight-loss" TValue="decimal?" @bind-Value="State.EditingWeightLossPercent" Min="0" Max="99.99m" CssClass="field-narrow"
                         Tooltip="Weight lost in making; the cost spreads over what's left. New made ingredients start at 3%." />
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired] public RawMaterialForm State { get; set; } = null!;

    // The picker's text: the category's name as it takes the cursor, or what's typed since. Once the picker is left it's
    // settled (CommitCategoryTextAsync): a listed category is picked, and a new name offers to add it.
    private void ArriveAtCategory()
    {
        State.CategorySearchText = State.EditingCategory?.Name ?? "";
        State.BeginCategoryEdit();
    }

    private void PickCategory(RawMaterialCategory? category)
    {
        State.EditingCategory = category;
        State.CategorySearchText = category?.Name ?? "";
    }
}
