@page "/raw-materials"
@page "/raw-materials/{Id:int}"
@inherits RecordScreenBase<RawMaterialsState>
@inject Prompts Prompts
@inject IJSRuntime JS

<PageTitle>@(State!.SelectedRawMaterial?.Name ?? "Raw Materials") · TinapayanRMS</PageTitle>

<UndoKeys Screen="State!" Redraw="RedrawNowAsync" />

@* The list beside the picked material: its header, then its cards in tabs along the bottom.
   Every tab is part of the one form Save writes. Price History only applies to a saved purchased material. Between
   picking a material and its details arriving, the tabs ignore the mouse (AreDetailsReady). Each material has its own
   address, so the browser's Back and Forward step between the materials opened. *@
<CascadingValue Value="(IUndoRecorder)State!" IsFixed="true">
    <div class="record-screen">
        <MaterialList List="State!.List" />

        <div class="record-details">
            <SummaryHeader State="State!" />

            <section class="card tabs-card @(State!.AreDetailsReady ? "" : "details-pending")">
                <SfTab @bind-SelectedItem="State!.SelectedDetailsTab" HeaderPlacement="HeaderPosition.Bottom" LoadOn="ContentLoad.Init" CssClass="details-tabs">
                    <TabItems>
                        <TabItem>
                            <ChildContent><TabHeader Text="Cost Setup" /></ChildContent>
                            <ContentTemplate>
                                @if (State!.ShowPurchaseSetup)
                                {
                                    <PurchaseCostSetup State="State!" />
                                }
                                @if (State!.IsEditingMade)
                                {
                                    <BillOfMaterials State="State!" />
                                }
                                @if (State!.IsEditingLinked)
                                {
                                    <LinkedCost State="State!" />
                                }
                            </ContentTemplate>
                        </TabItem>
                        <TabItem>
                            <ChildContent><TabHeader Text="Alternative Units" /></ChildContent>
                            <ContentTemplate><AlternativeUnits State="State!" /></ContentTemplate>
                        </TabItem>
                        <TabItem>
                            <ChildContent><TabHeader Text="Usage Example" /></ChildContent>
                            <ContentTemplate><UsageExample State="State!" /></ContentTemplate>
                        </TabItem>
                        <TabItem>
                            <ChildContent><TabHeader Text="Dependents" /></ChildContent>
                            <ContentTemplate>
                                <div class="tab-card">
                                    <h2 class="section-header">Dependents</h2>
                                    <DependentTiles Products="State!.Dependents.Products" Caption="@State!.Dependents.Text" Open="id => Commands.Run(State!.Dependents.OpenProductCommand, id)" />
                                </div>
                            </ContentTemplate>
                        </TabItem>
                        <TabItem Visible="State!.ShowPriceHistory">
                            <ChildContent><TabHeader Text="Price History" /></ChildContent>
                            <ContentTemplate><PriceHistory State="State!" /></ContentTemplate>
                        </TabItem>
                    </TabItems>
                </SfTab>
            </section>
        </div>
    </div>
</CascadingValue>

@code {
    protected override ScreenCommand LoadCommand => State!.LoadCommand;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        var state = State!;

        // A name typed into the Category picker that isn't a category yet: asks whether to add it, starting with the name.
        AddSubscription(state.PromptForNewCategory.RegisterHandler(async interaction =>
            interaction.SetOutput(await Prompts.AskAsync(new TextPromptRequest("New Category", "Name", interaction.Input, $"“{interaction.Input}” isn't a category yet. Add it?")))));

        // Copy fills the form with a name to change: the cursor goes to Name. New names the material in the list instead,
        // where its row's box has the cursor.
        state.List.Copied += FocusName;
        AddSubscription(System.Reactive.Disposables.Disposable.Create(() => state.List.Copied -= FocusName));
    }

    protected override string AddressRoot => "raw-materials";

    protected override int? ShownId => State!.SelectedRawMaterial?.Id;

    protected override string ShownProperty => nameof(RawMaterialsState.SelectedRawMaterial);

    private void FocusName() => _ = FocusNameAsync();

    private async Task FocusNameAsync()
    {
        await RedrawNowAsync();
        await JS.InvokeVoidAsync("tinapayan.focus", "rm-name");
    }
}
