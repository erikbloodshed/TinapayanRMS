@page "/raw-materials"
@page "/raw-materials/{Id:int}"
@page "/raw-materials/new/{Number:int}"
@inherits RecordViewBase<RawMaterialsState, RawMaterialForm>
@inject IJSRuntime JS

<PageTitle>@(State!.Form?.SelectedRawMaterial?.Name ?? "Raw Materials") · TinapayanRMS</PageTitle>

@* The Raw Materials view: the materials, the list by type and category, beside a strip of tabs, a material open in each,
   as Visual Studio Code's editors are; under it, the form of the tab showing (RawMaterialFormView), drawn afresh as
   another tab shows, each keeping what's typed into it. A material picked in the list opens in the preview tab, which the
   next one picked replaces while it holds nothing unsaved. *@
<div class="record-screen">
    <RawMaterialsListCard List="State!.List" />

    <div class="record-details">
        <RecordTabStrip TForm="RawMaterialForm" Tabs="State!.Tabs" AddressOf="AddressOf" Close="CloseAsync" Keep="State!.Keep" Label="Raw materials open" />

        @if (State!.Form is { } form)
        {
            <RawMaterialFormView @key="form" Form="form" />
        }
        else
        {
            <section class="card empty-record">
                <p>No raw material is open. Pick one in the list, or start a new one.</p>
                <CommandButton Command="State!.NewCommand" Icon="AppIcon.Add" Label="New" />
            </section>
        }
    </div>
</div>

@code {
    protected override ScreenCommand LoadCommand => State!.LoadCommand;

    protected override string AddressRoot => "raw-materials";

    protected override void OnInitialized()
    {
        base.OnInitialized();
        var view = State!;

        // Copy fills a form with a name to change: the cursor goes to Name. New names the material in the list instead,
        // where its row's box has the cursor.
        view.List.Copied += FocusName;
        AddSubscription(System.Reactive.Disposables.Disposable.Create(() => view.List.Copied -= FocusName));
    }

    // A tab's ✕: asks about its changes first, showing it, and stays on Cancel.
    private async Task CloseAsync(RecordTab<RawMaterialForm> tab) => await State!.CloseTabAsync(tab);

    private void FocusName() => _ = FocusNameAsync();

    private async Task FocusNameAsync()
    {
        await RedrawNowAsync();
        await JS.InvokeVoidAsync("tinapayan.focus", "rm-name");
    }
}
