@using TinapayanRMS.Domain.Enums
@* Raw Materials' list: a search box; the list's commands as icons; the materials in a folder
   for their type, then their category; and, under the tree, what the last move did, with Undo. Dragging materials onto
   another category of their type moves them there, saved at once; a right-click opens the row's menu, or the list's. A
   name is typed in place, as in a file explorer (TreeNameEdit): a material or category renamed, or a new material or
   folder named. *@
<section class="card list-card tree-card">
    <div class="list-heading">
        <h2 class="section-header">Raw Materials</h2>
        @* Not one of the form's boxes: it keeps the cursor, and what's typed, when another record takes the form. *@
        <CascadingValue TValue="IUndoRecorder" Value="null" IsFixed="true">
            <TextField @bind-Value="List.SearchText" Placeholder="Search raw material" CssClass="list-search" />
        </CascadingValue>
    </div>

    <div class="list-toolbar">
        <ActionButton Icon="AppIcon.Add" Tooltip="New Raw Material" Flat="true" OnClick="() => Commands.Run(List.NewMaterialInCommand, null)" />
        <MenuButton CssClass="e-flat icon-only" Tooltip="New Folder: for ingredients, made ingredients or packaging">
            <Face><Icon Of="AppIcon.NewFolder" /></Face>
            <ChildContent>
                <ActionButton Icon="AppIcon.NewFolder" Label="New Ingredient Folder" Flat="true" OnClick="() => Commands.Run(List.NewCategoryCommand, RawMaterialCategoryType.Ingredient)" />
                <ActionButton Icon="AppIcon.NewFolder" Label="New Made Folder" Flat="true" OnClick="() => Commands.Run(List.NewCategoryCommand, RawMaterialCategoryType.Made)" />
                <ActionButton Icon="AppIcon.NewFolder" Label="New Packaging Folder" Flat="true" OnClick="() => Commands.Run(List.NewCategoryCommand, RawMaterialCategoryType.Packaging)" />
            </ChildContent>
        </MenuButton>
        <ActionButton Icon="AppIcon.ExpandAll" Tooltip="Expand All" Flat="true" OnClick="() => Commands.Run(List.ExpandAllCommand, null)" />
        <ActionButton Icon="AppIcon.CollapseAll" Tooltip="Collapse All" Flat="true" OnClick="() => Commands.Run(List.CollapseAllCommand, null)" />
    </div>

    <FolderTree TNode="RawMaterialTreeNode"
                Roots="List.RawMaterialTree.Roots"
                ChildrenOf="n => n is RawMaterialFolderNode folder ? folder.Children : null"
                IsExpanded="n => n is RawMaterialFolderNode { IsExpanded: true }"
                SetExpanded="(n, open) => { if (n is RawMaterialFolderNode folder) folder.IsExpanded = open; }"
                Selected="List.SelectedTreeNodes"
                KeyOf="KeyOf"
                RowClass="@(n => n.IsTypeFolder ? "top-level" : null)"
                CanDrag="n => Screen.CanDrag(n)"
                IsEditing="IsEditing"
                RenamesOnSecondClick="n => n is RawMaterialLeafNode { IsNew: false }"
                CanDrop="(dragged, target) => Screen.CanDrop(dragged, target)"
                OnDrop="(dragged, target) => Screen.DropAsync(dragged, target)"
                MenuFor="List.TreeMenuFor"
                Shortcut="List.TreeShortcut">
        <RowTemplate Context="node">
            @if (node.IsFolder)
            {
                <span class="@AppIcons.CssOf(node.Icon!.Value) tree-glyph" aria-hidden="true"></span>
            }
            @if (List.TreeNameEdit is { } edit && ReferenceEquals(edit.Node, node))
            {
                @* Keyed by the edit: a name refused comes back as a new one, and a new box. *@
                <TreeNameBox @key="edit" InitialText="@edit.InitialText" Hint="@edit.Hint"
                             OnCommit="List.CommitTreeNameAsync" OnCancel="List.CancelTreeName" />
            }
            else
            {
                <span class="tree-title">@node.Title</span>
                @if (node.IsFolder)
                {
                    <span class="tree-count">(@node.MaterialCount)</span>
                }
            }
        </RowTemplate>
    </FolderTree>

    <MoveNoticeBar Notice="@List.MoveNotice" UndoCommand="List.UndoMoveCommand" DismissCommand="List.DismissMoveNoticeCommand" />
</section>

@code {
    [Parameter, EditorRequired] public RawMaterialsList List { get; set; } = null!;

    private static string KeyOf(RawMaterialTreeNode node) => node switch
    {
        RawMaterialFolderNode folder => "folder-" + folder.Key,
        RawMaterialLeafNode leaf => "material-" + leaf.RawMaterial.Id,
        _ => node.Title,
    };

    private bool IsEditing(RawMaterialTreeNode node) => ReferenceEquals(List.TreeNameEdit?.Node, node);

    // What can be dragged and dropped where is the list's to say (IListTreeScreen), as its tests check it.
    private IListTreeScreen Screen => List;
}
