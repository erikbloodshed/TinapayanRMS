@* A product's packaging (the WPF PackagingSectionView): where it's linked from, as a tag, or a link that opens the
   packaging set on Sub-Assemblies; what it costs per sellable unit; its lines, typed into unless they're linked; and
   Move to Sub-Assemblies for its own, or Make a Copy for a linked one. Under them, its bulk packaging: what one bulk pack
   takes (a box several units share, its tape), and in a box of its own how many products the pack holds, which share
   out its cost. *@
<div class="section-view">
    <div class="section-heading">
        <div class="usage-badges">
            @if (ViewModel.Packaging.IsPackagingLinkedToProduct)
            {
                <span class="badge badge-warning">@ViewModel.Packaging.PackagingLinkedToText</span>
            }
            @if (ViewModel.Packaging.IsPackagingLinkedToSet && ViewModel.Packaging.PackagingLinkedSetId is { } setId)
            {
                <button type="button" class="badge badge-link" @onclick="() => Commands.Run(ViewModel.OpenSubAssemblyCommand, setId)" title="Open the packaging set on the Sub-Assemblies screen">
                    @ViewModel.Packaging.PackagingLinkedToText
                </button>
            }
            @if (ViewModel.Packaging.IsPackagingMoving)
            {
                <span class="badge badge-warning" title="Save puts these lines on the Sub-Assemblies screen as a packaging set named after this product, and this product links it there. Undo or Revert to keep them this product's own.">Moves to Sub-Assemblies on Save</span>
            }
        </div>
        <div class="lines-footer-right">
            <span class="caption">@ViewModel.CostUnitCaption · @ViewModel.Costing.Costs.OwnPackaging.ToString("N2")</span>
            @if (ViewModel.Packaging.CanMovePackaging)
            {
                <CommandButton Command="ViewModel.MovePackagingToSubAssembliesCommand" Icon="AppIcon.Link" Label="Move to Sub-Assemblies"
                               Tooltip="Save puts these lines on the Sub-Assemblies screen as a packaging set, named after this product, and this product links it there. Other products can then link it too, and its lines are edited on the Sub-Assemblies screen." />
            }
        </div>
    </div>

    <PackagingLinesGrid Items="ViewModel.Packaging.LineEdits" NewItem="@(ViewModel.Packaging.IsPackagingEditable ? ViewModel.Packaging.NewLineEdit : null)" Materials="ViewModel.PackagingMaterials"
                        @bind-SelectedItem="ViewModel.Packaging.SelectedLineEdit" CostHeader="Cost per Unit" ReadOnly="!ViewModel.Packaging.IsPackagingEditable" Basis="ViewModel.CostBasis" />

    <div class="lines-footer">
        @if (ViewModel.Packaging.IsPackagingLinked)
        {
            <p class="caption">Its lines are kept where it's linked from, and follow every change there. Make a Copy to change them here.</p>
            <CommandButton Command="ViewModel.CopyPackagingCommand" Icon="AppIcon.Copy" Label="Make a Copy"
                           Tooltip="Make these lines this product's own, to change them here. It stops following where it's from." />
        }
        else
        {
            <span></span>
            <CommandButton Command="ViewModel.RemoveLineCommand" CssClass="remove-line" Icon="AppIcon.Remove" Label="Remove Line" />
        }
    </div>

    <div class="add-ins bulk-packaging">
        <div class="add-ins-heading">
            <span class="group-heading">Bulk Packaging</span>
            <div class="bulk-quantity">
                <label class="form-label" for="bulk-quantity">Products per pack</label>
                <NumberField ID="bulk-quantity" TValue="int?" @bind-Value="ViewModel.Packaging.BulkQuantity" Format="N0" Min="1" CssClass="param-field"
                             Tooltip="How many products one bulk pack holds: the pack's cost is shared out among them." />
            </div>
        </div>
        <PackagingLinesGrid @ref="_bulk" Items="ViewModel.Packaging.BulkEdits" NewItem="ViewModel.Packaging.NewBulkEdit" Materials="ViewModel.PackagingMaterials"
                            @bind-SelectedItem="ViewModel.Packaging.SelectedBulkEdit" CostHeader="Cost per Pack" Basis="ViewModel.CostBasis"
                            EmptyText="No bulk packaging. Add what one bulk pack takes, such as a box several products share." />
        <div class="lines-footer">
            <p class="caption">@ViewModel.Packaging.BulkCostText</p>
            <div class="button-row">
                <ActionButton Icon="AppIcon.Add" Label="Insert Line" OnClick="() => _bulk?.InsertLineAsync() ?? Task.CompletedTask"
                              Tooltip="Puts a blank line in above the selected one, or at the bottom with none selected. Insert." />
                <CommandButton Command="ViewModel.RemoveBulkLineCommand" CssClass="remove-line" Icon="AppIcon.Remove" Label="Remove Line" />
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ProductsViewModel ViewModel { get; set; } = null!;

    private PackagingLinesGrid? _bulk;
}
