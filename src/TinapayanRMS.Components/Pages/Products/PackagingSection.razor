@* A product's packaging, on a tab every product has, with both its tables always there.
   First the packaging per piece: where it's linked from, as a tag, or a link that opens the packaging set on
   Sub-Assemblies; what its lines cost one sellable unit; Link and Copy, which open a picker of the packaging sets (and,
   to copy, the other products) in their place, ready to type into; and Move to Sub-Assemblies for lines of its own. Its
   table is typed straight into unless it's linked, with Make a Copy and Remove Link under a linked one, and while it has
   no lines a caption says what to add (a table's own empty text shows only without an add row). Then its bulk packaging:
   what one bulk pack takes (a box several units share, its tape), typed in or a packaging set it links (Link opens a
   picker of the sets in its place, and a linked one has Make a Copy and Remove Link under it), and in a box of its own
   how many products the pack holds, which share out its cost. *@
<div class="section-view">
    <div class="section-heading">
        <div class="usage-badges">
            <span class="group-heading">Packaging per Piece</span>
            @if (State.Packaging.IsPackagingLinkedToProduct)
            {
                <span class="badge badge-warning">@State.Packaging.PackagingLinkedToText</span>
            }
            @if (State.Packaging.IsPackagingLinkedToSet && State.Packaging.PackagingLinkedSetId is { } setId)
            {
                <button type="button" class="badge badge-link" @onclick="() => Commands.Run(State.OpenSubAssemblyCommand, setId)" title="Open the packaging set on the Sub-Assemblies screen">
                    @State.Packaging.PackagingLinkedToText
                </button>
            }
            @if (State.Packaging.IsPackagingMoving)
            {
                <span class="badge badge-warning" title="Save makes these lines a packaging set on Sub-Assemblies, linked here. Undo or Revert to keep them here.">Moves to Sub-Assemblies on Save</span>
            }
            @if (State.Packaging.IsPickingSource)
            {
                <PickField ID="packaging-source" TItem="LinkableSubAssemblyOption" Items="State.Packaging.SourceOptions" TextField="PackagingSourceName"
                           Value="State.Packaging.PickedSource" ValueChanged="State.Packaging.PickSource" Placeholder="@State.Packaging.SourcePlaceholder" CssClass="packaging-source"
                           OpenOnShow="true" PopupWidth="420px"
                           Tooltip="@(State.Packaging.SourceMode == PackagingSourceMode.Copy
                               ? "Its lines replace these, as this product's own to change."
                               : "Its lines replace these, read-only, and follow the set.")" />
                <CommandButton Command="State.Packaging.CancelPickingCommand" Icon="AppIcon.Cancel" Flat="true" Tooltip="Keep the packaging as it is" />
            }
        </div>
        <div class="lines-footer-right">
            <span class="caption" title="These lines' cost per sellable unit. Bulk packaging has its own table; the Costing tab's Packaging holds both.">@State.Costing.CostUnitCaption · @State.Packaging.LinesCost.ToString("N2")</span>
            @if (!State.Packaging.IsPickingSource)
            {
                <CommandButton Command="State.Packaging.StartLinkingCommand" Icon="AppIcon.Link" Label="Link"
                               Tooltip="Link a packaging set from Sub-Assemblies in place of these lines. It shows read-only and follows the set." />
                <CommandButton Command="State.Packaging.StartCopyingCommand" Icon="AppIcon.Copy" Label="Copy"
                               Tooltip="Copy lines from a packaging set or another product, as this product's own to change." />
            }
            @if (State.Packaging.CanMovePackaging && State.Packaging.LineEdits.Count > 0)
            {
                <CommandButton Command="State.Packaging.MoveToSubAssembliesCommand" Icon="AppIcon.Link" Label="Move to Sub-Assemblies"
                               Tooltip="Save makes these lines a packaging set on Sub-Assemblies, linked here, so other products can link it too." />
            }
        </div>
    </div>

    <PackagingLinesGrid @ref="_lines" Items="State.Packaging.LineEdits" NewItem="@(State.Packaging.IsPackagingEditable ? State.Packaging.NewLineEdit : null)" Materials="State.PackagingMaterials"
                        @bind-SelectedItem="State.Packaging.SelectedLineEdit" CostHeader="Cost per Unit" ReadOnly="!State.Packaging.IsPackagingEditable" Basis="State.Costing.CostBasis" />

    <div class="lines-footer">
        @if (State.Packaging.IsPackagingLinked)
        {
            <p class="caption">Its lines are kept where it's linked from, and follow every change there. Make a Copy to change them here.</p>
            <div class="button-row">
                <CommandButton Command="State.Packaging.MakeCopyCommand" Icon="AppIcon.Copy" Label="Make a Copy"
                               Tooltip="Make these lines this product's own to change here. They stop following their source." />
                <CommandButton Command="State.Packaging.RemoveLinkCommand" Icon="AppIcon.Unlink" Label="Remove Link"
                               Tooltip="Remove the link and its lines. The packaging set stays on Sub-Assemblies." />
            </div>
        }
        else
        {
            if (State.Packaging.LineEdits.Count == 0)
            {
                <p class="caption">No packaging per piece. Add what one piece takes, such as its bag and label, or Link a packaging set.</p>
            }
            else
            {
                <span></span>
            }
            <div class="button-row">
                <ActionButton Icon="AppIcon.Add" Label="Insert Line" OnClick="() => _lines?.InsertLineAsync() ?? Task.CompletedTask"
                              Tooltip="Adds a blank line above the selected one, or at the end. Insert." />
                <CommandButton Command="State.Packaging.RemoveLineCommand" CssClass="remove-line" Icon="AppIcon.Remove" Label="Remove Line" />
            </div>
        }
    </div>

    <div class="add-ins bulk-packaging">
        <div class="add-ins-heading">
            <div class="usage-badges">
                <span class="group-heading">Bulk Packaging</span>
                @if (State.Packaging.IsBulkLinked && State.Packaging.BulkLinkedSetId is { } bulkSetId)
                {
                    <button type="button" class="badge badge-link" @onclick="() => Commands.Run(State.OpenSubAssemblyCommand, bulkSetId)" title="Open the packaging set on the Sub-Assemblies screen">
                        @State.Packaging.BulkLinkedToText
                    </button>
                }
                @if (State.Packaging.IsPickingBulkSource)
                {
                    <PickField ID="bulk-packaging-source" TItem="LinkableSubAssemblyOption" Items="State.Packaging.SourceOptions" TextField="PackagingSourceName"
                               Value="State.Packaging.PickedSource" ValueChanged="State.Packaging.PickSource" Placeholder="@State.Packaging.SourcePlaceholder" CssClass="packaging-source"
                               OpenOnShow="true" PopupWidth="420px"
                               Tooltip="Its lines replace these as one bulk pack's packaging, read-only, and follow the set." />
                    <CommandButton Command="State.Packaging.CancelPickingCommand" Icon="AppIcon.Cancel" Flat="true" Tooltip="Keep the bulk packaging as it is" />
                }
            </div>
            <div class="lines-footer-right">
                @if (!State.Packaging.IsPickingBulkSource)
                {
                    <CommandButton Command="State.Packaging.StartLinkingBulkCommand" Icon="AppIcon.Link" Label="Link"
                                   Tooltip="Link a packaging set from Sub-Assemblies as one bulk pack's packaging. It shows read-only and follows the set." />
                }
                <div class="bulk-quantity">
                    <label class="form-label" for="bulk-quantity">Products per pack</label>
                    <NumberField ID="bulk-quantity" TValue="int?" @bind-Value="State.Packaging.BulkQuantity" Format="N0" Min="1" CssClass="param-field"
                                 Tooltip="How many products one bulk pack holds; they share its cost." />
                </div>
            </div>
        </div>
        <PackagingLinesGrid @ref="_bulk" Items="State.Packaging.BulkEdits" NewItem="@(State.Packaging.IsBulkEditable ? State.Packaging.NewBulkEdit : null)" Materials="State.PackagingMaterials"
                            @bind-SelectedItem="State.Packaging.SelectedBulkEdit" CostHeader="Cost per Pack" ReadOnly="!State.Packaging.IsBulkEditable" Basis="State.Costing.CostBasis" />
        <div class="lines-footer">
            <p class="caption">@State.Packaging.BulkCostText</p>
            <div class="button-row">
                @if (State.Packaging.IsBulkLinked)
                {
                    <CommandButton Command="State.Packaging.MakeBulkCopyCommand" Icon="AppIcon.Copy" Label="Make a Copy"
                                   Tooltip="Make these lines this product's own to change here. They stop following the set." />
                    <CommandButton Command="State.Packaging.RemoveBulkLinkCommand" Icon="AppIcon.Unlink" Label="Remove Link"
                                   Tooltip="Remove the link and its lines, leaving no bulk packaging. The set stays on Sub-Assemblies." />
                }
                else
                {
                    <ActionButton Icon="AppIcon.Add" Label="Insert Line" OnClick="() => _bulk?.InsertLineAsync() ?? Task.CompletedTask"
                                  Tooltip="Adds a blank line above the selected one, or at the end. Insert." />
                    <CommandButton Command="State.Packaging.RemoveBulkLineCommand" CssClass="remove-line" Icon="AppIcon.Remove" Label="Remove Line" />
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ProductForm State { get; set; } = null!;

    private PackagingLinesGrid? _lines;
    private PackagingLinesGrid? _bulk;
}
