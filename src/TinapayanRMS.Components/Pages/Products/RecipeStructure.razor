@* A product's Recipe Structure: a tab per section (a composite's Products first, then its
   sub-assemblies, one while a sub-assembly is being added, and Packaging, always), with Add Sub-Assembly's
   three ways in and Delete Sub-Assembly. Under the tabs, the form for the tab showing. The strip and the heading stay
   put while the form under them scrolls. *@
<div class="recipe-structure">
    <div class="recipe-heading">
        <h2 class="panel-header">Recipe Structure</h2>
        <div class="button-row">
            <MenuButton CssClass="e-outline" Tooltip="Make a new sub-assembly, or link or copy an existing one, in a tab of its own">
                <Face><Icon Of="AppIcon.Add" /> <span class="command-label">Add Sub-Assembly</span></Face>
                <ChildContent>
                    <ActionButton Icon="AppIcon.Add" Label="New sub-assembly" Flat="true" OnClick="() => Commands.Run(State.Recipe.AddUsageCommand, UsageFormMode.New)"
                                  Tooltip="Type its lines here. Save keeps it with this product in a product-owned role, otherwise on Sub-Assemblies, linked." />
                    <ActionButton Icon="AppIcon.Link" Label="Link an existing one" Flat="true" OnClick="() => Commands.Run(State.Recipe.AddUsageCommand, UsageFormMode.Link)"
                                  Tooltip="Link one from Sub-Assemblies; it follows its changes. Another product's own can only be copied." />
                    <ActionButton Icon="AppIcon.Copy" Label="Copy an existing one" Flat="true" OnClick="() => Commands.Run(State.Recipe.AddUsageCommand, UsageFormMode.Copy)"
                                  Tooltip="Start from an existing one's lines and role. Save keeps it as a new one, named after this product." />
                </ChildContent>
            </MenuButton>
            <CommandButton Command="State.Recipe.RemoveUsageCommand" Icon="AppIcon.Delete" Label="Delete Sub-Assembly"
                           Tooltip="Remove the sub-assembly showing, on Save. This product's own is deleted; a linked one stays on Sub-Assemblies." />
        </div>
    </div>

    @if (!State.Recipe.HasRecipeSections)
    {
        <p class="caption">Nothing in the recipe yet. Add Sub-Assembly adds a section — a new one, or one linked or copied. Packaging is typed, linked or copied on the Packaging tab.</p>
    }

    <div class="recipe-tabs" role="tablist">
        @foreach (var tab in State.Recipe.RecipeTabs)
        {
            var recipeTab = tab;
            <button type="button" role="tab" class="recipe-tab @(ReferenceEquals(recipeTab, State.Recipe.SelectedRecipeTab) ? "active" : "")"
                    aria-selected="@(ReferenceEquals(recipeTab, State.Recipe.SelectedRecipeTab) ? "true" : "false")"
                    @onclick="() => State.Recipe.PickRecipeTab(recipeTab)">
                <Icon Of="recipeTab.Icon" />
                <span>@recipeTab.Header</span>
            </button>
        }
    </div>

    <div class="recipe-form">
        @if (State.Recipe.IsUsageFormShowing)
        {
            <UsageForm State="State" />
        }
        @if (State.Recipe.IsPackagingShowing)
        {
            <PackagingSection State="State" />
        }
        @if (State.Recipe.IsComponentsShowing)
        {
            <ComponentsSection State="State" />
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ProductForm State { get; set; } = null!;
}
