@* Products' list (the WPF ProductListCard): a search box; the list's commands as icons, and the category filter; the
   products in a folder for their stage (Production, Innovation), then in the user's own folders, as deep as they go, as
   in a file explorer; the deleted ones in a Deleted folder at the end; and what the last move did, with Undo. A folder
   isn't a category: the filter finds a category's products wherever they're filed. Dragging products, or one folder,
   onto a folder moves them there, saved at once, the list scrolling as the pointer nears its top or bottom; so do Cut
   (Ctrl+X) and Paste (Ctrl+V) on a folder, the rows cut faded till then. A deleted product only comes back by Restore,
   from its menu. A name is
   typed in place (TreeNameEdit): a product or folder renamed, or a new product or folder named. *@
<section class="card list-card tree-card">
    <div class="list-heading">
        <h2 class="section-header">Products</h2>
        @* Not one of the form's boxes: it keeps the cursor, and what's typed, when another record takes the form. *@
        <CascadingValue TValue="IUndoRecorder" Value="null" IsFixed="true">
            <TextField @bind-Value="List.SearchText" Placeholder="Search products" CssClass="list-search" />
        </CascadingValue>
    </div>

    <div class="list-toolbar">
        <ActionButton Icon="AppIcon.Add" Tooltip="New Product" Flat="true" OnClick="() => Commands.Run(List.NewProductInCommand, null)" />
        <ActionButton Icon="AppIcon.Composite" Tooltip="New Composite Product" Flat="true" OnClick="() => Commands.Run(List.NewCompositeProductInCommand, null)" />
        <ActionButton Icon="AppIcon.NewFolder" Tooltip="New Folder" Flat="true" OnClick="() => Commands.Run(List.NewFolderCommand, null)" />
        <CommandButton Command="List.PrintAllCommand" Icon="AppIcon.Print" Tooltip="Print All Products" Flat="true" />
        <ActionButton Icon="AppIcon.ExpandAll" Tooltip="Expand All" Flat="true" OnClick="() => Commands.Run(List.ExpandAllCommand, null)" />
        <ActionButton Icon="AppIcon.CollapseAll" Tooltip="Collapse All" Flat="true" OnClick="() => Commands.Run(List.CollapseAllCommand, null)" />
    </div>

    @* A row of its own, so "All categories" and a long category's name show whole. Not one of the form's boxes either:
       picking a category changes nothing to save. *@
    <div class="list-filter-row">
        <CascadingValue TValue="IUndoRecorder" Value="null" IsFixed="true">
            <PickField ID="product-category-filter" TItem="ProductCategoryFilter" Items="List.CategoryFilters" TextField="Label"
                       @bind-Value="List.CategoryFilter" CssClass="list-filter"
                       Tooltip="Show only one category's products, in their folders" />
        </CascadingValue>
    </div>

    <FolderTree TNode="ProductTreeNode"
                Roots="List.ProductTree.Roots"
                ChildrenOf="n => n is ProductFolderNode folder ? folder.Children : null"
                IsExpanded="n => n is ProductFolderNode { IsExpanded: true }"
                SetExpanded="(n, open) => { if (n is ProductFolderNode folder) folder.IsExpanded = open; }"
                Selected="List.SelectedTreeNodes"
                KeyOf="KeyOf"
                RowClass="RowClass"
                CanDrag="n => Screen.CanDrag(n)"
                IsEditing="IsEditing"
                RenamesOnSecondClick="n => n is ProductLeafNode { IsDeleted: false, IsNew: false }"
                CanDrop="(dragged, target) => Screen.CanDrop(dragged, target)"
                OnDrop="(dragged, target) => Screen.DropAsync(dragged, target)"
                MenuFor="List.TreeMenuFor"
                Shortcut="List.TreeShortcut">
        <RowTemplate Context="node">
            @if (node.IsFolder)
            {
                <span class="@AppIcons.CssOf(node.Icon!.Value) tree-glyph" aria-hidden="true"></span>
            }
            @if (List.TreeNameEdit is { } edit && ReferenceEquals(edit.Node, node))
            {
                @* Keyed by the edit: a name refused comes back as a new one, and a new box. *@
                <TreeNameBox @key="edit" InitialText="@edit.InitialText" Hint="@edit.Hint"
                             OnCommit="List.CommitTreeNameAsync" OnCancel="List.CancelTreeName" />
            }
            else
            {
                <span class="tree-title">@node.Title</span>
                @if (node.IsBelowTargetMarkup)
                {
                    <span class="@AppIcons.CssOf(AppIcon.Warning) tree-flag" title="Its current price earns less than its target markup" aria-label="Short of its target markup"></span>
                }
                @if (node.IsFolder)
                {
                    <span class="tree-count">(@node.ProductCount)</span>
                }
            }
        </RowTemplate>
    </FolderTree>

    <MoveNoticeBar Notice="@List.MoveNotice" UndoCommand="List.UndoMoveCommand" DismissCommand="List.DismissMoveNoticeCommand" />
</section>

@code {
    [Parameter, EditorRequired] public ProductsList List { get; set; } = null!;

    private static string KeyOf(ProductTreeNode node) => node switch
    {
        ProductFolderNode folder => "folder-" + folder.Key,
        ProductLeafNode leaf => "product-" + leaf.Product.Id,
        _ => node.Title,
    };

    private string? RowClass(ProductTreeNode node)
    {
        var kind = node switch
        {
            { IsTopLevel: true } => "top-level",
            ProductLeafNode { IsDeleted: true } => "deleted",
            _ => null,
        };

        // Cut (Ctrl+X) and waiting to be pasted: faded, as in File Explorer.
        return List.CutNodes.Contains(node) ? (kind is null ? "cut" : kind + " cut") : kind;
    }

    private bool IsEditing(ProductTreeNode node) => ReferenceEquals(List.TreeNameEdit?.Node, node);

    // What can be dragged and dropped where is the list's to say (IListTreeScreen), as its tests check it.
    private IListTreeScreen Screen => List;
}
