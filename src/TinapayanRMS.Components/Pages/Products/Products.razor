@page "/products"
@page "/products/{Id:int}"
@page "/products/new/{Number:int}"
@inherits RecordViewBase<ProductsState, ProductForm>
@inject Prompts Prompts

<PageTitle>@(State!.Form?.SelectedProduct?.Name ?? "Products") · TinapayanRMS</PageTitle>

@* The Products view: every product, the list by stage and folder, beside a strip of tabs, a product open in each, as Visual
   Studio Code's editors are; under it, the form of the tab showing (ProductFormView), drawn afresh as another tab shows,
   each keeping what's typed into it. A product picked in the list opens in the preview tab, which the next one picked
   replaces while it holds nothing unsaved. *@
<div class="record-screen">
    <ProductsListCard List="State!.List" />

    <div class="record-details">
        <RecordTabStrip TForm="ProductForm" Tabs="State!.Tabs" AddressOf="AddressOf" Close="CloseTabAsync" Keep="State!.Keep" Label="Products open" />

        @if (State!.Form is { } form)
        {
            <ProductFormView @key="form" Form="form" />
        }
        else
        {
            <section class="card empty-record">
                <p>No product is open. Pick one in the list, or start a new one.</p>
                <CommandButton Command="State!.NewCommand" Icon="AppIcon.Add" Label="New" />
            </section>
        }
    </div>
</div>

@code {
    protected override ScreenCommand LoadCommand => State!.LoadCommand;

    protected override string AddressRoot => "products";

    protected override void OnInitialized()
    {
        base.OnInitialized();

        // A name asked for by the list's menu: a clone's or a variant's. The list names everything else in place.
        AddSubscription(State!.List.PromptForName.RegisterHandler(async interaction =>
            interaction.SetOutput(await Prompts.AskAsync(interaction.Input))));
    }
}
