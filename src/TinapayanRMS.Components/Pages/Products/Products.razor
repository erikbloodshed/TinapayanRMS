@page "/products"
@page "/products/{Id:int}"
@inherits RecordScreenBase<ProductsViewModel>
@inject Prompts Prompts

<PageTitle>@(ViewModel!.SelectedProduct?.Name ?? "Products") · TinapayanRMS</PageTitle>

<UndoKeys Screen="ViewModel!" Redraw="RedrawNowAsync" />

@* The Products screen (the WPF ProductsView): the list beside the picked product's header and its tabs along the bottom.
   Every tab but Clone and History is part of the one form Save writes. Clone and History only apply to a saved
   product. Between
   picking a product and its details arriving, the tabs ignore the mouse (AreDetailsReady). Each product has its own
   address, so the browser's Back and Forward step between the products opened. *@
<CascadingValue Value="(IUndoRecorder)ViewModel!" IsFixed="true">
    <div class="record-screen">
        <ProductList ViewModel="ViewModel!" />

        <div class="record-details">
            <ProductHeader ViewModel="ViewModel!" />

            <section class="card tabs-card @(ViewModel!.AreDetailsReady ? "" : "details-pending")">
                <SfTab @bind-SelectedItem="ViewModel!.SelectedDetailsTab" HeaderPlacement="HeaderPosition.Bottom" LoadOn="ContentLoad.Init" CssClass="details-tabs">
                    <TabItems>
                        <TabItem>
                            <ChildContent><TabHeader Text="Recipe" /></ChildContent>
                            <ContentTemplate><RecipeStructure ViewModel="ViewModel!" /></ContentTemplate>
                        </TabItem>
                        <TabItem>
                            <ChildContent><TabHeader Text="Costing" /></ChildContent>
                            <ContentTemplate><Costing ViewModel="ViewModel!" /></ContentTemplate>
                        </TabItem>
                        <TabItem Visible="ViewModel!.ShowLinks">
                            <ChildContent><TabHeader Text="Clone" /></ChildContent>
                            <ContentTemplate>
                                <div class="tab-card narrow-card">
                                    <h2 class="panel-header">Clone This Product</h2>
                                    <FormRow Label="New Product Name" For="clone-name">
                                        <TextField ID="clone-name" @bind-Value="ViewModel!.EditingCloneName" />
                                    </FormRow>
                                    <div class="button-row">
                                        <CommandButton Command="ViewModel!.CloneCommand" Icon="AppIcon.Copy" Label="Clone" />
                                        <CommandButton Command="ViewModel!.CreateVariantCommand" Icon="AppIcon.Link" Label="Create Variant" />
                                    </div>
                                    <p class="caption form-extra">Clone links the same sub-assemblies from the Sub-Assemblies screen and copies this product's own, and its packaging. Create Variant links every sub-assembly this product uses, its own included, so the new product follows every change made to them, and gets no packaging: give it its own. Both start in Innovation.</p>
                                </div>
                            </ContentTemplate>
                        </TabItem>
                        <TabItem Visible="ViewModel!.ShowLinks">
                            <ChildContent><TabHeader Text="History" /></ChildContent>
                            <ContentTemplate><History ViewModel="ViewModel!" /></ContentTemplate>
                        </TabItem>
                    </TabItems>
                </SfTab>
            </section>
        </div>
    </div>
</CascadingValue>

@code {
    protected override ReactiveCommand<RxVoid, RxVoid> LoadCommand => ViewModel!.LoadCommand;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        var viewModel = ViewModel!;

        // A name typed into the Category picker that isn't a category yet: asks whether to add it, starting with the name.
        AddSubscription(viewModel.PromptForNewCategory.RegisterHandler(async interaction =>
            interaction.SetOutput(await Prompts.AskAsync(new TextPromptRequest("New Category", "Name", interaction.Input, $"“{interaction.Input}” isn't a category yet. Add it?")))));

        // A name asked for by the list's menu: a clone's or a variant's. The list names everything else in place.
        AddSubscription(viewModel.PromptForName.RegisterHandler(async interaction =>
            interaction.SetOutput(await Prompts.AskAsync(interaction.Input))));

        // Move to In-House: the made ingredient's name and the Made category it goes in.
        AddSubscription(viewModel.PromptForMadeIngredient.RegisterHandler(async interaction =>
            interaction.SetOutput(await Prompts.AskChoiceAsync(interaction.Input))));
    }

    protected override string AddressRoot => "products";

    protected override int? ShownId => ViewModel!.SelectedProduct?.Id;

    protected override string ShownProperty => nameof(ProductsViewModel.SelectedProduct);

    protected override void Open(int id) => ViewModel!.OpenProduct(id);

    protected override void OpenOnLoad(int id) => ViewModel!.OpenProductOnLoad(id);

    // Print prints the product as this screen shows it, unsaved edits and all, so going there asks nothing.
    protected override bool KeepsForm(string path) => path.Equals("print", StringComparison.OrdinalIgnoreCase);
}
