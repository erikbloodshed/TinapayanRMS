@* A product's Scaling tab (the WPF ScalingCard): the recipe worked out for a number of sellable units, which isn't
   saved. Each section is made in whole batches; a made ingredient opens into what it's made from. Every row is open.
   From What You Have works the other way: how many units an amount of one ingredient makes. *@
<div class="scaling">
    <div class="scaling-heading">
        <label class="form-label" for="scaling-units">Sellable Units</label>
        <NumberField ID="scaling-units" TValue="int" @bind-Value="ViewModel.Scaling.Units" Format="N0" Min="1" CssClass="field-narrow"
                     Tooltip="How many to make: boxes for a Box of 8, pieces for a product sold by the piece. Only for this tab: it isn't saved." />
        <span class="caption">@ViewModel.Scaling.PiecesText</span>
        <span class="scaling-total">Total Cost <strong>@ViewModel.Scaling.TotalCost.ToString("N2")</strong></span>
    </div>
    <div class="scaling-have">
        <label class="form-label" for="scaling-have-ingredient">From What You Have</label>
        <PickField ID="scaling-have-ingredient" TItem="RawMaterial" Items="ViewModel.Scaling.Ingredients" TextField="Name" AllowEmpty="true"
                   Value="ViewModel.Scaling.HaveIngredient" ValueChanged="m => ViewModel.Scaling.HaveIngredient = m" Placeholder="Ingredient"
                   Tooltip="An ingredient there's only so much of: the tab works out how many it makes." CssClass="field-wide" />
        <NumberField TValue="decimal?" Value="ViewModel.Scaling.HaveAmount" ValueChanged="v => ViewModel.Scaling.HaveAmount = v" Format="N2" Min="0"
                     Placeholder="Amount" CssClass="field-narrow" />
        <PickField TItem="IngredientAmountUnit" Items="ViewModel.Scaling.HaveUnits" TextOf="u => u.Name"
                   Value="ViewModel.Scaling.HaveUnit" ValueChanged="u => ViewModel.Scaling.HaveUnit = u" Tooltip="Grams, or one of the ingredient's own units." CssClass="field-narrow" />
        @if (ViewModel.Scaling.HasHaveMakes)
        {
            <CommandButton Command="ViewModel.Scaling.ScaleToHaveCommand" Glyph="@Glyphs.Apply" Label="@ViewModel.Scaling.ScaleToHaveLabel" Tooltip="Puts this in Sellable Units, so the table shows it." />
        }
        <span class="caption">@ViewModel.Scaling.HaveText</span>
    </div>
    <p class="caption">Each section is made in whole batches, so the amounts and the total cost include the extra pieces. A made ingredient opens into what it's made from.</p>

    <div class="scaling-table">
        <table class="line-grid tree-grid">
            <thead>
                <tr>
                    <th>Item</th>
                    <th class="col-number">Amount</th>
                    <th class="col-number">Cost</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in ViewModel.Scaling.Rows)
                {
                    @RenderRow(row, 0)
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ProductsViewModel ViewModel { get; set; } = null!;

    private RenderFragment RenderRow(ScalingRow row, int depth) => @<text>
        <tr class="@(row.IsGroup ? "group-row" : "")">
            <td class="cell-text" style="padding-left:@(8 + depth * 20)px">
                <span class="scaling-name">@row.Name</span>
                @if (!string.IsNullOrEmpty(row.Detail))
                {
                    <span class="muted scaling-detail">@row.Detail</span>
                }
            </td>
            <td class="cell-number">@row.AmountText</td>
            <td class="cell-number">@row.Cost.ToString("N2")</td>
        </tr>
        @foreach (var child in row.Children)
        {
            @RenderRow(child, depth + 1)
        }
    </text>;
}
