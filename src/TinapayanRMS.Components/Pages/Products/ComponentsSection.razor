@* A composite product's Products tab: the products it holds and how many of each, each
   bringing its recipe cost and, when ticked, its own packaging's too. *@
<div class="section-view">
    <div class="section-heading">
        <p class="caption">@State.ComponentsTable.Caption</p>
        <span class="caption">@State.Costing.CostUnitCaption · @State.ComponentsTable.ComponentsCost.ToString("N2")</span>
    </div>

    <LineGrid TRow="ProductComponentRow" Items="State.ComponentsTable.ComponentEdits" NewItem="State.ComponentsTable.NewComponentRow" IsBlank="r => r.IsBlank" @bind-SelectedItem="State.ComponentsTable.SelectedComponentEdit" Reorderable="true">
        <Header>
            <th>Product</th>
            <th class="col-number col-qty">Qty</th>
            <th class="col-number">Recipe Cost</th>
            @if (State.ComponentsTable.IncludesPackaging)
            {
                <th class="col-number">Packaging Cost</th>
            }
            <th class="col-number">Cost</th>
        </Header>
        <Row Context="row">
            <td>
                <PickField TItem="Product" Items="State.ComponentsTable.ComponentProductOptions" TextField="Name" CssClass="cell-field" Deferred="true" PopupWidth="420px"
                           Value="row.Product" ValueChanged="p => row.ComponentProductId = p?.Id">
                    <ItemTemplate Context="product"><span class="pick-columns"><span>@product.Name</span><span class="muted">@product.Category?.Name</span></span></ItemTemplate>
                </PickField>
            </td>
            <td><NumberField TValue="int?" Value="row.Quantity" ValueChanged="v => row.Quantity = v" Format="N0" Min="0" CssClass="cell-field" /></td>
            <td class="cell-number">@row.RecipeCost?.ToString("N2")</td>
            @if (State.ComponentsTable.IncludesPackaging)
            {
                <td class="cell-number">@row.PackagingCost?.ToString("N2")</td>
            }
            <td class="cell-number">@row.Cost.ToString("N2")</td>
        </Row>
    </LineGrid>

    <div class="lines-footer">
        <SfCheckBox Label="Include each product's packaging" @bind-Checked="State.ComponentsTable.IsPackagingTicked"
                    title="Each product's packaging, times its quantity, adds to Packaging on the Costing tab, with no labor, overhead or admin on it." />
        <CommandButton Command="State.ComponentsTable.RemoveLineCommand" CssClass="remove-line" Icon="AppIcon.Remove" Label="Remove Line" />
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ProductForm State { get; set; } = null!;
}
