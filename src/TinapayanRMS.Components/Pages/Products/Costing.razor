@* A product's Costing tab: on the left, the four costing metrics, each as a percentage and the
   amount it comes to, either of which can be typed, with its share of the price under it; on the right the Costing
   Summary, from the parts and their wastage through labor, overhead and administrative to the base cost, each with its
   share of the price; under it, in the same table so its columns line up with the breakdown's, the suggested selling
   price beside the current store price, each as its markup, VAT and price (the markup one row, each price's percentage
   before its amount, as "(30.0%) 30.00"), the suggested one also rounded up as Settings → Costing Defaults → Price Rounding says. *@
<div class="costing">
    <div class="costing-heading">
        <h2 class="panel-header">Costing Summary</h2>
        <CommandButton Command="State.ExportCostingCommand" Icon="AppIcon.ExportToExcel" Label="Export to Excel"
                       Tooltip="Saves the costing and recipe to Excel as shown, unsaved changes included." />
    </div>
    <div class="costing-columns">
        <div class="costing-metrics">
            <div class="cost-tile cost-labor">
                <label class="form-label" for="cost-labor" data-title="@State.Costing.MetricBaseTooltip">Labor Metric</label>
                <NumberField ID="cost-labor" TValue="decimal" @bind-Value="State.Costing.EditingLaborPercent" Format="N1" Min="0" Suffix="%" />
                <NumberField TValue="decimal" @bind-Value="State.Costing.EditingLaborAmount" Format="N2" Min="0" Tooltip="@($"The labor cost, {State.Costing.CostUnitCaption}. Typing it sets the percentage.")" />
                <span class="tile-caption">@State.Costing.Costs.LaborShare.ToString("N1")% of the price</span>
            </div>
            <div class="cost-tile cost-overhead">
                <label class="form-label" for="cost-overhead" data-title="@State.Costing.MetricBaseTooltip">Overhead Metric</label>
                <NumberField ID="cost-overhead" TValue="decimal" @bind-Value="State.Costing.EditingOverheadPercent" Format="N1" Min="0" Suffix="%" />
                <NumberField TValue="decimal" @bind-Value="State.Costing.EditingOverheadAmount" Format="N2" Min="0" Tooltip="@($"The overhead cost, {State.Costing.CostUnitCaption}. Typing it sets the percentage.")" />
                <span class="tile-caption">@State.Costing.Costs.OverheadShare.ToString("N1")% of the price</span>
            </div>
            <div class="cost-tile cost-administrative">
                <label class="form-label" for="cost-administrative" data-title="@($"Administrative: office, permits, bookkeeping. {State.Costing.MetricBaseTooltip}")">Admin Metric</label>
                <NumberField ID="cost-administrative" TValue="decimal" @bind-Value="State.Costing.EditingAdministrativePercent" Format="N1" Min="0" Suffix="%" />
                <NumberField TValue="decimal" @bind-Value="State.Costing.EditingAdministrativeAmount" Format="N2" Min="0" Tooltip="@($"The administrative cost, {State.Costing.CostUnitCaption}. Typing it sets the percentage.")" />
                <span class="tile-caption">@State.Costing.Costs.AdministrativeShare.ToString("N1")% of the price</span>
            </div>
            <div class="cost-tile cost-markup">
                <label class="form-label" for="cost-markup" data-title="On the base cost: materials, wastage, labor, overhead and administrative">Markup Metric</label>
                <NumberField ID="cost-markup" TValue="decimal" @bind-Value="State.Costing.EditingMarkupPercent" Format="N1" Min="0" Suffix="%" />
                <NumberField TValue="decimal" @bind-Value="State.Costing.EditingMarkupAmount" Format="N2" Min="0" Tooltip="@($"The markup, {State.Costing.CostUnitCaption}, before VAT. Typing it sets the percentage.")" />
                <span class="tile-caption">@State.Costing.Costs.MarkupShare.ToString("N1")% of the price</span>
            </div>
        </div>

        <table class="cost-summary">
            <thead>
                <tr>
                    <th>Component</th>
                    <th class="number">@State.Costing.CostUnitCaption</th>
                    <th class="number">% of Price</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>@State.Costing.Costs.PartsTitle</td>
                    <td class="number">@State.Costing.Costs.SubAssemblies.ToString("N2")</td>
                    <td class="number share">@State.Costing.Costs.SubAssembliesShare.ToString("N1")%</td>
                </tr>
                @foreach (var line in State.Costing.Costs.SubAssemblyLines)
                {
                    <tr class="part-row">
                        <td>@line.Name</td>
                        <td class="number">@line.Cost.ToString("N2")</td>
                        <td class="number">@line.Share.ToString("N1")%</td>
                    </tr>
                }
                <tr data-title="What's lost in making, as a cost: the category's Wastage %, or else the shop's (Settings → Costing Defaults).">
                    <td>Wastage (@State.Costing.Costs.WastagePercent.ToString("0.##")% of @State.Costing.Costs.PartsBase)</td>
                    <td class="number">@State.Costing.Costs.Wastage.ToString("N2")</td>
                    <td class="number share">@State.Costing.Costs.WastageShare.ToString("N1")%</td>
                </tr>
                <tr>
                    <td>@State.Costing.Costs.PackagingTitle</td>
                    <td class="number">@State.Costing.Costs.Packaging.ToString("N2")</td>
                    <td class="number share">@State.Costing.Costs.PackagingShare.ToString("N1")%</td>
                </tr>
                <tr>
                    <td>Labor (@State.Costing.Costs.LaborPercent.ToString("0.##")% of @State.Costing.Costs.PartsBase)</td>
                    <td class="number">@State.Costing.Costs.Labor.ToString("N2")</td>
                    <td class="number share">@State.Costing.Costs.LaborShare.ToString("N1")%</td>
                </tr>
                <tr>
                    <td>Overhead (@State.Costing.Costs.OverheadPercent.ToString("0.##")% of @State.Costing.Costs.PartsBase)</td>
                    <td class="number">@State.Costing.Costs.Overhead.ToString("N2")</td>
                    <td class="number share">@State.Costing.Costs.OverheadShare.ToString("N1")%</td>
                </tr>
                <tr>
                    <td>Administrative (@State.Costing.Costs.AdministrativePercent.ToString("0.##")% of @State.Costing.Costs.PartsBase)</td>
                    <td class="number">@State.Costing.Costs.Administrative.ToString("N2")</td>
                    <td class="number share">@State.Costing.Costs.AdministrativeShare.ToString("N1")%</td>
                </tr>
                <tr class="subtotal-row">
                    <td>Subtotal (base cost)</td>
                    <td class="number">@State.Costing.Costs.BaseCost.ToString("N2")</td>
                    <td class="number share">@State.Costing.Costs.BaseCostShare.ToString("N1")%</td>
                </tr>
            </tbody>
            <tbody class="price-comparison">
                <tr class="section-gap"><td colspan="3"></td></tr>
                <tr class="price-heading">
                    <th>Component</th>
                    <th class="number" data-title="@($"{State.Costing.SuggestedSellingPriceLabel}: the base cost plus the Markup Metric, then VAT")">Suggested Price</th>
                    <th class="number" data-title="@CurrentPriceTooltip">Current Price</th>
                </tr>
                <tr>
                    <td>Markup</td>
                    <td class="number"><span class="percent">@PercentBefore(Costs.MarkupPercent)</span>@Costs.Markup.ToString("N2")</td>
                    <td class="number @CurrentMarkupClass" data-title="@CurrentMarkupTooltip">
                        @if (Costs.CurrentMarkup is { } currentMarkup)
                        {
                            @if (Costs.CurrentMarkupPercent is { } percent)
                            {
                                <span class="percent">@PercentBefore(percent)</span>
                            }
                            @currentMarkup.ToString("N2")
                        }
                        else
                        {
                            @("—")
                        }
                    </td>
                </tr>
                <tr>
                    <td>VAT (@Costs.VatPercent.ToString("0.##")%)</td>
                    <td class="number">@Costs.Vat.ToString("N2")</td>
                    <td class="number">@(Costs.CurrentVat?.ToString("N2") ?? "—")</td>
                </tr>
                <tr class="total-row">
                    <td>Selling price</td>
                    <td class="number">@Costs.SellingPrice.ToString("N2")</td>
                    <td class="number">@(Costs.CurrentPrice?.ToString("N2") ?? "—")</td>
                </tr>
                @if (Costs.HasPriceRounding)
                {
                    <tr class="rounded-row">
                        <td>@Costs.PriceRoundingLabel</td>
                        <td class="number">@Costs.RoundedSellingPrice.ToString("N2")</td>
                        <td></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ProductForm State { get; set; } = null!;

    private ProductCostSummary Costs => State.Costing.Costs;

    private string CurrentPriceTooltip => Costs.CurrentPrice is null
        ? $"No current price yet: type what the shop charges, {State.Costing.CostUnitCaption.ToLowerInvariant()} with VAT, in Current Price above to compare."
        : $"What the shop charges now, {State.Costing.CostUnitCaption.ToLowerInvariant()} with VAT (Current Price above), and what it earns once VAT is taken out.";

    // Red when the price doesn't cover the base cost, amber when it earns less than the Markup Metric, as the header's Markup %.
    private string CurrentMarkupClass => Costs.IsCurrentPriceBelowCost ? "figure-error" : Costs.IsBelowTargetMarkup ? "figure-warning" : "";

    // A markup's percentage before its amount: "(30.0%) 30.00". The space is the string's, as Razor drops one written
    // after the span.
    private static string PercentBefore(decimal percent) => $"({percent:N1}%) ";

    private string? CurrentMarkupTooltip => Costs.IsCurrentPriceBelowCost
        ? "The current price doesn't cover the base cost."
        : Costs.IsBelowTargetMarkup ? "Less than the Markup Metric." : null;
}
