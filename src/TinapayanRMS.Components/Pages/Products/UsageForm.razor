@inject IJSRuntime JS

@* The form a recipe section is added and edited in. While adding a link or a copy, the picker
   of what to link or copy. Then one row: a linked section's badge, which opens it on Sub-Assemblies, with the pencil
   that links another in its place; an own or new section's Role and optional Name; and at the far right Unlink and
   Copy for a linked one, or Move to Sub-Assemblies and Move to In-House for an own one. Then the batch's lines, with
   this product's add-ins to a linked recipe under them, beside
   the piece size: what a piece and the batch cost, the weight per piece and yield typed in, and the batch's weight they
   share out. Insert Line and Insert Add-In put a blank line in above the one picked. *@
<div class="usage-form">
    @if (State.UsageForm.IsFormPickingSource)
    {
        <div class="usage-title">@State.UsageForm.UsageFormTitle</div>
    }
    @if (State.UsageForm.IsFormNewMovingToSubAssemblies)
    {
        <span class="badge badge-warning" title="Save puts it on Sub-Assemblies, named after this product and role, and links it. Pick a product-owned role to keep it here.">Moves to Sub-Assemblies on Save</span>
    }

    @if (State.UsageForm.IsFormPickingSource)
    {
        <div class="usage-row">
            <label class="form-label" for="usage-source">Existing Sub-Assembly</label>
            <PickField ID="usage-source" TItem="LinkableSubAssemblyOption" Items="State.UsageForm.LinkableSubAssemblies" TextField="DisplayName" Value="State.UsageForm.EditingUsageSource" ValueChanged="State.UsageForm.PickSource"
                       Tooltip="Link one from Sub-Assemblies, or copy another product's own as a new one named after this product." />
        </div>
    }

    <div class="usage-row usage-identity">
        <div class="usage-badges">
            @if (State.UsageForm.EditingUsage?.IsReleasing == true)
            {
                <span class="badge badge-warning" title="Save moves it to Sub-Assemblies with its name and lines, and links it. Undo or Revert to keep it here.">Moves to Sub-Assemblies on Save</span>
            }
            @if (State.UsageForm.EditingUsage is { IsMovingToInHouse: true } moving)
            {
                <span class="badge badge-warning" title="Save moves it to Sub-Assemblies, links it, and adds a made ingredient from it. Undo or Revert to keep it here.">@moving.MovingToInHouseText</span>
            }
            @if (State.UsageForm.IsShowingLinkBadge && State.UsageForm.EditingUsage is { } linked)
            {
                <button type="button" class="badge badge-link" @onclick="() => Commands.Run(State.Recipe.OpenLinkedSourceCommand, linked)"
                        title="@linked.LinkedFromToolTip">
                    @linked.LinkedFromText
                </button>
                <CommandButton Command="State.UsageForm.StartChangingLinkCommand" Icon="AppIcon.Edit" Flat="true"
                               Tooltip="Link another sub-assembly instead, keeping the piece size and add-ins." />
            }
            @if (State.UsageForm.IsChangingLink)
            {
                <PickField TItem="LinkableSubAssemblyOption" Items="State.UsageForm.ChangeLinkOptions" TextField="DisplayName" Value="State.UsageForm.ChangeLinkTarget" ValueChanged="State.UsageForm.PickLinkTarget"
                           Placeholder="Link instead…" CssClass="change-link" Tooltip="A sub-assembly from the Sub-Assemblies screen to link in this one's place" />
                <CommandButton Command="State.UsageForm.CancelChangingLinkCommand" Icon="AppIcon.Cancel" Flat="true" Tooltip="Keep the link as it is" />
            }
        </div>

        @if (State.UsageForm.IsFormEditingLines)
        {
            <div class="usage-role">
                <label class="form-label" for="usage-role">Role</label>
                <PickField ID="usage-role" TItem="SubAssemblyRole" Items="State.UsageForm.FormRoleOptions" TextField="Name" Value="State.UsageForm.EditingUsageRole" ValueChanged="State.UsageForm.PickRole" CssClass="role-picker"
                           Tooltip="What it's called in the recipe. Roles are added in Settings → Roles." />
                <label class="form-label" for="usage-name">Name (optional)</label>
                <TextField ID="usage-name" @bind-Value="State.UsageForm.EditingUsageName" Placeholder="e.g. Ube" CssClass="usage-name"
                           Tooltip="Tells apart sub-assemblies in the same role, e.g. Filling: Ube and Filling: Cheese. Optional for the only one." />
            </div>
        }

        <div class="usage-actions">
            @if (State.UsageForm.HasFormAddIns)
            {
                <button type="button" class="badge badge-link" @onclick="GoToAddInsAsync" title="This product adds extras to the linked recipe. Click to see them.">@State.UsageForm.FormAddInsBadgeText</button>
            }
            @if (State.UsageForm.IsFormShowingNoAddIns)
            {
                <span class="badge badge-muted" title="No extras on the linked recipe. Add colouring, flavouring or inclusions under its lines.">@State.UsageForm.FormAddInsBadgeText</span>
            }
            @if (!State.UsageForm.IsAddingUsage && State.UsageForm.EditingUsage is { } usage)
            {
                @if (State.UsageForm.IsEditingLinkedUsage)
                {
                    <ActionButton Icon="AppIcon.Unlink" Label="Unlink" OnClick="() => Commands.Run(State.Recipe.UnlinkCommand, usage)" Disabled="!State.Recipe.UnlinkCommand.CanExecute(usage)"
                                  Tooltip="Make a copy for this product alone, whatever its role. The original stays on Sub-Assemblies; others can copy it but not link it." />
                    <ActionButton Icon="AppIcon.Copy" Label="Copy" OnClick="() => Commands.Run(State.Recipe.MakeCopyCommand, usage)" Disabled="!State.Recipe.MakeCopyCommand.CanExecute(usage)"
                                  Tooltip="Copy it to change its lines for this product alone. Save keeps the copy, named after this product, in its place." />
                }
                @if (State.UsageForm.IsEditingOwnedUsage)
                {
                    <ActionButton Icon="AppIcon.Link" Label="Move to Sub-Assemblies" OnClick="() => Commands.Run(State.Recipe.MoveToSubAssembliesCommand, usage)" Disabled="!State.Recipe.MoveToSubAssembliesCommand.CanExecute(usage)"
                                  Tooltip="Save moves it to Sub-Assemblies, linked here, so other products can link it too." />
                }
                @if (State.UsageForm.CanMoveEditingUsageToInHouse)
                {
                    <ActionButton Icon="AppIcon.InHouse" Label="Move to In-House" OnClick="() => Commands.Run(State.Recipe.MoveToInHouseCommand, usage)" Disabled="!State.Recipe.MoveToInHouseCommand.CanExecute(usage)"
                                  Tooltip="Save makes it a made ingredient other recipes can use, and moves it to Sub-Assemblies, linked here." />
                }
            }
        </div>
    </div>

    <div class="usage-columns">
        <div class="usage-tables">
            @if (State.UsageForm.IsFormShowingLines)
            {
                <div id="usage-lines">
                    <IngredientLinesGrid @ref="_lines" Items="State.UsageForm.FormLines" NewItem="@(State.UsageForm.IsFormLinesEditable ? State.UsageForm.NewFormLine : null)" Ingredients="State.Ingredients"
                                         @bind-SelectedItem="State.UsageForm.SelectedFormLine" PercentHeader="@State.UsageForm.UsageFormPercentHeader"
                                         ReadOnly="!State.UsageForm.IsFormLinesEditable" />
                </div>
                <div class="lines-footer">
                    <p class="caption">@State.UsageForm.UsageFormBaseCaption</p>
                    @if (State.UsageForm.IsFormLinesEditable)
                    {
                        <div class="button-row">
                            <ActionButton Icon="AppIcon.Add" Label="Insert Line" OnClick="() => _lines?.InsertLineAsync() ?? Task.CompletedTask"
                                          Tooltip="Adds a blank line above the selected one, or at the end. Insert." />
                            <CommandButton Command="State.UsageForm.RemoveLineCommand" CssClass="remove-line" Icon="AppIcon.Remove" Label="Remove Line" />
                        </div>
                    }
                </div>
            }

            @if (State.UsageForm.IsFormShowingAddIns)
            {
                <div id="usage-add-ins" class="add-ins">
                    <div class="add-ins-heading">
                        <span class="group-heading">Add-Ins</span>
                        <button type="button" class="badge badge-link" @onclick="GoToTopAsync" title="Scroll back up to the linked recipe's lines.">Go to top</button>
                    </div>
                    <IngredientLinesGrid @ref="_addIns" Items="State.UsageForm.FormAddIns" NewItem="State.UsageForm.NewFormAddIn" Ingredients="State.Ingredients"
                                         @bind-SelectedItem="State.UsageForm.SelectedFormAddIn" PercentHeader="@State.UsageForm.UsageFormPercentHeader"
                                         ShowBase="false" />
                    <div class="lines-footer">
                        <p class="caption">@State.UsageForm.UsageFormAddInsCaption</p>
                        <div class="button-row">
                            <ActionButton Icon="AppIcon.Add" Label="Insert Add-In" OnClick="() => _addIns?.InsertLineAsync() ?? Task.CompletedTask"
                                          Tooltip="Adds a blank add-in above the selected one, or at the end. Insert." />
                            <CommandButton Command="State.UsageForm.RemoveAddInCommand" CssClass="remove-line" Icon="AppIcon.Remove" Label="Remove Add-In" />
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="piece-size">
            <div class="stat-tiles">
                <div class="stat-tile" title="This section's cost per piece: the batch cost shared by weight per piece.">
                    <div class="caption">Cost/piece</div>
                    <div class="stat-value">@State.UsageForm.UsageFormCostPerPieceText</div>
                </div>
                <div class="stat-tile" title="What the whole batch costs: its lines, and this product's add-ins to them.">
                    <div class="caption">Batch cost</div>
                    <div class="stat-value">@State.UsageForm.UsageFormBatchCostText</div>
                </div>
            </div>

            <div class="group-heading">Batch parameters</div>
            <div class="param-row">
                <label for="usage-weight">Weight/piece (g)</label>
                <NumberField ID="usage-weight" TValue="decimal" Value="State.UsageForm.EditingUsageWeightPerPiece" ValueChanged="State.UsageForm.TypeWeightPerPiece" Min="0" CssClass="param-field"
                             Tooltip="Batch weight per piece. Typing it works out the yield." />
            </div>
            <div class="param-row">
                <label for="usage-yield">Yield (pcs)</label>
                <NumberField ID="usage-yield" TValue="decimal" Value="State.UsageForm.EditingUsageYield" ValueChanged="State.UsageForm.TypeYield" Min="0" CssClass="param-field"
                             Tooltip="Pieces per batch. Typing it works out the weight per piece." />
            </div>

            <div class="group-heading">Computed</div>
            <div class="param-row" title="Its lines plus this product's add-ins. Yield and weight per piece share it out.">
                <span>Total weight</span>
                <span>@State.UsageForm.UsageFormTotalWeightText</span>
            </div>

            <p class="caption piece-size-caption">@State.UsageForm.UsageFormPieceSizeCaption</p>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ProductForm State { get; set; } = null!;

    private IngredientLinesGrid? _lines;
    private IngredientLinesGrid? _addIns;

    private async Task GoToAddInsAsync() => await JS.InvokeVoidAsync("tinapayan.scrollIntoView", "usage-add-ins");

    private async Task GoToTopAsync() => await JS.InvokeVoidAsync("tinapayan.scrollIntoView", "usage-lines");
}
