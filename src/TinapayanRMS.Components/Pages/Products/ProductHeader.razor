@* The picked product's header: a tag while its costs show unbuffered and one saying where a new product will be filed;
   Save, Undo, Redo, Revert, Print, Export to PDF, the Buffered/Unbuffered switch and Delete, as icons, each named by its
   tooltip; its figures in coloured tiles; then what's typed in about it on one row. No name (its tab shows it) and no New
   (the list's toolbar has it). A composite has no Quantity Required: it's one unit of the products it holds. *@
<section class="card header-card">
    <div class="header-title-row">
        <div class="header-title-group">
            @if (State.Costing.IsUnbuffered)
            {
                <span class="badge badge-warning" data-title="True costs, without cost buffers. Buffered switches back.">Unbuffered costs</span>
            }
            @if (State.Costing.BelowCostText is { } belowCost)
            {
                <span class="badge badge-warning" data-title="@belowCost">Priced below cost</span>
            }
            @if (State.Costing.NoPieceSizeText is { } noPieceSize)
            {
                <span class="badge badge-warning" data-title="@noPieceSize">No piece size</span>
            }
            @if (State.NewProductTag is { } tag)
            {
                <span class="badge badge-warning" data-title="Where Save files this new product: the New Products In stage (Settings → Costing Defaults), or the folder New Product Here was used on.">@tag</span>
            }
        </div>
        <div class="button-row">
            <CommandButton Command="State.SaveCommand" Icon="AppIcon.Save" Primary="true" Tooltip="Save: saves the details, recipe, packaging and costing together." />
            <CommandButton Command="State.UndoCommand" Icon="AppIcon.Undo" Tooltip="Undo: takes back the last change. Ctrl+Z." />
            <CommandButton Command="State.RedoCommand" Icon="AppIcon.Redo" Tooltip="Redo: puts back the change the last Undo took. Ctrl+Y." />
            <CommandButton Command="State.RevertCommand" Icon="AppIcon.Cancel"
                           Tooltip="Revert: puts the whole product back as last saved." />
            <CommandButton Command="State.PrintCommand" Icon="AppIcon.Print"
                           Tooltip="Print: previews and prints the recipe and costing as shown." />
            <CommandButton Command="State.ExportPdfCommand" Icon="AppIcon.ExportToPdf"
                           Tooltip="Export to PDF: saves the recipe and costing as shown, unsaved changes included. On History, the picked version." />
            <CommandButton Command="State.ToggleCostBasisCommand" Icon="AppIcon.Calculate" Tooltip="@($"{State.Costing.CostBasisButtonLabel}: {State.Costing.CostBasisButtonTooltip}")" />
            <CommandButton Command="State.DeleteCommand" Icon="AppIcon.Delete"
                           Tooltip="Delete: moves it to the Deleted folder (asks first) and closes its tab." />
        </div>
    </div>

    <div class="section-divider"></div>

    <div class="figure-tiles">
        <div class="figure-tile tile-peach" data-title="@State.Costing.MaterialCostTooltip">
            <div class="figure-label">Material Cost</div>
            <div class="figure-value">@State.Costing.Costs.Material.ToString("N2")</div>
        </div>
        <div class="figure-tile tile-pink" data-title="@($"{State.Costing.CostUnitCaption}: material cost plus labor, overhead and admin, before markup and VAT")">
            <div class="figure-label">Base Cost</div>
            <div class="figure-value">@State.Costing.Costs.BaseCost.ToString("N2")</div>
        </div>
        <div class="figure-tile tile-sky" data-title="@($"{State.Costing.CostUnitCaption}, with VAT: what the shop charges now")">
            <div class="figure-label">Current Price</div>
            <div class="figure-value">@(State.EditingCurrentPrice?.ToString("N2") ?? "—")</div>
        </div>
        <div class="figure-tile tile-green" data-title="The markup the current price earns on the base cost, VAT excluded">
            <div class="figure-label">Markup %</div>
            <div class="figure-value @(State.Costing.Costs.IsCurrentPriceBelowCost ? "figure-error" : State.Costing.Costs.IsBelowTargetMarkup ? "figure-warning" : "")"
                 data-title="@(State.Costing.Costs.IsCurrentPriceBelowCost ? "The current price doesn't cover the base cost." : State.Costing.Costs.IsBelowTargetMarkup ? "Less than the Markup Metric on the Costing tab." : null)">@(State.Costing.Costs.CurrentMarkupPercent is { } markup ? $"{markup:N2}%" : "—")</div>
        </div>
        <div class="figure-tile tile-mauve" data-title="@State.LastUpdatedText">
            <div class="figure-label">Last Updated</div>
            <div class="figure-value">@State.LastUpdatedText</div>
        </div>
    </div>

    <div class="header-fields">
        <label class="form-label" for="product-name">Product Name</label>
        <TextField ID="product-name" @bind-Value="State.EditingName" CssClass="field-wide" />

        <label class="form-label" for="product-category">Category</label>
        <PickField ID="product-category" TItem="ProductCategory" Items="State.Categories" TextField="Name"
                   Value="State.EditingCategory" ValueChanged="PickCategory" AllowEmpty="true"
                   OnArrive="ArriveAtCategory" OnTyped="t => State.CategorySearchText = t" OnLeave="State.CommitCategoryTextAsync"
                   Tooltip="Groups it in the Products list. Pick one, or type a new name to add it." />

        @if (State.IsEditingSingle)
        {
            <label class="form-label" for="product-quantity" data-title="Pieces per sellable unit: 1 if sold by the piece.">Quantity Required</label>
            <NumberField ID="product-quantity" TValue="int" @bind-Value="State.EditingQuantityRequired" Format="N0" Min="1" CssClass="field-narrow"
                         Tooltip="Pieces per sellable unit: 1 by the piece, 8 for a &quot;Box of 8&quot;. The costing multiplies by it." />
        }

        <label class="form-label" for="product-price" data-title="@($"{State.Costing.CostUnitCaption}, with VAT: what the shop charges now")">Current Price</label>
        <NumberField ID="product-price" TValue="decimal?" @bind-Value="State.EditingCurrentPrice" Format="N2" Min="0" CssClass="field-medium"
                     Tooltip="@($"{State.Costing.CostUnitCaption}, with VAT: what the shop charges now. The Markup % in the header shows what it earns.")" />
    </div>
</section>

@code {
    [Parameter, EditorRequired] public ProductForm State { get; set; } = null!;

    // The picker's text: the category's name as it takes the cursor, or what's typed since; settled once it's left.
    private void ArriveAtCategory()
    {
        State.CategorySearchText = State.EditingCategory?.Name ?? "";
        State.BeginCategoryEdit();
    }

    private void PickCategory(ProductCategory? category)
    {
        State.EditingCategory = category;
        State.CategorySearchText = category?.Name ?? "";
    }
}
