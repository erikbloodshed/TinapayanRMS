@page "/print/preview"
@using TinapayanRMS.Components.Printing
@inject PrintPreviews Previews
@inject NavigationManager Navigation

<PageTitle>Print preview · TinapayanRMS</PageTitle>

@* The preview a screen opens for its own printout: the Price Simulator's products, picked or all shown; a Reports table as
   it's shown; a sub-assembly's recipe. Back returns to the screen that asked. *@
<section class="card print-card">
    <PrintPane Set="_choice?.Set" Tables="Previews.Tables" Empty="Nothing to preview. Print from the Price Simulator, Reports or Sub-Assemblies.">
        <Options>
            <ActionButton Icon="AppIcon.Back" Label="Back" OnClick="() => Navigation.NavigateTo(Previews.ReturnTo)" />
            @if (Previews.Choices.Count > 1)
            {
                <label class="form-label" for="preview-choice">Print</label>
                <PickField ID="preview-choice" TItem="PrintChoice" Items="Previews.Choices" TextField="Label" @bind-Value="_choice" CssClass="print-scope" />
            }
        </Options>
    </PrintPane>
</section>

@code {
    private PrintChoice? _choice;

    protected override void OnInitialized() => _choice = Previews.Choices.FirstOrDefault();
}
