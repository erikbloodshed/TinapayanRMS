@page "/reports"
@using Syncfusion.Blazor.Calendars
@using TinapayanRMS.Components.Printing
@inherits ScreenBase<ReportsState>
@inject IViewStateStore ViewState
@inject IFileDialogs Dialogs

<PageTitle>Reports · TinapayanRMS</PageTitle>

@* Reports: five tables in tabs. Each sorts by a click on a heading and filters from the funnel in
   it; a double-click on a row opens its product or material; and Export to Excel saves the table as it's shown, in its
   order, with its filters and only the columns showing (the grid's own export, saved where Windows' Save dialog says). Product Cost
   Summary's Columns button chooses which columns show. Each table's filters, sort and columns are as they were left,
   kept for the Windows user (GridLayouts). Cost Buffers' Re-apply Target Buffer changes the buffered costs of the materials
   picked, or of every one shown below target, after asking. A tab's table is built the first time its tab is shown
   (ContentLoad.Demand), then kept: the page opens with one table to draw, not five, each drawn twice a visit, with the
   last visit's rows and then the new ones. A grid draws all its rows for each change to its list, so each table's rows
   come in one change (TableRows), and none when they show the same; and each grid is in a SelfDrawn, since it draws
   itself as they change, so the page drawing again (a button, a toast, a grid's event) doesn't draw the grids again. *@
<section class="card tabs-card report-card">
    <SfTab LoadOn="ContentLoad.Demand" CssClass="details-tabs report-tabs">
        <TabItems>
            <TabItem>
                <ChildContent><TabHeader Text="@ReportsState.ProductCostSummaryTitle" /></ChildContent>
                <ContentTemplate>
                    <div class="report">
                        <div class="report-heading">
                            <h2 class="section-header">Product Cost Summary</h2>
                            <div class="button-row">
                                <CommandButton Command="State!.ExportProductCostsCommand" Icon="AppIcon.ExportToExcel" Label="Export to Excel"
                                               Tooltip="Saves this table to an Excel workbook as it's shown: in its order, with its filters, and with only the columns showing." />
                                <ActionButton Icon="AppIcon.Print" Label="Print" Tooltip="Shows this table as it's shown, in its order, with its filters and only the columns showing, in the print preview: print it there or save it as a PDF." OnClick="() => PrintAsync(_productCosts, ReportsState.ProductCostSummaryTitle, ProductCostsCaption)" />
                                <ActionButton Icon="AppIcon.Columns" Label="Columns" Tooltip="Choose which columns show. Product always does." OnClick="OpenColumnChooserAsync" />
                            </div>
                        </div>
                        <p class="caption">Every product as it's saved, costed at today's prices. Each figure is for one sellable unit of the pieces shown; Markup % is what the current price earns on the base cost, and Short By how far it falls short of the Target Markup %. Filter by product, stage or category from the funnel in its heading, and double-click a product to open it.</p>
                        <SelfDrawn>
                            <SfGrid @ref="_productCosts" ID="report-product-costs" TValue="ProductCostRow" DataSource="State!.ProductCosts" GridLines="GridLine.Both" Height="100%" Width="100%" RowHeight="24"
                                    AllowSorting="true" AllowFiltering="true" AllowExcelExport="true" ShowColumnChooser="true" AllowTextWrap="true" AllowResizing="true">
                                <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel" />
                                <GridTextWrapSettings WrapMode="WrapMode.Header" />
                                <GridEvents TValue="ProductCostRow" OnRecordDoubleClick="OpenProductAsync" Created="() => RestoreAsync(_productCosts, ProductCostsKey)"
                                            OnActionComplete="e => SaveAsync(_productCosts, ProductCostsKey, e.RequestType)" />
                                <GridColumns>
                                    <GridColumn Field="@nameof(ProductCostRow.ProductId)" IsPrimaryKey="true" Visible="false" ShowInColumnChooser="false" />
                                    <GridColumn Field="@nameof(ProductCostRow.ProductName)" HeaderText="Product" Width="260" ShowInColumnChooser="false" IsFrozen="true" />
                                    <GridColumn Field="@nameof(ProductCostRow.Stage)" HeaderText="Stage" Width="180" />
                                    <GridColumn Field="@nameof(ProductCostRow.Category)" HeaderText="Category" Width="140" />
                                    <GridColumn Field="@nameof(ProductCostRow.Pieces)" HeaderText="Pieces" Width="80" Format="N0" TextAlign="TextAlign.Right" AllowFiltering="false" />
                                    <GridColumn Field="@nameof(ProductCostRow.IngredientsCost)" HeaderText="Ingredients Cost" Format="N2" TextAlign="TextAlign.Right" Width="106" AllowFiltering="false" />
                                    <GridColumn Field="@nameof(ProductCostRow.WastageCost)" HeaderText="Wastage Cost" Format="N2" TextAlign="TextAlign.Right" Width="96" AllowFiltering="false" />
                                    <GridColumn Field="@nameof(ProductCostRow.PackagingCost)" HeaderText="Packaging Cost" Format="N2" TextAlign="TextAlign.Right" Width="104" AllowFiltering="false" />
                                    <GridColumn Field="@nameof(ProductCostRow.LaborCost)" HeaderText="Labor Cost" Format="N2" TextAlign="TextAlign.Right" Width="90" AllowFiltering="false" />
                                    <GridColumn Field="@nameof(ProductCostRow.OverheadCost)" HeaderText="Overhead Cost" Format="N2" TextAlign="TextAlign.Right" Width="98" AllowFiltering="false" />
                                    <GridColumn Field="@nameof(ProductCostRow.AdministrativeCost)" HeaderText="Admin Cost" Format="N2" TextAlign="TextAlign.Right" Width="90" AllowFiltering="false" />
                                    <GridColumn Field="@nameof(ProductCostRow.BaseCost)" HeaderText="Base Cost" Format="N2" TextAlign="TextAlign.Right" Width="90" AllowFiltering="false" />
                                    <GridColumn Field="@nameof(ProductCostRow.SuggestedPrice)" HeaderText="Suggested Price" Format="N2" TextAlign="TextAlign.Right" Width="104" AllowFiltering="false" />
                                    <GridColumn Field="@nameof(ProductCostRow.RoundedPrice)" HeaderText="Rounded Price" Format="N2" TextAlign="TextAlign.Right" Width="98" AllowFiltering="false" />
                                    <GridColumn Field="@nameof(ProductCostRow.CurrentPrice)" HeaderText="Current Price" Format="N2" TextAlign="TextAlign.Right" Width="92" AllowFiltering="false" />
                                    <GridColumn Field="@nameof(ProductCostRow.MarkupPercent)" HeaderText="Markup %" Format="N2" TextAlign="TextAlign.Right" Width="88" AllowFiltering="false" />
                                    <GridColumn Field="@nameof(ProductCostRow.TargetMarkupPercent)" HeaderText="Target Markup %" Format="N2" TextAlign="TextAlign.Right" Width="96" AllowFiltering="false" />
                                    <GridColumn Field="@nameof(ProductCostRow.ShortOfTargetMarkup)" HeaderText="Short By" Format="N2" TextAlign="TextAlign.Right" Width="84" AllowFiltering="false" />
                                    <GridColumn Field="@nameof(ProductCostRow.NoPieceSize)" HeaderText="No Piece Size" Width="140" />
                                </GridColumns>
                            </SfGrid>
                        </SelfDrawn>
                    </div>
                </ContentTemplate>
            </TabItem>
            <TabItem>
                <ChildContent><TabHeader Text="@ReportsState.RawMaterialPriceSummaryTitle" /></ChildContent>
                <ContentTemplate>
                    <div class="report">
                        <div class="report-heading">
                            <h2 class="section-header">Raw Materials Price Summary</h2>
                            <div class="button-row">
                                <CommandButton Command="State!.ExportRawMaterialPricesCommand" Icon="AppIcon.ExportToExcel" Label="Export to Excel"
                                               Tooltip="Saves this table to an Excel workbook as it's shown, in its order." />
                                <ActionButton Icon="AppIcon.Print" Label="Print" Tooltip="Shows this table as it's shown, in its order, with its filters and only the columns showing, in the print preview: print it there or save it as a PDF." OnClick="() => PrintAsync(_rawMaterialPrices, ReportsState.RawMaterialPriceSummaryTitle, RawMaterialPricesCaption)" />
                            </div>
                        </div>
                        <p class="caption">Every purchased material's latest price, from its price history. Change % is how far that price moved its cost from the price before it. Double-click a material to open it.</p>
                        <SelfDrawn>
                            <SfGrid @ref="_rawMaterialPrices" ID="report-raw-material-prices" TValue="RawMaterialPriceSummaryRow" DataSource="State!.RawMaterialPrices" GridLines="GridLine.Both" Height="100%" Width="100%" RowHeight="24"
                                    AllowSorting="true" AllowFiltering="true" AllowExcelExport="true" AllowResizing="true">
                                <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel" />
                                <GridEvents TValue="RawMaterialPriceSummaryRow" OnRecordDoubleClick="OpenRawMaterialAsync" Created="() => RestoreAsync(_rawMaterialPrices, RawMaterialPricesKey)"
                                            OnActionComplete="e => SaveAsync(_rawMaterialPrices, RawMaterialPricesKey, e.RequestType)" />
                                <GridColumns>
                                    <GridColumn Field="@nameof(RawMaterialPriceSummaryRow.RawMaterialId)" IsPrimaryKey="true" Visible="false" />
                                    <GridColumn Field="@nameof(RawMaterialPriceSummaryRow.Name)" HeaderText="Raw Material" Width="280" />
                                    <GridColumn Field="@nameof(RawMaterialPriceSummaryRow.Type)" HeaderText="Type" />
                                    <GridColumn Field="@nameof(RawMaterialPriceSummaryRow.Category)" HeaderText="Category" />
                                    <GridColumn Field="@nameof(RawMaterialPriceSummaryRow.UnitName)" HeaderText="Unit" />
                                    <GridColumn Field="@nameof(RawMaterialPriceSummaryRow.Price)" HeaderText="Price" Format="N2" TextAlign="TextAlign.Right" AllowFiltering="false" />
                                    <GridColumn Field="@nameof(RawMaterialPriceSummaryRow.ChangePercent)" HeaderText="Change %" Format="N2" TextAlign="TextAlign.Right" AllowFiltering="false" />
                                    <GridColumn Field="@nameof(RawMaterialPriceSummaryRow.PriceDate)" HeaderText="Since" Format="MMM d, yyyy" Type="ColumnType.Date" AllowFiltering="false" />
                                </GridColumns>
                            </SfGrid>
                        </SelfDrawn>
                    </div>
                </ContentTemplate>
            </TabItem>
            <TabItem>
                <ChildContent><TabHeader Text="@ReportsState.CostBuffersTitle" /></ChildContent>
                <ContentTemplate>
                    <div class="report">
                        <div class="report-heading">
                            <h2 class="section-header">Cost Buffers</h2>
                            <div class="button-row">
                                <SfCheckBox Label="Only below target" @bind-Checked="State!.OnlyBelowTarget" />
                                <CommandButton Command="State!.ReapplyTargetBuffersCommand" Icon="AppIcon.Apply" Label="Re-apply Target Buffer"
                                               Tooltip="Puts the target buffer back on top of the brand each one is costed at (its Basis brand, else the dearest) for the materials picked, or for every one shown below target. Asks first." />
                                <CommandButton Command="State!.ExportCostBuffersCommand" Icon="AppIcon.ExportToExcel" Label="Export to Excel"
                                               Tooltip="Saves this table to an Excel workbook as it's shown, in its order." />
                                <ActionButton Icon="AppIcon.Print" Label="Print" Tooltip="Shows this table as it's shown, in its order, with its filters and only the columns showing, in the print preview: print it there or save it as a PDF." OnClick="() => PrintAsync(_costBuffers, ReportsState.CostBuffersTitle, CostBuffersCaption)" />
                            </div>
                        </div>
                        <p class="caption">Every purchased material's buffered cost against the brand it's costed at now (its Basis brand, else the dearest). Brand prices don't move the buffered cost, so a rise wears the buffer down; Target % is the buffer last typed for it. Pick materials (Ctrl or Shift for several), or none for all shown, and Re-apply Target Buffer puts it back on top. Double-click one to open it.</p>
                        <SelfDrawn>
                            <SfGrid @ref="_costBuffers" ID="report-cost-buffers" TValue="CostBufferRow" DataSource="State!.CostBuffers" GridLines="GridLine.Both" Height="100%" Width="100%" RowHeight="24"
                                    AllowSorting="true" AllowFiltering="true" AllowExcelExport="true" AllowResizing="true">
                                <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel" />
                                <GridSelectionSettings Mode="SelectionMode.Row" Type="SelectionType.Multiple" />
                                <GridEvents TValue="CostBufferRow" OnRecordDoubleClick="OpenCostBufferMaterialAsync" RowSelected="SyncCostBuffersAsync" RowDeselected="SyncCostBuffersAsync"
                                            Created="() => RestoreAsync(_costBuffers, CostBuffersKey)" OnActionComplete="e => SaveAsync(_costBuffers, CostBuffersKey, e.RequestType)" />
                                <GridColumns>
                                    <GridColumn Field="@nameof(CostBufferRow.RawMaterialId)" IsPrimaryKey="true" Visible="false" />
                                    <GridColumn Field="@nameof(CostBufferRow.Name)" HeaderText="Raw Material" Width="280" />
                                    <GridColumn Field="@nameof(CostBufferRow.Type)" HeaderText="Type" />
                                    <GridColumn Field="@nameof(CostBufferRow.Category)" HeaderText="Category" />
                                    <GridColumn Field="@nameof(CostBufferRow.Per)" HeaderText="Per" Width="70" AllowFiltering="false" />
                                    <GridColumn Field="@nameof(CostBufferRow.DearestCost)" HeaderText="Brand Cost" Format="N4" TextAlign="TextAlign.Right" AllowFiltering="false" />
                                    <GridColumn Field="@nameof(CostBufferRow.BufferedCost)" HeaderText="Buffered Cost" Format="N4" TextAlign="TextAlign.Right" AllowFiltering="false" />
                                    <GridColumn Field="@nameof(CostBufferRow.BufferPercent)" HeaderText="Buffer %" Format="N2" TextAlign="TextAlign.Right" AllowFiltering="false" />
                                    <GridColumn Field="@nameof(CostBufferRow.TargetPercent)" HeaderText="Target %" Format="N2" TextAlign="TextAlign.Right" AllowFiltering="false" />
                                    <GridColumn Field="@nameof(CostBufferRow.ShortBy)" HeaderText="Short By" Format="N2" TextAlign="TextAlign.Right" AllowFiltering="false" />
                                </GridColumns>
                            </SfGrid>
                        </SelfDrawn>
                    </div>
                </ContentTemplate>
            </TabItem>
            <TabItem>
                <ChildContent><TabHeader Text="@ReportsState.CostDriversTitle" /></ChildContent>
                <ContentTemplate>
                    <div class="report">
                        <div class="report-heading">
                            <h2 class="section-header">Cost Drivers</h2>
                            <div class="button-row">
                                <CommandButton Command="State!.ExportCostDriversCommand" Icon="AppIcon.ExportToExcel" Label="Export to Excel"
                                               Tooltip="Saves this table to an Excel workbook as it's shown, in its order." />
                                <ActionButton Icon="AppIcon.Print" Label="Print" Tooltip="Shows this table as it's shown, in its order, with its filters and only the columns showing, in the print preview: print it there or save it as a PDF." OnClick="() => PrintAsync(_costDrivers, ReportsState.CostDriversTitle, CostDriversCaption)" />
                            </div>
                        </div>
                        <p class="caption">The purchased materials that make up most of the products in Production's material cost, one sellable unit of each, at buffered costs: a material is counted however it gets into a product, through a made or linked ingredient too. Cumulative % adds each row to those above it, so the top few that make up most of the cost show where a price rise would hurt. Double-click a material to open it.</p>
                        <SelfDrawn>
                            <SfGrid @ref="_costDrivers" ID="report-cost-drivers" TValue="CostDriverRow" DataSource="State!.CostDrivers" GridLines="GridLine.Both" Height="100%" Width="100%" RowHeight="24"
                                    AllowSorting="true" AllowFiltering="true" AllowExcelExport="true" AllowResizing="true">
                                <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel" />
                                <GridEvents TValue="CostDriverRow" OnRecordDoubleClick="OpenCostDriverMaterialAsync" Created="() => RestoreAsync(_costDrivers, CostDriversKey)"
                                            OnActionComplete="e => SaveAsync(_costDrivers, CostDriversKey, e.RequestType)" />
                                <GridColumns>
                                    <GridColumn Field="@nameof(CostDriverRow.RawMaterialId)" IsPrimaryKey="true" Visible="false" />
                                    <GridColumn Field="@nameof(CostDriverRow.Name)" HeaderText="Raw Material" Width="260" />
                                    <GridColumn Field="@nameof(CostDriverRow.Category)" HeaderText="Category" />
                                    <GridColumn Field="@nameof(CostDriverRow.Products)" HeaderText="Products" Format="N0" TextAlign="TextAlign.Right" Width="90" AllowFiltering="false" />
                                    <GridColumn Field="@nameof(CostDriverRow.CostInProducts)" HeaderText="Cost in Products" Format="N2" TextAlign="TextAlign.Right" AllowFiltering="false" />
                                    <GridColumn Field="@nameof(CostDriverRow.ShareOfAll)" HeaderText="Share %" Format="N2" TextAlign="TextAlign.Right" AllowFiltering="false" />
                                    <GridColumn Field="@nameof(CostDriverRow.CumulativeShare)" HeaderText="Cumulative %" Format="N2" TextAlign="TextAlign.Right" AllowFiltering="false" />
                                    <GridColumn Field="@nameof(CostDriverRow.LargestShare)" HeaderText="Largest Share %" Format="N2" TextAlign="TextAlign.Right" AllowFiltering="false" />
                                    <GridColumn Field="@nameof(CostDriverRow.LargestIn)" HeaderText="Largest In" Width="220" />
                                </GridColumns>
                            </SfGrid>
                        </SelfDrawn>
                    </div>
                </ContentTemplate>
            </TabItem>
            <TabItem>
                <ChildContent><TabHeader Text="@ReportsState.MarginErosionTitle" /></ChildContent>
                <ContentTemplate>
                    <div class="report">
                        <div class="report-heading">
                            <h2 class="section-header">Margin Erosion</h2>
                            <div class="button-row">
                                <label class="form-label" for="margin-erosion-since">Since</label>
                                <SfDatePicker ID="margin-erosion-since" TValue="DateTime" Value="State!.MarginErosionSince" ValueChanged="d => State!.MarginErosionSince = d"
                                              Format="MMM d, yyyy" Width="150px" ShowClearButton="false" />
                                <SfCheckBox Label="Only dropped" @bind-Checked="State!.OnlyDropped" />
                                <CommandButton Command="State!.ExportMarginErosionCommand" Icon="AppIcon.ExportToExcel" Label="Export to Excel"
                                               Tooltip="Saves this table to an Excel workbook as it's shown, in its order." />
                                <ActionButton Icon="AppIcon.Print" Label="Print" Tooltip="Shows this table as it's shown, in its order, with its filters and only the columns showing, in the print preview: print it there or save it as a PDF." OnClick="() => PrintAsync(_marginErosion, ReportsState.MarginErosionTitle, MarginErosionCaption)" />
                            </div>
                        </div>
                        <p class="caption">Each product's markup at its Current Price as it stood on the day picked, its latest version saved by then at its costs then, against now. A product with no version by then, or no Current Price then or now, isn't listed. Change is in percentage points: below 0 means it earns less now. Double-click a product to open it.</p>
                        <SelfDrawn>
                            <SfGrid @ref="_marginErosion" ID="report-margin-erosion" TValue="MarginErosionRow" DataSource="State!.MarginErosion" GridLines="GridLine.Both" Height="100%" Width="100%" RowHeight="24"
                                    AllowSorting="true" AllowFiltering="true" AllowExcelExport="true" AllowTextWrap="true" AllowResizing="true">
                                <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel" />
                                <GridTextWrapSettings WrapMode="WrapMode.Header" />
                                <GridEvents TValue="MarginErosionRow" OnRecordDoubleClick="OpenErodedProductAsync" Created="() => RestoreAsync(_marginErosion, MarginErosionKey)"
                                            OnActionComplete="e => SaveAsync(_marginErosion, MarginErosionKey, e.RequestType)" />
                                <GridColumns>
                                    <GridColumn Field="@nameof(MarginErosionRow.ProductId)" IsPrimaryKey="true" Visible="false" />
                                    <GridColumn Field="@nameof(MarginErosionRow.ProductName)" HeaderText="Product" Width="240" />
                                    <GridColumn Field="@nameof(MarginErosionRow.Stage)" HeaderText="Stage" />
                                    <GridColumn Field="@nameof(MarginErosionRow.Category)" HeaderText="Category" />
                                    <GridColumn Field="@nameof(MarginErosionRow.VersionNumber)" HeaderText="Version" Format="N0" TextAlign="TextAlign.Right" Width="80" AllowFiltering="false" />
                                    <GridColumn Field="@nameof(MarginErosionRow.VersionSavedAt)" HeaderText="Saved" Format="MMM d, yyyy" Type="ColumnType.Date" AllowFiltering="false" />
                                    <GridColumn Field="@nameof(MarginErosionRow.BaseCostThen)" HeaderText="Base Cost Then" Format="N2" TextAlign="TextAlign.Right" AllowFiltering="false" />
                                    <GridColumn Field="@nameof(MarginErosionRow.BaseCostNow)" HeaderText="Base Cost Now" Format="N2" TextAlign="TextAlign.Right" AllowFiltering="false" />
                                    <GridColumn Field="@nameof(MarginErosionRow.CurrentPriceThen)" HeaderText="Price Then" Format="N2" TextAlign="TextAlign.Right" AllowFiltering="false" />
                                    <GridColumn Field="@nameof(MarginErosionRow.CurrentPriceNow)" HeaderText="Price Now" Format="N2" TextAlign="TextAlign.Right" AllowFiltering="false" />
                                    <GridColumn Field="@nameof(MarginErosionRow.MarkupThen)" HeaderText="Markup % Then" Format="N2" TextAlign="TextAlign.Right" AllowFiltering="false" />
                                    <GridColumn Field="@nameof(MarginErosionRow.MarkupNow)" HeaderText="Markup % Now" Format="N2" TextAlign="TextAlign.Right" AllowFiltering="false" />
                                    <GridColumn Field="@nameof(MarginErosionRow.Change)" HeaderText="Change" Format="N2" TextAlign="TextAlign.Right" AllowFiltering="false" />
                                </GridColumns>
                            </SfGrid>
                        </SelfDrawn>
                    </div>
                </ContentTemplate>
            </TabItem>
        </TabItems>
    </SfTab>
</section>

@code {
    private const string ProductCostsKey = "reports-product-costs-grid";
    private const string RawMaterialPricesKey = "reports-raw-material-prices-grid";
    private const string CostBuffersKey = "reports-cost-buffers-grid";
    private const string CostDriversKey = "reports-cost-drivers-grid";
    private const string MarginErosionKey = "reports-margin-erosion-grid";

    private SfGrid<ProductCostRow>? _productCosts;
    private SfGrid<RawMaterialPriceSummaryRow>? _rawMaterialPrices;
    private SfGrid<CostBufferRow>? _costBuffers;
    private SfGrid<CostDriverRow>? _costDrivers;
    private SfGrid<MarginErosionRow>? _marginErosion;

    // What each printed table is, under its title.
    private const string ProductCostsCaption = "Every product as it's saved, costed at today's prices, for one sellable unit of the pieces shown.";
    private const string RawMaterialPricesCaption = "Every purchased material's latest price, from its price history.";
    private const string CostBuffersCaption = "Every purchased material's buffered cost against the brand it's costed at now.";
    private const string CostDriversCaption = "The purchased materials that make up most of the material cost of the products in Production, at buffered costs.";
    private string MarginErosionCaption => $"Each product's markup at its Current Price on {State!.MarginErosionSince:MMM d, yyyy}, against now, in percentage points.";

    [Inject] private PrintPreviews Previews { get; set; } = null!;
    [Inject] private PrintPage PageSetup { get; set; } = null!;
    [Inject] private Serilog.ILogger PrintLogger { get; set; } = null!;

    protected override ScreenCommand LoadCommand => State!.LoadCommand;

    // Print: the table as it's shown, in the Print dialog, on Settings → Printing's page as it's saved now. A grid that
    // can't be read says so in a toast.
    private async Task PrintAsync<TRow>(SfGrid<TRow>? grid, string title, string caption)
    {
        if (grid is null)
        {
            return;
        }

        try
        {
            await PageSetup.RefreshAsync(CancellationToken.None);
            Previews.ShowTables(await GridPrints.PrintoutAsync(grid, title, caption, DateTime.Now));
        }
        catch (Exception exception)
        {
            PrintLogger.Warning(exception, "Printing the {Report} report failed", title);
            ScreenNotices.ShowError($"{title} couldn't be printed: {exception.Message}");
        }
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();

        // The page's grids are new, with nothing picked: Cost Buffers' picks went with the grid they were made in.
        State!.SelectedCostBuffers.Clear();

        // Export to Excel: the table named, as it's shown, under "<title> yyyy-MM-dd.xlsx", where the Save dialog
        // says. The grid makes the workbook itself, as it shows the table.
        AddSubscription(State!.ExportToExcel.RegisterHandler(async interaction =>
        {
            var fileName = $"{interaction.Input} {DateTime.Today:yyyy-MM-dd}.xlsx";
            var path = await Dialogs.ChooseSaveFileAsync(fileName, ExcelWorkbook.Kind);
            if (path is null)
            {
                interaction.SetOutput(null);
                return;
            }

            var properties = new ExcelExportProperties { FileName = fileName };
            var workbook = interaction.Input switch
            {
                ReportsState.ProductCostSummaryTitle => await WorkbookOfAsync(_productCosts, properties),
                ReportsState.CostBuffersTitle => await WorkbookOfAsync(_costBuffers, properties),
                ReportsState.CostDriversTitle => await WorkbookOfAsync(_costDrivers, properties),
                ReportsState.MarginErosionTitle => await WorkbookOfAsync(_marginErosion, properties),
                ReportsState.RawMaterialPriceSummaryTitle => await WorkbookOfAsync(_rawMaterialPrices, properties),
                _ => null,
            };
            if (workbook is null)
            {
                interaction.SetOutput(null);
                return;
            }

            await File.WriteAllBytesAsync(path, workbook);
            interaction.SetOutput(path);
        }));
    }

    // The grid's own Excel export, the table as it's shown (GridExports).
    private static async Task<byte[]?> WorkbookOfAsync<TRow>(SfGrid<TRow>? grid, ExcelExportProperties properties) =>
        grid is null ? null : await GridExports.WorkbookAsync(grid, properties);

    // A table as it was left, for the Windows user: its sort, filters and columns.
    private Task RestoreAsync<TRow>(SfGrid<TRow>? grid, string key) => GridLayouts.RestoreAsync(grid, ViewState, key);

    private Task SaveAsync<TRow>(SfGrid<TRow>? grid, string key, Syncfusion.Blazor.Grids.Action action) =>
        GridLayouts.SaveAfterAsync(grid, ViewState, key, action);

    private Task OpenProductAsync(RecordDoubleClickEventArgs<ProductCostRow> args) =>
        args.RowData is { } row ? Commands.Run(State!.OpenProductCommand, row.ProductId) : Task.CompletedTask;

    private Task OpenRawMaterialAsync(RecordDoubleClickEventArgs<RawMaterialPriceSummaryRow> args) =>
        args.RowData is { } row ? Commands.Run(State!.OpenRawMaterialCommand, row.RawMaterialId) : Task.CompletedTask;

    private Task OpenCostBufferMaterialAsync(RecordDoubleClickEventArgs<CostBufferRow> args) =>
        args.RowData is { } row ? Commands.Run(State!.OpenRawMaterialCommand, row.RawMaterialId) : Task.CompletedTask;

    private Task OpenCostDriverMaterialAsync(RecordDoubleClickEventArgs<CostDriverRow> args) =>
        args.RowData is { } row ? Commands.Run(State!.OpenRawMaterialCommand, row.RawMaterialId) : Task.CompletedTask;

    private Task OpenErodedProductAsync(RecordDoubleClickEventArgs<MarginErosionRow> args) =>
        args.RowData is { } row ? Commands.Run(State!.OpenProductCommand, row.ProductId) : Task.CompletedTask;

    // The materials picked in Cost Buffers, which Re-apply Target Buffer takes.
    private async Task SyncCostBuffersAsync(object args)
    {
        if (_costBuffers is null)
        {
            return;
        }

        var picked = await _costBuffers.GetSelectedRecordsAsync();
        State!.SelectedCostBuffers.Clear();
        foreach (var row in picked)
        {
            State.SelectedCostBuffers.Add(row);
        }
    }

    private async Task OpenColumnChooserAsync()
    {
        if (_productCosts is not null)
        {
            await _productCosts.OpenColumnChooserAsync(null, null);
        }
    }
}
