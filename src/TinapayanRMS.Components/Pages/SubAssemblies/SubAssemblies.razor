@page "/sub-assemblies"
@page "/sub-assemblies/{Id:int}"
@page "/sub-assemblies/new/{Number:int}"
@inherits RecordViewBase<SubAssembliesState, SubAssemblyForm>
@inject Prompts Prompts

<PageTitle>@(State!.Form?.SelectedRow?.Name ?? "Sub-Assemblies") · TinapayanRMS</PageTitle>

@* The Sub-Assemblies view: the standalone sub-assemblies, the list by role, beside a strip of tabs, a sub-assembly open in
   each, as Visual Studio Code's editors are; under it, the form of the tab showing (SubAssemblyFormView), drawn afresh as
   another tab shows, each keeping what's typed into it. A sub-assembly picked in the list opens in the preview tab, which
   the next one picked replaces while it holds nothing unsaved. *@
<div class="record-screen">
    <SubAssembliesListCard List="State!.List" />

    <div class="record-details">
        <RecordTabStrip TForm="SubAssemblyForm" Tabs="State!.Tabs" AddressOf="AddressOf" Close="CloseAsync" Keep="State!.Keep" Label="Sub-assemblies open" />

        @if (State!.Form is { } form)
        {
            <SubAssemblyFormView @key="form" Form="form" />
        }
        else
        {
            <section class="card empty-record">
                <p>No sub-assembly is open. Pick one in the list, or start a new one.</p>
                <CommandButton Command="State!.NewCommand" Icon="AppIcon.Add" Label="New" />
            </section>
        }
    </div>
</div>

@code {
    protected override ScreenCommand LoadCommand => State!.LoadCommand;

    protected override string AddressRoot => "sub-assemblies";

    protected override void OnInitialized()
    {
        base.OnInitialized();

        // Make In-House Ingredient: the made ingredient's name and the Made category it goes in.
        AddSubscription(State!.List.PromptForMadeIngredient.RegisterHandler(async interaction =>
            interaction.SetOutput(await Prompts.AskChoiceAsync(interaction.Input))));
    }

    // A tab's ✕: asks about its changes first, showing it, and stays on Cancel.
    private async Task CloseAsync(RecordTab<SubAssemblyForm> tab) => await State!.CloseTabAsync(tab);
}
