@page "/sub-assemblies"
@page "/sub-assemblies/{Id:int}"
@inherits RecordScreenBase<SubAssembliesViewModel>
@inject Prompts Prompts

<PageTitle>@(ViewModel!.SelectedRow?.Name ?? "Sub-Assemblies") · TinapayanRMS</PageTitle>

<UndoKeys Screen="ViewModel!" Redraw="RedrawNowAsync" />

@* The standalone sub-assemblies (the WPF SubAssembliesView): the list by role, beside the picked one's header, with its
   batch figures, and its Recipe and Dependents tabs. One in the Packaging role is a packaging set: packaging materials per
   set instead of ingredients in grams, and one figure, Set Cost. *@
<CascadingValue Value="(IUndoRecorder)ViewModel!" IsFixed="true">
    <div class="record-screen">
        <SubAssemblyList List="ViewModel!.List" />

        <div class="record-details">
            <section class="card header-card">
                <div class="header-title-row">
                    <h1 class="header-title">@ViewModel!.HeaderTitle</h1>
                    <div class="button-row">
                        <CommandButton Command="ViewModel!.NewCommand" Icon="AppIcon.Add" Label="New" />
                        <CommandButton Command="ViewModel!.CopyCommand" Icon="AppIcon.Copy" Label="Copy"
                                       Tooltip="Starts a new sub-assembly with this one's role and lines, named '… Copy'. Rename it if you like, then Save; this one stays as it was saved." />
                        <CommandButton Command="ViewModel!.NewProductCommand" Icon="AppIcon.Link" Label="New Product"
                                       Tooltip="Starts a new product on the Products screen that links this sub-assembly, named after it. Type its piece size, then Save there. Not for a packaging set." />
                        <CommandButton Command="ViewModel!.SaveCommand" Icon="AppIcon.Save" Label="Save" Primary="true" Tooltip="Saves the name, role and lines together." />
                        <CommandButton Command="ViewModel!.UndoCommand" Icon="AppIcon.Undo" Label="Undo" Tooltip="Takes back the last change: a quantity typed, a line added or removed. Ctrl+Z." />
                        <CommandButton Command="ViewModel!.RedoCommand" Icon="AppIcon.Redo" Label="Redo" Tooltip="Puts back the change the last Undo took. Ctrl+Y." />
                        <CommandButton Command="ViewModel!.DeleteCommand" Icon="AppIcon.Delete" Label="Delete" />
                    </div>
                </div>

                <div class="section-divider"></div>

                <div class="figure-tiles">
                    @if (ViewModel!.IsPackaging)
                    {
                        <div class="figure-tile tile-flamingo">
                            <div class="figure-label">Set Cost</div>
                            <div class="figure-value">@ViewModel!.PackagingSet.Cost.ToString("N4")</div>
                        </div>
                        <div class="figure-tile"></div>
                        <div class="figure-tile"></div>
                    }
                    else
                    {
                        <div class="figure-tile tile-teal">
                            <div class="figure-label">Batch Weight</div>
                            <div class="figure-value">@ViewModel!.Batch.BatchWeight.ToString("#,0.##") g</div>
                        </div>
                        <div class="figure-tile tile-flamingo">
                            <div class="figure-label">Batch Cost</div>
                            <div class="figure-value">@ViewModel!.Batch.BatchCost.ToString("N2")</div>
                        </div>
                        <div class="figure-tile tile-yellow">
                            <div class="figure-label">Cost per g</div>
                            <div class="figure-value">@ViewModel!.Batch.CostPerGram.ToString("N4")</div>
                        </div>
                    }
                </div>

                <div class="header-fields">
                    <label class="form-label" for="sa-name">Name</label>
                    <TextField ID="sa-name" @bind-Value="ViewModel!.EditingName" CssClass="field-wide" />
                    <label class="form-label" for="sa-role">Role</label>
                    <PickField ID="sa-role" TItem="SubAssemblyRole" Items="ViewModel!.Roles" TextField="Name" @bind-Value="ViewModel!.EditingRole" />
                </div>
            </section>

            <section class="card tabs-card">
                <SfTab @bind-SelectedItem="ViewModel!.SelectedDetailsTab" HeaderPlacement="HeaderPosition.Bottom" LoadOn="ContentLoad.Init" CssClass="details-tabs">
                    <TabItems>
                        <TabItem>
                            <ChildContent><TabHeader Text="Recipe" /></ChildContent>
                            <ContentTemplate>
                                <div class="tab-card">
                                    <h2 class="section-header">Lines</h2>
                                    @if (ViewModel!.IsPackaging)
                                    {
                                        <PackagingLinesGrid @ref="_packagingLines" Items="ViewModel!.PackagingSet.Lines" NewItem="ViewModel!.PackagingSet.NewLine" Materials="ViewModel!.PackagingMaterials"
                                                            @bind-SelectedItem="ViewModel!.PackagingSet.SelectedLine" CostHeader="Cost per Set" />
                                    }
                                    else
                                    {
                                        <IngredientLinesGrid @ref="_lines" Items="ViewModel!.Batch.Lines" NewItem="ViewModel!.Batch.NewLine" Ingredients="ViewModel!.Ingredients"
                                                             @bind-SelectedItem="ViewModel!.Batch.SelectedLine" PercentHeader="@ViewModel!.Batch.PercentHeader" />
                                    }
                                    <div class="lines-footer">
                                        <p class="caption">
                                            @(ViewModel!.IsPackaging
                                                ? "A product whose packaging links this set takes one whole set per sellable unit."
                                                : ViewModel!.Batch.FormulaBaseCaption)
                                        </p>
                                        <div class="button-row">
                                            <ActionButton Icon="AppIcon.Add" Label="Insert Line" OnClick="InsertLineAsync"
                                                          Tooltip="Puts a blank line in above the selected one, or at the bottom with none selected. Insert." />
                                            <CommandButton Command="ViewModel!.RemoveLineCommand" CssClass="remove-line" Icon="AppIcon.Remove" Label="Remove Line" />
                                        </div>
                                    </div>
                                    @if (!ViewModel!.IsPackaging)
                                    {
                                        <div class="scale-row">
                                            <label class="form-label" for="sa-scale-basis">Scale</label>
                                            <PickField ID="sa-scale-basis" TItem="BatchScaleOption" Items="ViewModel!.Batch.ScaleOptions" TextOf="o => o.Label"
                                                       Value="ViewModel!.Batch.ScaleOption" ValueChanged="o => { if (o is not null) ViewModel!.Batch.ScaleOption = o; }" CssClass="scale-basis" />
                                            <span>to</span>
                                            <NumberField TValue="decimal?" Value="ViewModel!.Batch.ScaleTo" ValueChanged="v => ViewModel!.Batch.ScaleTo = v" Format="#,0.##" Min="0"
                                                         Placeholder="Grams" CssClass="scale-to" />
                                            <span>g</span>
                                            <CommandButton Command="ViewModel!.Batch.ScaleCommand" Icon="AppIcon.Calculate" Label="Scale"
                                                           Tooltip="Multiplies every line so the batch, or its base, weighs this much. Each line keeps its percentage. Undo takes it back." />
                                        </div>
                                    }
                                </div>
                            </ContentTemplate>
                        </TabItem>
                        <TabItem>
                            <ChildContent><TabHeader Text="Dependents" /></ChildContent>
                            <ContentTemplate>
                                <div class="tab-card">
                                    <h2 class="section-header">Dependents</h2>
                                    <DependentTiles Products="ViewModel!.Dependents.Products" MadeIngredients="ViewModel!.Dependents.MadeIngredients" Caption="@ViewModel!.Dependents.Text"
                                                 Open="id => Commands.Run(ViewModel!.Dependents.OpenProductCommand, id)" OpenMadeIngredient="id => Commands.Run(ViewModel!.Dependents.OpenRawMaterialCommand, id)" />
                                </div>
                            </ContentTemplate>
                        </TabItem>
                    </TabItems>
                </SfTab>
            </section>
        </div>
    </div>
</CascadingValue>

@code {
    private IngredientLinesGrid? _lines;
    private PackagingLinesGrid? _packagingLines;

    // Insert Line in the table showing: a recipe's lines, or a packaging set's.
    private Task InsertLineAsync() =>
        (ViewModel!.IsPackaging ? _packagingLines?.InsertLineAsync() : _lines?.InsertLineAsync()) ?? Task.CompletedTask;

    protected override ReactiveCommand<RxVoid, RxVoid> LoadCommand => ViewModel!.LoadCommand;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        var viewModel = ViewModel!;

        // Make In-House Ingredient: the made ingredient's name and the Made category it goes in.
        AddSubscription(viewModel.List.PromptForMadeIngredient.RegisterHandler(async interaction =>
            interaction.SetOutput(await Prompts.AskChoiceAsync(interaction.Input))));
    }

    protected override string AddressRoot => "sub-assemblies";

    protected override int? ShownId => ViewModel!.SelectedRow?.Id;

    protected override string ShownProperty => nameof(SubAssembliesViewModel.SelectedRow);

    protected override void Open(int id) => ViewModel!.OpenSubAssembly(id);

    protected override void OpenOnLoad(int id) => ViewModel!.OpenSubAssemblyOnLoad(id);
}
