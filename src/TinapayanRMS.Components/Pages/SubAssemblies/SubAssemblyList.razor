@* Sub-Assemblies' list (the WPF SubAssemblyListCard): a search box; the list's commands as icons; the standalone
   sub-assemblies in a folder for each role; and what the last move did, with Undo. Dragging sub-assemblies onto another
   role's folder gives them that role, saved at once; a right-click opens the row's menu, or the list's. A name is typed
   in place, as in a file explorer (TreeNameEdit): a sub-assembly or role renamed, or a new sub-assembly or folder named. *@
<section class="card list-card tree-card">
    <div class="list-heading">
        <h2 class="section-header">Sub-Assemblies</h2>
        @* Not one of the form's boxes: it keeps the cursor, and what's typed, when another record takes the form. *@
        <CascadingValue TValue="IUndoRecorder" Value="null" IsFixed="true">
            <TextField @bind-Value="List.SearchText" Placeholder="Search sub-assembly" CssClass="list-search" />
        </CascadingValue>
    </div>

    <div class="list-toolbar">
        <ActionButton Icon="AppIcon.Add" Tooltip="New Sub-Assembly" Flat="true" OnClick="() => Commands.Run(List.NewSubAssemblyInCommand, null)" />
        <CommandButton Command="List.NewRoleCommand" Icon="AppIcon.NewFolder" Tooltip="New Folder: a role" Flat="true" />
        <CommandButton Command="List.ExpandAllCommand" Icon="AppIcon.ExpandAll" Tooltip="Expand All" Flat="true" />
        <CommandButton Command="List.CollapseAllCommand" Icon="AppIcon.CollapseAll" Tooltip="Collapse All" Flat="true" />
    </div>

    <FolderTree TNode="SubAssemblyTreeNode"
                Roots="List.SubAssemblyTree.Roots"
                ChildrenOf="n => n is SubAssemblyFolderNode folder ? folder.Children : null"
                IsExpanded="n => n is SubAssemblyFolderNode { IsExpanded: true }"
                SetExpanded="(n, open) => { if (n is SubAssemblyFolderNode folder) folder.IsExpanded = open; }"
                Selected="List.SelectedTreeNodes"
                KeyOf="KeyOf"
                RowClass="@(n => n.IsFolder ? "top-level" : null)"
                CanDrag="n => Screen.CanDrag(n)"
                IsEditing="IsEditing"
                RenamesOnSecondClick="n => n is SubAssemblyLeafNode { IsNew: false }"
                CanDrop="(dragged, target) => Screen.CanDrop(dragged, target)"
                OnDrop="(dragged, target) => Screen.DropAsync(dragged, target)"
                MenuFor="List.TreeMenuFor"
                Shortcut="List.TreeShortcut">
        <RowTemplate Context="node">
            @if (node.IsFolder)
            {
                <span class="@AppIcons.CssOf(node.Icon!.Value) tree-glyph" aria-hidden="true"></span>
            }
            @if (List.TreeNameEdit is { } edit && ReferenceEquals(edit.Node, node))
            {
                @* Keyed by the edit: a name refused comes back as a new one, and a new box. *@
                <TreeNameBox @key="edit" InitialText="@edit.InitialText" Hint="@edit.Hint"
                             OnCommit="List.CommitTreeNameAsync" OnCancel="List.CancelTreeName" />
            }
            else
            {
                <span class="tree-title">@node.Title</span>
                @if (node.IsFolder)
                {
                    <span class="tree-count">(@node.SubAssemblyCount)</span>
                }
            }
        </RowTemplate>
    </FolderTree>

    <MoveNoticeBar Notice="@List.MoveNotice" UndoCommand="List.UndoMoveCommand" DismissCommand="List.DismissMoveNoticeCommand" />
</section>

@code {
    [Parameter, EditorRequired] public SubAssembliesList List { get; set; } = null!;

    private static string KeyOf(SubAssemblyTreeNode node) => node switch
    {
        SubAssemblyFolderNode folder => "role-" + folder.Key,
        SubAssemblyLeafNode leaf => "sub-assembly-" + leaf.SubAssembly.Id,
        _ => node.Title,
    };

    private bool IsEditing(SubAssemblyTreeNode node) => ReferenceEquals(List.TreeNameEdit?.Node, node);

    // What can be dragged and dropped where is the list's to say (IListTreeScreen), as its tests check it.
    private IListTreeScreen Screen => List;
}
