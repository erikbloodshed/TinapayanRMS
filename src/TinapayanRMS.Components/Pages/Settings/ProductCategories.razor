@page "/settings/product-categories"
@inherits ScreenBase<ProductCategoriesState>

<PageTitle>Product Categories · TinapayanRMS</PageTitle>

<SettingsTabs />

<div class="list-and-form">
    <section class="card list-card">
        <h2 class="section-header">Product Categories</h2>
        <PickGrid TItem="ProductCategory" DataSource="State!.Items" SelectedItem="State!.SelectedItem" SelectedItemChanged="State!.Pick">
            <Columns>
                <GridColumn Field="@nameof(ProductCategory.Id)" IsPrimaryKey="true" Visible="false" />
                <GridColumn Field="@nameof(ProductCategory.Name)" HeaderText="Name" />
                <GridColumn Field="@nameof(ProductCategory.WastagePercent)" HeaderText="Wastage %" Format="N2" TextAlign="TextAlign.Right" Width="110" />
            </Columns>
        </PickGrid>
    </section>

    <section class="card form-card">
        <h2 class="section-header">@State!.FormTitle</h2>
        <FormRow Label="Name" For="product-category-name">
            <TextField ID="product-category-name" @bind-Value="State!.EditingName" />
        </FormRow>
        <FormRow Label="Wastage %" For="product-category-wastage">
            <NumberField ID="product-category-wastage" TValue="decimal?" @bind-Value="State!.EditingWastagePercent" Format="N2" Min="0" Max="100" Placeholder="Shop-wide"
                         Tooltip="What's lost making this category's products, as a cost on top of their sub-assemblies, in place of the shop-wide Wastage % (Costing Defaults). Blank uses the shop-wide one." />
        </FormRow>
        <p class="caption form-extra">Blank uses the shop-wide Wastage % from Costing Defaults. A composite product uses its own category's, not its products'.</p>
        <div class="button-row">
            <CommandButton Command="State!.NewCommand" Icon="AppIcon.Add" Label="New" />
            <CommandButton Command="State!.SaveCommand" Icon="AppIcon.Save" Label="Save" Primary="true" />
            <CommandButton Command="State!.DeleteCommand" Icon="AppIcon.Delete" Label="Delete" />
        </div>
    </section>
</div>

@code {
    protected override ScreenCommand LoadCommand => State!.LoadCommand;
}
