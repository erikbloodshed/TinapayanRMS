@page "/settings/costing-defaults"
@using TinapayanRMS.Domain.Enums
@inherits ScreenBase<CostingDefaultsState>

<PageTitle>Costing Defaults · TinapayanRMS</PageTitle>

<SettingsTabs />

@* The two cards side by side, each as tall as its own content; in a narrow window Stored Costs wraps under the defaults. *@
<div class="card-wrap">
    <section class="card fixed-card">
        <h2 class="section-header">Costing Defaults</h2>
        <p class="caption">Where a new product goes, what its costing starts with (unless its category sets its own, in Product Categories), and what a new raw material's cost buffer starts with: each keeps its own from its first Save, so changing these doesn't change anything saved. VAT % and Wastage % are different: every product is priced with them (Wastage % unless its category sets its own), so changing either reprices them all. Warn Below % only changes which products are flagged short of their target markup.</p>

        <FormRow Label="New Products In" For="new-products-in">
            <PickField ID="new-products-in" TItem="KeyValuePair<ProductStage, string>" Items="State!.Stages" TextOf="s => s.Value"
                       Value="State!.Stages.FirstOrDefault(s => s.Key == State!.EditingNewProductStage)" ValueChanged="s => State!.EditingNewProductStage = s.Key"
                       Tooltip="Where New files a product. New Product Here uses its folder; clones and variants go in Innovation." />
        </FormRow>
        <FormRow Label="Labor %" For="labor-percent">
            <NumberField TValue="decimal" Format="N2" Min="0" ID="labor-percent" @bind-Value="State!.EditingLaborPercent" Tooltip="Of the sub-assemblies (ingredients) cost per piece, unless the product's category sets its own" />
        </FormRow>
        <FormRow Label="Overhead %" For="overhead-percent">
            <NumberField TValue="decimal" Format="N2" Min="0" ID="overhead-percent" @bind-Value="State!.EditingOverheadPercent" Tooltip="Of the sub-assemblies (ingredients) cost per piece, unless the product's category sets its own" />
        </FormRow>
        <FormRow Label="Administrative %" For="administrative-percent">
            <NumberField TValue="decimal" Format="N2" Min="0" ID="administrative-percent" @bind-Value="State!.EditingAdministrativePercent" Tooltip="Of the sub-assemblies (ingredients) cost per piece: office, permits, bookkeeping. Unless the product's category sets its own." />
        </FormRow>
        <FormRow Label="Markup %" For="markup-percent">
            <NumberField TValue="decimal" Format="N2" Min="0" ID="markup-percent" @bind-Value="State!.EditingMarkupPercent" Tooltip="On the base cost: materials, wastage, labor, overhead and administrative. Unless the product's category sets its own." />
        </FormRow>
        <FormRow Label="VAT %" For="vat-percent">
            <NumberField TValue="decimal" Format="N2" Min="0" ID="vat-percent" @bind-Value="State!.EditingVatPercent" Tooltip="VAT on top of the marked-up price. Changing it reprices every product." />
        </FormRow>
        <FormRow Label="Wastage %" For="wastage-percent">
            <NumberField TValue="decimal" Format="N2" Min="0" ID="wastage-percent" @bind-Value="State!.EditingWastagePercent" Max="100m" Tooltip="What's lost making a product, as a cost on its ingredients (not packaging), unless its category sets one. 3% adds ₱3 per ₱100." />
        </FormRow>
        <FormRow Label="Cost Buffer %" For="cost-buffer-percent">
            <NumberField TValue="decimal" Format="N2" Min="0" ID="cost-buffer-percent" @bind-Value="State!.EditingCostBufferPercent" Max="100m" Tooltip="What a new raw material's Cost Buffer % starts at: a cushion on top of its cost for price swings and waste" />
        </FormRow>
        <FormRow Label="Price Rounding" For="price-rounding">
            <PickField ID="price-rounding" TItem="PriceRoundingOption" Items="State!.PriceRoundingOptions" TextOf="o => o.Label"
                       Value="State!.EditingPriceRounding" ValueChanged="o => { if (o is not null) State!.EditingPriceRounding = o; }"
                       Tooltip="Rounds suggested prices up to a price you'd charge, shown beside the exact one. Exact figures don't change." />
        </FormRow>
        <FormRow Label="Warn Below %" For="markup-floor-percent">
            <NumberField TValue="decimal?" Format="N2" Min="0" ID="markup-floor-percent" @bind-Value="State!.EditingMarkupFloorPercent" Placeholder="Markup Metric"
                         Tooltip="A product is flagged when its current price earns under both its Markup Metric and this. At 28%, one aiming for 30% is flagged under 28%. Blank flags any shortfall. A category can set its own." />
        </FormRow>

        <div class="button-row form-extra">
            <CommandButton Command="State!.SaveCommand" Icon="AppIcon.Save" Label="Save" Primary="true" />
        </div>
    </section>

    <section class="card fixed-card">
        <h2 class="section-header">Stored Costs</h2>
        <p class="caption">Each Save keeps made and linked ingredients' costs, and sub-assemblies' totals, up to date. If the database was changed outside the app, work them all out again from what they're made of.</p>
        <CommandButton Command="State!.RecalculateCostsCommand" Icon="AppIcon.Calculate" Label="Recalculate Costs" />
    </section>
</div>

@code {
    protected override ScreenCommand LoadCommand => State!.LoadCommand;
}
