@page "/settings/security"
@using System.Reactive.Linq
@using TinapayanRMS.ApplicationCore.Rules
@inherits ScreenBase<SecurityState>

<PageTitle>Security · TinapayanRMS</PageTitle>

<SettingsTabs />

@* The app's password and its auto-lock, both kept in the database (AccessSettings). The password boxes are cleared after
   each try, so they're drawn afresh then: a box never has its text rewritten while it has the cursor. What a box sends
   during a try is dropped: Enter in a box also sends its text as a change, which would otherwise land after the try had
   cleared it and come back in the fresh box. *@
<div class="card-wrap">
    <section class="card fixed-card">
        <h2 class="section-header">Password</h2>
        @if (State!.HasPassword)
        {
            <p class="caption">The app asks for it as it opens and whenever the window is locked. To change it, type the current one, then the new one twice. Forgotten, it can be cleared on this computer with scripts\Reset-Password.ps1, and the app then asks for a new one.</p>
        }
        else
        {
            <p class="caption">There's no password: anyone can open the app. Set one, and the app asks for it as it opens and whenever the window is locked.</p>
        }

        <div @key="_attempt">
            @if (State!.HasPassword)
            {
                <FormRow Label="Current Password" For="current-password">
                    <TextField ID="current-password" Password="true" Value="@State!.CurrentPassword" ValueChanged="v => Typed(() => State!.CurrentPassword = v)" />
                </FormRow>
            }
            <FormRow Label="New Password" For="new-password">
                <TextField ID="new-password" Password="true" Value="@State!.NewPassword" ValueChanged="v => Typed(() => State!.NewPassword = v)"
                           Tooltip="@($"At least {PasswordRules.MinLength} characters")" />
            </FormRow>
            <FormRow Label="Type It Again" For="password-confirmation">
                <TextField ID="password-confirmation" Password="true" Value="@State!.Confirmation" ValueChanged="v => Typed(() => State!.Confirmation = v)"
                           OnEnter="ChangePasswordAsync" />
            </FormRow>
        </div>

        <div class="button-row form-extra">
            <ActionButton Label="@(State!.HasPassword ? "Change Password" : "Set Password")" Icon="AppIcon.Lock" Primary="true" OnClick="ChangePasswordAsync" Disabled="_busy" />
        </div>
    </section>

    <section class="card fixed-card">
        <h2 class="section-header">Auto-Lock</h2>
        <p class="caption">The window locks itself after this many minutes without a key, a click or a scroll in it, and the password opens it again where you left off. 0 locks it only when you click Lock in the title bar.</p>
        <FormRow Label="Lock After (Minutes)" For="auto-lock-minutes">
            <NumberField ID="auto-lock-minutes" TValue="int" Format="N0" Min="0" Max="PasswordRules.MaxAutoLockMinutes"
                         @bind-Value="State!.EditingAutoLockMinutes" CssClass="field-narrow"
                         Tooltip="@($"0 for never, up to {PasswordRules.MaxAutoLockMinutes} (four hours)")" />
        </FormRow>
        <div class="button-row form-extra">
            <CommandButton Command="State!.SaveAutoLockCommand" Icon="AppIcon.Save" Label="Save" />
        </div>
    </section>
</div>

@code {
    private bool _busy;

    // Bumped after every try: the password boxes are drawn afresh, empty.
    private int _attempt;

    protected override ScreenCommand LoadCommand => State!.LoadCommand;

    // A box's text, unless a try is running: see the note at the top.
    private void Typed(Action set)
    {
        if (!_busy)
        {
            set();
        }
    }

    private async Task ChangePasswordAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            await State!.ChangePasswordCommand.ExecuteAsync();
        }
        finally
        {
            _busy = false;
            _attempt++;
        }
    }
}
