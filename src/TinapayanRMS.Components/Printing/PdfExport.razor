@using Microsoft.AspNetCore.Components.Sections
@implements IDisposable
@inject IFileDialogs Dialogs
@inject IAppWindow Window
@inject PrintPage PageSetup
@inject IJSRuntime JS

@* Export to PDF: asks where to save the pages, then draws them out of sight for as long as the window takes to write the
   file. They're drawn in the layout's outlet (OutletName), outside the window's shell as the Print dialog's document is,
   so on paper print.css puts the shell away and prints them alone, at the paper's width: drawn in the product's tab,
   the list beside it printed too, and squeezed the pages off the paper's edge. *@
@if (_set is not null)
{
    <SectionContent SectionName="@OutletName">
        <div class="pdf-export" aria-hidden="true">
            <PrintDocument Set="_set" IncludeRecipe="true" IncludeCosting="true" />
        </div>
    </SectionContent>
}

@code {
    /// <summary>The layout's outlet the pages are drawn in, outside the window's shell (MainLayout).</summary>
    public const string OutletName = "pdf-export";

    private const string Kind = "PDF document";

    private IDisposable? _handler;
    private ProductPrintSet? _set;
    private TaskCompletionSource? _drawn;

    /// <summary>The screen's question: these pages, answered with where they were saved, or null when cancelled.</summary>
    [Parameter, EditorRequired] public Interaction<ProductPrintSet, string?> Export { get; set; } = null!;

    protected override void OnInitialized() => _handler = Export.RegisterHandler(SaveAsync);

    protected override void OnAfterRender(bool firstRender)
    {
        if (_set is not null)
        {
            _drawn?.TrySetResult();
        }
    }

    private async Task SaveAsync(InteractionContext<ProductPrintSet, string?> interaction)
    {
        _drawn = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
        var path = await Dialogs.ChooseSaveFileAsync(FileNameOf(interaction.Input), Kind);
        if (path is null)
        {
            interaction.SetOutput(null);
            return;
        }

        try
        {
            await PageSetup.RefreshAsync(CancellationToken.None);
            _set = interaction.Input;
            await InvokeAsync(StateHasChanged);
            await _drawn.Task;
            // The pages broken as the print preview breaks them, before the window writes them: the web view's PDF fires no
            // beforeprint, and PrintDocument's own call isn't awaited.
            await JS.InvokeVoidAsync("tinapayan.layOutPrintoutPages");
            await Window.SavePageAsPdfAsync(path);
        }
        finally
        {
            _set = null;
            await InvokeAsync(StateHasChanged);
        }

        interaction.SetOutput(path);
    }

    // The set's title or the product's name, less what Windows refuses in a file's name ("Ube/Cheese Roll" is
    // "Ube-Cheese Roll.pdf"). The print preview's Export to PDF suggests the same.
    internal static string FileNameOf(ProductPrintSet set) => FileNameOf(set.Title ?? set.Products[0].ProductName);

    // A name, less what Windows refuses in a file's name, as a PDF's.
    internal static string FileNameOf(string name)
    {
        foreach (var refused in Path.GetInvalidFileNameChars())
        {
            name = name.Replace(refused, '-');
        }

        return $"{name.Trim().TrimEnd('.')}.pdf";
    }

    public void Dispose()
    {
        _handler?.Dispose();
        _drawn?.TrySetCanceled();
    }
}
