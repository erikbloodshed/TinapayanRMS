@using System.Globalization
@using TinapayanRMS.ApplicationCore.Rules
@using TinapayanRMS.Domain.Enums
@inject PrintPage PageSetup
@inject IJSRuntime JS

@* A printout as a document the browser prints, built from a ProductPrintSet:
   one product's recipe and costing; a set of products, each starting a page of its own after a
   title and contents; or a Price Simulator report, with today's figures beside the simulated ones.
   Each part that starts a page on paper is a print-sheet, which the preview draws as a sheet of paper of its own. Within
   one, app.js works out the pages each time it's drawn and as it's printed (a heading kept with its table, a table's
   totals once, after its last row, the part's name and a split table's column headings at the top of each page after its
   first, "Continued on page n" under a table that goes on, and a set's contents' page numbers), and the browser numbers
   the pages. The page is Settings → Printing's (PrintPage): the paper's size and margins, and the note at each page's foot,
   for @page; each sheet's size on the screen and the type's; the height app.js fills each page to; the shop's heading at
   the top of each part; and the columns and parts it leaves out. *@
<style>@PageRule</style>
<div class="print-document" style="@SheetStyle" data-page-height="@PageSetup.PrintedArea.Height.ToString("0.##", CultureInfo.InvariantCulture)">
    @if (Tables is { } tables)
    {
        <section class="print-sheet print-tables">
            @ShopHeading
            <header class="print-title">
                <h1>@tables.Title</h1>
                @foreach (var line in tables.Lines)
                {
                    <p class="print-muted">@line</p>
                }
                <p class="print-small">Printed @Printed(tables.PrintedAt)@(tables.SaveNote is { } note ? " · " + note : "")</p>
            </header>
            @if (tables.SaveNote == ProductPrintout.UnsavedChangesNote || tables.SaveNote == ProductPrintout.NotSavedNote)
            {
                <p class="print-draft">Draft: @(tables.SaveNote == ProductPrintout.NotSavedNote ? "this hasn't been saved yet" : "it includes changes not yet saved"). Save it before it's used.</p>
                <div class="print-draft-mark" aria-hidden="true">Draft</div>
            }
            @foreach (var table in tables.Tables)
            {
                @TablePart(table)
            }
        </section>
    }
    else if (Set.Title is { } title)
    {
        <section class="print-sheet">
            @ShopHeading
            <header class="print-title">
                <h1>@title</h1>
                <p class="print-muted">@Set.Products.Count @(Set.Products.Count == 1 ? "product" : "products") · @Parts · Printed @Printed(Set.PrintedAt)</p>
                <p class="print-small">As saved: edits not yet saved on the Products screen aren't in these pages.</p>
                @if (IsSimulation)
                {
                    <p class="print-small">At buffered costs, with the price changes tried on the Price Simulator screen, beside today's figures. Nothing in it is saved.</p>
                }
            </header>

            @if (IsSimulation)
            {
                @PriceChanges("Price Changes", Set.PriceChanges ?? [], "No price changes tried: every figure is today's.")
            }

            <h2 class="print-section">Products</h2>
            @if (Set.Products.Count == 0)
            {
                <p class="print-muted">No products in @title.</p>
            }
            else if (IsSimulation)
            {
                <table class="print-table">
                    <thead><tr><th>Product</th><th class="n">Base Cost</th><th class="n">Simulated Base Cost</th><th class="n">Change %</th><th class="n">Page</th></tr></thead>
                    <tbody>
                        @foreach (var product in Set.Products)
                        {
                            var now = product.Simulation?.Now ?? product.Costs;
                            <tr><td>@product.ProductName</td><td class="n">@Money(now.BaseCost)</td><td class="n">@Money(product.Costs.BaseCost)</td><td class="n">@ChangePercent(now.BaseCost, product.Costs.BaseCost)</td><td class="n print-contents-page"></td></tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <table class="print-table">
                    <thead><tr><th>Product</th><th>Folder</th><th class="n">Page</th></tr></thead>
                    <tbody>
                        @foreach (var product in Set.Products)
                        {
                            <tr><td>@product.ProductName</td><td>@product.StageTitle › @product.CategoryName</td><td class="n print-contents-page"></td></tr>
                        }
                    </tbody>
                </table>
            }
        </section>
    }

    @if (Tables is null)
    {
        @foreach (var product in Set.Products)
        {
            <article class="print-sheet print-product">@ShopHeading@ProductPart(product)</article>
        }
    }
</div>

@code {
    /// <summary>The products to print; or set <see cref="Tables"/> instead.</summary>
    [Parameter] public ProductPrintSet Set { get; set; } = null!;

    /// <summary>Tables to print instead of products: a Reports table as it's shown, a sub-assembly's recipe.</summary>
    [Parameter] public TablePrintout? Tables { get; set; }

    // A table printout's cell: a figure at the right, a date on one line.
    private static string? CellClass(PrintedColumn column) => (column.IsNumber, column.KeepsToOneLine) switch
    {
        (true, _) => "n",
        (false, true) => "nw",
        _ => null,
    };

    // A table of a table printout, under its heading, with its total once after its rows and a note under it.
    private RenderFragment TablePart(PrintedTable table) => @<section class="print-block">
        @if (table.Heading is { } heading)
        {
            <h2 class="print-section">@heading</h2>
        }
        <table class="print-table">
            <thead>
                <tr>
                    @foreach (var column in table.Columns)
                    {
                        <th class="@CellClass(column)">@column.Header</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (table.Rows.Count == 0)
                {
                    <tr><td colspan="@table.Columns.Count" class="print-muted">Nothing to show.</td></tr>
                }
                @foreach (var row in table.Rows)
                {
                    <tr>
                        @for (var c = 0; c < table.Columns.Count; c++)
                        {
                            <td class="@CellClass(table.Columns[c])">@(c < row.Count ? row[c] : "")</td>
                        }
                    </tr>
                }
            </tbody>
            @if (table.Total is { } total)
            {
                <tfoot>
                    <tr>
                        @for (var c = 0; c < table.Columns.Count; c++)
                        {
                            <td class="@CellClass(table.Columns[c])">@(c < total.Count ? total[c] : "")</td>
                        }
                    </tr>
                </tfoot>
            }
        </table>
        @if (table.Note is { } note)
        {
            <p class="print-small">@note</p>
        }
    </section>;

    /// <summary>Each sub-assembly's ingredients and piece size, then the packaging.</summary>
    [Parameter] public bool IncludeRecipe { get; set; } = true;

    /// <summary>The costing breakdown, and the costs beside the recipe's lines.</summary>
    [Parameter] public bool IncludeCosting { get; set; } = true;

    /// <summary>
    /// In place of the costing: the recipe's costs as the costing prints them, each line's with its unit cost (Cost/g, Unit
    /// Cost) whatever Settings → Printing leaves out, each table's total and each section's cost per piece, then the total
    /// sub-assembly cost (the raw materials) at the end, and none of the breakdown. The costing wins when both are set.
    /// </summary>
    [Parameter] public bool IncludeSubAssemblyTotal { get; set; }

    private bool SubAssemblyTotalOnly => IncludeSubAssemblyTotal && !IncludeCosting;

    // The recipe's own costs, each line's and each table's: with the costing, or the sub-assembly total in its place.
    private bool ShowsRecipeCosts => IncludeCosting || SubAssemblyTotalOnly;

    /// <summary>
    /// For the production floor: the recipe alone (the preview passes no costing with it), in large type, with a box to
    /// tick beside each ingredient and packaging line as it's weighed, and a line to sign at the end.
    /// </summary>
    [Parameter] public bool ProductionCopy { get; set; }

    /// <summary>The production copy's type: Settings → Printing's size, or a quarter larger than normal if that's more.</summary>
    public const decimal ProductionTypeScale = 1.25m;

    private decimal TypeScale => ProductionCopy ? Math.Max(ProductionTypeScale, PageSetup.TypeScale) : PageSetup.TypeScale;

    // A production copy's box to tick, at the end of a line.
    private static RenderFragment TickBox => @<td class="print-tick"><span class="print-tick-box"></span></td>;

    // The pages, as printing will break them, each time the document is drawn: the preview shows where each starts, the
    // part's name at its top and a set's contents' page numbers (app.js). A page going away as it's drawn has nothing to do.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            await JS.InvokeVoidAsync("tinapayan.layOutPrintoutPages");
        }
        catch (Exception exception) when (exception is JSDisconnectedException or TaskCanceledException or ObjectDisposedException)
        {
        }
    }

    private static string Mm(decimal millimetres) => millimetres.ToString("0.##", CultureInfo.InvariantCulture) + "mm";

    // Each sheet on the screen as the paper is, with what's printed at the page's width, and the type's size (print.css).
    private string SheetStyle =>
        $"--paper-width: {Mm(PageSetup.Paper.Width)}; --paper-height: {Mm(PageSetup.Paper.Height)}; " +
        $"--margin-top: {Mm(PageSetup.Margins.Top)}; --margin-side: {Mm(PageSetup.Margins.Side)}; --margin-bottom: {Mm(PageSetup.Margins.Bottom)}; " +
        $"--type-scale: {TypeScale.ToString("0.##", CultureInfo.InvariantCulture)}";

    // The paper and margins, and the note at the foot of each page, opposite its number (print.css's @bottom-right). It
    // comes after print.css's @page, so it wins.
    private string PageRule
    {
        get
        {
            var rule = $"@page {{ size: {Mm(PageSetup.Paper.Width)} {Mm(PageSetup.Paper.Height)}; " +
                       $"margin: {Mm(PageSetup.Margins.Top)} {Mm(PageSetup.Margins.Side)} {Mm(PageSetup.Margins.Bottom)}; ";
            if (PageSetup.Settings.FooterNote is { } note)
            {
                rule += $"@bottom-left {{ content: {CssString(note)}; font-family: \"Segoe UI\", sans-serif; font-size: 8.5pt; color: #5c5f77; }} ";
            }

            return rule + "}";
        }
    }

    /// <summary>Text as a quoted CSS string: its quotes and backslashes escaped, and a line break as one.</summary>
    public static string CssString(string text) =>
        "\"" + text.Replace("\\", "\\\\").Replace("\"", "\\\"").Replace("\r", "").Replace("\n", "\\A ") + "\"";

    // What's left out (Settings → Printing): the recipe's unit costs (Cost/g, packaging's Unit Cost) go with the costing
    // too, and the figure tiles and price comparison are only ever the costing's. The sub-assembly total always has the
    // unit costs: its lines' costs are what it's printed for (the user, 2026-11-21).
    private bool ShowsUnitCosts => SubAssemblyTotalOnly || (IncludeCosting && !PageSetup.Settings.OmitUnitCosts);
    private bool ShowsPercentages => !PageSetup.Settings.OmitPercentages;
    private bool ShowsFigures => IncludeCosting && !PageSetup.Settings.OmitFigures;
    private bool ShowsPriceComparison => !PageSetup.Settings.OmitPriceComparison;

    // The shop's name, address line and logo at the top of each part, when Settings has any of them.
    private RenderFragment ShopHeading => @<text>
        @if (PageSetup.HasHeading)
        {
            <header class="print-shop">
                @if (PageSetup.LogoSource is { } logo)
                {
                    <img class="print-shop-logo" src="@logo" alt="" />
                }
                <div class="print-shop-text">
                    @if (PageSetup.Settings.ShopName is { } name)
                    {
                        <div class="print-shop-name">@name</div>
                    }
                    @if (PageSetup.Settings.ShopAddress is { } address)
                    {
                        <div class="print-shop-address">@address</div>
                    }
                </div>
            </header>
        }
    </text>;

    private bool IsSimulation => Set.PriceChanges is not null || Set.Products.Any(p => p.Simulation is not null);

    /// <summary>What the printout is, naming only the parts included.</summary>
    private string Parts => (IncludeRecipe, IncludeCosting) switch
    {
        _ when ProductionCopy => "Production Copy",
        (true, true) => "Recipe and Costing",
        (true, false) when SubAssemblyTotalOnly => "Recipe and Sub-Assembly Total",
        (true, false) => "Recipe",
        _ => "Costing",
    };

    private static string Printed(DateTime at) => at.ToString("MMM d, yyyy, h:mm tt", CultureInfo.CurrentCulture);

    private static string Grams(decimal grams) => grams.ToString("N1", CultureInfo.CurrentCulture);

    private static string Percent(decimal? percent) => percent is { } value ? value.ToString("N1", CultureInfo.CurrentCulture) : "—";

    private static string Share(decimal share) => share.ToString("N1", CultureInfo.CurrentCulture) + "%";

    private static string Money(decimal amount) => amount.ToString("N2", CultureInfo.CurrentCulture);

    private static string MarkupText(decimal? markup) => markup is { } value ? value.ToString("N2", CultureInfo.CurrentCulture) + "%" : "—";

    // A markup's percentage in the price comparison, in its own column after the amount, as the Costing tab shows it.
    private static string MarkupShare(decimal? markup) => markup is { } value ? "(" + value.ToString("N1", CultureInfo.CurrentCulture) + "%)" : "";

    private static string Change(decimal now, decimal simulated) =>
        simulated == now ? "—" : (simulated - now).ToString("+#,0.00;-#,0.00", CultureInfo.CurrentCulture);

    private static string ChangePercent(decimal now, decimal simulated) =>
        simulated == now ? "—" : CostingRules.PercentOf(simulated - now, now).ToString("+#,0.00;-#,0.00;0.00", CultureInfo.CurrentCulture) + "%";

    /// <summary>What the report says under a product's simulated Current Price: the price that keeps today's markup.</summary>
    public const string KeepMarkupNote = "To keep markup";

    private static string BasisSuffix(ProductPrintout printout) =>
        printout.CostBasis == CostBasis.Unbuffered ? $" · {ProductPrintout.UnbufferedNote}" : string.Empty;

    private static string PieceSizeText(PrintedSection section, bool withCost)
    {
        if (section.GoesIntoName is { } into)
        {
            return $"Goes whole into {into}, whose piece size shares it out.";
        }

        if (!section.HasPieceSize)
        {
            return withCost ? "No weight per piece or yield yet, so this section costs nothing per piece." : "No weight per piece or yield yet.";
        }

        List<string> parts = [];
        parts.Add($"Weight per piece {section.WeightPerPiece:#,0.##} g");
        parts.Add($"Yield {section.Yield:#,0.##} pcs");
        if (withCost)
        {
            parts.Add($"Cost per piece {section.CostPerPiece:N2}");
        }

        return string.Join(" · ", parts);
    }

    private RenderFragment ProductPart(ProductPrintout printout) => @<text>
        <header class="print-title">
            <h1>@printout.ProductName</h1>
            <p class="print-muted">@printout.CategoryName · @printout.StageTitle · @printout.CostUnitCaption@BasisSuffix(printout)@(printout.Simulation is not null ? " · Simulated prices" : "")</p>
            <p class="print-small">Last updated @printout.LastUpdatedText · Printed @Printed(Set.PrintedAt)@(printout.SaveNote is { } note ? " · " + note : "")</p>
            @if (ProductionCopy)
            {
                <p class="print-production">Production copy</p>
            }
        </header>

        @if (printout.IsDraft)
        {
            @* A banner under the title, and on paper "Draft" faintly across every page (print.css: a fixed box is printed
               on each page). Only This product can be a draft: a set prints as saved. *@
            <p class="print-draft">Draft: @(printout.SaveNote == ProductPrintout.NotSavedNote ? "this product hasn't been saved yet" : "it includes changes not yet saved"). Save it on the Products screen before it's used.</p>
            <div class="print-draft-mark" aria-hidden="true">Draft</div>
        }

        @if (ShowsFigures)
        {
            @Figures(printout)
        }
        @if (printout.Simulation is { } simulated)
        {
            @PriceChanges("Price Changes Applied", simulated.Changes, "No price change reaches this product: its figures are today's.")
        }
        @if (IncludeRecipe)
        {
            <h2 class="print-part">Recipe</h2>
            @if (printout.Components is { } components)
            {
                @ComponentsPart(printout, components)
            }
            @if (printout.Sections.Count == 0 && printout.Components is null)
            {
                <p class="print-muted">No sub-assemblies yet.</p>
            }
            @foreach (var section in printout.Sections)
            {
                @SectionPart(printout, section)
            }
            @if (printout.Packaging is { } packaging)
            {
                @PackagingPart(printout, packaging)
            }
        }
        @if (IncludeCosting)
        {
            @CostingPart(printout)
        }
        else if (IncludeRecipe && SubAssemblyTotalOnly)
        {
            @SubAssemblyTotalPart(printout)
        }
        @if (ProductionCopy)
        {
            <p class="print-signoff">Weighed by <span></span> Checked by <span></span> Date <span></span></p>
        }
    </text>;

    private RenderFragment Figures(ProductPrintout printout) => @<div class="print-figures">
        @if (printout.Simulation is { } simulated)
        {
            var costs = printout.Costs;
            var now = simulated.Now;
            <div><span>Base Cost</span><strong>@Money(costs.BaseCost)</strong><em>Now @Money(now.BaseCost)</em></div>
            <div><span>Suggested Price</span><strong>@Money(costs.SellingPrice)</strong><em>Now @Money(now.SellingPrice)</em></div>
            <div>
                <span>Current Price</span><strong>@(costs.CurrentPrice is { } price ? Money(price) : "—")</strong>
                @if (costs.BaseCost != now.BaseCost && PriceChangeRules.PriceToKeepMarkup(costs.CurrentPrice, now.BaseCost, costs.BaseCost) is { } keep)
                {
                    <em>@KeepMarkupNote @Money(keep)</em>
                }
            </div>
            <div><span>Markup at Current Price</span><strong class="@(costs.IsCurrentPriceBelowCost ? "print-error" : "")">@MarkupText(costs.CurrentMarkupPercent)</strong><em>Now @MarkupText(now.CurrentMarkupPercent)</em></div>
        }
        else
        {
            <div><span>Material Cost</span><strong>@Money(printout.Costs.Material)</strong></div>
            <div><span>Base Cost</span><strong>@Money(printout.Costs.BaseCost)</strong></div>
            <div><span>Current Price</span><strong>@(printout.Costs.CurrentPrice is { } price ? Money(price) : "—")</strong></div>
            <div><span>Markup at Current Price</span><strong class="@(printout.Costs.IsCurrentPriceBelowCost ? "print-error" : "")">@MarkupText(printout.Costs.CurrentMarkupPercent)</strong></div>
        }
    </div>;

    private RenderFragment PriceChanges(string heading, IReadOnlyList<PrintedPriceChange> changes, string none) => @<text>
        <h2 class="print-section">@heading</h2>
        @if (changes.Count == 0)
        {
            <p class="print-muted">@none</p>
        }
        else
        {
            <table class="print-table">
                <thead><tr><th>Raw Material</th><th>Per</th><th class="n">Current Price</th><th class="n">Change %</th><th class="n">New Price</th></tr></thead>
                <tbody>
                    @foreach (var change in changes)
                    {
                        <tr>
                            <td>@change.Material</td>
                            <td>@change.Per</td>
                            <td class="n">@(change.CurrentPrice is { } current ? Money(current) : "—")</td>
                            <td class="n">@(change.ChangePercent is { } percent ? percent.ToString("+#,0.00;-#,0.00;0.00", CultureInfo.CurrentCulture) + "%" : "—")</td>
                            <td class="n">@Money(change.NewPrice)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </text>;

    private RenderFragment ComponentsPart(ProductPrintout printout, IReadOnlyList<PrintedComponent> components) => @<text>
        <h3 class="print-section">Products</h3>
        @if (components.Count == 0)
        {
            <p class="print-muted">No products yet.</p>
        }
        else
        {
            var withPackaging = components.Any(c => c.PackagingCost is not null);
            var withNow = printout.Simulation is not null;
            <table class="print-table">
                <thead>
                    <tr>
                        <th>Product</th><th class="n">Qty</th>
                        @if (ShowsRecipeCosts)
                        {
                            <th class="n">Recipe Cost</th>
                            @if (withPackaging) { <th class="n">Packaging Cost</th> }
                            <th class="n">Cost</th>
                            @if (withNow) { <th class="n">Cost Now</th> }
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var component in components)
                    {
                        <tr>
                            <td>@component.Product</td><td class="n">@component.Quantity?.ToString("N0")</td>
                            @if (ShowsRecipeCosts)
                            {
                                <td class="n">@Money(component.RecipeCost)</td>
                                @if (withPackaging) { <td class="n">@(component.PackagingCost is { } p ? Money(p) : "")</td> }
                                <td class="n">@Money(component.Cost)</td>
                                @if (withNow) { <td class="n">@(component.NowCost is { } now ? Money(now) : "")</td> }
                            }
                        </tr>
                    }
                </tbody>
                @if (ShowsRecipeCosts)
                {
                    <tfoot>
                        <tr>
                            <td>Total</td><td></td><td></td>
                            @if (withPackaging) { <td></td> }
                            <td class="n">@Money(components.Sum(c => c.Cost))</td>
                            @if (withNow) { <td class="n">@(components.Any(c => c.NowCost is not null) ? Money(components.Sum(c => c.NowCost ?? c.Cost)) : "")</td> }
                        </tr>
                    </tfoot>
                }
            </table>
        }
    </text>;

    private RenderFragment SectionPart(ProductPrintout printout, PrintedSection section) => @<section class="print-block">
        @{ var withNow = printout.Simulation is not null && ShowsRecipeCosts; }
        <h3 class="print-section">@section.Name @if (section.Source is { } source) { <span class="print-source">@source</span> }</h3>
        <table class="print-table">
            <thead>
                <tr>
                    <th>Ingredient</th><th class="n">Grams</th>
                    @if (ShowsPercentages) { <th class="n">@section.PercentHeader</th> }
                    @if (ShowsUnitCosts) { <th class="n">Cost/g</th> }
                    @if (ShowsRecipeCosts) { <th class="n">Cost</th> }
                    @if (withNow) { <th class="n">Cost Now</th> }
                    @if (ProductionCopy) { <th class="print-tick">Done</th> }
                </tr>
            </thead>
            <tbody>
                @foreach (var line in section.Lines)
                {
                    @LineRow(line, withNow)
                }
                @foreach (var line in section.FoldedIn)
                {
                    @LineRow(line, withNow)
                }
                @if (section.AddIns.Count > 0)
                {
                    <tr class="print-subheading"><td colspan="@(2 + (ShowsPercentages ? 1 : 0) + (ShowsUnitCosts ? 1 : 0) + (ShowsRecipeCosts ? 1 : 0) + (withNow ? 1 : 0) + (ProductionCopy ? 1 : 0))">Add-ins</td></tr>
                    @foreach (var line in section.AddIns)
                    {
                        @LineRow(line, withNow)
                    }
                }
            </tbody>
            <tfoot>
                <tr>
                    <td>Total</td><td class="n">@Grams(section.TotalWeight)</td>
                    @if (ShowsPercentages) { <td class="n">@Percent(section.TotalPercent)</td> }
                    @if (ShowsUnitCosts) { <td></td> }
                    @if (ShowsRecipeCosts) { <td class="n">@Money(section.BatchCost)</td> }
                    @if (withNow) { <td class="n">@(section.NowBatchCost is { } now ? Money(now) : "")</td> }
                    @if (ProductionCopy) { <td></td> }
                </tr>
            </tfoot>
        </table>
        <p class="print-small">@PieceSizeText(section, ShowsRecipeCosts)</p>
    </section>;

    // A line's costs, with the costing or the sub-assembly total.
    private RenderFragment LineRow(PrintedLine line, bool withNow) => @<tr>
        <td>@line.Ingredient</td><td class="n">@Grams(line.Grams)</td>
        @if (ShowsPercentages) { <td class="n">@Percent(line.Percent)</td> }
        @if (ShowsUnitCosts) { <td class="n">@line.CostPerGram.ToString("N4")</td> }
        @if (ShowsRecipeCosts) { <td class="n">@Money(line.Cost)</td> }
        @if (withNow) { <td class="n">@(line.NowCost is { } now ? Money(now) : "")</td> }
        @if (ProductionCopy) { @TickBox }
    </tr>;

    private RenderFragment PackagingPart(ProductPrintout printout, PrintedPackaging packaging) => @<section class="print-block">
        @{ var withNow = printout.Simulation is not null && ShowsRecipeCosts; }
        <h3 class="print-section">Packaging @if (packaging.LinkedTo is { } linkedTo) { <span class="print-source">@linkedTo</span> }</h3>
        <table class="print-table">
            <thead>
                <tr>
                    <th>Material</th><th class="n">Qty</th><th>Unit</th>
                    @if (ShowsUnitCosts) { <th class="n">Unit Cost</th> }
                    @if (ShowsRecipeCosts) { <th class="n">Cost</th> }
                    @if (withNow) { <th class="n">Cost Now</th> }
                    @if (ProductionCopy) { <th class="print-tick">Done</th> }
                </tr>
            </thead>
            <tbody>
                @foreach (var line in packaging.Lines)
                {
                    <tr>
                        <td>@line.Material</td><td class="n">@line.Qty?.ToString("#,0.####")</td><td>@line.Unit</td>
                        @if (ShowsUnitCosts) { <td class="n">@line.UnitCost.ToString("N4")</td> }
                        @if (ShowsRecipeCosts) { <td class="n">@Money(line.Cost)</td> }
                        @if (withNow) { <td class="n">@(line.NowCost is { } now ? Money(now) : "")</td> }
                        @if (ProductionCopy) { @TickBox }
                    </tr>
                }
            </tbody>
            @if (ShowsRecipeCosts)
            {
                <tfoot>
                    <tr>
                        <td>Total</td><td></td><td></td>
                        @if (ShowsUnitCosts) { <td></td> }
                        <td class="n">@Money(packaging.Total)</td>
                        @if (withNow) { <td class="n">@(packaging.Lines.Any(l => l.NowCost is not null) ? Money(packaging.Lines.Sum(l => l.NowCost ?? l.Cost)) : "")</td> }
                    </tr>
                </tfoot>
            }
        </table>
        @if (packaging.Bulk is { } bulk)
        {
            @BulkPackagingPart(bulk)
        }
    </section>;

    // The bulk pack's lines, under the packaging's.
    private RenderFragment BulkPackagingPart(PrintedBulkPackaging bulk) => @<text>
        <h3 class="print-section">Bulk Packaging <span class="print-source">@string.Join(" · ", new[] { bulk.LinkedTo, bulk.Quantity is { } held ? $"one pack holds {held} {(held == 1 ? "product" : "products")}" : null }.OfType<string>())</span></h3>
        <table class="print-table">
            <thead>
                <tr>
                    <th>Material</th><th class="n">Qty per Pack</th><th>Unit</th>
                    @if (ShowsUnitCosts) { <th class="n">Unit Cost</th> }
                    @if (ShowsRecipeCosts) { <th class="n">Cost per Pack</th> }
                    @if (ProductionCopy) { <th class="print-tick">Done</th> }
                </tr>
            </thead>
            <tbody>
                @foreach (var line in bulk.Lines)
                {
                    <tr>
                        <td>@line.Material</td><td class="n">@line.Qty?.ToString("#,0.####")</td><td>@line.Unit</td>
                        @if (ShowsUnitCosts) { <td class="n">@line.UnitCost.ToString("N4")</td> }
                        @if (ShowsRecipeCosts) { <td class="n">@Money(line.Cost)</td> }
                        @if (ProductionCopy) { @TickBox }
                    </tr>
                }
            </tbody>
            @if (ShowsRecipeCosts)
            {
                <tfoot>
                    <tr><td>Pack cost</td><td></td><td></td>@if (ShowsUnitCosts) { <td></td> }<td class="n">@Money(bulk.PackCost)</td></tr>
                    <tr><td>Per unit</td><td></td><td></td>@if (ShowsUnitCosts) { <td></td> }<td class="n">@Money(bulk.CostPerUnit)</td></tr>
                </tfoot>
            }
        </table>
    </text>;

    private RenderFragment CostingPart(ProductPrintout printout) => @<section class="print-block print-keep">
        @{
            var costs = printout.Costs;
            var now = printout.Simulation?.Now;
            var unit = printout.CostUnitCaption;
        }
        <h2 class="print-part">Costing (@unit@BasisSuffix(printout))</h2>
        <table class="print-table print-costing">
            <thead>
                <tr>
                    <th>Component</th>
                    @if (now is not null) { <th class="n">Now</th><th class="n">Simulated</th><th class="n">Change</th> } else { <th class="n">@unit</th> }
                    <th class="n">% of Price</th>
                </tr>
            </thead>
            <tbody>
                @CostRow(costs.PartsTitle, now?.SubAssemblies, costs.SubAssemblies, costs.SubAssembliesShare)
                @foreach (var line in costs.SubAssemblyLines)
                {
                    var nowLine = now?.SubAssemblyLines.FirstOrDefault(l => l.Name == line.Name);
                    <tr class="print-part-row">
                        <td>@line.Name</td>
                        @if (now is not null) { <td class="n">@(nowLine is not null ? Money(nowLine.Cost) : "")</td><td class="n">@Money(line.Cost)</td><td class="n">@(nowLine is not null ? Change(nowLine.Cost, line.Cost) : "")</td> } else { <td class="n">@Money(line.Cost)</td> }
                        <td class="n">@Share(line.Share)</td>
                    </tr>
                }
                @CostRow($"Wastage ({costs.WastagePercent:0.##}% of {costs.PartsBase})", now?.Wastage, costs.Wastage, costs.WastageShare)
                @CostRow(costs.PackagingTitle, now?.Packaging, costs.Packaging, costs.PackagingShare)
                @CostRow($"Labor ({costs.LaborPercent:0.##}% of {costs.PartsBase})", now?.Labor, costs.Labor, costs.LaborShare)
                @CostRow($"Overhead ({costs.OverheadPercent:0.##}% of {costs.PartsBase})", now?.Overhead, costs.Overhead, costs.OverheadShare)
                @CostRow($"Administrative ({costs.AdministrativePercent:0.##}% of {costs.PartsBase})", now?.Administrative, costs.Administrative, costs.AdministrativeShare)
                @CostRow("Subtotal (base cost)", now?.BaseCost, costs.BaseCost, costs.BaseCostShare, "print-band")
                @if (now is not null)
                {
                    @CostRow($"Markup ({costs.MarkupPercent:0.##}%)", now.Markup, costs.Markup, costs.MarkupShare)
                    @CostRow($"VAT ({costs.VatPercent:0.##}%)", now.Vat, costs.Vat, costs.VatShare)
                    @CostRow(printout.SuggestedSellingPriceLabel, now.SellingPrice, costs.SellingPrice, costs.SellingPriceShare, "print-band print-total")
                }
            </tbody>
        </table>
        @if (now is null && ShowsPriceComparison)
        {
            @PriceComparison(costs)
        }
    </section>;

    // The sub-assembly total in place of the costing: the costing's first figure alone, for one sellable unit, under the
    // recipe; a simulation's with today's beside it.
    private RenderFragment SubAssemblyTotalPart(ProductPrintout printout) => @<section class="print-block print-keep">
        @{
            var costs = printout.Costs;
            var now = printout.Simulation?.Now;
        }
        <table class="print-table print-costing print-sub-assembly-total">
            @if (now is not null)
            {
                <thead><tr><th></th><th class="n">Now</th><th class="n">Simulated</th><th class="n">Change</th></tr></thead>
            }
            <tbody>
                <tr class="print-band print-total">
                    <td>@SubAssemblyTotalLabel(printout)</td>
                    @if (now is not null) { <td class="n">@Money(now.SubAssemblies)</td><td class="n">@Money(costs.SubAssemblies)</td><td class="n">@Change(now.SubAssemblies, costs.SubAssemblies)</td> } else { <td class="n">@Money(costs.SubAssemblies)</td> }
                </tr>
            </tbody>
        </table>
    </section>;

    /// <summary>"Total sub-assembly cost (Per piece)"; a composite's names what it holds, "Total products cost (Per pack)".</summary>
    private static string SubAssemblyTotalLabel(ProductPrintout printout) =>
        $"Total {(printout.Costs.IsComposite ? printout.Costs.PartsBase : "sub-assembly")} cost ({printout.CostUnitCaption}{BasisSuffix(printout)})";

    // The suggested price beside the current one, as the Costing tab shows them under the base cost. A simulation's
    // costing keeps its markup, VAT and price rows in the breakdown instead, now beside simulated.
    private static RenderFragment PriceComparison(ProductCostSummary costs) => @<table class="print-table print-costing print-price-comparison">
        @{
            var markupClass = costs.IsCurrentPriceBelowCost ? "print-error" : costs.IsBelowTargetMarkup ? "print-warning" : null;
        }
        <thead>
            <tr>
                <th>Component</th>
                <th class="n">Suggested Price</th>
                <th class="print-percent"></th>
                <th class="n">Current Price</th>
                <th class="print-percent"></th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Markup</td>
                <td class="n">@Money(costs.Markup)</td>
                <td class="n print-percent">@MarkupShare(costs.MarkupPercent)</td>
                <td class="n @markupClass">@(costs.CurrentMarkup is { } markup ? Money(markup) : "—")</td>
                <td class="n print-percent @markupClass">@MarkupShare(costs.CurrentMarkupPercent)</td>
            </tr>
            <tr>
                <td>VAT (@costs.VatPercent.ToString("0.##", CultureInfo.CurrentCulture)%)</td>
                <td class="n">@Money(costs.Vat)</td>
                <td class="print-percent"></td>
                <td class="n">@(costs.CurrentVat is { } vat ? Money(vat) : "—")</td>
                <td class="print-percent"></td>
            </tr>
            <tr class="print-band print-total">
                <td>Selling price</td>
                <td class="n">@Money(costs.SellingPrice)</td>
                <td class="print-percent"></td>
                <td class="n">@(costs.CurrentPrice is { } price ? Money(price) : "—")</td>
                <td class="print-percent"></td>
            </tr>
            @if (costs.HasPriceRounding)
            {
                <tr class="print-part-row">
                    <td>@costs.PriceRoundingLabel</td>
                    <td class="n">@Money(costs.RoundedSellingPrice)</td>
                    <td colspan="3"></td>
                </tr>
            }
        </tbody>
    </table>;

    private RenderFragment CostRow(string label, decimal? now, decimal amount, decimal share, string? css = null) => @<tr class="@css">
        <td>@label</td>
        @if (now is { } before) { <td class="n">@Money(before)</td><td class="n">@Money(amount)</td><td class="n">@Change(before, amount)</td> } else { <td class="n">@Money(amount)</td> }
        <td class="n">@Share(share)</td>
    </tr>;

}
