@typeparam TNode where TNode : class
@using System.Collections.Specialized
@implements IAsyncDisposable
@inject IJSRuntime JS

@* A list of records filed in folders: the Raw Materials, Sub-Assemblies and Products lists, as the WPF app's SfTreeViews
   were (DESIGN.md, "How it's built"). The ViewModel owns everything: the folders and their rows (each tree's Roots and
   Children), whether each folder is open (IsExpanded, kept through a refresh and between visits), and the rows picked
   (SelectedTreeNodes, which this changes as rows are clicked: alone, or with Ctrl or Shift). Clicking a folder opens or
   closes it. Rows that can be dragged are dragged onto a folder (or a row in one) to move them there, which the screen
   saves at once: with the pointer, by app.js's watchTreeDrag, which scrolls the list as the pointer nears its top or
   bottom, since the Windows web view doesn't hand the browser's own drag and drop back to the page. A right-click opens
   the menu for the row, or for the list in its empty space; F2, Del, Ctrl+X and Ctrl+V do what the row's menu shows
   beside them, Esc what the screen gives it (Products: forgets what was cut), Enter opens or closes a folder, and the
   arrows move through the rows. Where the screen says (RenamesOnSecondClick), a slow second click on the row picked does
   what F2 does, as in File Explorer. A row picked from elsewhere (a Save, Back) has its folders opened and is scrolled
   into view. *@
<div @ref="_element" class="folder-tree" tabindex="0" role="tree" aria-multiselectable="true"
     @onkeydown="OnKeyDown" @onfocusout="CancelSecondClick" @oncontextmenu="OnListContextMenu" @oncontextmenu:preventDefault="true">
    @{
        _visible.Clear();
        _redraws?.Drawn();
    }
    @foreach (var root in Roots)
    {
        @RenderNode(root, 0)
    }
</div>

<TreeMenu @ref="_menu" />

@code {
    private ElementReference _element;
    private TreeMenu? _menu;

    // The rows as drawn, top to bottom, for the arrows and Shift-clicks.
    private readonly List<TNode> _visible = [];

    // What the tree last scrolled to, so a pick from elsewhere can be told from one made here.
    private object? _shownSelection;
    private bool _pickedHere;

    // The rename a slow second click on a row is waiting to make.
    private CancellationTokenSource? _secondClick;

    // Dragging: the rows being dragged, and the row they're over; the page's watch on the drags (app.js's watchTreeDrag),
    // and what it calls, let go with the tree.
    private IReadOnlyList<TNode> _dragging = [];
    private TNode? _dropTarget;
    private Drags? _drags;
    private DotNetObjectReference<Drags>? _dragsReference;
    private IJSObjectReference? _dragWatch;

    // The folders' and rows' changes this tree listens to, so it redraws when a folder opens, a title changes or a
    // folder's rows change; added as rows appear, removed with the tree.
    private readonly Dictionary<object, Action> _watched = new(ReferenceEqualityComparer.Instance);
    private RedrawGate? _redraws;

    // Each row's handlers, made the first time it's drawn and kept with the tree, as _watched is. Made afresh on every
    // drawing, each would be a new handler the page swaps in, for every row of the list, each time anything on the screen
    // changes (ASP.NET Core's rendering guidance: avoid recreating delegates for many repeated elements).
    private readonly Dictionary<object, RowEvents> _rowEvents = new(ReferenceEqualityComparer.Instance);

    // A drag is the page's own (watchTreeDrag), so a row's handlers are its click and its menu.
    private sealed record RowEvents(EventCallback<MouseEventArgs> Click, EventCallback<MouseEventArgs> ContextMenu);

    private RowEvents EventsOf(TNode node)
    {
        if (!_rowEvents.TryGetValue(node, out var events))
        {
            events = new RowEvents(
                EventCallback.Factory.Create<MouseEventArgs>(this, e => OnRowClick(node, e)),
                EventCallback.Factory.Create<MouseEventArgs>(this, e => OnRowContextMenu(node, e)));
            _rowEvents[node] = events;
        }

        return events;
    }

    // A folder's expander, on a span rather than an Icon: a tree draws one per folder on each redraw.
    private static readonly string OpenExpander = "tree-expander " + AppIcons.CssOf(AppIcon.Expanded);
    private static readonly string ClosedExpander = "tree-expander " + AppIcons.CssOf(AppIcon.Collapsed);

    /// <summary>The top-level folders.</summary>
    [Parameter, EditorRequired] public IEnumerable<TNode> Roots { get; set; } = [];

    /// <summary>A folder's rows, or null for a record, which holds none.</summary>
    [Parameter, EditorRequired] public Func<TNode, IList<TNode>?> ChildrenOf { get; set; } = null!;

    [Parameter, EditorRequired] public Func<TNode, bool> IsExpanded { get; set; } = null!;

    [Parameter, EditorRequired] public Action<TNode, bool> SetExpanded { get; set; } = null!;

    /// <summary>The ViewModel's SelectedTreeNodes.</summary>
    [Parameter, EditorRequired] public IList<object> Selected { get; set; } = null!;

    /// <summary>What a row shows: its glyph, title and count, as the WPF ItemTemplates did.</summary>
    [Parameter, EditorRequired] public RenderFragment<TNode> RowTemplate { get; set; } = null!;

    /// <summary>A stable key for each row, which its element's ID is made from.</summary>
    [Parameter, EditorRequired] public Func<TNode, string> KeyOf { get; set; } = null!;

    [Parameter] public Func<TNode, string?>? RowClass { get; set; }

    [Parameter] public Func<TNode, bool>? CanDrag { get; set; }

    /// <summary>
    /// Whether a row's name is being typed in place (a TreeNameBox in its RowTemplate): it isn't dragged, so the mouse
    /// selects the text in it, and a click, F2, Del, Ctrl+X or Ctrl+V on it does nothing.
    /// </summary>
    [Parameter] public Func<TNode, bool>? IsEditing { get; set; }

    /// <summary>Whether dropping the rows dragged on a row (or the list's empty space, null) would move any of them.</summary>
    [Parameter] public Func<IReadOnlyList<TNode>, TNode?, bool>? CanDrop { get; set; }

    [Parameter] public Func<IReadOnlyList<TNode>, TNode?, Task>? OnDrop { get; set; }

    /// <summary>The menu for a row, or for the list's empty space (null).</summary>
    [Parameter] public Func<TNode?, IReadOnlyList<TreeMenuItem>>? MenuFor { get; set; }

    /// <summary>What a key (F2, Del) does to the row picked, as its menu shows: TreeShortcut.</summary>
    [Parameter] public Func<string, TreeMenuItem?>? Shortcut { get; set; }

    /// <summary>
    /// The rows a slow second click renames, as in File Explorer: a click anywhere on the one row picked already, not part
    /// of a double-click, runs what F2 does (<see cref="Shortcut"/>) once <see cref="SecondClickWait"/> is over, unless
    /// another click, a key, a drag or a menu comes first. A double-click renames nothing (the user's choice). None when
    /// it's null.
    /// </summary>
    [Parameter] public Func<TNode, bool>? RenamesOnSecondClick { get; set; }

    /// <summary>
    /// What a second click waits for before it renames, so a double-click's second click can call it off: half a second,
    /// Windows' double-click time, unless a test gives its own.
    /// </summary>
    [Parameter] public Func<CancellationToken, Task> SecondClickWait { get; set; } = cancellation => Task.Delay(500, cancellation);

    /// <summary>Changes the tree's rows can't be watched for on their own; the screen passes something that changes with them.</summary>
    [Parameter] public object? Version { get; set; }

    private string ElementId(TNode node) => "tree-" + KeyOf(node).Replace('/', '-').Replace(' ', '-');

    private RenderFragment RenderNode(TNode node, int depth) => builder =>
    {
        _visible.Add(node);
        Watch(node);
        var children = ChildrenOf(node);
        var isFolder = children is not null;
        var isOpen = isFolder && IsExpanded(node);
        var isSelected = Selected.Contains(node);
        var isEditing = IsEditing?.Invoke(node) == true;
        var draggable = !isEditing && CanDrag?.Invoke(node) == true;
        var classes = "tree-row"
            + (isSelected ? " selected" : "")
            + (isEditing ? " editing" : "")
            + (ReferenceEquals(node, _dropTarget) ? " drop-target" : "")
            + (_dragging.Contains(node) ? " dragging" : "")
            + (RowClass?.Invoke(node) is { } extra ? " " + extra : "");

        var seq = 0;
        builder.OpenElement(seq++, "div");
        builder.SetKey(node);
        builder.AddAttribute(seq++, "id", ElementId(node));
        builder.AddAttribute(seq++, "class", classes);
        builder.AddAttribute(seq++, "role", "treeitem");
        builder.AddAttribute(seq++, "aria-selected", isSelected ? "true" : "false");
        if (isFolder)
        {
            builder.AddAttribute(seq++, "aria-expanded", isOpen ? "true" : "false");
        }

        builder.AddAttribute(seq++, "style", $"padding-left:{8 + depth * 18}px");
        // What the page's watch drags (watchTreeDrag). Never the browser's own drag, which the web view keeps.
        builder.AddAttribute(seq++, "draggable", "false");
        if (draggable)
        {
            builder.AddAttribute(seq++, "data-drag", "true");
        }

        var events = EventsOf(node);
        builder.AddAttribute(seq++, "onclick", events.Click);
        builder.AddAttribute(seq++, "oncontextmenu", events.ContextMenu);
        builder.AddEventStopPropagationAttribute(seq++, "oncontextmenu", true);

        // The row's own, because the list's is never reached: stopping the event here stops it before the list's
        // preventDefault, and the browser's menu opened over this one.
        builder.AddEventPreventDefaultAttribute(seq++, "oncontextmenu", true);

        builder.OpenElement(seq++, "span");
        builder.AddAttribute(seq++, "class", isFolder && children!.Count > 0 ? (isOpen ? OpenExpander : ClosedExpander) : "tree-expander glyph");
        builder.CloseElement();
        builder.AddContent(seq++, RowTemplate(node));
        builder.CloseElement();

        if (isOpen)
        {
            foreach (var child in children!)
            {
                builder.AddContent(seq, RenderNode(child, depth + 1));
            }
        }
    };

    protected override void OnParametersSet()
    {
        var first = Selected.Count > 0 ? Selected[0] : null;
        if (!ReferenceEquals(first, _shownSelection) && first is TNode node && !_pickedHere)
        {
            // Picked from elsewhere: open the folders above it, so it's drawn, and scroll to it once it is.
            foreach (var folder in PathTo(node).SkipLast(1))
            {
                if (!IsExpanded(folder))
                {
                    SetExpanded(folder, true);
                }
            }
        }

        _pickedHere = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("tinapayan.preventKeys", _element, new[] { "ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight", "Home", "End", " " });
            _drags = new Drags(this);
            _dragsReference = DotNetObjectReference.Create(_drags);
            _dragWatch = await JS.InvokeAsync<IJSObjectReference>("tinapayan.watchTreeDrag", _element, _dragsReference);
        }

        var first = Selected.Count > 0 ? Selected[0] : null;
        if (!ReferenceEquals(first, _shownSelection))
        {
            _shownSelection = first;
            if (first is TNode node)
            {
                await JS.InvokeVoidAsync("tinapayan.scrollIntoView", ElementId(node));
            }
        }
    }

    /// <summary>The folders from the top down to <paramref name="target"/>, and it last; empty if it isn't in the tree.</summary>
    private List<TNode> PathTo(TNode target)
    {
        var path = new List<TNode>();
        foreach (var root in Roots)
        {
            if (Find(root, target, path))
            {
                return path;
            }
        }

        return [];
    }

    private bool Find(TNode node, TNode target, List<TNode> path)
    {
        path.Add(node);
        if (ReferenceEquals(node, target))
        {
            return true;
        }

        foreach (var child in ChildrenOf(node) ?? [])
        {
            if (Find(child, target, path))
            {
                return true;
            }
        }

        path.RemoveAt(path.Count - 1);
        return false;
    }

    private void OnRowClick(TNode node, MouseEventArgs e)
    {
        CancelSecondClick();
        if (IsEditing?.Invoke(node) == true)
        {
            return;
        }

        _pickedHere = true;

        // Ctrl-click adds a row to the rows picked, or takes it out (Cmd-click too, as the web app took it on a Mac).
        if (e.CtrlKey || e.MetaKey)
        {
            if (!Selected.Remove(node))
            {
                Selected.Add(node);
            }

            return;
        }

        if (e.ShiftKey && Selected.Count > 0 && Selected[0] is TNode anchor)
        {
            var from = _visible.IndexOf(anchor);
            var to = _visible.IndexOf(node);
            if (from >= 0 && to >= 0)
            {
                var range = _visible.GetRange(Math.Min(from, to), Math.Abs(to - from) + 1);
                Selected.Clear();
                Selected.Add(anchor);
                foreach (var row in range.Where(r => !ReferenceEquals(r, anchor)))
                {
                    Selected.Add(row);
                }

                return;
            }
        }

        // A plain click picks the row alone; on a folder it also opens or closes it. On the row picked alone already, once
        // more and not as a double-click's second (Detail 2), it renames the row in a moment, as in File Explorer. Anywhere
        // on the row: on its name text alone, which is short beside the row, it worked only now and then.
        var wasPickedAlone = Selected.Count == 1 && ReferenceEquals(Selected[0], node);
        PickAlone(node);
        if (ChildrenOf(node) is not null)
        {
            SetExpanded(node, !IsExpanded(node));
        }
        else if (wasPickedAlone && e.Detail <= 1 && RenamesOnSecondClick?.Invoke(node) == true)
        {
            _ = RenameAfterWaitAsync(node);
        }
    }

    /// <summary>Does what F2 does on the row picked: renames it, where the screen gives F2 that.</summary>
    private void Rename()
    {
        if (Shortcut?.Invoke("F2") is { Command: { } command } item && command.CanExecute(item.Parameter))
        {
            command.Execute(item.Parameter);
        }
    }

    /// <summary>
    /// Renames <paramref name="node"/> as F2 would, once <see cref="SecondClickWait"/> is over, if nothing called it off
    /// meanwhile and the row is still the one picked. Another click, a key, a drag or a menu in the tree calls it off, and
    /// so does the cursor leaving the tree: a click on a field straight after had the name box take the cursor from it, and
    /// what was typed there renamed the record. Nothing awaits it: it deals with its own end.
    /// </summary>
    private async Task RenameAfterWaitAsync(TNode node)
    {
        var waiting = _secondClick = new CancellationTokenSource();
        try
        {
            await SecondClickWait(waiting.Token);
            await InvokeAsync(() =>
            {
                if (waiting.IsCancellationRequested || Selected.Count != 1 || !ReferenceEquals(Selected[0], node))
                {
                    return;
                }

                CancelSecondClick();
                Rename();
            });
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
        {
            // Called off by another click or key, or the tree went.
        }
    }

    private void CancelSecondClick()
    {
        if (_secondClick is { } waiting)
        {
            _secondClick = null;
            waiting.Cancel();
            waiting.Dispose();
        }
    }

    private void PickAlone(TNode node)
    {
        if (Selected.Count != 1 || !ReferenceEquals(Selected[0], node))
        {
            Selected.Clear();
            Selected.Add(node);
        }
    }

    private async Task OnRowContextMenu(TNode node, MouseEventArgs e)
    {
        CancelSecondClick();
        if (MenuFor is null || _menu is null)
        {
            return;
        }

        // A row outside the rows picked is picked alone first, so the record the menu acts on is the one showing.
        if (!Selected.Contains(node))
        {
            _pickedHere = true;
            PickAlone(node);
        }

        await _menu.OpenAsync(MenuFor(node), e.ClientX, e.ClientY);
    }

    private async Task OnListContextMenu(MouseEventArgs e)
    {
        CancelSecondClick();
        if (MenuFor is not null && _menu is not null)
        {
            await _menu.OpenAsync(MenuFor(null), e.ClientX, e.ClientY);
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        CancelSecondClick();
        var current = Selected.Count > 0 ? Selected[0] as TNode : null;
        var isEditing = current is not null && IsEditing?.Invoke(current) == true;

        // Cut and paste, as in a file explorer: what the menu of the row picked shows beside Ctrl+X and Ctrl+V. Not in the
        // name box, whose own cut and paste they are.
        if (e.CtrlKey && !e.AltKey && !e.ShiftKey && !e.MetaKey && e.Key.ToUpperInvariant() is "X" or "V")
        {
            if (!isEditing)
            {
                RunShortcut("Ctrl+" + e.Key.ToUpperInvariant());
            }

            return;
        }

        if (e.CtrlKey || e.AltKey || e.MetaKey)
        {
            return;
        }

        switch (e.Key)
        {
            case "ArrowDown" or "ArrowUp" or "Home" or "End":
                if (_visible.Count == 0)
                {
                    return;
                }

                var index = current is null ? -1 : _visible.IndexOf(current);
                index = e.Key switch
                {
                    "ArrowDown" => Math.Min(index + 1, _visible.Count - 1),
                    "ArrowUp" => Math.Max(index - 1, 0),
                    "Home" => 0,
                    _ => _visible.Count - 1,
                };
                _pickedHere = true;
                PickAlone(_visible[index]);
                _shownSelection = null;
                break;
            case "ArrowRight" when current is not null && ChildrenOf(current) is not null && !IsExpanded(current):
                SetExpanded(current, true);
                break;
            case "ArrowLeft" when current is not null && ChildrenOf(current) is not null && IsExpanded(current):
                SetExpanded(current, false);
                break;
            case "ArrowLeft" when current is not null && PathTo(current) is { Count: > 1 } path:
                _pickedHere = true;
                PickAlone(path[^2]);
                _shownSelection = null;
                break;
            case "Enter" or " " when current is not null && ChildrenOf(current) is not null:
                SetExpanded(current, !IsExpanded(current));
                break;
            case "F2" or "Delete" when !isEditing:
                RunShortcut(e.Key == "F2" ? "F2" : "Del");
                break;
            case "Escape" when !isEditing:
                RunShortcut("Esc");
                break;
            case "ContextMenu" when current is not null && MenuFor is not null && _menu is not null:
                await _menu.OpenAsync(MenuFor(current), 200, 200);
                break;
        }
    }

    /// <summary>Runs what the row picked's menu shows beside <paramref name="gesture"/> (TreeShortcut), if it can run.</summary>
    private void RunShortcut(string gesture)
    {
        if (Shortcut?.Invoke(gesture) is { Command: { } command } item && command.CanExecute(item.Parameter))
        {
            command.Execute(item.Parameter);
        }
    }

    /// <summary>The row drawn with this element's id, or null for none (the list's empty space, or a row gone since).</summary>
    private TNode? RowOf(string? elementId) =>
        elementId is null ? null : _visible.FirstOrDefault(n => ElementId(n) == elementId);

    /// <summary>
    /// A drag begun on the row with this element's id (watchTreeDrag): a row that's picked drags every row picked that can
    /// be dragged; any other is picked alone and drags alone. Returns how many rows it drags, which the page's ghost of
    /// them shows; none when that row can't be dragged.
    /// </summary>
    internal int StartDrag(string elementId)
    {
        CancelSecondClick();
        if (RowOf(elementId) is not { } node || CanDrag?.Invoke(node) != true)
        {
            return 0;
        }

        if (!Selected.Contains(node))
        {
            _pickedHere = true;
            PickAlone(node);
        }

        _dragging = [.. Selected.OfType<TNode>().Where(n => CanDrag?.Invoke(n) == true)];
        StateHasChanged();
        return _dragging.Count;
    }

    /// <summary>
    /// The rows dragged are over this row (null: the list's empty space): it's marked when they can drop there. Returns
    /// whether they can, which the page's ghost says ("Move to Cakes").
    /// </summary>
    internal bool DragOver(string? elementId)
    {
        var over = RowOf(elementId);
        var target = over is not null && _dragging.Count > 0 && CanDrop?.Invoke(_dragging, over) == true ? over : null;
        if (!ReferenceEquals(target, _dropTarget))
        {
            _dropTarget = target;
            StateHasChanged();
        }

        return target is not null;
    }

    /// <summary>The rows dragged let go on this row, or on the list's empty space (null): they move, if they can.</summary>
    internal async Task DropAsync(string? elementId)
    {
        var dragging = _dragging;
        var target = RowOf(elementId);
        EndDrag();
        if (dragging.Count > 0 && OnDrop is not null && CanDrop?.Invoke(dragging, target) == true)
        {
            await OnDrop(dragging, target);
        }
    }

    /// <summary>The drag ends with nothing dropped: let go beside the list, Escape, or the pointer lost.</summary>
    internal void EndDrag()
    {
        if (_dragging.Count > 0 || _dropTarget is not null)
        {
            _dragging = [];
            _dropTarget = null;
            StateHasChanged();
        }
    }

    /// <summary>
    /// What the page's drag watch calls: a go-between that lets go of the tree as the tree goes, so nothing that kept the
    /// reference handed to the page keeps the tree, and a drop arriving after the tree has gone moves nothing.
    /// </summary>
    public sealed class Drags(FolderTree<TNode> tree)
    {
        private FolderTree<TNode>? _tree = tree;

        /// <summary>How many rows the drag takes: none when it can't start there.</summary>
        [JSInvokable]
        public Task<int> Start(string elementId) => Ask(t => t.StartDrag(elementId));

        /// <summary>Whether the rows dragged can drop on that row.</summary>
        [JSInvokable]
        public Task<bool> Over(string? elementId) => Ask(t => t.DragOver(elementId));

        [JSInvokable]
        public Task Drop(string? elementId) => _tree is { } tree ? tree.InvokeAsync(() => tree.DropAsync(elementId)) : Task.CompletedTask;

        [JSInvokable]
        public Task Cancel() => Run(t => t.EndDrag());

        private Task Run(Action<FolderTree<TNode>> action) => _tree is { } tree ? tree.InvokeAsync(() => action(tree)) : Task.CompletedTask;

        private async Task<T> Ask<T>(Func<FolderTree<TNode>, T> question)
        {
            var answer = default(T)!;
            if (_tree is { } tree)
            {
                await tree.InvokeAsync(() => answer = question(tree));
            }

            return answer;
        }

        internal void LetGo() => _tree = null;
    }

    private void Watch(TNode node)
    {
        if (!_watched.ContainsKey(node) && node is INotifyPropertyChanged changing)
        {
            changing.PropertyChanged += OnNodeChanged;
            _watched[node] = () => changing.PropertyChanged -= OnNodeChanged;
        }

        if (ChildrenOf(node) is INotifyCollectionChanged rows && !_watched.ContainsKey(rows))
        {
            rows.CollectionChanged += OnRowsChanged;
            _watched[rows] = () => rows.CollectionChanged -= OnRowsChanged;
        }
    }

    // Many rows can change at once (a refresh); they're drawn once, after the last, unless the screen has drawn the tree
    // by then.
    private void OnNodeChanged(object? sender, PropertyChangedEventArgs e) => Redraws.Request();

    private void OnRowsChanged(object? sender, NotifyCollectionChangedEventArgs e) => Redraws.Request();

    private RedrawGate Redraws => _redraws ??= new RedrawGate(InvokeAsync, StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        CancelSecondClick();
        foreach (var unwatch in _watched.Values)
        {
            unwatch();
        }

        _watched.Clear();
        _rowEvents.Clear();
        if (_dragWatch is not null)
        {
            try
            {
                await _dragWatch.InvokeVoidAsync("dispose");
                await _dragWatch.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The page has gone: nothing left to let go of.
            }
        }

        _drags?.LetGo();
        _dragsReference?.Dispose();
    }
}
