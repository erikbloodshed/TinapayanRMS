@using TinapayanRMS.ApplicationCore.Interfaces

@* The Consumer tiles (the WPF app's UsedByTilesStyle): one per product that uses the record, in rows and columns of
   equal width, each with the product's name, wrapping when long, and under it, on Raw
   Materials, what the material makes up of the product's material cost. A tile opens its product on the Products screen.
   On Sub-Assemblies, a tile follows for each made ingredient made from it, which opens it on Raw Materials. *@
<div class="consumer-tiles">
    @foreach (var product in Products)
    {
        <button type="button" class="consumer-tile" title="Open on the Products screen" @onclick="() => Open.InvokeAsync(product.Id)">
            <span class="consumer-name">@product.Name</span>
            @if (product.CostShareText is { } share)
            {
                <span class="consumer-share" title="What the material makes up of this product's material cost, its ingredients and packaging at buffered costs, however it gets into it">@share</span>
            }
        </button>
    }
    @foreach (var ingredient in MadeIngredients)
    {
        <button type="button" class="consumer-tile" title="A made ingredient made from it. Open on the Raw Materials screen" @onclick="() => OpenMadeIngredient.InvokeAsync(ingredient.Id)">
            <span class="consumer-name">@ingredient.Name</span>
        </button>
    }
</div>
@if (Caption is not null)
{
    <p class="caption">@Caption</p>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<LinkingProduct> Products { get; set; } = [];

    /// <summary>The made ingredients made from a sub-assembly, after its products; none elsewhere.</summary>
    [Parameter] public IReadOnlyList<MadeIngredientUse> MadeIngredients { get; set; } = [];

    [Parameter] public string? Caption { get; set; }

    [Parameter] public EventCallback<int> Open { get; set; }

    [Parameter] public EventCallback<int> OpenMadeIngredient { get; set; }
}
