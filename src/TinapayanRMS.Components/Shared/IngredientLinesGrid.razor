@using System.Collections.ObjectModel

@* A recipe's ingredient lines, as the WPF Sub-Assemblies and Products recipe grids: the ingredient (picked from a list
   of names: the category and cost per gram it also showed, in columns, made a list of a hundred-odd ingredients slower
   to draw and to read, and the line shows the cost once picked), its grams, its percentage (Baker's % while a line is
   ticked as the base, typed where it can be; Absolute % while none is), its cost per gram and cost, and the Base tick.
   The lines are dragged into order, and the add row has no tick until it's a line. Insert Line (InsertLineAsync) puts a
   blank line in above the one picked, as one undo step. *@
<LineGrid @ref="_grid" TRow="IngredientLineRow" Items="Items" NewItem="NewItem" SelectedItem="SelectedItem" SelectedItemChanged="SelectedItemChanged"
          Reorderable="!ReadOnly" ReadOnly="ReadOnly" InsertKey="true" EmptyText="@EmptyText" Footer="Footer">
    <Header>
        <th>Ingredient</th>
        <th class="col-number col-grams">Grams</th>
        <th class="col-number col-percent">@PercentHeader</th>
        <th class="col-number col-cost-per-gram">Cost/g</th>
        <th class="col-number col-line-cost">Cost</th>
        @if (ShowBase)
        {
            <th class="col-check">Base</th>
        }
    </Header>
    <Row Context="row">
        <td>
            @if (ReadOnly)
            {
                <span class="cell-text">@row.Ingredient?.Name</span>
            }
            else
            {
                <PickField TItem="RawMaterial" Items="Ingredients" TextField="Name" CssClass="cell-field" Deferred="true" PopupWidth="320px"
                           Value="row.Ingredient" ValueChanged="m => row.IngredientId = m?.Id" />
            }
        </td>
        <td><NumberField TValue="decimal?" Value="row.Grams" ValueChanged="v => row.Grams = v" Format="#,0.0###" Min="0" ReadOnly="ReadOnly" CssClass="cell-field" /></td>
        <td><NumberField TValue="decimal?" Value="row.Percent" ValueChanged="v => row.Percent = v" Format="N1" Min="0" ReadOnly="@(ReadOnly || !row.CanTypeBakersPercent)" CssClass="cell-field" /></td>
        <td class="cell-number">@row.CostPerGram.ToString("N4")</td>
        <td class="cell-number">@row.Cost.ToString("N2")</td>
        @if (ShowBase)
        {
            <td class="cell-check">
                @if (Items.Contains(row))
                {
                    <input type="checkbox" checked="@row.IsFormulaBase" disabled="@ReadOnly" @onchange="e => SetBase(row, e.Value is true)"
                           title="The line the others' Baker's % are of: the flour, usually." />
                }
            </td>
        }
    </Row>
</LineGrid>

@code {
    [Parameter, EditorRequired] public ObservableCollection<IngredientLineRow> Items { get; set; } = null!;

    [Parameter] public Func<IngredientLineRow>? NewItem { get; set; }

    [Parameter, EditorRequired] public IEnumerable<RawMaterial> Ingredients { get; set; } = [];

    [Parameter] public IngredientLineRow? SelectedItem { get; set; }

    [Parameter] public EventCallback<IngredientLineRow?> SelectedItemChanged { get; set; }

    [Parameter] public string PercentHeader { get; set; } = "Baker's %";

    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>Whether the lines have a Base tick; a linked recipe's add-ins don't.</summary>
    [Parameter] public bool ShowBase { get; set; } = true;

    [Parameter] public string? EmptyText { get; set; }

    [Parameter] public RenderFragment? Footer { get; set; }

    [CascadingParameter] public IUndoRecorder? Recorder { get; set; }

    private LineGrid<IngredientLineRow>? _grid;

    /// <summary>Insert Line: a blank line above the one picked, or at the bottom, ready to type. Undo takes it away.</summary>
    public Task InsertLineAsync() => _grid?.InsertLineAsync() ?? Task.CompletedTask;

    // A tick is one change, start to finish, so one undo step.
    private void SetBase(IngredientLineRow row, bool isBase)
    {
        Recorder?.BeginUndoStep();
        row.IsFormulaBase = isBase;
        Recorder?.EndUndoStep();
    }
}
