@typeparam TItem

@* A picker bound to a ViewModel's choice, as the WPF screens' ComboBoxAdvs were: every picker filters as it's typed
   into, and picks only what it lists. The choice is
   the item itself (an entity, an enum, a unit), shown by its TextField, or as itself without one. The combo box holds
   each item's place in the list rather than the item, since it reads an enum's first value as no value at all. Within
   an undo screen the pick is one undo step. A picker on a screen that adds what's typed (the Category pickers) passes
   OnTyped and OnLeave, and the screen settles the text itself. As the WPF pickers highlighted the best match for what's
   typed (PickerMatchHighlight), the first match fills in as it's typed (Autofill), so Enter or Tab picks it. The list
   filters on every key (DebounceDelay 0): Syncfusion's default held each filter back 300 ms after the key, so the list
   and the fill-in trailed the typing, and a late fill-in could put back text just rubbed out. The lists are in memory,
   and a filter takes the window a few milliseconds. Only a pick made with the cursor in the box is passed on: the combo
   box also hands back values of its own as it settles on a list it was given (OnValueChanged). *@
<SfComboBox ID="@ID" TValue="int?" TItem="Choice" DataSource="_choices" Value="ShownIndex" ValueChanged="OnValueChanged" DebounceDelay="0"
            AllowFiltering="true" FilterType="FilterType.Contains" AllowCustom="false" Autofill="true" Placeholder="@Placeholder"
            Enabled="!Disabled" CssClass="@($"field {CssClass}")" ShowClearButton="ShowClearButton" title="@Tooltip" PopupWidth="@PopupWidth">
    <ComboBoxFieldSettings Text="Text" Value="Index" />
    <ComboBoxEvents TValue="int?" TItem="Choice" Focus="OnFocus" Blur="OnBlur" Filtering="OnFiltering" />
    @if (ItemTemplate is not null)
    {
        <ComboBoxTemplates TItem="Choice">
            <ItemTemplate Context="choice">@ItemTemplate(choice.Item)</ItemTemplate>
        </ComboBoxTemplates>
    }
</SfComboBox>

@code {
    /// <summary>An item as the combo box holds it: its place in the list, and the text it's found and shown by.</summary>
    public sealed record Choice(int Index, string Text, TItem Item);

    private List<Choice> _choices = [];

    [Parameter] public string? ID { get; set; }

    [Parameter, EditorRequired] public IEnumerable<TItem> Items { get; set; } = [];

    [Parameter] public TItem? Value { get; set; }

    [Parameter] public EventCallback<TItem?> ValueChanged { get; set; }

    /// <summary>The item's property shown for it ("Name"); none for an item shown as itself (an enum).</summary>
    [Parameter] public string? TextField { get; set; }

    /// <summary>The text shown for an item, in place of TextField.</summary>
    [Parameter] public Func<TItem, string>? TextOf { get; set; }

    [Parameter] public RenderFragment<TItem>? ItemTemplate { get; set; }

    [Parameter] public bool Disabled { get; set; }

    /// <summary>
    /// Whether the picker can be left with nothing picked (a Category). Where it can't (a line's ingredient, a role),
    /// text that matches nothing puts the pick back rather than clearing it.
    /// </summary>
    [Parameter] public bool AllowEmpty { get; set; }

    [Parameter] public bool ShowClearButton { get; set; }

    [Parameter] public string? Placeholder { get; set; }

    [Parameter] public string? Tooltip { get; set; }

    [Parameter] public string? CssClass { get; set; }

    [Parameter] public string PopupWidth { get; set; } = "100%";

    /// <summary>What's being typed, as it's typed: for a screen that settles typed text itself.</summary>
    [Parameter] public EventCallback<string> OnTyped { get; set; }

    [Parameter] public EventCallback OnArrive { get; set; }

    [Parameter] public EventCallback OnLeave { get; set; }

    [CascadingParameter] public IUndoRecorder? Recorder { get; set; }

    private int? SelectedIndex => IndexOf(Value);

    private int? IndexOf(TItem? item) =>
        item is null ? null : _choices.FindIndex(c => EqualityComparer<TItem>.Default.Equals(c.Item, item)) is >= 0 and var i ? i : null;

    // While the box has the cursor it's given what the typing last picked, not the ViewModel's pick drawn over it: a pick
    // refused there (text rubbed out, or matching nothing, where one is needed) wrote the old one back into the box under
    // the cursor, so Backspace seemed to do nothing. The ViewModel's pick shows again once the box is left. The typed pick
    // is kept as the item, not its place: a list rebuilt under the cursor would put another item at that place.
    private bool _hasCursor;

    private Choice? _typed;

    private int? ShownIndex => _hasCursor ? (_typed is null ? null : IndexOf(_typed.Item)) : SelectedIndex;

    protected override void OnParametersSet()
    {
        var items = Items.ToList();
        if (items.Count != _choices.Count || !items.Select((item, i) => EqualityComparer<TItem>.Default.Equals(item, _choices[i].Item) && Text(item) == _choices[i].Text).All(same => same))
        {
            _choices = [.. items.Select((item, i) => new Choice(i, Text(item), item))];
        }
    }

    private string Text(TItem item) =>
        TextOf?.Invoke(item)
        ?? (TextField is null ? item?.ToString() : item?.GetType().GetProperty(TextField)?.GetValue(item)?.ToString())
        ?? "";

    private async Task OnFocus(object args)
    {
        _typed = SelectedIndex is { } i ? _choices[i] : null;
        _hasCursor = true;
        Recorder?.BeginUndoStep();
        await OnArrive.InvokeAsync();
    }

    private async Task OnBlur(object args)
    {
        _hasCursor = false;
        Recorder?.EndUndoStep();
        await OnLeave.InvokeAsync();
    }

    private async Task OnFiltering(FilteringEventArgs args) => await OnTyped.InvokeAsync(args.Text ?? "");

    // Text that matched nothing, where a pick is needed, leaves the pick as it was, and the box shows it again once it's
    // left.
    private async Task OnValueChanged(int? index)
    {
        // A pick comes from the box while it has the cursor: a hand picks with the cursor in it, and the combo box passes on
        // a pick typed or filled in, on Tab or a click elsewhere, before it says the box was left. Without the cursor, a
        // value is the combo box settling on a list it was given, handing back the place it was given with it a drawing
        // before: a Raw Materials pick shows the base unit in the Buffered Cost "Per" list until the material's details
        // put its purchase unit there, and the combo box's late answer put the base unit back under a form already
        // settled, which then had changes to save. It's no pick: left out, the box is drawn again (as after any of its
        // events) with the ViewModel's pick. Only the clear button, which no picker shows, empties the box without it.
        if (!_hasCursor && !(index is null && ShowClearButton))
        {
            return;
        }

        _typed = index is { } i && i >= 0 && i < _choices.Count ? _choices[i] : null;
        if (_typed is not null)
        {
            await ValueChanged.InvokeAsync(_typed.Item);
        }
        else if (AllowEmpty)
        {
            await ValueChanged.InvokeAsync(default);
        }
    }
}
