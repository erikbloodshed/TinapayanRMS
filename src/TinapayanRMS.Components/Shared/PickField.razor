@typeparam TItem
@inject IJSRuntime JS

@* A picker bound to a ViewModel's choice, as the WPF screens' ComboBoxAdvs were: every picker filters as it's typed
   into, and picks only what it lists. The choice is
   the item itself (an entity, an enum, a unit), shown by its TextField, or as itself without one. The combo box holds
   each item's place in the list rather than the item, since it reads an enum's first value as no value at all. Within
   an undo screen the pick is one undo step. A picker on a screen that adds what's typed (the Category pickers) passes
   OnTyped and OnLeave, and the screen settles the text itself. As the WPF pickers highlighted the best match for what's
   typed (PickerMatchHighlight), the list is sorted best match first (each item's Rank, RecordNameMatch.Rank, set as
   it's typed, before the combo box filters), and the best match is highlighted for Enter or Tab to pick, the box
   keeping only what's typed: the combo box's own fill-in (Autofill) wrote the rest of a name into the box under the
   cursor, and found only names starting with what was typed. The combo box is the app's own (PickComboBox), which
   sorts by the rank and highlights the best match: Syncfusion's marks the item it held, where that's still listed. The
   list filters on every key (DebounceDelay 0): Syncfusion's default held each filter back 300 ms after the key, so the
   list trailed the typing. The lists are in memory, and a filter takes the window a few milliseconds. Only a pick made
   with the cursor in the box is passed on: the combo box also hands back values of its own as it settles on a list it
   was given (OnValueChanged). A picker that shows in answer to a button (OpenOnShow) takes the cursor and opens its list
   as it shows, so the next key filters it. A picker on every line of a table (Deferred) is the combo box only while it
   has the cursor: until then, a look-alike of it, a box with the item's name and the arrow, takes its place. *@
@if (Deferred)
{
    @* The look-alike keeps its place, and the cursor, while the combo box is made beside it, unseen (handing-over); once
       the combo box is set up, the cursor is handed to it (OnCreated), and the look-alike goes. *@
    <span @ref="_cell" class="deferred-pick-cell @(_handingOver ? "handing-over" : null)">
        @if (_live)
        {
            @ComboBox
        }
        @if (!_live || _handingOver)
        {
            <span class="e-ddl e-input-group e-control-container e-control-wrapper e-valid-input field @CssClass deferred-pick" style="width: 100%;" title="@Tooltip">
                <input class="e-input" type="text" value="@NameShown" data-text="@NameShown" placeholder="@Placeholder" disabled="@Disabled"
                       autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" role="combobox" aria-expanded="false" @onfocus="GoLive" />
                <span class="e-input-group-icon e-ddl-icon e-icons" @onmousedown="GoLiveAndOpen" @onmousedown:preventDefault="true"></span>
            </span>
        }
    </span>
}
else
{
    @ComboBox
}

@code {
    private RenderFragment ComboBox =>
        @<PickComboBox @ref="_box" TItem="TItem" ID="@ID" DataSource="_choices" Value="ShownIndex" ValueChanged="OnValueChanged" DebounceDelay="0"
                     AllowFiltering="true" FilterType="FilterType.Contains" AllowCustom="false" Autofill="false" Placeholder="@Placeholder"
                     Enabled="!Disabled" CssClass="@($"field {CssClass}")" ShowClearButton="ShowClearButton" title="@Tooltip" PopupWidth="@PopupWidth">
            <ComboBoxFieldSettings Text="Text" Value="Index" />
            <ComboBoxEvents TValue="int?" TItem="Choice" Created="OnCreated" Focus="OnFocus" Blur="OnBlur" Filtering="OnFiltering" OnValueSelect="OnSelect" />
            @if (ItemTemplate is not null)
            {
                <ComboBoxTemplates TItem="Choice">
                    <ItemTemplate Context="choice">@ItemTemplate(choice.Item)</ItemTemplate>
                </ComboBoxTemplates>
            }
        </PickComboBox>;

    /// <summary>
    /// An item as the combo box holds it: its place in the list, the text it's found and shown by, and how well that
    /// matches what's typed, which the list is sorted by. The match isn't part of what it is: the combo box may hold it
    /// by its hash while it changes.
    /// </summary>
    public sealed record Choice(int Index, string Text, TItem Item)
    {
        public int Rank { get; set; }

        public bool Equals(Choice? other) =>
            other is not null && Index == other.Index && Text == other.Text && EqualityComparer<TItem>.Default.Equals(Item, other.Item);

        public override int GetHashCode() => HashCode.Combine(Index, Text, Item);
    }

    private PickComboBox<TItem>? _box;

    private List<Choice> _choices = [];

    [Parameter] public string? ID { get; set; }

    [Parameter, EditorRequired] public IEnumerable<TItem> Items { get; set; } = [];

    [Parameter] public TItem? Value { get; set; }

    [Parameter] public EventCallback<TItem?> ValueChanged { get; set; }

    /// <summary>The item's property shown for it ("Name"); none for an item shown as itself (an enum).</summary>
    [Parameter] public string? TextField { get; set; }

    /// <summary>The text shown for an item, in place of TextField.</summary>
    [Parameter] public Func<TItem, string>? TextOf { get; set; }

    [Parameter] public RenderFragment<TItem>? ItemTemplate { get; set; }

    [Parameter] public bool Disabled { get; set; }

    /// <summary>
    /// Whether the picker can be left with nothing picked (a Category). Where it can't (a line's ingredient, a role),
    /// text that matches nothing puts the pick back rather than clearing it.
    /// </summary>
    [Parameter] public bool AllowEmpty { get; set; }

    [Parameter] public bool ShowClearButton { get; set; }

    [Parameter] public string? Placeholder { get; set; }

    [Parameter] public string? Tooltip { get; set; }

    [Parameter] public string? CssClass { get; set; }

    [Parameter] public string PopupWidth { get; set; } = "100%";

    /// <summary>
    /// Whether the picker takes the cursor and opens its list as it shows: one that appears in answer to a button (the
    /// Packaging tab's Link and Copy), where nothing else is to be done but pick. Without it, the user had to click the
    /// box first, and with the Vim keys on, what they typed straight away went to the keys instead.
    /// </summary>
    [Parameter] public bool OpenOnShow { get; set; }

    /// <summary>
    /// Whether the picker is the combo box only while it has the cursor, and until then a look-alike of it: a box with the
    /// item's name and the arrow, which takes the cursor (a click, Tab, Insert Line, the Vim keys) and its arrow's press as
    /// the combo box would, and hands them over, with anything typed meanwhile, once the combo box is made. For a picker on
    /// every line of a table (LineGrid): each combo box sets up its whole list as it's drawn, which made them the largest
    /// part of opening a screen or picking a record.
    /// </summary>
    [Parameter] public bool Deferred { get; set; }

    /// <summary>What's being typed, as it's typed: for a screen that settles typed text itself.</summary>
    [Parameter] public EventCallback<string> OnTyped { get; set; }

    [Parameter] public EventCallback OnArrive { get; set; }

    [Parameter] public EventCallback OnLeave { get; set; }

    [CascadingParameter] public IUndoRecorder? Recorder { get; set; }

    private int? SelectedIndex => IndexOf(Value);

    private int? IndexOf(TItem? item) =>
        item is null ? null : _choices.FindIndex(c => EqualityComparer<TItem>.Default.Equals(c.Item, item)) is >= 0 and var i ? i : null;

    // While the box has the cursor it's given what the typing last picked, not the ViewModel's pick drawn over it: a pick
    // refused there (text rubbed out, or matching nothing, where one is needed) wrote the old one back into the box under
    // the cursor, so Backspace seemed to do nothing. The ViewModel's pick shows again once the box is left. The typed pick
    // is kept as the item, not its place: a list rebuilt under the cursor would put another item at that place.
    private bool _hasCursor;

    private Choice? _typed;

    private int? ShownIndex => _hasCursor ? (_typed is null ? null : IndexOf(_typed.Item)) : SelectedIndex;

    // What Enter or Tab takes while the box has the cursor: the best match for what's typed, or the item the arrow keys
    // moved to. None once it's been picked, or with nothing typed.
    private Choice? _highlighted;

    // Whether the highlighted item was taken for what's typed, since the box took the cursor or was last typed into.
    private bool _highlightTaken;

    // Deferred: whether the combo box is drawn, and whether its look-alike still has the cursor while it's made; and
    // whether the look-alike's arrow was pressed, for the list to open once the combo box has the cursor.
    private bool _live;
    private bool _handingOver;
    private bool _openWhenLive;
    private ElementReference _cell;

    private string NameShown => Value is { } item ? Text(item) : "";

    // A look-alike's list waits until it goes live: only the combo box reads it.
    protected override void OnParametersSet()
    {
        if (!Deferred || _live)
        {
            UpdateChoices();
        }
    }

    private void UpdateChoices()
    {
        var items = Items.ToList();
        if (items.Count != _choices.Count || !items.Select((item, i) => EqualityComparer<TItem>.Default.Equals(item, _choices[i].Item) && Text(item) == _choices[i].Text).All(same => same))
        {
            _choices = [.. items.Select((item, i) => new Choice(i, Text(item), item))];
        }
    }

    private string Text(TItem item) =>
        TextOf?.Invoke(item)
        ?? (TextField is null ? item?.ToString() : item?.GetType().GetProperty(TextField)?.GetValue(item)?.ToString())
        ?? "";

    // The combo box says it's made once its first drawing has set up its script (sfBlazor's initialize), which its
    // FocusAsync and ShowPopupAsync call into: from then on it can be given the cursor and its list. A deferred picker's
    // look-alike hands it the cursor then, in the browser (tinapayan.handOverPick), with what was typed into it meanwhile,
    // unless the cursor went on elsewhere first: then the look-alike stays.
    private async Task OnCreated(object args)
    {
        if (_box is null)
        {
            return;
        }

        if (_handingOver)
        {
            var pressed = _openWhenLive;
            _openWhenLive = false;
            bool taken;
            try
            {
                taken = await JS.InvokeAsync<bool>("tinapayan.handOverPick", _cell, pressed);
            }
            catch (JSException)
            {
                taken = false;
            }

            _handingOver = false;
            if (!taken && !_hasCursor)
            {
                _live = false;
            }
            else if (pressed && _live)
            {
                await _box.ShowPopupAsync();
            }
        }
        else if (OpenOnShow)
        {
            await _box.FocusAsync();
            await _box.ShowPopupAsync();
        }
    }

    // Deferred: the look-alike took the cursor. The combo box is made beside it, unseen, and takes the cursor once it's
    // set up (OnCreated).
    private void GoLive()
    {
        if (!_live && !Disabled)
        {
            UpdateChoices();
            _live = true;
            _handingOver = true;
        }
    }

    // Its arrow pressed: the same, and the list opens once the combo box has the cursor.
    private void GoLiveAndOpen()
    {
        _openWhenLive = !Disabled;
        GoLive();
    }

    private async Task OnFocus(object args)
    {
        _typed = SelectedIndex is { } i ? _choices[i] : null;
        _highlighted = null;
        _highlightTaken = false;
        foreach (var choice in _choices)
        {
            choice.Rank = 0;
        }
        if (_box is not null)
        {
            _box.BestMatch = null;
            _box.LeftWithTypedText = false;
        }

        _hasCursor = true;
        Recorder?.BeginUndoStep();
        await OnArrive.InvokeAsync();
    }

    // Tab, or a click elsewhere, picks the highlighted item, unless Escape put the item's name back. The combo box picks
    // only an item named exactly what's typed as it's left, and on a new line, with nothing picked before, it says
    // nothing at all.
    private async Task OnBlur(object args)
    {
        if (_highlighted is not null && _box?.LeftWithTypedText == true)
        {
            await PassOnAsync(_highlighted);
        }

        _hasCursor = false;
        Recorder?.EndUndoStep();
        await OnLeave.InvokeAsync();

        // Deferred: the look-alike takes the combo box's place again. What the combo box still does after saying it was
        // left (a float label's size, in its script) finds nothing there to do.
        if (Deferred)
        {
            _live = false;
        }
    }

    // Ranked before the combo box filters, as it then sorts what it lists by the rank and highlights the first. With
    // nothing typed it lists everything as given, so every rank is the same.
    private async Task OnFiltering(FilteringEventArgs args)
    {
        var text = args.Text ?? "";
        _highlighted = null;
        _highlightTaken = false;
        foreach (var choice in _choices)
        {
            choice.Rank = RecordNameMatch.Rank(choice.Text, text) ?? int.MaxValue;
            if (choice.Rank != int.MaxValue && (_highlighted is null || choice.Rank < _highlighted.Rank))
            {
                _highlighted = choice;
            }
        }

        if (_box is not null)
        {
            _box.BestMatch = _highlighted;
        }

        await OnTyped.InvokeAsync(text);
    }

    // An item the arrow keys moved to, or clicked: what Enter or Tab takes now.
    private void OnSelect(SelectEventArgs<Choice> args)
    {
        if (_hasCursor && args.ItemData is not null)
        {
            _highlighted = args.ItemData;
        }
    }

    // Text that matched nothing, where a pick is needed, leaves the pick as it was, and the box shows it again once it's
    // left. Typed text naming no item exactly, settled by leaving or by Enter, is the highlighted item: the combo box
    // answers it with no pick. Only then: after Escape it also hands back no pick, and the line keeps its item.
    private async Task OnValueChanged(int? index)
    {
        // A pick comes from the box while it has the cursor: a hand picks with the cursor in it, and the combo box passes on
        // a pick typed or highlighted, on Tab or a click elsewhere, before it says the box was left. Without the cursor, a
        // value is the combo box settling on a list it was given, handing back the place it was given with it a drawing
        // before: a Raw Materials pick shows the base unit in the Buffered Cost "Per" list until the material's details
        // put its purchase unit there, and the combo box's late answer put the base unit back under a form already
        // settled, which then had changes to save. It's no pick: left out, the box is drawn again (as after any of its
        // events) with the ViewModel's pick. Only the clear button, which no picker shows, empties the box without it.
        if (!_hasCursor && !(index is null && ShowClearButton))
        {
            return;
        }

        if (index is { } i && i >= 0 && i < _choices.Count)
        {
            await PassOnAsync(_choices[i]);
        }
        else if (_box?.LeftWithTypedText == true && _highlighted is not null)
        {
            await PassOnAsync(_highlighted);
            _highlightTaken = true;
        }
        // The combo box, still showing what was typed, answers no pick again once the highlighted item is taken: a
        // Category, which can be left empty, was emptied.
        else if (!_highlightTaken)
        {
            _typed = null;
            if (AllowEmpty)
            {
                await ValueChanged.InvokeAsync(default);
            }
        }
    }

    private async Task PassOnAsync(Choice picked)
    {
        _typed = picked;
        _highlighted = null;
        await ValueChanged.InvokeAsync(picked.Item);
    }
}
