@implements IAsyncDisposable
@inject IJSRuntime JS

@* Ctrl+Z and Ctrl+Y (and Ctrl+Shift+Z) for the screen it's on, as the WPF app's UndoShortcuts gave every window: the
   browser's own undo in a text box is never used. The field with the cursor is left first, so what's half-typed lands
   and becomes the step this very press takes back; the step is then reopened for whatever's typed next. *@

@code {
    private DotNetObjectReference<UndoKeys>? _self;
    private IJSObjectReference? _registration;
    private bool _disposed;

    [Parameter, EditorRequired] public IUndoScreen Screen { get; set; } = null!;

    /// <summary>
    /// The screen's RedrawNowAsync. The step is drawn before the browser is told it's done, since that's when it puts the
    /// cursor back.
    /// </summary>
    [Parameter, EditorRequired] public Func<Task> Redraw { get; set; } = null!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);

            // The keys are the document's: a screen left before they were registered stops them at once.
            _registration = await JS.InvokeAsync<IJSObjectReference>("tinapayan.registerUndoKeys", _self).KeepUnlessGoneAsync(() => _disposed);
        }
    }

    [JSInvokable]
    public async Task Undo(bool redo)
    {
        Screen.EndUndoStep();
        if (redo)
        {
            Screen.TryRedo();
        }
        else
        {
            Screen.TryUndo();
        }

        Screen.BeginUndoStep();
        await Redraw();
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        await _registration.StopAsync();
        _self?.Dispose();
    }
}
