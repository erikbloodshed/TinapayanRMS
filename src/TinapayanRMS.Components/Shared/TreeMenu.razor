@using System.Windows.Input

@* The menu a right-click opens on a folder tree, built from the ViewModel's TreeMenuItems (TreeMenuFor): each item's
   icon, its header, the key that does the same at its right,
   a submenu in place of a command, and the lines between groups. Picking one runs its command with its parameter. *@
<SfContextMenu @ref="_menu" TValue="MenuItem" Items="_items" CssClass="tree-menu">
    <MenuEvents TValue="MenuItem" ItemSelected="OnItemSelected" />
    <MenuTemplates TValue="MenuItem">
        <Template>
            <span class="tree-menu-item">
                @if (_icons.TryGetValue(context.Id ?? "", out var icon))
                {
                    <Icon Of="icon" CssClass="tree-menu-glyph" />
                }
                else
                {
                    <span class="glyph tree-menu-glyph"></span>
                }
                <span class="tree-menu-text">@context.Text</span>
                @if (_gestures.GetValueOrDefault(context.Id ?? "") is { } gesture)
                {
                    <span class="tree-menu-gesture">@gesture</span>
                }
            </span>
        </Template>
    </MenuTemplates>
</SfContextMenu>

@code {
    // Syncfusion's own way to give a context menu items built in code is to make MenuItems, its item component, and
    // set their parameters; BL0005 warns against setting a component's parameters at all.
#pragma warning disable BL0005
    private SfContextMenu<MenuItem>? _menu;
    private List<MenuItem> _items = [];
    private readonly Dictionary<string, TreeMenuItem> _byId = [];
    private readonly Dictionary<string, AppIcon> _icons = [];
    private readonly Dictionary<string, string> _gestures = [];

    /// <summary>Opens <paramref name="items"/> at the window position given (a mouse event's ClientX and ClientY).</summary>
    public async Task OpenAsync(IReadOnlyList<TreeMenuItem> items, double x, double y)
    {
        _byId.Clear();
        _icons.Clear();
        _gestures.Clear();
        _items = Build(items, "m");
        if (_items.Count == 0 || _menu is null)
        {
            return;
        }

        StateHasChanged();
        await Task.Yield();
        await _menu.OpenAsync(x, y, enableCollision: true);
    }

    private List<MenuItem> Build(IReadOnlyList<TreeMenuItem> items, string prefix)
    {
        var built = new List<MenuItem>();
        for (var i = 0; i < items.Count; i++)
        {
            var item = items[i];
            var id = $"{prefix}-{i}";
            if (item.IsSeparator)
            {
                built.Add(new MenuItem { Id = id, Separator = true });
                continue;
            }

            _byId[id] = item;
            if (item.Icon is { } icon)
            {
                _icons[id] = icon;
            }

            if (item.Gesture is { } gesture)
            {
                _gestures[id] = gesture;
            }

            var canRun = item.IsEnabled && (item.Items.Count > 0 || (item.Command is { } command && command.CanExecute(item.Parameter)));
            built.Add(new MenuItem
            {
                Id = id,
                Text = item.Header,
                Disabled = !canRun,
                Items = item.Items.Count > 0 ? Build(item.Items, id) : null!,
            });
        }

        return built;
    }

    private void OnItemSelected(MenuEventArgs<MenuItem> args)
    {
        if (args.Item.Id is { } id && _byId.TryGetValue(id, out var item) && item.Items.Count == 0
            && item.Command is ICommand command && command.CanExecute(item.Parameter))
        {
            command.Execute(item.Parameter);
        }
    }
#pragma warning restore BL0005
}
