@* A percentage, as the WPF forms' DoubleTextBoxes held them: two decimals, never below Min, and no spin buttons. *@
<SfNumericTextBox ID="@ID" TValue="decimal" Value="Value" ValueChanged="ValueChanged" Min="Min" Max="Max" Format="n2" Decimals="2"
                  ShowSpinButton="false" ValidateDecimalOnType="true" title="@Tooltip" Readonly="ReadOnly" CssClass="number-box" />

@code {
    [Parameter] public string? ID { get; set; }

    [Parameter] public decimal Value { get; set; }

    [Parameter] public EventCallback<decimal> ValueChanged { get; set; }

    [Parameter] public decimal Min { get; set; }

    [Parameter] public decimal Max { get; set; } = decimal.MaxValue;

    [Parameter] public string? Tooltip { get; set; }

    [Parameter] public bool ReadOnly { get; set; }
}
