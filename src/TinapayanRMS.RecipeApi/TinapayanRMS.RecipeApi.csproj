<Project Sdk="Microsoft.NET.Sdk">

  <!-- A read-only HTTP API over the LAN for the shop's other apps (TinapayanBMS first): the mixes, ingredients, products and
       their recipes (Program). It prices with TinapayanRMS.Pricing, so its figures are the screens', and has nothing of the
       UI: it's on plain net11.0, which can't reference the UI project, so that can't come back by accident. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TinapayanRMS.Infrastructure\TinapayanRMS.Infrastructure.csproj" />
    <ProjectReference Include="..\TinapayanRMS.Pricing\TinapayanRMS.Pricing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The app's own, so it reads the database the app saves to. -->
    <Content Include="..\TinapayanRMS.UI\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="recipeapi.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TinapayanRMS.RecipeApi.Tests" />
  </ItemGroup>

</Project>
