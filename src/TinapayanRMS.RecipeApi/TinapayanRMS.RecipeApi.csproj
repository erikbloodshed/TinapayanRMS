<Project Sdk="Microsoft.NET.Sdk">

  <!-- A read-only HTTP API over the LAN for the shop's other apps (TinapayanBMS first): the mixes, ingredients,
       products and saved plans, and a production plan worked out with the app's own code (Program). It references the UI
       project because the plan's naming and the saved products' reading live there (ProductionPlanBuilder,
       SavedProductReader), so its figures are the Production Plan screen's. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(WindowsTargetFramework)</TargetFramework>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TinapayanRMS.UI\TinapayanRMS.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="recipeapi.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TinapayanRMS.RecipeApi.Tests" />
  </ItemGroup>

</Project>
